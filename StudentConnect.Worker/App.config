<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <connectionStrings>
    <!-- Template an toàn cho Release/Production. Khi chạy local tự động nạp từ Config/ConnectionStrings.config -->
    <add name="TDMUEcoSystemEntities"
         connectionString="metadata=res://*/Models.TDMUEcoSystemModel.csdl|res://*/Models.TDMUEcoSystemModel.ssdl|res://*/Models.TDMUEcoSystemModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=YOUR_SERVER;initial catalog=YOUR_DB;user id=YOUR_USER;password=YOUR_PASSWORD;MultipleActiveResultSets=True;App=EntityFramework;TrustServerCertificate=True&quot;"
         providerName="System.Data.EntityClient" />
  </connectionStrings>
  <appSettings>
    <!-- Template an toàn cho Release/Production. Khi chạy local tự động nạp từ Config/AppSettings.config -->
    <add key="GeminiApiKey" value="" />
    <add key="GeminiAgentName" value="Trợ lý ảo Mr. T" />
    <add key="GeminiModel" value="gemini-3.5-flash-lite" />
    <add key="WorkerPollingIntervalSeconds" value="30" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.LocalDbConnectionFactory, EntityFramework">
      <parameters>
        <parameter value="mssqllocaldb" />
      </parameters>
    </defaultConnectionFactory>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
</configuration>