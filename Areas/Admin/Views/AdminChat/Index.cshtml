@section scripts {
<form id="csrfForm" style="display:none;">@Html.AntiForgeryToken()</form>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    var currentActiveRoomId = null;
    var currentViewMessageId = null;
    var currentViewReportId = null;
    var currentSelectedMemberId = null;

    function getCsrfToken() {
        return $('input[name="__RequestVerificationToken"]').first().val() || '';
    }

    // ── CHUYỂN TAB CHÍNH (5 MỤC) ──
    var currentMsgPage = 1;

    function switchMainTab(tabId, btn) {
        $('.chat-tab-pane').hide();
        $('#' + tabId).show();
        $('.chat-nav-btn').removeClass('active');
        if (btn) $(btn).addClass('active');
        else $(`.chat-nav-btn[data-tab="${tabId}"]`).addClass('active');

        // Tự động tải dữ liệu có phân trang khi người dùng chuyển sang tab Quản lý tin nhắn
        if (tabId === 'tab-messages') {
            loadMessagesPage(currentMsgPage || 1);
        }
    }

    // ════════════════════════════════════════════════════════════
    // 1. QUẢN LÝ PHÒNG CHAT (BẢO TOÀN NGUYÊN BẢN CỦA DỰ ÁN)
    // ════════════════════════════════════════════════════════════

    // Live search phòng
    $('#liveSearch').on('keyup', function () {
        var val = $(this).val().toLowerCase();
        $('.room-row').each(function () {
            var searchData = $(this).data('search').toString().toLowerCase();
            $(this).toggle(searchData.indexOf(val) > -1);
        });
    });

    // Checkbox select all & bulk delete
    $('#selectAll').on('change', function () {
        $('.room-checkbox').prop('checked', this.checked);
        updateSelectBar();
    });

    $(document).on('change', '.room-checkbox', function () {
        updateSelectBar();
    });

    function updateSelectBar() {
        var count = $('.room-checkbox:checked').length;
        $('#selectCount').text(count);
        if (count > 0) {
            $('#selectBar').addClass('show');
            $('#btnDeleteSelectedBar').prop('disabled', false);
        } else {
            $('#selectBar').removeClass('show');
            $('#btnDeleteSelectedBar').prop('disabled', true);
        }
    }

    $('#btnClearSelect').on('click', function () {
        $('.room-checkbox').prop('checked', false);
        $('#selectAll').prop('checked', false);
        updateSelectBar();
    });

    $('#btnDeleteSelectedBar').on('click', function () {
        var selectedIds = $('.room-checkbox:checked').map(function () { return parseInt($(this).val()); }).get();
        if (selectedIds.length === 0) return;

        Swal.fire({
            title: `Xóa ${selectedIds.length} phòng chat đã chọn?`,
            text: 'Toàn bộ tin nhắn và lịch sử trò chuyện trong các phòng này sẽ bị xóa.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Xác nhận xóa',
            cancelButtonText: 'Hủy',
            confirmButtonColor: '#ff4d4d'
        }).then(function (res) {
            if (res.isConfirmed) {
                $.post('/Admin/AdminChat/DeleteMultipleRooms', { ids: selectedIds, __RequestVerificationToken: getCsrfToken() }, function (response) {
                    if (response.success) {
                        Swal.fire({ icon: 'success', title: 'Thành công', text: response.message, timer: 1500, showConfirmButton: false })
                            .then(() => location.reload());
                    } else {
                        Swal.fire('Lỗi', response.message, 'error');
                    }
                });
            }
        });
    });

    function confirmDelete(id, name, type) {
        Swal.fire({
            title: `Xóa phòng #${id}?`,
            text: `Bạn có chắc chắn muốn xóa "${name}" (${type})?`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Xóa vĩnh viễn',
            cancelButtonText: 'Hủy',
            confirmButtonColor: '#ff4d4d'
        }).then(function (res) {
            if (res.isConfirmed) {
                $.post('/Admin/AdminChat/DeleteRoom', { id: id, __RequestVerificationToken: getCsrfToken() }, function (response) {
                    if (response.success) {
                        $('#row-' + id).fadeOut(300, function () { $(this).remove(); });
                        Swal.fire({ icon: 'success', title: 'Đã xóa', text: response.message, toast: true, position: 'top-end', timer: 2500, showConfirmButton: false });
                    } else {
                        Swal.fire('Lỗi', response.message, 'error');
                    }
                });
            }
        });
    }

    function toggleRoomStatus(id, currentStatus, name, type) {
        var action = currentStatus ? "khóa/đóng" : "mở lại";
        Swal.fire({
            title: `Xác nhận ${action} phòng #${id}?`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Xác nhận',
            cancelButtonText: 'Hủy'
        }).then(function (res) {
            if (res.isConfirmed) {
                $.post('/Admin/AdminChat/ToggleRoomStatus', { id: id, __RequestVerificationToken: getCsrfToken() }, function (response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        Swal.fire('Lỗi', response.message, 'error');
                    }
                });
            }
        });
    }

    function viewRoomDetail(id) {
        currentActiveRoomId = id;
        $('#mdlRoomName').text(`Phòng #${id} ...`);
        $('#roomMessagesList').html('<div class="text-center text-white-50 py-4"><i class="bi bi-arrow-repeat spin"></i> Đang tải tin nhắn...</div>');
        $('#roomDetailOverlay').addClass('show');

        $.get('/Admin/AdminChat/GetRoomDetail', { id: id }, function (res) {
            if (res.success) {
                $('#mdlRoomName').text(res.roomName);
                $('#mdlRoomBadge').text(res.roomType);
                $('#mdlStatusBadge').text(res.isActive ? '● Đang mở' : '○ Đã đóng')
                                     .attr('class', 'adm-badge ' + (res.isActive ? 'badge-green' : 'badge-dim'));
                $('#mdlMsgCount').text(res.totalMessages);
                $('#mdlPartCount').text(res.totalParticipants);

                // Messages list
                var mHtml = '';
                if (!res.messages || res.messages.length === 0) {
                    mHtml = '<div class="text-center text-white-50 py-4">Phòng này chưa có tin nhắn nào.</div>';
                } else {
                    res.messages.forEach(function (m) {
                        mHtml += `<div class="chat-msg-item ${m.isHidden ? 'hidden-msg' : ''}">
                            <img src="${m.senderAvatar}" class="chat-msg-avatar" onerror="this.onerror=null;this.src=window.DEFAULT_AVATAR_SVG||'/Content/Images/default-avatar.png';" />
                            <div style="flex:1;">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="chat-msg-sender">${m.senderName}</span>
                                    <span class="chat-msg-time">${m.sentAt}</span>
                                </div>
                                <div class="chat-msg-text">
                                    ${m.isHidden ? `<span class="adm-badge badge-danger" style="font-size:9.5px;">[BQT đã ẩn: ${m.hiddenReason || 'Vi phạm'}]</span> ` : ''}
                                    ${m.content}
                                </div>
                                ${m.imageUrl ? `<div class="mt-2"><img src="${m.imageUrl}" style="max-height:120px; border-radius:6px; cursor:pointer;" onclick="openChatLightbox('${m.imageUrl}')" /></div>` : ''}
                            </div>
                        </div>`;
                    });
                }
                $('#roomMessagesList').html(mHtml);

                // Participants list
                var pHtml = '';
                if (!res.participants || res.participants.length === 0) {
                    pHtml = '<div class="text-center text-white-50 py-4">Chưa có thành viên nào.</div>';
                } else {
                    res.participants.forEach(function (p) {
                        pHtml += `<div class="col-md-6">
                            <div class="d-flex align-items-center gap-2 p-2" style="background:rgba(255,255,255,0.03); border-radius:8px; border:1px solid rgba(255,255,255,0.05);">
                                <img src="${p.avatar}" style="width:32px; height:32px; border-radius:50%;" onerror="this.onerror=null;this.src=window.DEFAULT_AVATAR_SVG||'/Content/Images/default-avatar.png';" />
                                <div style="flex:1;">
                                    <div class="text-white fw-bold" style="font-size:12px;">${p.displayName}</div>
                                    <div class="cell-id">@@${p.username} · ${p.isLeft ? 'Đã rời' : 'Đang tham gia'}</div>
                                </div>
                            </div>
                        </div>`;
                    });
                }
                $('#roomParticipantsList').html(pHtml);
            }
        });
    }

    function switchRoomModalSubTab(tab) {
        if (tab === 'messages') {
            $('#tabContentMessages').show();
            $('#tabContentParticipants').hide();
            $('#tabBtnMsg').addClass('cyan').css('color', '#00c8ff');
            $('#tabBtnPart').removeClass('cyan').css('color', '#fff');
        } else {
            $('#tabContentMessages').hide();
            $('#tabContentParticipants').show();
            $('#tabBtnPart').addClass('cyan').css('color', '#00c8ff');
            $('#tabBtnMsg').removeClass('cyan').css('color', '#fff');
        }
    }

    function closeRoomDetail() {
        $('#roomDetailOverlay').removeClass('show');
    }

    function toggleCurrentModalRoom() {
        if (currentActiveRoomId) {
            toggleRoomStatus(currentActiveRoomId, false, "", "");
        }
    }

    function deleteCurrentModalRoom() {
        if (currentActiveRoomId) {
            confirmDelete(currentActiveRoomId, "", "");
        }
    }

    // ════════════════════════════════════════════════════════════
    // 2. QUẢN LÝ TIN NHẮN (MESSAGE MANAGEMENT)
    // ════════════════════════════════════════════════════════════

    function renderPaginationComponent(containerId, infoId, page, totalPages, totalCount, pageSize, callbackFnName, itemLabel) {
        var $info = $('#' + infoId);
        var $btns = $('#' + containerId);

        if (!totalCount || totalCount === 0) {
            $info.html(`Không có ${itemLabel} nào`);
            $btns.html('');
            return;
        }

        var start = (page - 1) * pageSize + 1;
        var end = Math.min(page * pageSize, totalCount);
        $info.html(`Hiển thị <strong class="text-white">${start} - ${end}</strong> / <strong class="text-white">${totalCount}</strong> ${itemLabel} (Trang <strong>${page}</strong>/<strong>${totalPages}</strong>)`);

        var html = '<div class="pagination-wrap">';

        // Nút Trang đầu & Trang trước
        var prevDisabled = (page <= 1) ? 'disabled' : '';
        html += `<button type="button" class="page-btn" ${prevDisabled} onclick="${callbackFnName}(1)" title="Trang đầu">&laquo;&laquo;</button>`;
        html += `<button type="button" class="page-btn" ${prevDisabled} onclick="${callbackFnName}(${page - 1})" title="Trang trước">&lsaquo; Trước</button>`;

        // Cửa sổ số trang
        var startPage = Math.max(1, page - 2);
        var endPage = Math.min(totalPages, page + 2);

        if (startPage > 1) {
            html += `<button type="button" class="page-btn" onclick="${callbackFnName}(1)">1</button>`;
            if (startPage > 2) {
                html += `<span class="page-ellipsis">...</span>`;
            }
        }

        for (var p = startPage; p <= endPage; p++) {
            var activeClass = (p === page) ? 'active' : '';
            html += `<button type="button" class="page-btn ${activeClass}" onclick="${callbackFnName}(${p})">${p}</button>`;
        }

        if (endPage < totalPages) {
            if (endPage < totalPages - 1) {
                html += `<span class="page-ellipsis">...</span>`;
            }
            html += `<button type="button" class="page-btn" onclick="${callbackFnName}(${totalPages})">${totalPages}</button>`;
        }

        // Nút Trang sau & Trang cuối
        var nextDisabled = (page >= totalPages) ? 'disabled' : '';
        html += `<button type="button" class="page-btn" ${nextDisabled} onclick="${callbackFnName}(${page + 1})" title="Trang sau">Sau &rsaquo;</button>`;
        html += `<button type="button" class="page-btn" ${nextDisabled} onclick="${callbackFnName}(${totalPages})" title="Trang cuối">&raquo;&raquo;</button>`;

        html += '</div>';
        $btns.html(html);
    }

    function loadMessagesPage(page) {
        currentMsgPage = page || 1;
        var kw = $('#msgFilterKeyword').val();
        var snd = $('#msgFilterSender').val();
        var rId = $('#msgFilterRoomId').val();
        var type = $('#msgFilterType').val();
        var status = $('#msgFilterStatus').val();

        $('#messagesTableBody').html('<tr><td colspan="8" class="text-center py-4 text-white-50"><i class="bi bi-arrow-repeat spin"></i> Đang tải dữ liệu...</td></tr>');

        $.get('/Admin/AdminChat/FilterMessages', {
            keyword: kw, sender: snd, roomId: rId, msgType: type, status: status, page: currentMsgPage, pageSize: 30
        }, function (res) {
            if (res.success) {
                var html = '';
                if (!res.messages || res.messages.length === 0) {
                    html = '<tr><td colspan="8" class="text-center py-4 text-white-50">Không tìm thấy tin nhắn phù hợp.</td></tr>';
                } else {
                    res.messages.forEach(function (m) {
                        html += `<tr id="msg-row-${m.MessageID}">
                            <td style="text-align:center;">
                                <input type="checkbox" class="msg-checkbox" value="${m.MessageID}" style="cursor:pointer;" />
                            </td>
                            <td><span class="cell-id">#${m.MessageID}</span></td>
                            <td><span class="cell-date">${m.SentAtFormatted}</span></td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <img src="${m.SenderAvatar}" style="width:26px; height:26px; border-radius:50%; object-fit:cover;" onerror="this.onerror=null;this.src=window.DEFAULT_AVATAR_SVG||'/Content/Images/default-avatar.png';" />
                                    <div>
                                        <div class="fw-bold text-white" style="font-size:12px;">${m.SenderDisplayName}</div>
                                        <div style="font-size:10px; color:rgba(255,255,255,0.4);">${m.IsAnonymousMsg ? '[Ẩn danh]' : '@@' + m.SenderUsername}</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="adm-badge badge-dim">#${m.RoomID} - ${m.RoomName}</span></td>
                            <td>
                                <div style="max-width:280px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                    ${m.HasAttachments ? `<span class="adm-badge badge-purple me-1" style="font-size:9.5px;"><i class="bi bi-paperclip"></i> ${m.AttachmentsCount} tệp</span>` : ''}
                                    ${m.ImageUrl ? `<span class="adm-badge badge-cyan me-1" style="font-size:9.5px;"><i class="bi bi-image"></i> Ảnh</span>` : ''}
                                    <span class="text-white-50">${m.DisplayText}</span>
                                </div>
                            </td>
                            <td>
                                ${m.IsHidden ? `<span class="adm-badge badge-danger" title="Lý do: ${m.HiddenReason || ''}"><i class="bi bi-eye-slash"></i> Đã ẩn</span>` : `<span class="adm-badge badge-green"><i class="bi bi-check-circle"></i> Hiển thị</span>`}
                            </td>
                            <td style="text-align:center;">
                                <div style="display:inline-flex; gap:5px; align-items:center;">
                                    <button class="btn-adm cyan icon-only" title="Xem chi tiết" onclick="openMessageDetailModal(${m.MessageID})">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    ${m.IsHidden ? `<button class="btn-adm green icon-only" title="Bỏ ẩn" onclick="unhideMessage(${m.MessageID})"><i class="bi bi-eye-fill"></i></button>` : `<button class="btn-adm amber icon-only" title="Ẩn tin" onclick="promptHideMessage(${m.MessageID})"><i class="bi bi-eye-slash"></i></button>`}
                                    <button class="btn-adm danger icon-only" title="Xóa vĩnh viễn" onclick="confirmDeleteMessage(${m.MessageID})">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>`;
                    });
                }
                $('#messagesTableBody').html(html);

                // Render full pagination component
                renderPaginationComponent('msgPaginationBtns', 'msgPaginationInfo', res.page, res.totalPages, res.totalCount, 30, 'loadMessagesPage', 'tin nhắn');

                // Reset selection for newly rendered page
                $('#msgSelectAll').prop('checked', false);
                updateMsgSelectBar();
            } else {
                $('#messagesTableBody').html(`<tr><td colspan="8" class="text-center py-4 text-danger"><i class="bi bi-exclamation-triangle"></i> ${res.message || 'Lỗi khi tải dữ liệu'}</td></tr>`);
            }
        });
    }

    // Checkbox select all & bulk delete for Messages
    $(document).on('change', '#msgSelectAll', function () {
        $('.msg-checkbox').prop('checked', this.checked);
        updateMsgSelectBar();
    });

    $(document).on('change', '.msg-checkbox', function () {
        var totalCheckboxes = $('.msg-checkbox').length;
        var checkedCount = $('.msg-checkbox:checked').length;
        $('#msgSelectAll').prop('checked', totalCheckboxes > 0 && totalCheckboxes === checkedCount);
        updateMsgSelectBar();
    });

    function updateMsgSelectBar() {
        var count = $('.msg-checkbox:checked').length;
        $('#msgSelectCount').text(count);
        if (count > 0) {
            $('#msgSelectBar').addClass('show');
            $('#btnDeleteSelectedMessages').prop('disabled', false);
        } else {
            $('#msgSelectBar').removeClass('show');
            $('#btnDeleteSelectedMessages').prop('disabled', true);
        }
    }

    $(document).on('click', '#btnClearSelectMessages', function () {
        $('.msg-checkbox').prop('checked', false);
        $('#msgSelectAll').prop('checked', false);
        updateMsgSelectBar();
    });

    $(document).on('click', '#btnDeleteSelectedMessages', function () {
        var selectedIds = $('.msg-checkbox:checked').map(function () { return parseInt($(this).val()); }).get();
        if (selectedIds.length === 0) return;

        Swal.fire({
            title: `Xóa ${selectedIds.length} tin nhắn đã chọn?`,
            text: `Bạn có chắc chắn muốn xóa vĩnh viễn ${selectedIds.length} tin nhắn này? Toàn bộ nội dung và tệp đính kèm sẽ bị gỡ bỏ khỏi hệ thống.`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: '<i class="bi bi-trash3 me-1"></i> Xác nhận xóa',
            cancelButtonText: 'Hủy',
            confirmButtonColor: '#ff4d4d',
            cancelButtonColor: 'rgba(255,255,255,0.2)'
        }).then(function (result) {
            if (result.isConfirmed) {
                $.post('/Admin/AdminChat/AdminDeleteMultipleMessages', {
                    ids: selectedIds,
                    reason: 'Xóa hàng loạt bởi Quản trị viên',
                    __RequestVerificationToken: getCsrfToken()
                }, function (response) {
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Thành công',
                            text: response.message,
                            timer: 2000,
                            showConfirmButton: false
                        });

                        // Clear selection
                        $('#btnClearSelectMessages').trigger('click');

                        // Check if deleted all items on current page
                        var remainingOnPage = $('.msg-checkbox').length - selectedIds.length;
                        var targetPage = (remainingOnPage <= 0 && currentMsgPage > 1) ? currentMsgPage - 1 : currentMsgPage;
                        loadMessagesPage(targetPage);
                    } else {
                        Swal.fire('Lỗi', response.message, 'error');
                    }
                }).fail(function () {
                    Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ hoặc phiên làm việc đã hết hạn.', 'error');
                });
            }
        });
    });

    function openMessageDetailModal(id) {
        currentViewMessageId = id;
        $('#mdlMsgId').text(id);
        $('#messageDetailOverlay').addClass('show');

        $.get('/Admin/AdminChat/GetMessageDetail', { id: id }, function (res) {
            if (res.success && res.message) {
                var m = res.message;
                $('#mdlMsgSenderAvatar').attr('src', m.SenderAvatar || '/Content/Images/default-avatar.png');
                $('#mdlMsgSenderName').text(m.SenderDisplayName);
                $('#mdlMsgAnonBadge').text(m.IsAnonymousMsg ? 'Gửi ẩn danh' : 'Hiện danh tính');
                $('#mdlMsgTime').text(m.SentAtFormatted);
                $('#mdlMsgRoom').text(`#${m.RoomID} - ${m.RoomName}`);
                $('#mdlMsgText').text(m.DisplayText || '(Không có nội dung văn bản)');

                if (m.IsHidden) {
                    $('#mdlMsgHiddenBox').show();
                    $('#mdlMsgHiddenReason').text(m.HiddenReason || 'Vi phạm tiêu chuẩn cộng đồng');
                    $('#mdlMsgBtnToggleHide').html('<i class="bi bi-eye me-1"></i> Bỏ ẩn tin này').attr('class', 'btn-adm green');
                } else {
                    $('#mdlMsgHiddenBox').hide();
                    $('#mdlMsgBtnToggleHide').html('<i class="bi bi-eye-slash me-1"></i> Ẩn tin này').attr('class', 'btn-adm amber');
                }

                // Attachments
                var attHtml = '';
                if (m.ImageUrl) {
                    attHtml += `<div class="mb-2"><img src="${m.ImageUrl}" style="max-height:180px; border-radius:8px; cursor:pointer;" onclick="openChatLightbox('${m.ImageUrl}')" /></div>`;
                }
                if (m.AttachmentItems && m.AttachmentItems.length > 0) {
                    m.AttachmentItems.forEach(function (att) {
                        if (att.IsImage && att.Url) {
                            attHtml += `<div class="mb-2"><img src="${att.Url}" style="max-height:180px; border-radius:8px; cursor:pointer;" onclick="openChatLightbox('${att.Url}')" /></div>`;
                        } else {
                            attHtml += `<div class="p-2 d-flex justify-content-between align-items-center" style="background:#050a14; border-radius:6px; border:1px solid var(--chat-card-border);">
                                <span class="text-white"><i class="bi bi-file-earmark-text me-1 text-info"></i> ${att.FileName} (${att.FormattedSize})</span>
                                <a href="/Chat/DownloadAttachment?messageId=${m.MessageID}&fileKey=${encodeURIComponent(att.FileKey || '')}" class="btn-adm cyan" style="padding:2px 8px; font-size:11px;">Tải về</a>
                            </div>`;
                        }
                    });
                }
                if (attHtml) {
                    $('#mdlMsgAttachmentsList').html(attHtml);
                    $('#mdlMsgAttachmentsBox').show();
                } else {
                    $('#mdlMsgAttachmentsBox').hide();
                }
            }
        });
    }

    function closeMessageDetail() {
        $('#messageDetailOverlay').removeClass('show');
    }

    function promptHideMessage(id) {
        Swal.fire({
            title: `Ẩn tin nhắn #${id}?`,
            text: 'Tin nhắn sẽ bị che giấu khỏi người xem trong phòng chat.',
            input: 'text',
            inputPlaceholder: 'Nhập lý do ẩn vi phạm...',
            showCancelButton: true,
            confirmButtonText: 'Ẩn tin nhắn',
            cancelButtonText: 'Hủy'
        }).then(function (r) {
            if (r.isConfirmed) {
                $.post('/Admin/AdminChat/HideMessage', {
                    messageId: id, reason: r.value, __RequestVerificationToken: getCsrfToken()
                }, function (res) {
                    if (res.success) {
                        Swal.fire({ icon: 'success', title: 'Thành công', text: res.message, toast: true, position: 'top-end', timer: 2000, showConfirmButton: false });
                        closeMessageDetail();
                        loadMessagesPage(1);
                    } else {
                        Swal.fire('Lỗi', res.message, 'error');
                    }
                });
            }
        });
    }

    function unhideMessage(id) {
        $.post('/Admin/AdminChat/UnhideMessage', {
            messageId: id, __RequestVerificationToken: getCsrfToken()
        }, function (res) {
            if (res.success) {
                Swal.fire({ icon: 'success', title: 'Thành công', text: res.message, toast: true, position: 'top-end', timer: 2000, showConfirmButton: false });
                closeMessageDetail();
                loadMessagesPage(1);
            } else {
                Swal.fire('Lỗi', res.message, 'error');
            }
        });
    }

    function confirmDeleteMessage(id) {
        Swal.fire({
            title: `Xóa vĩnh viễn tin nhắn #${id}?`,
            text: 'Thao tác không thể hoàn tác và sẽ xóa bỏ toàn bộ dữ liệu tin nhắn cùng tệp đính kèm.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Xác nhận xóa',
            cancelButtonText: 'Hủy',
            confirmButtonColor: '#ff4d4d'
        }).then(function (r) {
            if (r.isConfirmed) {
                $.post('/Admin/AdminChat/AdminDeleteMessage', {
                    messageId: id, reason: 'Xóa bởi Admin', __RequestVerificationToken: getCsrfToken()
                }, function (res) {
                    if (res.success) {
                        $('#msg-row-' + id).fadeOut(300, function () { $(this).remove(); });
                        closeMessageDetail();
                        Swal.fire({ icon: 'success', title: 'Đã xóa', text: res.message, toast: true, position: 'top-end', timer: 2000, showConfirmButton: false });
                    } else {
                        Swal.fire('Lỗi', res.message, 'error');
                    }
                });
            }
        });
    }

    function toggleHideFromModal() {
        if (!currentViewMessageId) return;
        var isHiddenNow = $('#mdlMsgHiddenBox').is(':visible');
        if (isHiddenNow) {
            unhideMessage(currentViewMessageId);
        } else {
            promptHideMessage(currentViewMessageId);
        }
    }

    function deleteFromModal() {
        if (currentViewMessageId) {
            confirmDeleteMessage(currentViewMessageId);
        }
    }

    // ════════════════════════════════════════════════════════════
    // 3. QUẢN LÝ BÁO CÁO VI PHẠM (REPORTS)
    // ════════════════════════════════════════════════════════════

    function loadReportsPage(page) {
        var status = $('#reportFilterStatus').val();
        var kw = $('#reportFilterKeyword').val();
        var dr = $('#reportFilterDateRange').val();

        $('#reportsTableBody').html('<tr><td colspan="8" class="text-center py-4 text-white-50"><i class="bi bi-arrow-repeat spin"></i> Đang tải danh sách báo cáo...</td></tr>');

        $.get('/Admin/AdminChat/FilterReports', { status: status, keyword: kw, dateRange: dr, page: page }, function (res) {
            if (res.success) {
                var html = '';
                if (!res.reports || res.reports.length === 0) {
                    html = '<tr><td colspan="8" class="text-center py-4 text-white-50">Không có báo cáo nào phù hợp.</td></tr>';
                } else {
                    res.reports.forEach(function (r) {
                        html += `<tr id="rep-row-${r.ReportID}">
                            <td><span class="cell-id">#${r.ReportID}</span></td>
                            <td><span class="cell-date">${r.CreatedAtFormatted}</span></td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <img src="${r.ReporterAvatar}" style="width:24px; height:24px; border-radius:50%;" onerror="this.onerror=null;this.src=window.DEFAULT_AVATAR_SVG||'/Content/Images/default-avatar.png';" />
                                    <span class="text-white fw-bold" style="font-size:12px;">${r.ReporterDisplayName}</span>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <img src="${r.ReportedUserAvatar || '/Content/Images/default-avatar.png'}" style="width:28px; height:28px; border-radius:50%;" onerror="this.onerror=null;this.src=window.DEFAULT_AVATAR_SVG||'/Content/Images/default-avatar.png';" />
                                    <div class="d-flex flex-column">
                                        ${r.ReportedUserID && r.ReportedUserID > 0 ? `
                                            <span class="text-danger fw-bold" style="font-size:12px;">${r.ReportedUserRealDisplayName || r.ReportedUserDisplayName || ('Người dùng #' + r.ReportedUserID)}</span>
                                            <span class="cell-id text-cyan" style="font-size:11px;">ID: #${r.ReportedUserID} • ${r.ReportedUserRealUsername || ''}</span>
                                            ${r.ReportedUserEmail ? `<span class="text-white-50" style="font-size:10px;">${r.ReportedUserEmail}</span>` : ''}
                                        ` : `
                                            <span class="text-warning fw-bold" style="font-size:12px;">${r.ReportedUserDisplayName || 'Chưa xác định'}</span>
                                            <span class="badge bg-warning text-dark" style="font-size:9px; width:fit-content;">${r.IdentityStatus || 'Chưa xác định danh tính'}</span>
                                        `}
                                        ${r.IsReportedUserAnonymous ? `<span class="badge bg-secondary text-white mt-1" style="font-size:9px; width:fit-content;"><i class="bi bi-incognito"></i> Ẩn danh: ${r.AnonymousAlias || 'Người ẩn danh'}</span>` : ''}
                                    </div>
                                </div>
                            </td>
                            <td><span class="adm-badge badge-amber">${r.Reason}</span></td>
                            <td>
                                <span style="display:inline-block; max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:12px; color:rgba(255,255,255,0.7);">
                                    ${r.EvidenceSnippet || r.Details || '—'}
                                </span>
                            </td>
                            <td>
                                <span class="adm-badge ${r.Status === 'Pending' ? 'badge-amber' : (r.Status === 'Processing' ? 'badge-cyan' : (r.Status === 'Resolved' ? 'badge-green' : 'badge-dim'))}">
                                    ${r.Status}
                                </span>
                            </td>
                            <td style="text-align:center;">
                                <button class="btn-adm cyan icon-only" title="Xử lý báo cáo" onclick="openReportDetailModal(${r.ReportID})">
                                    <i class="bi bi-shield-check"></i>
                                </button>
                            </td>
                        </tr>`;
                    });
                }
                $('#reportsTableBody').html(html);
                $('#repPaginationInfo').text(`Trang ${res.page} / ${res.totalPages} (Tổng số: ${res.totalCount} báo cáo)`);

                var btnHtml = '';
                if (res.page > 1) {
                    btnHtml += `<button type="button" class="btn-adm" style="padding:2px 8px;" onclick="loadReportsPage(${res.page - 1})">&laquo; Trước</button>`;
                }
                if (res.page < res.totalPages) {
                    btnHtml += `<button type="button" class="btn-adm" style="padding:2px 8px;" onclick="loadReportsPage(${res.page + 1})">Sau &raquo;</button>`;
                }
                $('#repPaginationBtns').html(btnHtml);
            }
        });
    }

    function openReportDetailModal(id) {
        currentViewReportId = id;
        $('#mdlRepId').text(id);
        $('#reportDetailOverlay').addClass('show');

        $.get('/Admin/AdminChat/GetReportDetail', { id: id }, function (res) {
            if (res.success && res.report) {
                var r = res.report;
                $('#mdlRepReporterAvatar').attr('src', r.ReporterAvatar || '/Content/Images/default-avatar.png');
                $('#mdlRepReporterName').text(r.ReporterDisplayName);
                $('#mdlRepCreatedAt').text(r.CreatedAtFormatted);
                $('#mdlRepReportedAvatar').attr('src', r.ReportedUserAvatar || '/Content/Images/default-avatar.png');
                if (r.ReportedUserID && r.ReportedUserID > 0) {
                    $('#mdlRepReportedRealName').text(r.ReportedUserRealDisplayName || r.ReportedUserDisplayName || ('Tài khoản #' + r.ReportedUserID));
                    $('#mdlRepReportedAccountInfo').text('UserID: #' + r.ReportedUserID + ' | Tài khoản: @@' + (r.ReportedUserRealUsername || ''));
                    $('#mdlRepReportedEmail').text(r.ReportedUserEmail ? ('Email: ' + r.ReportedUserEmail) : 'Email: (Chưa cập nhật)');
                    $('#mdlRepIdentityBadge').attr('class', 'adm-badge badge-green').html('<i class="bi bi-shield-check"></i> ' + (r.IdentityStatus || 'Đã xác thực danh tính'));
                } else {
                    $('#mdlRepReportedRealName').text(r.ReportedUserDisplayName || 'Chưa xác định');
                    $('#mdlRepReportedAccountInfo').text('UserID: Không xác định');
                    $('#mdlRepReportedEmail').text('');
                    $('#mdlRepIdentityBadge').attr('class', 'adm-badge badge-amber').html('<i class="bi bi-question-diamond"></i> ' + (r.IdentityStatus || 'Chưa xác định danh tính'));
                }

                if (r.IsReportedUserAnonymous) {
                    $('#mdlRepAnonInfo').html('<span class="badge bg-secondary text-white"><i class="bi bi-incognito"></i> Gửi ở chế độ: Ẩn danh (' + (r.AnonymousAlias || 'Người ẩn danh') + ')</span>');
                } else {
                    $('#mdlRepAnonInfo').html('<span class="badge bg-dark text-white-50"><i class="bi bi-person-check"></i> Gửi ở chế độ: Công khai</span>');
                }

                $('#mdlRepRoomInfo').text(r.RoomName);
                $('#mdlRepReason').text(r.Reason);
                $('#mdlRepDetails').text(r.Details || 'Không có mô tả thêm');

                var evidenceText = r.EvidenceSnippet || '';
                if (r.MessageContent) {
                    evidenceText = r.MessageContent;
                }
                if (!evidenceText) {
                    evidenceText = '(Không trích xuất được tin nhắn bằng chứng)';
                }
                if (r.MessageSentAtFormatted) {
                    evidenceText += '\n[Thời gian tin nhắn gửi: ' + r.MessageSentAtFormatted + ']';
                }
                $('#mdlRepEvidence').text(evidenceText);
                $('#mdlRepStatusBadge').text(r.Status).attr('class', 'adm-badge ' + (r.Status === 'Pending' ? 'badge-amber' : (r.Status === 'Processing' ? 'badge-cyan' : 'badge-green')));
                $('#mdlRepNotes').val(r.HandlingNotes || '');
            }
        });
    }

    function closeReportDetail() {
        $('#reportDetailOverlay').removeClass('show');
    }

    function submitProcessReport() {
        if (!currentViewReportId) return;

        var action = $('#mdlRepActionType').val();
        var dur = $('#mdlRepDuration').val();
        var notes = $('#mdlRepNotes').val();

        $.post('/Admin/AdminChat/ProcessReportWithAction', {
            reportId: currentViewReportId,
            actionType: action,
            durationHours: dur,
            notes: notes,
            __RequestVerificationToken: getCsrfToken()
        }, function (res) {
            if (res.success) {
                Swal.fire({ icon: 'success', title: 'Thành công', text: res.message, timer: 2000, showConfirmButton: false });
                closeReportDetail();
                loadReportsPage(1);
            } else {
                Swal.fire('Lỗi', res.message, 'error');
            }
        });
    }

    function rejectReportFromModal() {
        if (!currentViewReportId) return;

        Swal.fire({
            title: 'Từ chối báo cáo vi phạm?',
            text: 'Đánh dấu báo cáo này là không hợp lệ hoặc sai sự thật.',
            input: 'text',
            inputPlaceholder: 'Nhập lý do từ chối...',
            showCancelButton: true,
            confirmButtonText: 'Xác nhận từ chối',
            cancelButtonText: 'Đóng'
        }).then(function (r) {
            if (r.isConfirmed) {
                $.post('/Admin/AdminChat/UpdateReportStatus', {
                    reportId: currentViewReportId,
                    status: 'Rejected',
                    handlingNotes: r.value || 'Báo cáo không có căn cứ vi phạm',
                    __RequestVerificationToken: getCsrfToken()
                }, function (res) {
                    if (res.success) {
                        Swal.fire({ icon: 'success', title: 'Thành công', text: res.message, timer: 1500, showConfirmButton: false });
                        closeReportDetail();
                        loadReportsPage(1);
                    } else {
                        Swal.fire('Lỗi', res.message, 'error');
                    }
                });
            }
        });
    }

    // ════════════════════════════════════════════════════════════
    // 4. QUẢN LÝ THÀNH VIÊN VÀ HẠN CHẾ / CẤM CHAT
    // ════════════════════════════════════════════════════════════

    function loadMembersPage(page) {
        var kw = $('#memberFilterKeyword').val();
        var status = $('#memberFilterStatus').val();

        $('#membersTableBody').html('<tr><td colspan="7" class="text-center py-4 text-white-50"><i class="bi bi-arrow-repeat spin"></i> Đang tải thành viên...</td></tr>');

        $.get('/Admin/AdminChat/SearchMembers', { keyword: kw, filterStatus: status, page: page }, function (res) {
            if (res.success) {
                var html = '';
                if (!res.members || res.members.length === 0) {
                    html = '<tr><td colspan="7" class="text-center py-4 text-white-50">Không tìm thấy thành viên nào.</td></tr>';
                } else {
                    res.members.forEach(function (mem) {
                        html += `<tr id="mem-row-${mem.UserID}">
                            <td><span class="cell-id">#${mem.UserID}</span></td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <img src="${mem.Avatar}" style="width:30px; height:30px; border-radius:50%; object-fit:cover;" onerror="this.onerror=null;this.src=window.DEFAULT_AVATAR_SVG||'/Content/Images/default-avatar.png';" />
                                    <div>
                                        <div class="text-white fw-bold" style="font-size:12.5px;">${mem.DisplayName}</div>
                                        <div class="cell-id">@@${mem.Username} · ${mem.Email}</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="adm-badge badge-dim font-monospace">${mem.TotalRoomsJoined} phòng</span></td>
                            <td><span class="adm-badge badge-dim font-monospace">${mem.TotalMessagesSent} tin</span></td>
                            <td>${mem.TotalReportsReceived > 0 ? `<span class="adm-badge badge-danger font-monospace">${mem.TotalReportsReceived} lần</span>` : `<span class="text-white-50">0</span>`}</td>
                            <td>
                                ${mem.IsBanned ? `<span class="adm-badge badge-danger"><i class="bi bi-slash-circle"></i> Đang bị cấm</span>` : (mem.IsMuted ? `<span class="adm-badge badge-amber"><i class="bi bi-volume-mute"></i> Đang bị hạn chế</span>` : `<span class="adm-badge badge-green"><i class="bi bi-check-circle"></i> Bình thường</span>`)}
                            </td>
                            <td style="text-align:center;">
                                <div style="display:inline-flex; gap:5px; align-items:center;">
                                    <button class="btn-adm cyan icon-only" title="Hồ sơ & Phòng tham gia" onclick="openMemberDetailModal(${mem.UserID})">
                                        <i class="bi bi-person-lines-fill"></i>
                                    </button>
                                    ${mem.IsBanned || mem.IsMuted ? `<button class="btn-adm green icon-only" title="Gỡ cấm" onclick="promptRevokeRestriction(${mem.ActiveRestriction ? mem.ActiveRestriction.RestrictionID : 0}, '${mem.DisplayName}')"><i class="bi bi-unlock"></i></button>` : `<button class="btn-adm amber icon-only" title="Phạt / Cấm chat" onclick="openApplyRestrictionModal(${mem.UserID}, '${mem.DisplayName}')"><i class="bi bi-slash-circle"></i></button>`}
                                </div>
                            </td>
                        </tr>`;
                    });
                }
                $('#membersTableBody').html(html);
                $('#memPaginationInfo').text(`Trang ${res.page} / ${res.totalPages} (Tổng số: ${res.totalCount} thành viên)`);

                var btnHtml = '';
                if (res.page > 1) {
                    btnHtml += `<button type="button" class="btn-adm" style="padding:2px 8px;" onclick="loadMembersPage(${res.page - 1})">&laquo; Trước</button>`;
                }
                if (res.page < res.totalPages) {
                    btnHtml += `<button type="button" class="btn-adm" style="padding:2px 8px;" onclick="loadMembersPage(${res.page + 1})">Sau &raquo;</button>`;
                }
                $('#memPaginationBtns').html(btnHtml);
            }
        });
    }

    function openMemberDetailModal(userId) {
        currentSelectedMemberId = userId;
        $('#memberDetailOverlay').addClass('show');

        $.get('/Admin/AdminChat/GetMemberDetail', { userId: userId }, function (res) {
            if (res.success && res.member) {
                var m = res.member;
                $('#mdlMemUsername').text(m.Username);
                $('#mdlMemDisplayName').text(m.DisplayName);
                $('#mdlMemEmail').text(m.Email);
                $('#mdlMemPhone').text(m.PhoneNumber || 'Chưa cập nhật');
                $('#mdlMemAvatar').attr('src', m.Avatar || '/Content/Images/default-avatar.png');
                $('#mdlMemRoomsCount').text(`${m.TotalRoomsJoined} phòng`);
                $('#mdlMemMsgsCount').text(`${m.TotalMessagesSent} tin`);
                $('#mdlMemRepsCount').text(`${m.TotalReportsReceived} báo cáo vi phạm`);

                // Rooms
                var rHtml = '';
                if (!m.JoinedRooms || m.JoinedRooms.length === 0) {
                    rHtml = '<tr><td colspan="4" class="text-center py-2 text-white-50">Chưa tham gia phòng nào.</td></tr>';
                } else {
                    m.JoinedRooms.forEach(function (r) {
                        rHtml += `<tr>
                            <td><span class="cell-name">#${r.RoomID} - ${r.RoomName}</span></td>
                            <td><span class="adm-badge badge-dim">${r.RoomType}</span></td>
                            <td><span class="cell-date">${r.JoinedAt ? r.JoinedAt : '—'}</span></td>
                            <td><span class="adm-badge ${r.IsLeft ? 'badge-dim' : 'badge-green'}">${r.IsLeft ? 'Đã rời' : 'Đang ở phòng'}</span></td>
                        </tr>`;
                    });
                }
                $('#mdlMemRoomsTable').html(rHtml);

                // Restrictions
                var restHtml = '';
                if (!m.RestrictionHistory || m.RestrictionHistory.length === 0) {
                    restHtml = '<tr><td colspan="5" class="text-center py-2 text-white-50">Lịch sử trong sạch, chưa từng bị xử phạt.</td></tr>';
                } else {
                    m.RestrictionHistory.forEach(function (rest) {
                        restHtml += `<tr>
                            <td><span class="adm-badge ${rest.RestrictionType === 'Ban' ? 'badge-danger' : 'badge-amber'}">${rest.RestrictionType}</span></td>
                            <td><span style="font-size:12px;">${rest.Reason}</span></td>
                            <td><span class="cell-date">${rest.ExpiresAtFormatted}</span></td>
                            <td><span class="text-white-50" style="font-size:11px;">${rest.CreatedByAdminName}</span></td>
                            <td><span class="adm-badge ${rest.IsActive ? 'badge-danger' : 'badge-dim'}">${rest.IsActive ? 'Đang hiệu lực' : 'Đã kết thúc'}</span></td>
                        </tr>`;
                    });
                }
                $('#mdlMemRestrictionsTable').html(restHtml);
            }
        });
    }

    function closeMemberDetail() {
        $('#memberDetailOverlay').removeClass('show');
    }

    function openApplyRestrictionModal(userId, name) {
        currentSelectedMemberId = userId;
        $('#mdlApplyUserId').val(userId);
        $('#mdlApplyUserName').text(name);
        $('#applyRestrictionOverlay').addClass('show');
    }

    function openApplyRestrictionModalFromMember() {
        closeMemberDetail();
        openApplyRestrictionModal(currentSelectedMemberId, $('#mdlMemDisplayName').text());
    }

    function closeApplyRestriction() {
        $('#applyRestrictionOverlay').removeClass('show');
    }

    function onRestrictionTypeChange(type) {
        if (type === 'Warn') {
            $('#mdlApplyDurationWrap').hide();
        } else {
            $('#mdlApplyDurationWrap').show();
        }
    }

    function submitApplyRestriction(e) {
        e.preventDefault();
        var form = $('#applyRestrictionForm');
        $.post('/Admin/AdminChat/ApplyRestriction', form.serialize(), function (res) {
            if (res.success) {
                Swal.fire({ icon: 'success', title: 'Thành công', text: res.message, timer: 2000, showConfirmButton: false });
                closeApplyRestriction();
                loadMembersPage(1);
            } else {
                Swal.fire('Lỗi', res.message, 'error');
            }
        });
    }

    function promptRevokeRestriction(restrictionId, name) {
        Swal.fire({
            title: `Gỡ bỏ cấm/hạn chế cho ${name}?`,
            text: 'Người dùng sẽ được khôi phục quyền trò chuyện ngay lập tức.',
            input: 'text',
            inputPlaceholder: 'Nhập lý do mở cấm...',
            showCancelButton: true,
            confirmButtonText: 'Xác nhận mở cấm',
            cancelButtonText: 'Đóng'
        }).then(function (r) {
            if (r.isConfirmed) {
                $.post('/Admin/AdminChat/RevokeRestriction', {
                    restrictionId: restrictionId,
                    reason: r.value || 'BQT xem xét mở cấm trước thời hạn',
                    __RequestVerificationToken: getCsrfToken()
                }, function (res) {
                    if (res.success) {
                        Swal.fire({ icon: 'success', title: 'Thành công', text: res.message, timer: 2000, showConfirmButton: false });
                        loadMembersPage(1);
                    } else {
                        Swal.fire('Lỗi', res.message, 'error');
                    }
                });
            }
        });
    }

    // ── LIGHTBOX XEM ẢNH PHÓNG TO ──
    function openChatLightbox(url) {
        $('#chatLightboxImg').attr('src', url);
        $('#chatImageLightbox').addClass('show');
    }

    function closeChatLightbox(e) {
        $('#chatImageLightbox').removeClass('show');
    }
</script>
}
