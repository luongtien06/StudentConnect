@model IEnumerable<StudentConnect.Models.ChatRoom>
@{
    ViewBag.Title = "Quản lý Trò chuyện";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@functions {
    string GetTypeLabel(string type)
    {
        switch (type)
        {
            case "1vs1": return "Chat riêng";
            case "Anonymous": return "Ẩn danh";
            case "RandomGroup": return "Nhóm ngẫu nhiên";
            case "Group": return "Nhóm tự tạo";
            default: return "Khác";
        }
    }

    string GetTypeBadge(string type)
    {
        switch (type)
        {
            case "1vs1": return "badge-cyan";
            case "Anonymous": return "badge-amber";
            case "RandomGroup": return "badge-purple";
            case "Group": return "badge-green";
            default: return "badge-gray";
        }
    }
}

<style>
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
    }

    .page-title {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.3rem;
        font-weight: 600;
        color: #fff;
        margin: 0;
    }

    .page-sub {
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        color: rgba(0,200,255,0.5);
        letter-spacing: 0.1em;
        margin-top: 3px;
    }

    /* stat cards */
    .stat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px,1fr));
        gap: 12px;
        margin-bottom: 1.5rem;
    }

    .stat-card {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 12px;
        padding: 14px 18px;
    }

    .stat-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 9px;
        letter-spacing: 0.1em;
        color: rgba(255,255,255,0.25);
        margin-bottom: 6px;
    }

    .stat-value {
        font-size: 1.6rem;
        font-weight: 700;
        color: #fff;
        line-height: 1;
    }

        .stat-value.cyan {
            color: #00c8ff;
        }

        .stat-value.purple {
            color: #7b61ff;
        }

        .stat-value.green {
            color: #00c850;
        }

        .stat-value.amber {
            color: #ffa000;
        }

    /* main card */
    .admin-card {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 16px;
        overflow: hidden;
    }

    .admin-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 20px;
        border-bottom: 1px solid rgba(255,255,255,0.07);
        background: rgba(255,255,255,0.02);
    }

    .admin-card-title {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        letter-spacing: 0.1em;
        color: rgba(0,200,255,0.6);
        font-weight: 500;
    }

    /* toolbar */
    .toolbar {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .btn-adm {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 14px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 500;
        font-family: 'Space Grotesk', sans-serif;
        border: 1px solid;
        cursor: pointer;
        transition: all 0.2s;
        background: none;
    }

        .btn-adm:disabled {
            opacity: 0.3;
            cursor: not-allowed;
        }

        .btn-adm.danger {
            color: rgba(255,100,100,0.8);
            border-color: rgba(255,60,60,0.25);
        }

            .btn-adm.danger:not(:disabled):hover {
                background: rgba(255,60,60,0.1);
                border-color: rgba(255,60,60,0.5);
            }

        .btn-adm.cyan {
            color: #00c8ff;
            border-color: rgba(0,200,255,0.25);
        }

            .btn-adm.cyan:hover {
                background: rgba(0,200,255,0.1);
                border-color: rgba(0,200,255,0.5);
            }

        .btn-adm.icon-only {
            padding: 6px 10px;
        }

    /* search */
    .search-wrap {
        position: relative;
    }

        .search-wrap input {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 8px;
            color: #fff;
            font-size: 12px;
            padding: 7px 12px 7px 32px;
            outline: none;
            width: 200px;
            font-family: 'Space Grotesk', sans-serif;
            transition: all 0.2s;
        }

            .search-wrap input:focus {
                border-color: rgba(0,200,255,0.35);
                background: rgba(0,200,255,0.04);
            }

            .search-wrap input::placeholder {
                color: rgba(255,255,255,0.2);
            }

        .search-wrap i {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: rgba(255,255,255,0.2);
            font-size: 12px;
        }

    /* table */
    .admin-table {
        width: 100%;
        border-collapse: collapse;
        font-family: 'Space Grotesk', sans-serif;
    }

        .admin-table thead tr {
            border-bottom: 1px solid rgba(255,255,255,0.07);
            background: rgba(255,255,255,0.02);
        }

        .admin-table th {
            font-family: 'JetBrains Mono', monospace;
            font-size: 10px;
            letter-spacing: 0.08em;
            color: rgba(255,255,255,0.25);
            padding: 11px 14px;
            text-align: left;
            font-weight: 400;
            white-space: nowrap;
        }

        .admin-table tbody tr {
            border-bottom: 1px solid rgba(255,255,255,0.04);
            transition: background 0.15s;
        }

            .admin-table tbody tr:hover {
                background: rgba(255,255,255,0.03);
            }

            .admin-table tbody tr.selected {
                background: rgba(0,200,255,0.05);
            }

        .admin-table td {
            padding: 11px 14px;
            font-size: 13px;
            color: rgba(255,255,255,0.7);
            vertical-align: middle;
        }

    /* custom checkbox */
    .adm-check {
        width: 15px;
        height: 15px;
        border-radius: 4px;
        cursor: pointer;
        accent-color: #00c8ff;
    }

    /* id cell */
    .cell-id {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        color: rgba(255,255,255,0.3);
    }

    /* room name */
    .cell-name {
        color: rgba(255,255,255,0.88);
        font-weight: 500;
    }

        .cell-name.anon {
            color: rgba(255,255,255,0.35);
            font-style: italic;
            font-weight: 400;
        }

    /* badges */
    .adm-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 100px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        letter-spacing: 0.06em;
        border: 1px solid;
    }

    .badge-cyan {
        background: rgba(0,200,255,0.1);
        border-color: rgba(0,200,255,0.25);
        color: #00c8ff;
    }

    .badge-amber {
        background: rgba(255,160,0,0.1);
        border-color: rgba(255,160,0,0.25);
        color: #ffa000;
    }

    .badge-purple {
        background: rgba(123,97,255,0.1);
        border-color: rgba(123,97,255,0.25);
        color: #7b61ff;
    }

    .badge-gray {
        background: rgba(255,255,255,0.05);
        border-color: rgba(255,255,255,0.12);
        color: rgba(255,255,255,0.4);
    }

    .badge-green {
        background: rgba(0,200,80,0.1);
        border-color: rgba(0,200,80,0.25);
        color: #00c850;
    }

    .badge-dim {
        background: rgba(255,255,255,0.04);
        border-color: rgba(255,255,255,0.08);
        color: rgba(255,255,255,0.25);
    }

    /* date */
    .cell-date {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        color: rgba(255,255,255,0.3);
    }

    /* selected count bar */
    .select-bar {
        display: none;
        align-items: center;
        gap: 10px;
        padding: 8px 20px;
        background: rgba(0,200,255,0.06);
        border-bottom: 1px solid rgba(0,200,255,0.15);
        font-size: 12px;
        color: rgba(0,200,255,0.7);
        font-family: 'JetBrains Mono', monospace;
        letter-spacing: 0.06em;
    }

        .select-bar.show {
            display: flex;
        }

    /* empty state */
    .empty-state {
        text-align: center;
        padding: 3rem 1rem;
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        color: rgba(255,255,255,0.15);
        letter-spacing: 0.08em;
    }

    /* DataTables overrides */
    .dataTables_wrapper .dataTables_paginate .paginate_button {
        border-radius: 7px !important;
    }

    div.dataTables_wrapper div.dataTables_filter {
        display: none;
    }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">Quản lý Trò chuyện</h1>
        <div class="page-sub">ANONYMOUS CHAT · ROOM MANAGEMENT</div>
    </div>
</div>

<!-- STAT CARDS -->
<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-label">TỔNG PHÒNG</div>
        <div class="stat-value cyan">@Model.Count()</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">HOẠT ĐỘNG</div>
        <div class="stat-value green">@Model.Count(r => r.IsActive == true)</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">ĐÃ ĐÓNG</div>
        <div class="stat-value amber">@Model.Count(r => r.IsActive != true)</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">CHAT RIÊNG</div>
        <div class="stat-value purple">@Model.Count(r => r.RoomType == "1vs1")</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">ẨN DANH</div>
        <div class="stat-value amber">@Model.Count(r => r.RoomType == "Anonymous")</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">NHÓM</div>
        <div class="stat-value cyan">@Model.Count(r => r.RoomType == "Group" || r.RoomType == "RandomGroup")</div>
    </div>
</div>

<!-- MAIN TABLE -->
<div class="admin-card">
    <div class="admin-card-header">
        <span class="admin-card-title">DANH SÁCH PHÒNG</span>
        <div class="toolbar">
            <div class="search-wrap">
                <i class="bi bi-search"></i>
                <input type="text" id="liveSearch" placeholder="Tìm phòng..." />
            </div>
        </div>
    </div>

    <!-- selected bar -->
    <div class="select-bar" id="selectBar">
        <i class="bi bi-check2-square"></i>
        <span id="selectCount">0</span> phòng đã chọn
        <button class="btn-adm danger" style="padding:4px 12px; font-size:11px;" id="btnDeleteSelectedBar" disabled>
            <i class="bi bi-trash3"></i> Xóa
        </button>
        <button class="btn-adm cyan" style="padding:4px 12px; font-size:11px;" id="btnClearSelect">
            Bỏ chọn
        </button>
    </div>

    <div class="table-responsive">
        <table class="admin-table" id="dataTable">
            <thead>
                <tr>
                    <th width="36"><input type="checkbox" class="adm-check" id="selectAll"></th>
                    <th>ID</th>
                    <th>PHÒNG</th>
                    <th>LOẠI</th>
                    <th>NGÀY TẠO</th>
                    <th>TRẠNG THÁI</th>
                    <th style="text-align:center;">THAO TÁC</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    bool isActive = item.IsActive == true;
                    bool hasName = !string.IsNullOrEmpty(item.RoomName);
                    <tr id="row-@item.RoomID">
                        <td><input type="checkbox" class="adm-check room-checkbox" value="@item.RoomID"></td>
                        <td><span class="cell-id">#@item.RoomID</span></td>
                        <td>
                            <span class="cell-name @(!hasName ? "anon" : "")">
                                @(hasName ? item.RoomName : "Phòng ẩn danh")
                            </span>
                        </td>
                        <td>
                            <span class="adm-badge @GetTypeBadge(item.RoomType)">
                                @GetTypeLabel(item.RoomType)
                            </span>
                        </td>
                        <td>
                            <span class="cell-date">
                                @(item.CreatedAt.HasValue ? item.CreatedAt.Value.ToString("dd/MM/yyyy HH:mm") : "---")
                            </span>
                        </td>
                        <td>
                            @if (isActive)
                            {
                                <span class="adm-badge badge-green">● Hoạt động</span>
                            }
                            else
                            {
                                <span class="adm-badge badge-dim">○ Đóng</span>
                            }
                        </td>
                        <td style="text-align:center;">
                            <button class="btn-adm danger icon-only" onclick="confirmDelete(@item.RoomID)"
                                    title="Xóa phòng #@item.RoomID">
                                <i class="bi bi-trash3" style="font-size:13px;"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section scripts {
<form id="csrfForm" style="display:none;">@Html.AntiForgeryToken()</form>
<script>
$(function () {

    var token = $('input[name="__RequestVerificationToken"]').val();

    var table = $('#dataTable').DataTable({
        language: {
            lengthMenu: "Hiển thị _MENU_ hàng",
            zeroRecords: "Không có dữ liệu phòng chat nào",
            info:         "Trang _PAGE_ / _PAGES_ · Tổng _TOTAL_ phòng",
            infoEmpty:    "Không có dữ liệu",
            infoFiltered: "(lọc từ _MAX_ phòng)",
            paginate: { previous: "‹", next: "›" }
        },
        order: [[1, 'desc']],
        columnDefs: [{ orderable: false, targets: [0, 6] }]
    });

    $('#liveSearch').on('input', function () {
        table.search($(this).val()).draw();
    });

    function getChecked() { return $('.room-checkbox:checked'); }

    function updateDeleteBtn() {
        var n     = getChecked().length;
        var total = $('.room-checkbox').length;
        $('#btnDeleteSelected, #btnDeleteSelectedBar').prop('disabled', n === 0);
        $('#selectCount').text(n);
        n > 0 ? $('#selectBar').addClass('show') : $('#selectBar').removeClass('show');
        $('#selectAll').prop('indeterminate', n > 0 && n < total);
        $('#selectAll').prop('checked', n > 0 && n === total);
    }

    $(document).on('change', '.room-checkbox', updateDeleteBtn);

    $('#selectAll').on('change', function () {
        table.rows({ search: 'applied' }).nodes().to$()
            .find('.room-checkbox').prop('checked', this.checked);
        updateDeleteBtn();
    });

    $('#btnClearSelect').on('click', function () {
        $('.room-checkbox').prop('checked', false);
        $('#selectAll').prop('checked', false);
        updateDeleteBtn();
    });

    // ── Single delete
    window.confirmDelete = function (id) {
        Swal.fire({
            title: 'Xóa phòng #' + id + '?',
            text: 'Toàn bộ tin nhắn trong phòng sẽ bị xóa vĩnh viễn.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Xóa',
            cancelButtonText: 'Hủy'
        }).then(function (result) {
            if (!result.isConfirmed) return;

            $.post(
                '@Url.Action("DeleteRoom", "AdminChat", new { area = "Admin" })',
                { id: id, __RequestVerificationToken: token },
                function (res) {
                    if (res.success) {
                        table.row($('#row-' + id)).remove().draw(false);
                        Swal.fire({
                            icon: 'success', title: 'Đã xóa!',
                            toast: true, position: 'top-end',
                            showConfirmButton: false, timer: 2500
                        });
                        updateDeleteBtn();
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể xóa phòng.', 'error');
                    }
                }
            ).fail(function () {
                Swal.fire('Lỗi kết nối', 'Vui lòng thử lại.', 'error');
            });
        });
    };

    // ── Bulk delete
    function bulkDelete() {
        var ids = getChecked().map(function () { return $(this).val(); }).get();
        if (!ids.length) return;

        Swal.fire({
            title: 'Xóa ' + ids.length + ' phòng?',
            text: 'Hành động này không thể hoàn tác.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Xóa tất cả',
            cancelButtonText: 'Hủy'
        }).then(function (result) {
            if (!result.isConfirmed) return;

            $.post(
                '@Url.Action("DeleteMultipleRooms", "AdminChat", new { area = "Admin" })',
                { ids: ids, __RequestVerificationToken: token },
                function (res) {
                    if (res.success) {
                        ids.forEach(function (id) {
                            table.row($('#row-' + id)).remove();
                        });
                        table.draw(false);
                        $('#selectAll').prop('checked', false);
                        updateDeleteBtn();
                        Swal.fire({
                            icon: 'success', title: res.message || 'Đã xóa!',
                            toast: true, position: 'top-end',
                            showConfirmButton: false, timer: 2500
                        });
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể xóa.', 'error');
                    }
                }
            ).fail(function () {
                Swal.fire('Lỗi kết nối', 'Vui lòng thử lại.', 'error');
            });
        });
    }

    $('#btnDeleteSelected, #btnDeleteSelectedBar').on('click', bulkDelete);
});
    </script>
}