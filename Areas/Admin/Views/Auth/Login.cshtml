@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Đăng nhập Quản trị</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-dark d-flex align-items-center justify-content-center" style="height: 100vh;">
    <div class="card shadow p-4" style="width: 400px; border-radius: 15px;">
        <h3 class="text-center mb-4">Đăng nhập Admin</h3>
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }
        <form action="@Url.Action("Login", "Auth", new { area = "Admin" })" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label>Email quản trị</label>
                <input type="email" name="username" class="form-control" placeholder="admin@tdmu.edu.vn" required />
            </div>
            <div class="mb-3">
                <label>Mật khẩu</label>
                <input type="password" name="password" class="form-control" required />
            </div>

            <div class="mb-4 form-check">
                <input type="checkbox" class="form-check-input" id="rememberMe" name="rememberMe" value="true">
                <label class="form-check-label text-muted" for="rememberMe" style="font-size: 0.9rem;">
                    Ghi nhớ phiên đăng nhập (30 ngày)
                </label>
            </div>

            <button type="submit" class="btn btn-primary w-100">Đăng nhập</button>
        </form>
    </div>
</body>
</html>