@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập Quản trị</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #121418;
            background-image: radial-gradient(circle at center, #1b1e24 0%, #121418 100%);
        }

        .login-card {
            background-color: #1e2126;
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5);
            border-radius: 16px;
        }

        .form-control {
            background-color: #15171b;
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #e9ecef;
        }

            .form-control:focus {
                background-color: #15171b;
                border-color: #3d8bfd;
                box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
                color: #fff;
            }

        .btn-login {
            background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
            border: none;
            transition: all 0.3s ease;
        }

            .btn-login:hover {
                background: linear-gradient(135deg, #0a58ca 0%, #084298 100%);
                transform: translateY(-1px);
                box-shadow: 0 6px 15px rgba(13, 110, 253, 0.3);
            }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center" style="min-height: 100vh;">

    <div class="card login-card p-4 p-sm-5" style="width: 100%; max-width: 420px;">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-white mb-2">Đăng nhập Admin</h3>
            <p class="text-secondary small mb-0">Vui lòng đăng nhập để truy cập hệ thống</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger border-0 rounded-3 text-center shadow-sm py-2" role="alert">
                @ViewBag.Error
            </div>
        }

        <form action="@Url.Action("Login", "Auth", new { area = "Admin" })" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label text-light opacity-75 small fw-medium">Email quản trị</label>
                <input type="email" name="username" class="form-control rounded-3 py-2" placeholder="admin@tdmu.edu.vn" required />
            </div>

            <div class="mb-4">
                <label class="form-label text-light opacity-75 small fw-medium">Mật khẩu</label>
                <input type="password" name="password" class="form-control rounded-3 py-2" placeholder="••••••••" required />
            </div>

            <div class="mb-4 form-check d-flex align-items-center">
                <input type="checkbox" class="form-check-input mt-0 me-2" id="rememberMe" name="rememberMe" value="true">
                <label class="form-check-label text-secondary mt-1" for="rememberMe" style="font-size: 0.9rem;">
                    Ghi nhớ phiên đăng nhập (30 ngày)
                </label>
            </div>

            <button type="submit" class="btn btn-primary btn-login w-100 py-2 rounded-3 fw-semibold text-white">
                Đăng nhập
            </button>
        </form>
    </div>

</body>
</html>