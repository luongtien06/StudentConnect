                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (isSuperAdmin)
{
    @* ══ MODAL: Phân quyền theo nhóm (Dành cho SuperAdmin) ══ *@
    <div class="modal fade dk-modal" id="batchRoleModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title d-flex align-items-center gap-2">
                        <i class="bi bi-shield-shaded" style="color:var(--dk-cyan)"></i>
                        <span>Phân quyền vai trò theo nhóm người dùng</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info py-2 px-3 mb-3 d-flex align-items-center gap-2" style="background:rgba(0,200,255,0.08); border:1px solid rgba(0,200,255,0.25); color:#67dcff; font-size:12px; border-radius:8px;">
                        <i class="bi bi-info-circle-fill fs-5"></i>
                        <div>
                            Tính năng cho phép Quản trị viên tối cao gán hoặc thu hồi vai trò đồng loạt cho từng nhóm người dùng thay vì phải sửa thủ công từng người riêng lẻ.
                        </div>
                    </div>

                    <!-- BƯỚC 1: CHỌN NHÓM ĐỐI TƯỢNG -->
                    <div class="mb-4">
                        <label class="fw-bold mb-2 d-block" style="color:var(--dk-text); font-size:13px;">
                            <span class="badge bg-primary me-1">Bước 1</span> Chọn nhóm người dùng áp dụng:
                        </label>
                        <div class="p-3 rounded" style="background:var(--dk-bg2); border:1px solid var(--dk-border);">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="batchScope" id="scopeSelected" value="selected" disabled>
                                <label class="form-check-label text-white" for="scopeSelected">
                                    <strong>Nhóm đã chọn trong danh sách:</strong> <span class="badge bg-info text-dark" id="modalSelectedCountBadge">0 tài khoản</span>
                                </label>
                            </div>

                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="batchScope" id="scopeTDMU" value="tdmu" checked>
                                <label class="form-check-label text-white" for="scopeTDMU">
                                    <strong>Toàn bộ Sinh viên TDMU:</strong> <span class="text-white-50">(@tdmuCount tài khoản sinh viên)</span>
                                </label>
                            </div>

                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="batchScope" id="scopeGuest" value="guest">
                                <label class="form-check-label text-white" for="scopeGuest">
                                    <strong>Toàn bộ Khách vãng lai:</strong> <span class="text-white-50">(@guestCount tài khoản ngoài trường)</span>
                                </label>
                            </div>

                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="batchScope" id="scopeByRole" value="by_role">
                                <label class="form-check-label text-white" for="scopeByRole">
                                    <strong>Toàn bộ người dùng đang giữ vai trò:</strong>
                                </label>
                                <div class="mt-2 ps-4" id="sourceRoleBox" style="display:none;">
                                    <select class="form-select form-select-sm" id="batchSourceRole" style="max-width:320px;">
                                        <option value="User">Người dùng thông thường (User)</option>
                                        <option value="AdminUser">Admin Quản lý Người dùng</option>
                                        <option value="AdminChat">Admin Quản lý Trò chuyện</option>
                                        <option value="AdminMarket">Admin Quản lý Chợ</option>
                                        <option value="AdminConnect">Admin Quản lý Kết nối</option>
                                        <option value="adminFeedStory">Admin Quản lý Feed và Tin</option>
                                        <option value="AdminAiAgent">Admin Quản lý AI Agent</option>
                                        <option value="AllAdmin">Tất cả tài khoản Quản trị viên</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- BƯỚC 2: CHỌN VAI TRÒ MỚI CẦN GÁN -->
                    <div class="mb-3">
                        <label class="fw-bold mb-2 d-block" style="color:var(--dk-text); font-size:13px;">
                            <span class="badge bg-success me-1">Bước 2</span> Chọn vai trò mới cần phân bổ cho nhóm:
                        </label>
                        <div class="p-3 rounded" style="background:var(--dk-bg2); border:1px solid var(--dk-border);">
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <div class="form-check p-2 rounded border" style="border-color:var(--dk-border)!important;">
                                        <input class="form-check-input ms-1" type="radio" name="batchTargetRole" id="targetRoleUser" value="User" checked>
                                        <label class="form-check-label ms-2 text-white" for="targetRoleUser">
                                            <div><span class="dk-badge dk-badge-blue">Người dùng (User)</span></div>
                                            <small class="text-white-50" style="font-size:11px;">Thu hồi quyền admin, thành viên bình thường</small>
                                        </label>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-check p-2 rounded border" style="border-color:var(--dk-border)!important;">
                                        <input class="form-check-input ms-1" type="radio" name="batchTargetRole" id="targetRoleAdminUser" value="AdminUser">
                                        <label class="form-check-label ms-2 text-white" for="targetRoleAdminUser">
                                            <div><span class="dk-badge dk-badge-cyan">QL Người dùng</span></div>
                                            <small class="text-white-50" style="font-size:11px;">Quyền quản lý hồ sơ và người dùng</small>
                                        </label>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-check p-2 rounded border" style="border-color:var(--dk-border)!important;">
                                        <input class="form-check-input ms-1" type="radio" name="batchTargetRole" id="targetRoleAdminChat" value="AdminChat">
                                        <label class="form-check-label ms-2 text-white" for="targetRoleAdminChat">
                                            <div><span class="dk-badge dk-badge-cyan">QL Trò chuyện</span></div>
                                            <small class="text-white-50" style="font-size:11px;">Quyền quản lý phòng chat, tin nhắn và cấm chat</small>
                                        </label>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-check p-2 rounded border" style="border-color:var(--dk-border)!important;">
                                        <input class="form-check-input ms-1" type="radio" name="batchTargetRole" id="targetRoleAdminMarket" value="AdminMarket">
                                        <label class="form-check-label ms-2 text-white" for="targetRoleAdminMarket">
                                            <div><span class="dk-badge dk-badge-green">QL Chợ sinh viên</span></div>
                                            <small class="text-white-50" style="font-size:11px;">Quyền kiểm duyệt và quản lý Chợ</small>
                                        </label>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-check p-2 rounded border" style="border-color:var(--dk-border)!important;">
                                        <input class="form-check-input ms-1" type="radio" name="batchTargetRole" id="targetRoleAdminConnect" value="AdminConnect">
                                        <label class="form-check-label ms-2 text-white" for="targetRoleAdminConnect">
                                            <div><span class="dk-badge dk-badge-amber">QL Kết nối</span></div>
                                            <small class="text-white-50" style="font-size:11px;">Quyền quản lý bài viết Kết nối TDMU</small>
                                        </label>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-check p-2 rounded border" style="border-color:var(--dk-border)!important;">
                                        <input class="form-check-input ms-1" type="radio" name="batchTargetRole" id="targetRoleAdminFeedStory" value="adminFeedStory">
                                        <label class="form-check-label ms-2 text-white" for="targetRoleAdminFeedStory">
                                            <div><span class="dk-badge dk-badge-purple">QL Feed và Tin</span></div>
                                            <small class="text-white-50" style="font-size:11px;">Quyền quản lý Feed & Stories 24h</small>
                                        </label>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-check p-2 rounded border" style="border-color:var(--dk-border)!important;">
                                        <input class="form-check-input ms-1" type="radio" name="batchTargetRole" id="targetRoleAdminAiAgent" value="AdminAiAgent">
                                        <label class="form-check-label ms-2 text-white" for="targetRoleAdminAiAgent">
                                            <div><span class="dk-badge dk-badge-purple">QL AI Agent</span></div>
                                            <small class="text-white-50" style="font-size:11px;">Quyền quản lý AI Agent, tác vụ tự động và lịch chạy</small>
                                        </label>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-check p-2 rounded border" style="border-color:rgba(167,139,250,.4)!important; background:rgba(167,139,250,.05);">
                                        <input class="form-check-input ms-1" type="radio" name="batchTargetRole" id="targetRoleSuperAdmin" value="SuperAdmin">
                                        <label class="form-check-label ms-2 text-white" for="targetRoleSuperAdmin">
                                            <div><span class="dk-badge dk-badge-purple"><i class="bi bi-shield-fill-check me-1"></i>Admin tối cao (SuperAdmin)</span></div>
                                            <small class="text-white-50" style="font-size:11px;">Toàn quyền tối cao với hệ thống</small>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="p-2 rounded" style="background:rgba(239,68,68,0.06); border:1px solid rgba(239,68,68,0.2); font-size:12px; color:#fca5a5;">
                        <i class="bi bi-shield-lock-fill me-1"></i>
                        <strong>Bảo vệ an toàn:</strong> Hệ thống tự động bảo toàn quyền SuperAdmin của tài khoản bạn đang đăng nhập để tránh tình trạng vô tình tự hạ quyền của chính mình.
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="button" class="btn btn-primary" onclick="executeBatchRoleAssignment()">
                        <i class="bi bi-check2-circle me-1"></i> Áp dụng phân quyền nhóm
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section scripts {
    <script>
        function syncCreateRole(select) {
            var val = $(select).val();
            if (val === 'User') {
                $('#create-IsAdmin').val('false');
                $('#create-AdminRole').val('');
            } else {
                $('#create-IsAdmin').val('true');
                $('#create-AdminRole').val(val);
            }
        }

        function syncEditRole(select) {
            var val = $(select).val();
            if (val === 'User') {
                $('#edit-IsAdmin').val('false');
                $('#edit-AdminRole').val('');
            } else {
                $('#edit-IsAdmin').val('true');
                $('#edit-AdminRole').val(val);
            }
        }

        $(document).ready(function () {

            // ── DataTables (language inline) ─────────────────────────────────
            var table = $('#userTable').DataTable({
                order: [[@(isSuperAdmin ? 1 : 0), 'desc']],
                pageLength: 10,
                columnDefs: [
                    @if (isSuperAdmin)
                    {
                        <text>{ orderable: false, targets: [0, 7] }</text>
                    }
                    else
                    {
                        <text>{ orderable: false, targets: [6] }</text>
                    }
                ],
                language: {
                    lengthMenu: 'Hiển thị _MENU_ người dùng',
                    zeroRecords: 'Không tìm thấy người dùng nào',
                    info: 'Trang _PAGE_ / _PAGES_',
                    infoEmpty: 'Không có dữ liệu',
                    infoFiltered: '(lọc từ _MAX_ người dùng)',
                    search: 'Tìm kiếm:',
                    paginate: { first: '«', last: '»', next: '›', previous: '‹' }
                }
            });

            // Cập nhật badge đếm
            table.on('draw', function () {
                $('#recordCount').text(table.rows({ search: 'applied' }).count());
            });

            @if (isSuperAdmin)
            {
                <text>
                // ── Quản lý lựa chọn hàng loạt ─────────────────────────────────
                function updateUserSelectBar() {
                    var checked = $('.user-check-item:checked');
                    var count = checked.length;
                    var total = $('.user-check-item').length;
                    $('#userSelectCount').text(count);
                    $('#modalSelectedCountBadge').text(count + ' tài khoản');

                    if (count > 0) {
                        $('#userSelectBar').css('display', 'flex');
                        $('#scopeSelected').prop('disabled', false);
                    } else {
                        $('#userSelectBar').hide();
                        if ($('#scopeSelected').is(':checked')) {
                            $('#scopeTDMU').prop('checked', true);
                        }
                        $('#scopeSelected').prop('disabled', true);
                    }
                    $('#chkAllUsers').prop('indeterminate', count > 0 && count < total);
                    $('#chkAllUsers').prop('checked', count > 0 && count === total);
                }

                $('#chkAllUsers').on('change', function () {
                    table.rows({ search: 'applied' }).nodes().to$()
                        .find('.user-check-item').prop('checked', this.checked);
                    updateUserSelectBar();
                });

                $(document).on('change', '.user-check-item', updateUserSelectBar);

                window.clearUserSelection = function () {
                    $('.user-check-item').prop('checked', false);
                    $('#chkAllUsers').prop('checked', false);
                    updateUserSelectBar();
                };

                window.openBatchRoleForSelected = function () {
                    var checked = $('.user-check-item:checked');
                    if (checked.length === 0) {
                        Swal.fire({
                            icon: 'info',
                            title: 'Thông báo',
                            text: 'Vui lòng chọn ít nhất 1 người dùng trên bảng để phân vai trò!',
                            background: '#0d1626',
                            color: '#fff'
                        });
                        return;
                    }
                    $('#scopeSelected').prop('disabled', false).prop('checked', true);
                    $('#sourceRoleBox').hide();
                    new bootstrap.Modal(document.getElementById('batchRoleModal')).show();
                };

                $('input[name="batchScope"]').on('change', function () {
                    if ($(this).val() === 'by_role') {
                        $('#sourceRoleBox').slideDown(150);
                    } else {
                        $('#sourceRoleBox').slideUp(150);
                    }
                });

                // Thực thi phân quyền nhóm
                window.executeBatchRoleAssignment = function () {
                    var scope = $('input[name="batchScope"]:checked').val();
                    var targetRole = $('input[name="batchTargetRole"]:checked').val();
                    var sourceRole = $('#batchSourceRole').val();

                    var userIds = [];
                    if (scope === 'selected') {
                        $('.user-check-item:checked').each(function () {
                            userIds.push(parseInt($(this).val()));
                        });
                        if (userIds.length === 0) {
                            Swal.fire({
                                icon: 'warning',
                                title: 'Chưa chọn tài khoản',
                                text: 'Bạn đang chọn phân quyền cho nhóm tích chọn, nhưng chưa tích chọn tài khoản nào!',
                                background: '#0d1626',
                                color: '#fff'
                            });
                            return;
                        }
                    }

                    var roleTitles = {
                        'User': 'Người dùng thông thường (User)',
                        'SuperAdmin': 'Admin tối cao (SuperAdmin)',
                        'AdminUser': 'Admin Quản lý Người dùng',
                        'AdminChat': 'Admin Quản lý Trò chuyện',
                        'AdminMarket': 'Admin Quản lý Chợ',
                        'AdminConnect': 'Admin Quản lý Kết nối',
                        'adminFeedStory': 'Admin Quản lý Feed và Tin',
                        'AdminAiAgent': 'Admin Quản lý AI Agent'
                    };

                    var scopeLabels = {
                        'selected': userIds.length + ' tài khoản được chọn trong danh sách',
                        'tdmu': 'Toàn bộ sinh viên TDMU (@tdmuCount tài khoản)',
                        'guest': 'Toàn bộ khách vãng lai (@guestCount tài khoản)',
                        'by_role': 'Toàn bộ người dùng đang giữ vai trò ' + (roleTitles[sourceRole] || sourceRole)
                    };

                    var targetRoleTitle = roleTitles[targetRole] || targetRole;
                    var scopeTitle = scopeLabels[scope] || scope;

                    Swal.fire({
                        title: '<i class="bi bi-shield-shaded text-info me-2"></i>Xác nhận phân quyền nhóm',
                        html:
                            '<div style="text-align:left;font-size:13px;color:#cbd5e1;">' +
                                '<p style="margin-bottom:8px;">Nhóm áp dụng: <strong style="color:#00c8ff;">' + scopeTitle + '</strong></p>' +
                                '<div style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:8px;padding:10px 14px;margin-bottom:12px;">' +
                                    '<span style="font-size:11px;color:rgba(255,255,255,0.5);">VAI TRÒ MỚI SẼ GÁN:</span>' +
                                    '<div style="font-size:15px;font-weight:700;color:#22c55e;margin-top:2px;">' + targetRoleTitle + '</div>' +
                                '</div>' +
                                '<div style="padding:10px 12px;border-radius:8px;background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.25);color:#fbbf24;font-size:12px;">' +
                                    '<i class="bi bi-shield-lock-fill me-1"></i> Lưu ý: Quyền hạn mới sẽ có hiệu lực ngay lập tức. Tài khoản đang đăng nhập của bạn sẽ luôn được giữ an toàn.' +
                                '</div>' +
                            '</div>',
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: '<i class="bi bi-check2-circle me-1"></i> Xác nhận áp dụng',
                        cancelButtonText: 'Hủy bỏ',
                        confirmButtonColor: '#22c55e',
                        background: '#0d1626',
                        color: '#fff'
                    }).then(function (result) {
                        if (!result.isConfirmed) return;

                        var modalEl = document.getElementById('batchRoleModal');
                        if (modalEl) {
                            var modalInstance = bootstrap.Modal.getInstance(modalEl);
                            if (modalInstance) modalInstance.hide();
                        }

                        Swal.fire({
                            title: 'Đang xử lý phân quyền...',
                            text: 'Hệ thống đang cập nhật vai trò cho nhóm người dùng...',
                            allowOutsideClick: false,
                            didOpen: function () { Swal.showLoading(); }
                        });

                        var token = $('input[name="__RequestVerificationToken"]').first().val();

                        $.ajax({
                            url: '@Url.Action("BatchAssignRole", "AdminUser", new { area = "Admin" })',
                            type: 'POST',
                            data: {
                                userIds: userIds,
                                scope: scope,
                                sourceRole: sourceRole,
                                targetRole: targetRole,
                                __RequestVerificationToken: token
                            },
                            success: function (res) {
                                if (res.success) {
                                    Swal.fire({
                                        icon: 'success',
                                        title: 'Phân quyền thành công!',
                                        text: res.message,
                                        background: '#0d1626',
                                        color: '#fff',
                                        timer: 2500
                                    }).then(function () {
                                        location.reload();
                                    });
                                } else {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Không thể phân quyền',
                                        text: res.message,
                                        background: '#0d1626',
                                        color: '#fff'
                                    });
                                }
                            },
                            error: function () {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Lỗi',
                                    text: 'Không thể kết nối đến máy chủ.',
                                    background: '#0d1626',
                                    color: '#fff'
                                });
                            }
                        });
                    });
                };
                </text>
            }

            // ── Modal Chi tiết ────────────────────────────────────────────────
            $(document).on('click', '.btn-view-detail', function () {
                var d = $(this).data();
                $('#view-id').text(d.id);
                $('#view-avatar').attr('src', d.avatar || window.DEFAULT_AVATAR_SVG || '/Content/Images/default-avatar.png');
                $('#view-username').text(d.username);
                $('#view-email').text(d.email);
                $('#view-phone').text(d.phone);
                $('#view-type').text(d.type);
                $('#view-role').text(d.role);
                $('#view-joined').text(d.joined);
                new bootstrap.Modal(document.getElementById('detailsModal')).show();
            });

            // ── Modal Sửa ────────────────────────────────────────────────────
            $(document).on('click', '.btn-edit-user', function () {
                var d = $(this).data();
                $('#edit-id-label').text(d.id);
                $('#edit-UserID').val(d.id);
                $('#edit-Username').val(d.username);
                $('#edit-Email').val(d.email);
                $('#edit-IsTDMU').val(d.isTdmu);

                var isAdmin = (d.isAdmin === true || d.isAdmin === 'true');
                var roleVal = 'User';
                if (isAdmin) {
                    roleVal = d.adminRole || 'SuperAdmin';
                }
                var editSelect = document.getElementById('edit-RoleSelect');
                if (editSelect) {
                    $(editSelect).val(roleVal);
                    syncEditRole(editSelect);
                } else {
                    $('#edit-IsAdmin').val(isAdmin ? 'true' : 'false');
                    $('#edit-AdminRole').val(d.adminRole || '');
                }

                // Reset form đổi mật khẩu và thu gọn collapse
                $('#edit-NewPassword').val('').removeClass('is-invalid').attr('type', 'password');
                $('#edit-ConfirmPassword').val('').removeClass('is-invalid').attr('type', 'password');
                $('#edit-NewPassword-error').hide().text('');
                $('#edit-ConfirmPassword-error').hide().text('');
                $('.btn-toggle-pwd i').removeClass('bi-eye-slash').addClass('bi-eye');
                var collapseEl = document.getElementById('editPasswordCollapse');
                if (collapseEl && collapseEl.classList.contains('show')) {
                    var bsCol = bootstrap.Collapse.getInstance(collapseEl);
                    if (bsCol) bsCol.hide();
                    else collapseEl.classList.remove('show');
                }
                $('#iconEditPasswordCollapse').removeClass('bi-chevron-up').addClass('bi-chevron-down');

                new bootstrap.Modal(document.getElementById('editModal')).show();
            });

            // ── Bật/Tắt hiện mật khẩu ─────────────────────────────────────────
            $(document).on('click', '.btn-toggle-pwd', function () {
                var targetId = $(this).data('target');
                var input = document.getElementById(targetId);
                if (!input) return;
                var icon = $(this).find('i');
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.removeClass('bi-eye').addClass('bi-eye-slash');
                } else {
                    input.type = 'password';
                    icon.removeClass('bi-eye-slash').addClass('bi-eye');
                }
            });

            // ── Đồng bộ icon xoay chevron khi mở/đóng collapse mật khẩu ───────
            var pwdCollapseEl = document.getElementById('editPasswordCollapse');
            if (pwdCollapseEl) {
                pwdCollapseEl.addEventListener('show.bs.collapse', function () {
                    $('#iconEditPasswordCollapse').removeClass('bi-chevron-down').addClass('bi-chevron-up');
                });
                pwdCollapseEl.addEventListener('hide.bs.collapse', function () {
                    $('#iconEditPasswordCollapse').removeClass('bi-chevron-up').addClass('bi-chevron-down');
                });
            }

            // ── Kiểm tra hợp lệ form Sửa người dùng (Validation tiếng Việt) ───
            function ensurePasswordCollapseOpen() {
                var collapseEl = document.getElementById('editPasswordCollapse');
                if (collapseEl && !collapseEl.classList.contains('show')) {
                    var bsCol = bootstrap.Collapse.getOrCreateInstance(collapseEl);
                    bsCol.show();
                }
            }

            $('#editModal form').on('submit', function (e) {
                var newPwd = ($('#edit-NewPassword').val() || '').trim();
                var confirmPwd = ($('#edit-ConfirmPassword').val() || '').trim();

                // Xóa trạng thái lỗi cũ
                $('#edit-NewPassword').removeClass('is-invalid');
                $('#edit-ConfirmPassword').removeClass('is-invalid');
                $('#edit-NewPassword-error').hide().text('');
                $('#edit-ConfirmPassword-error').hide().text('');

                // Cả 2 đều rỗng -> hợp lệ, giữ nguyên mật khẩu hiện tại
                if (!newPwd && !confirmPwd) {
                    return true;
                }

                var hasError = false;

                // Kiểm tra nếu chỉ nhập 1 trong 2 trường
                if (!newPwd) {
                    ensurePasswordCollapseOpen();
                    $('#edit-NewPassword').addClass('is-invalid');
                    $('#edit-NewPassword-error').text('Vui lòng nhập mật khẩu mới!').show();
                    hasError = true;
                }

                if (!confirmPwd) {
                    ensurePasswordCollapseOpen();
                    $('#edit-ConfirmPassword').addClass('is-invalid');
                    $('#edit-ConfirmPassword-error').text('Vui lòng nhập xác nhận mật khẩu mới!').show();
                    hasError = true;
                }

                if (hasError) {
                    e.preventDefault();
                    return false;
                }

                // Kiểm tra quy tắc mật khẩu mạnh
                var hasNumber = /[0-9]+/;
                var hasChar = /[a-zA-Z]+/;
                var hasSymbols = /[\x40!#$%^&*()_+=\[{\]};:<>|./?,-]/;

                if (newPwd.length < 8 || !hasNumber.test(newPwd) || !hasChar.test(newPwd) || !hasSymbols.test(newPwd)) {
                    ensurePasswordCollapseOpen();
                    $('#edit-NewPassword').addClass('is-invalid');
                    $('#edit-NewPassword-error').text('Mật khẩu phải có ít nhất 8 ký tự, bao gồm cả chữ cái, số và ký tự đặc biệt!').show();
                    $('#edit-NewPassword').focus();
                    e.preventDefault();
                    return false;
                }

                // Kiểm tra khớp mật khẩu
                if (newPwd !== confirmPwd) {
                    ensurePasswordCollapseOpen();
                    $('#edit-ConfirmPassword').addClass('is-invalid');
                    $('#edit-ConfirmPassword-error').text('Mật khẩu xác nhận không khớp!').show();
                    $('#edit-ConfirmPassword').focus();
                    e.preventDefault();
                    return false;
                }

                return true;
            });

            // ── Modal Xóa ────────────────────────────────────────────────────
            $(document).on('click', '.btn-delete-user', function () {
                var d = $(this).data();
                $('#delete-user-id').val(d.id);
                var displayLabel = d.username ? d.username : ('ID #' + d.id);
                $('#delete-username-label').text('"' + displayLabel + '"');
                new bootstrap.Modal(document.getElementById('deleteModal')).show();
            });

            // ── Auto-dismiss toast sau 4 giây ────────────────────────────────
            document.querySelectorAll('.toast.show').forEach(function (el) {
                setTimeout(function () {
                    new bootstrap.Toast(el, { delay: 400 }).hide();
                }, 4000);
            });

        });
    </script>
}
