@model IEnumerable<StudentConnect.Models.User>
@{
    ViewBag.Title = "Quản lý Người Dùng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    /* ── Biến màu (đồng bộ với AdminMarket) ── */
    :root {
        --dk-bg0:#0f1117; --dk-bg1:#161b27; --dk-bg2:#1c2333; --dk-bg3:#232a3b;
        --dk-border:#2e3a52; --dk-border2:#3a4a66;
        --dk-text:#e2e8f0; --dk-text2:#94a3b8; --dk-text3:#64748b;
        --dk-blue:#3b82f6; --dk-blue-bg:#1e3a5f; --dk-blue-dim:#1d2d45;
        --dk-green:#22c55e; --dk-green-bg:#14532d;
        --dk-amber:#f59e0b; --dk-amber-bg:#451a03;
        --dk-red:#ef4444;   --dk-red-bg:#450a0a;
        --dk-purple:#a78bfa; --dk-purple-bg:#2e1065;
        --dk-cyan:#22d3ee;   --dk-cyan-bg:#164e63;  --dk-cyan-dim:#0c3549;
    }

    /* ── Toast ── */
    .dk-toast { display:flex; align-items:center; border-radius:8px; padding:10px 14px; gap:8px; font-size:13px; }
    .dk-toast-success { background:var(--dk-green-bg); border:1px solid rgba(34,197,94,.3); color:var(--dk-green); }
    .dk-toast-error   { background:var(--dk-red-bg);   border:1px solid rgba(239,68,68,.3);  color:var(--dk-red);   }
    .dk-toast .btn-close { filter:invert(1) brightness(.8); }

    /* ── Stats ── */
    .dk-stats { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-bottom:16px; }
    @@media (max-width:768px) { .dk-stats { grid-template-columns:repeat(2,1fr); } }
    @@media (max-width:480px) { .dk-stats { grid-template-columns:1fr; } }
    .dk-stat  { background:var(--dk-bg1); border:1px solid var(--dk-border); border-radius:12px; padding:14px 16px; }
    .dk-stat-label { font-size:11px; color:var(--dk-text3); text-transform:uppercase; letter-spacing:.05em; margin-bottom:6px; }
    .dk-stat-val   { font-size:22px; font-weight:700; line-height:1; }
    .dk-stat-val.c-blue   { color:var(--dk-blue);   }
    .dk-stat-val.c-green  { color:var(--dk-green);  }
    .dk-stat-val.c-cyan   { color:var(--dk-cyan);   }
    .dk-stat-val.c-purple { color:var(--dk-purple); }
    .dk-stat-sub { font-size:11px; color:var(--dk-text3); margin-top:4px; }

    /* ── Card ── */
    .dk-card        { background:var(--dk-bg1)!important; border:1px solid var(--dk-border)!important; border-radius:12px!important; }
    .dk-card-header { background:var(--dk-bg2)!important; border-bottom:1px solid var(--dk-border)!important; }

    /* ── Toolbar ── */
    .dk-toolbar { background:var(--dk-bg1); border-bottom:1px solid var(--dk-border); padding:12px 16px; display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
    .dk-toolbar label { color:var(--dk-text3)!important; font-size:12px; margin-bottom:0; }
    .dk-count { font-size:12px; color:var(--dk-text3); background:var(--dk-bg2); border:1px solid var(--dk-border); border-radius:20px; padding:4px 12px; white-space:nowrap; }
    .dk-count strong { color:var(--dk-blue); }

    /* ── Form controls ── */
    .form-control, .form-select {
        background:var(--dk-bg2)!important; border:1px solid var(--dk-border)!important;
        color:var(--dk-text)!important; border-radius:8px!important;
    }
    .form-control:focus, .form-select:focus {
        border-color:var(--dk-blue)!important;
        box-shadow:0 0 0 2px rgba(59,130,246,.15)!important;
    }
    .form-control::placeholder { color:var(--dk-text3)!important; }

    /* ── Table ── */
    #userTable { color:var(--dk-text)!important; }
    #userTable thead th {
        background:var(--dk-bg2)!important; color:var(--dk-text3)!important;
        border-color:var(--dk-border2)!important; font-size:11px;
        text-transform:uppercase; letter-spacing:.05em; font-weight:600;
    }
    #userTable tbody td {
        background:var(--dk-bg1)!important; border-color:var(--dk-border)!important;
        color:var(--dk-text)!important; vertical-align:middle;
    }
    #userTable tbody tr:nth-child(even) td { background:#181f2e!important; }
    #userTable tbody tr:hover td           { background:var(--dk-bg2)!important; }

    /* Avatar */
    .dk-avatar {
        width:40px; height:40px; object-fit:cover;
        border-radius:10px; border:1px solid var(--dk-border);
        flex-shrink:0;
    }
    .dk-avatar-lg {
        width:80px; height:80px; object-fit:cover;
        border-radius:16px; border:2px solid var(--dk-border2);
    }

    /* Username cell */
    .dk-username { font-weight:600; color:var(--dk-cyan); font-size:13px; }
    .dk-email    { font-size:12px; color:var(--dk-text2); margin-top:2px; }

    /* ── Badges ── */
    .dk-badge { display:inline-flex; align-items:center; padding:3px 9px; border-radius:20px; font-size:11px; font-weight:500; white-space:nowrap; }
    .dk-badge-green  { background:var(--dk-green-bg);  color:var(--dk-green);  border:1px solid rgba(34,197,94,.2);   }
    .dk-badge-gray   { background:var(--dk-bg3);       color:var(--dk-text2);  border:1px solid var(--dk-border);     }
    .dk-badge-red    { background:var(--dk-red-bg);    color:var(--dk-red);    border:1px solid rgba(239,68,68,.2);   }
    .dk-badge-blue   { background:var(--dk-blue-dim);  color:var(--dk-blue);   border:1px solid rgba(59,130,246,.25); }
    .dk-badge-purple { background:var(--dk-purple-bg); color:var(--dk-purple); border:1px solid rgba(167,139,250,.3); }
    .dk-badge-amber  { background:var(--dk-amber-bg);  color:var(--dk-amber);  border:1px solid rgba(245,158,11,.3); }
    .dk-badge-cyan   { background:var(--dk-cyan-bg);   color:var(--dk-cyan);   border:1px solid rgba(34,211,238,.3); }

    /* ── Action icon buttons ── */
    .dk-btn {
        width:30px; height:30px; padding:0; border-radius:6px; border:1px solid var(--dk-border);
        background:var(--dk-bg2); display:inline-flex; align-items:center; justify-content:center;
        cursor:pointer; transition:background .15s, border-color .15s; vertical-align:middle;
    }
    .dk-btn.view { color:var(--dk-cyan); }
    .dk-btn.view:hover { background:var(--dk-cyan-dim); border-color:rgba(34,211,238,.4); }
    .dk-btn.edit { color:var(--dk-blue); }
    .dk-btn.edit:hover { background:var(--dk-blue-dim); border-color:rgba(59,130,246,.4); }
    .dk-btn.del  { color:var(--dk-red);  }
    .dk-btn.del:hover  { background:var(--dk-red-bg);  border-color:rgba(239,68,68,.4);  }

    /* ── Add button ── */
    .dk-btn-add {
        background:var(--dk-green-bg)!important; border:1px solid rgba(34,197,94,.3)!important;
        color:var(--dk-green)!important; border-radius:8px; font-weight:500; transition:background .2s;
        white-space:nowrap;
    }
    .dk-btn-add:hover { background:rgba(34,197,94,.2)!important; color:var(--dk-green)!important; }

    /* ── DataTables chrome ── */
    .dataTables_wrapper .dataTables_length label,
    .dataTables_wrapper .dataTables_filter label,
    .dataTables_wrapper .dataTables_info { color:var(--dk-text2)!important; }
    .dataTables_wrapper .dataTables_paginate .paginate_button {
        background:var(--dk-bg2)!important; border:1px solid var(--dk-border)!important;
        border-radius:6px!important; margin:0 2px!important; color:var(--dk-text2)!important;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current,
    .dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
        background:var(--dk-blue)!important; border-color:var(--dk-blue)!important; color:#fff!important;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
        background:var(--dk-bg3)!important; color:var(--dk-text)!important;
    }

    /* ── Modals ── */
    .dk-modal .modal-content {
        background:var(--dk-bg1)!important; border:1px solid var(--dk-border2)!important;
        border-radius:16px!important; color:var(--dk-text)!important;
    }
    .dk-modal .modal-header { background:var(--dk-bg2)!important; border-bottom:1px solid var(--dk-border)!important; }
    .dk-modal .modal-footer { background:var(--dk-bg1)!important; border-top:1px solid var(--dk-border)!important;    }
    .dk-modal .modal-title  { color:var(--dk-text)!important; }
    .dk-modal .btn-close    { filter:invert(1) brightness(.7); }
    .dk-modal label         { color:var(--dk-text3)!important; font-size:12px; font-weight:500!important; }

    .dk-modal .btn-secondary { background:var(--dk-bg2)!important; border:1px solid var(--dk-border)!important; color:var(--dk-text2)!important; }
    .dk-modal .btn-primary   { background:var(--dk-blue)!important; border-color:var(--dk-blue)!important;  color:#fff!important; }
    .dk-modal .btn-success   { background:var(--dk-green-bg)!important; border-color:rgba(34,197,94,.4)!important; color:var(--dk-green)!important; }
    .dk-modal .btn-danger    { background:var(--dk-red)!important;  border-color:var(--dk-red)!important;   color:#fff!important; }

    /* Detail info table */
    .dk-info-table { width:100%; font-size:13px; }
    .dk-info-table td { padding:6px 0; border-bottom:1px solid var(--dk-border); vertical-align:top; }
    .dk-info-table tr:last-child td { border-bottom:none; }
    .dk-info-table td:first-child { color:var(--dk-text3); width:130px; font-size:12px; }

    /* Delete modal */
    .dk-modal-danger .modal-header { background:rgba(239,68,68,.1)!important; border-bottom-color:rgba(239,68,68,.2)!important; }
    .dk-modal-danger .modal-title  { color:var(--dk-red)!important; }

    /* Responsive table — ẩn cột ít quan trọng ở mobile */
    /* ── COMPREHENSIVE RESPONSIVE MOBILE STYLES (320px - 768px) ── */
    @@media (max-width: 768px) {
        .col-hide-md { display: none !important; }

        .dk-stats {
            grid-template-columns: repeat(2, 1fr) !important;
            gap: 10px;
            margin-bottom: 1.2rem;
        }
        .dk-stat {
            padding: 12px 14px;
        }
        .dk-stat-val {
            font-size: 1.5rem;
        }

        .dk-card-header {
            flex-direction: column;
            gap: 12px;
            align-items: stretch !important;
            padding: 14px !important;
        }
        .dk-card-header h4 {
            font-size: 1.15rem;
        }
        .dk-card-header .d-flex {
            width: 100%;
        }
        .dk-card-header .btn {
            flex: 1 1 auto;
            text-align: center;
            justify-content: center;
            min-height: 38px;
        }

        .dk-toolbar {
            flex-direction: column;
            align-items: stretch !important;
            gap: 8px;
            padding: 10px 14px;
        }
        .dk-count {
            margin-left: 0 !important;
        }

        #userSelectBar {
            flex-direction: column;
            align-items: stretch !important;
            gap: 8px;
            padding: 10px 14px !important;
        }
        #userSelectBar button {
            width: 100%;
            min-height: 36px;
        }

        .table-responsive {
            padding-left: 6px !important;
            padding-right: 6px !important;
        }
        #userTable {
            font-size: 12.5px;
        }
        #userTable th, #userTable td {
            padding: 9px 8px;
        }
        .dk-avatar {
            width: 32px !important;
            height: 32px !important;
        }
        .dk-username {
            font-size: 13px !important;
        }
        .dk-email {
            font-size: 11px !important;
        }
        .dk-btn {
            width: 34px !important;
            height: 34px !important;
            font-size: 14px !important;
            margin: 2px 1px;
        }

        .dataTables_wrapper .dataTables_filter,
        .dataTables_wrapper .dataTables_length {
            width: 100% !important;
            text-align: left !important;
            float: none !important;
            margin-bottom: 8px;
        }
        .dataTables_wrapper .dataTables_filter input,
        .dataTables_wrapper .dataTables_length select {
            width: 100% !important;
            min-height: 38px;
            font-size: 13px;
            margin-left: 0 !important;
        }
        .dataTables_wrapper .dataTables_paginate {
            text-align: center !important;
            float: none !important;
            margin-top: 10px;
        }
        .dataTables_wrapper .dataTables_paginate .paginate_button {
            padding: 6px 10px !important;
            min-height: 36px;
        }
    }

    @@media (max-width: 480px) {
        .col-hide-sm { display: none !important; }

        .dk-stats {
            grid-template-columns: repeat(2, 1fr) !important;
            gap: 8px;
        }
        .dk-stat {
            padding: 10px 12px;
        }
        .dk-stat-val {
            font-size: 1.35rem;
        }
    }

    @@media (max-width: 360px) {
        .dk-stats {
            grid-template-columns: 1fr !important;
            gap: 6px;
        }
        .dk-stat {
            padding: 8px 10px;
        }
    }
</style>

@* ── Toasts ── *@
@if (TempData["Success"] != null)
{
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:9999">
        <div class="toast show border-0 dk-toast dk-toast-success" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <div class="flex-grow-1">@TempData["Success"]</div>
            <button type="button" class="btn-close ms-2" data-bs-dismiss="toast"></button>
        </div>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:9999">
        <div class="toast show border-0 dk-toast dk-toast-error" role="alert">
            <i class="bi bi-x-circle-fill"></i>
            <div class="flex-grow-1">@TempData["Error"]</div>
            <button type="button" class="btn-close ms-2" data-bs-dismiss="toast"></button>
        </div>
    </div>
}

@* ── Stats ── *@
@{
    bool isSuperAdmin = (Session["AdminRole"] as string) == "SuperAdmin";
    int totalUsers = Model.Count();
    int tdmuCount = Model.Count(u => u.IsTDMUStudent);
    int adminCount = Model.Count(u => u.IsAdmin);
    int guestCount = totalUsers - tdmuCount;
}
<div class="dk-stats">
    <div class="dk-stat">
        <div class="dk-stat-label">Tổng người dùng</div>
        <div class="dk-stat-val c-blue">@totalUsers</div>
    </div>
    <div class="dk-stat">
        <div class="dk-stat-label">Sinh viên TDMU</div>
        <div class="dk-stat-val c-green">@tdmuCount</div>
    </div>
    <div class="dk-stat">
        <div class="dk-stat-label">Khách</div>
        <div class="dk-stat-val c-cyan">@guestCount</div>
    </div>
    <div class="dk-stat">
        <div class="dk-stat-label">Quản trị viên</div>
        <div class="dk-stat-val c-purple">@adminCount</div>
    </div>
</div>

@* ── Main card ── *@
<div class="card dk-card shadow-none border-0 mb-4">
    <div class="card-header dk-card-header d-flex justify-content-between align-items-center py-3 flex-wrap gap-2">
        <h4 class="m-0 fw-bold" style="color:var(--dk-cyan)">
            <i class="bi bi-people-fill me-2"></i>Danh sách người dùng
        </h4>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            @if (isSuperAdmin)
            {
                <button type="button" class="btn btn-sm btn-outline-info" style="border-radius:8px; padding:6px 14px; font-weight:500;" data-bs-toggle="modal" data-bs-target="#batchRoleModal">
                    <i class="bi bi-shield-shaded me-1"></i>Phân quyền theo nhóm
                </button>
            }
            <button class="btn dk-btn-add" data-bs-toggle="modal" data-bs-target="#createModal">
                <i class="bi bi-person-plus-fill me-1"></i>Thêm
            </button>
        </div>
    </div>

    <div class="card-body p-0" style="background:var(--dk-bg1)">

        @* Toolbar *@
        <div class="dk-toolbar">
            @if (isSuperAdmin)
            {
                <div class="d-flex align-items-center gap-2">
                    <span class="text-white-50" style="font-size:12px;">Thao tác: Chọn các tài khoản để phân quyền hàng loạt hoặc bấm <strong>"Phân quyền theo nhóm"</strong></span>
                </div>
            }
            <div class="dk-count ms-auto">
                Tổng: <strong id="recordCount">@totalUsers</strong> người dùng
            </div>
        </div>

        @if (isSuperAdmin)
        {
            @* Floating / Sticky Selection Bar *@
            <div id="userSelectBar" style="display:none; align-items:center; gap:12px; padding:10px 20px; background:rgba(0,200,255,0.08); border-bottom:1px solid rgba(0,200,255,0.22); font-size:12px; color:#00c8ff;">
                <i class="bi bi-check2-square fs-6"></i>
                <span>Đã chọn <strong id="userSelectCount" style="color:#fff; font-size:13px;">0</strong> tài khoản</span>
                <button type="button" class="btn btn-sm btn-primary" style="padding:4px 14px; font-size:11px; border-radius:6px; font-weight:600;" onclick="openBatchRoleForSelected()">
                    <i class="bi bi-shield-lock-fill me-1"></i> Phân vai trò nhóm đã chọn
                </button>
                <button type="button" class="btn btn-sm btn-secondary" style="padding:4px 12px; font-size:11px; border-radius:6px; background:rgba(255,255,255,0.1); border:none; color:#cbd5e1;" onclick="clearUserSelection()">
                    Bỏ chọn
                </button>
            </div>
        }

        @* Table *@
        <div class="table-responsive px-3 pt-3 pb-2">
            <table id="userTable" class="table table-hover align-middle" style="width:100%">
                <thead>
                    <tr>
                        @if (isSuperAdmin)
                        {
                            <th style="width:36px" class="text-center"><input type="checkbox" class="adm-check" id="chkAllUsers" title="Chọn tất cả"></th>
                        }
                        <th style="width:50px">ID</th>
                        <th style="width:60px">Avatar</th>
                        <th>Tài khoản</th>
                        <th class="col-hide-md" style="width:80px">Loại</th>
                        <th class="col-hide-sm" style="width:110px">Vai trò</th>
                        <th class="col-hide-md" style="width:130px">Ngày tham gia</th>
                        <th style="width:105px" class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var joinDate = item.CreatedAt.HasValue
                            ? item.CreatedAt.Value.ToString("dd/MM/yyyy HH:mm")
                            : "N/A";
                        var phone = string.IsNullOrEmpty(item.PhoneNumber)
                            ? "Chưa cập nhật"
                            : item.PhoneNumber;

                        string roleDetailText = "Người dùng (User)";
                        if (item.IsAdmin)
                        {
                            if (item.AdminRole == "SuperAdmin") { roleDetailText = "Admin tối cao (Toàn quyền)"; }
                            else if (item.AdminRole == "AdminUser") { roleDetailText = "Admin Quản lý Người dùng"; }
                            else if (item.AdminRole == "AdminChat") { roleDetailText = "Admin Quản lý Trò chuyện"; }
                            else if (item.AdminRole == "AdminMarket") { roleDetailText = "Admin Quản lý Chợ"; }
                            else if (item.AdminRole == "AdminConnect") { roleDetailText = "Admin Quản lý Kết nối"; }
                            else if (item.AdminRole == "adminFeedStory") { roleDetailText = "Admin Quản lý Feed và Tin"; }
                            else if (item.AdminRole == "AdminAiAgent") { roleDetailText = "Admin Quản lý AI Agent"; }
                            else { roleDetailText = "Quản trị viên (Admin)"; }
                        }
                        <tr id="user-row-@item.UserID">
                            @if (isSuperAdmin)
                            {
                                <td class="text-center">
                                    <input type="checkbox" class="adm-check user-check-item" value="@item.UserID" data-name="@item.Username" data-role="@(item.IsAdmin ? (item.AdminRole ?? "Admin") : "User")">
                                </td>
                            }
                            <td style="font-size:12px;color:var(--dk-text3);font-weight:600" class="text-center">
                                #@item.UserID
                            </td>
                            <td class="text-center">
                                <img src="@item.Avatar"
                                     alt="Avatar"
                                     class="dk-avatar"
                                     onerror="this.onerror=null;this.src=window.DEFAULT_AVATAR_SVG||'/Content/Images/default-avatar.png'" />
                            </td>
                            <td>
                                <div class="dk-username">@item.Username</div>
                                <div class="dk-email">@item.Email</div>
                                <div class="d-sm-none mt-1 d-flex flex-wrap gap-1">
                                    @if (item.IsTDMUStudent)
                                    {
                                        <span class="dk-badge dk-badge-green" style="font-size:9.5px; padding:1px 5px;">SV TDMU</span>
                                    }
                                    else
                                    {
                                        <span class="dk-badge dk-badge-gray" style="font-size:9.5px; padding:1px 5px;">Khách</span>
                                    }
                                    @if (item.IsAdmin)
                                    {
                                        if (item.AdminRole == "SuperAdmin")
                                        {
                                            <span class="dk-badge dk-badge-purple" style="font-size:9.5px; padding:1px 5px;"><i class="bi bi-shield-fill-check me-1"></i>SuperAdmin</span>
                                        }
                                        else if (item.AdminRole == "AdminUser")
                                        {
                                            <span class="dk-badge dk-badge-cyan" style="font-size:9.5px; padding:1px 5px;"><i class="bi bi-person-gear me-1"></i>QL User</span>
                                        }
                                        else if (item.AdminRole == "AdminChat")
                                        {
                                            <span class="dk-badge dk-badge-cyan" style="font-size:9.5px; padding:1px 5px;"><i class="bi bi-chat-dots-fill me-1"></i>QL Chat</span>
                                        }
                                        else if (item.AdminRole == "AdminMarket")
                                        {
                                            <span class="dk-badge dk-badge-green" style="font-size:9.5px; padding:1px 5px;"><i class="bi bi-shop me-1"></i>QL Chợ</span>
                                        }
                                        else if (item.AdminRole == "AdminConnect")
                                        {
                                            <span class="dk-badge dk-badge-amber" style="font-size:9.5px; padding:1px 5px;"><i class="bi bi-globe me-1"></i>QL Kết nối</span>
                                        }
                                        else if (item.AdminRole == "adminFeedStory")
                                        {
                                            <span class="dk-badge dk-badge-purple" style="font-size:9.5px; padding:1px 5px;"><i class="bi bi-collection-play me-1"></i>QL Feed</span>
                                        }
                                        else if (item.AdminRole == "AdminAiAgent")
                                        {
                                            <span class="dk-badge dk-badge-purple" style="font-size:9.5px; padding:1px 5px;"><i class="bi bi-robot me-1"></i>QL AI</span>
                                        }
                                        else
                                        {
                                            <span class="dk-badge dk-badge-blue" style="font-size:9.5px; padding:1px 5px;">Admin</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="dk-badge dk-badge-blue" style="font-size:9.5px; padding:1px 5px;">User</span>
                                    }
                                </div>
                            </td>
                            <td class="col-hide-md">
                                @if (item.IsTDMUStudent)
                                {
                                    <span class="dk-badge dk-badge-green">SV TDMU</span>
                                }
                                else
                                {
                                    <span class="dk-badge dk-badge-gray">Khách</span>
                                }
                            </td>
                            <td class="col-hide-sm">
                                @if (item.IsAdmin)
                                {
                                    if (item.AdminRole == "SuperAdmin")
                                    {
                                        <span class="dk-badge dk-badge-purple" title="Admin tối cao toàn quyền"><i class="bi bi-shield-fill-check me-1"></i>Admin tối cao</span>
                                    }
                                    else if (item.AdminRole == "AdminUser")
                                    {
                                        <span class="dk-badge dk-badge-cyan" title="Quản lý Người dùng"><i class="bi bi-person-gear me-1"></i>QL Người dùng</span>
                                    }
                                    else if (item.AdminRole == "AdminChat")
                                    {
                                        <span class="dk-badge dk-badge-cyan" title="Quản lý Trò chuyện"><i class="bi bi-chat-dots-fill me-1"></i>QL Trò chuyện</span>
                                    }
                                    else if (item.AdminRole == "AdminMarket")
                                    {
                                        <span class="dk-badge dk-badge-green" title="Quản lý Chợ"><i class="bi bi-shop me-1"></i>QL Chợ</span>
                                    }
                                    else if (item.AdminRole == "AdminConnect")
                                    {
                                        <span class="dk-badge dk-badge-amber" title="Quản lý Kết nối"><i class="bi bi-globe me-1"></i>QL Kết nối</span>
                                    }
                                    else if (item.AdminRole == "adminFeedStory")
                                    {
                                        <span class="dk-badge dk-badge-purple" title="Quản lý Feed và Tin"><i class="bi bi-collection-play me-1"></i>QL Feed & Tin</span>
                                    }
                                    else if (item.AdminRole == "AdminAiAgent")
                                    {
                                        <span class="dk-badge dk-badge-purple" title="Quản lý AI Agent"><i class="bi bi-robot me-1"></i>QL AI Agent</span>
                                    }
                                    else
                                    {
                                        <span class="dk-badge dk-badge-red">Admin</span>
                                    }
                                }
                                else
                                {
                                    <span class="dk-badge dk-badge-blue">User</span>
                                }
                            </td>
                            <td class="col-hide-md" style="font-size:12px;color:var(--dk-text2)">@joinDate</td>
                            <td class="text-center">
                                <button class="dk-btn view btn-view-detail"
                                        title="Xem hồ sơ"
                                        data-id="@item.UserID"
                                        data-username="@item.Username"
                                        data-email="@item.Email"
                                        data-phone="@phone"
                                        data-type="@(item.IsTDMUStudent ? "Sinh viên TDMU" : "Khách")"
                                        data-role="@roleDetailText"
                                        data-joined="@joinDate"
                                        data-avatar="@item.Avatar">
                                    <i class="bi bi-person-vcard"></i>
                                </button>
                                @{
                                    int loggedAdminId = Convert.ToInt32(Session["AdminID"] ?? Session["UserID"] ?? 0);
                                    bool canDeleteThisUser = (item.UserID != loggedAdminId) && !item.IsAdmin;
                                }
                                @if (isSuperAdmin || !item.IsAdmin)
                                {
                                    <button class="dk-btn edit btn-edit-user"
                                            title="Chỉnh sửa"
                                            data-id="@item.UserID"
                                            data-username="@item.Username"
                                            data-email="@item.Email"
                                            data-is-tdmu="@item.IsTDMUStudent.ToString().ToLower()"
                                            data-is-admin="@item.IsAdmin.ToString().ToLower()"
                                            data-admin-role="@(item.AdminRole ?? "")">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                }
                                @if (canDeleteThisUser)
                                {
                                    <button class="dk-btn del btn-delete-user"
                                            title="Xóa tài khoản"
                                            data-id="@item.UserID"
                                            data-username="@(string.IsNullOrEmpty(item.Username) ? item.Email : item.Username)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* ══ MODAL: Chi tiết (dùng chung) ══ *@
