<appSettings>
	<!-- File AppSettings.config nằm trong .gitignore và sẽ KHÔNG BAO GIỜ bị đẩy lên GitHub. -->
	<add key="GeminiApiKey" value="YOUR_GEMINI_API_KEY_HERE" />
	<add key="GeminiModel" value="gemini-3.5-flash-lite" />

	<!-- Cấu hình SMTP gửi OTP xác thực email sinh viên -->
	<add key="SmtpHost" value="smtp.gmail.com" />
	<add key="SmtpPort" value="587" />
	<add key="SmtpEnableSsl" value="true" />
	<add key="SmtpEmail" value="example@student.tdmu.edu.vn" />
	<add key="SmtpPassword" value="YOUR_APP_PASSWORD_HERE" />
	<add key="SmtpDisplayName" value="TDMUEcoSystem - Hệ thống Sinh viên TDMU" />
</appSettings>
