@model StudentConnect.Models.MarketPost
@{
    ViewBag.Title = "Đăng tin mới";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4 my-md-5" style="max-width: 650px;">
    <div class="card shadow" style="border-radius: 15px;">
        <div class="card-body p-3 p-sm-4 p-md-5">
            <h2 class="text-success font-weight-bold mb-4 text-center fs-4 fs-md-3">
                <i class="fas fa-store me-2"></i> Đăng tin lên chợ
            </h2>

            @using (Html.BeginForm("Create", "Market", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()

                @* Validation summary *@
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small" })

                <div class="form-group mb-3">
                    <label class="font-weight-bold">Tên món đồ *</label>
                    @Html.EditorFor(model => model.Title, new
                    {
                        htmlAttributes = new { @class = "form-control", placeholder = "VD: Sách giáo trình Giải tích 1" }
                    })
                    @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger small" })
                </div>

                <div class="form-group mb-3">
                    <label class="font-weight-bold">Danh mục *</label>
                    @Html.DropDownList("CategoryID", null, "-- Chọn danh mục --",
                        new { @class = "form-control", required = "required" })
                </div>

                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group mb-3">
                            <label class="font-weight-bold">Giá bán (VNĐ)</label>
                            @Html.EditorFor(model => model.Price, new
                            {
                                htmlAttributes = new { @class = "form-control", type = "number", min = "0", placeholder = "0 = Miễn phí / Thỏa thuận" }
                            })
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group mb-3">
                            <label class="font-weight-bold">Nơi giao dịch</label>
                            @* ✅ Thêm trường còn thiếu *@
                            @Html.EditorFor(model => model.ExchangeLocation, new
                            {
                                htmlAttributes = new { @class = "form-control", placeholder = "VD: Khu D, Thư viện..." }
                            })
                        </div>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label class="font-weight-bold">Mô tả chi tiết *</label>
                    @Html.TextAreaFor(model => model.Description, new
                    {
                        @class = "form-control",
                        rows = "4",
                        placeholder = "Mô tả tình trạng, lý do bán, thông tin liên hệ..."
                    })
                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger small" })
                </div>

                <div class="form-group mb-4">
                    <label class="font-weight-bold">Hình ảnh sản phẩm</label>
                    <input type="file" name="hinhAnhs" class="form-control" accept="image/jpeg,image/png,image/gif,image/webp" multiple />
                    <small class="text-muted d-block mt-1">Chọn tối đa 8 ảnh, mỗi ảnh không quá 5MB.</small>
                </div>

                <div class="d-flex flex-column-reverse flex-sm-row justify-content-between gap-2 mt-4">
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-pill px-4 py-2 text-center">
                        <i class="fas fa-arrow-left me-1"></i> Hủy bỏ
                    </a>
                    <button type="submit" class="btn btn-success shadow rounded-pill px-4 py-2 font-weight-bold text-center">
                        <i class="fas fa-paper-plane me-1"></i> Đăng tin ngay!
                    </button>
                </div>
            }
        </div>
    </div>
</div>