@using PagedList.Mvc;
@model PagedList.IPagedList<StudentConnect.Models.MarketPost>
@{
    ViewBag.Title = "Quản lý tin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --c-bg: #050c1a;
        --c-surface: #0d1626;
        --c-surface2: #111d30;
        --c-border: #1a2540;
        --c-border2: #232840;
        --c-cyan: #00c8ff;
        --c-green: #00c850;
        --c-amber: #ef9f27;
        --c-red: #e24b4a;
        --c-purple: #7b61ff;
        --c-text: rgba(255,255,255,0.9);
        --c-muted: #8b94a5;
        --c-hint: #4a5568;
        --radius: 14px;
        --tr: 0.2s ease;
    }

    /* ── HEADER ── */
    .inventory-header {
        background: var(--c-surface);
        border: 1px solid var(--c-border2);
        border-radius: var(--radius);
        padding: 18px 22px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        position: relative;
        overflow: hidden;
    }

        .inventory-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(0,200,255,0.4), transparent);
        }

    .market-title-glow {
        font-size: 1.4rem;
        font-weight: 700;
        color: #fff;
        margin: 0;
        letter-spacing: -.02em;
    }

        .market-title-glow .text-cyan {
            color: var(--c-cyan) !important;
        }

    .inventory-header p {
        color: var(--c-hint);
        font-size: 12px;
        margin: 4px 0 0;
    }

    .btn-create-new {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 20px;
        border-radius: 50px;
        background: var(--c-cyan);
        color: #000;
        border: none;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: all var(--tr);
        text-decoration: none;
    }

        .btn-create-new:hover {
            background: #00b0e0;
            color: #000;
            box-shadow: 0 4px 16px rgba(0,200,255,0.3);
        }

    /* ── GLASS PANEL ── */
    .glass-panel {
        background: var(--c-surface);
        border: 1px solid var(--c-border2);
        border-radius: 18px;
        padding: 22px;
        margin-top: 24px;
    }

    /* ── TABLE ── */
    .table {
        color: var(--c-text);
        border-color: var(--c-border);
        margin: 0;
    }

        .table thead tr {
            border-bottom: 1px solid var(--c-border2);
            background: var(--c-surface2);
        }

        .table thead th {
            border-bottom: none;
            color: var(--c-hint);
            font-size: 10px;
            font-weight: 600;
            letter-spacing: .08em;
            text-transform: uppercase;
            padding: 11px 16px;
            white-space: nowrap;
        }

        .table tbody tr {
            border-bottom: 1px solid rgba(255,255,255,0.04);
            transition: background var(--tr);
        }

            .table tbody tr:hover {
                background: rgba(255,255,255,0.025);
            }

            .table tbody tr:last-child {
                border-bottom: none;
            }

        .table td {
            padding: 12px 16px;
            vertical-align: middle;
            font-size: 13px;
            color: var(--c-muted);
            border-color: transparent;
        }

    /* product cell */
    .post-img {
        width: 46px;
        height: 46px;
        border-radius: 10px;
        object-fit: cover;
        flex-shrink: 0;
        display: block;
        border: 1px solid var(--c-border2);
        transition: border-color var(--tr);
    }

    .table tbody tr:hover .post-img {
        border-color: rgba(0,200,255,0.3);
    }

    .prod-name {
        font-size: 13px;
        font-weight: 600;
        color: var(--c-text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 220px;
        display: block;
    }

    /* badge */
    .table .badge {
        background: rgba(0,200,255,0.08) !important;
        border: 1px solid rgba(0,200,255,0.2) !important;
        color: var(--c-cyan) !important;
        font-size: 10px !important;
        font-weight: 500 !important;
        padding: 3px 10px !important;
        border-radius: 20px !important;
    }

    /* price */
    .price-tag {
        font-size: 13px;
        font-weight: 700;
        color: var(--c-green);
        font-family: 'JetBrains Mono', monospace;
    }

    /* date */
    .table td.cell-date {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        color: var(--c-hint) !important;
    }

    /* action buttons */
    .btn-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border-radius: 8px;
        font-size: 12px;
        border: 1px solid;
        cursor: pointer;
        transition: all var(--tr);
        background: none;
        text-decoration: none;
        margin: 0 2px;
    }

        .btn-action:active {
            transform: scale(0.93);
        }

    .btn-outline-info {
        color: var(--c-cyan) !important;
        border-color: rgba(0,200,255,0.25) !important;
    }

        .btn-outline-info:hover {
            background: rgba(0,200,255,0.1) !important;
            border-color: rgba(0,200,255,0.5) !important;
        }

    .btn-outline-warning {
        color: var(--c-amber) !important;
        border-color: rgba(239,159,39,0.25) !important;
    }

        .btn-outline-warning:hover {
            background: rgba(239,159,39,0.1) !important;
            border-color: rgba(239,159,39,0.5) !important;
        }

    .btn-outline-danger {
        color: var(--c-red) !important;
        border-color: rgba(226,75,74,0.25) !important;
    }

        .btn-outline-danger:hover {
            background: rgba(226,75,74,0.1) !important;
            border-color: rgba(226,75,74,0.5) !important;
        }

    /* empty */
    .empty-row td {
        text-align: center;
        padding: 3.5rem 1rem !important;
        color: var(--c-hint) !important;
        font-size: 13px;
    }

    .empty-row .empty-icon {
        font-size: 2.2rem;
        opacity: .25;
        display: block;
        margin-bottom: 10px;
    }

    /* ── PAGINATION ── */
    .pagination-container {
        margin-top: 20px;
        display: flex;
        justify-content: center;
    }

    .pagination li a, .pagination li span {
        background: var(--c-surface2) !important;
        border: 1px solid var(--c-border2) !important;
        color: var(--c-muted) !important;
        font-size: 12px !important;
        padding: 7px 14px;
        transition: all var(--tr);
    }

        .pagination li a:hover {
            background: rgba(0,200,255,0.1) !important;
            border-color: rgba(0,200,255,0.4) !important;
            color: var(--c-cyan) !important;
        }

    .pagination .active span {
        background: var(--c-cyan) !important;
        border-color: var(--c-cyan) !important;
        color: #000 !important;
        font-weight: 700;
    }

    .pagination li:first-child a {
        border-radius: 8px 0 0 8px !important;
    }

    .pagination li:last-child a {
        border-radius: 0 8px 8px 0 !important;
    }

    .pagination .disabled a {
        opacity: .3;
    }

    /* ── MODAL ── */
    #createPostModal .modal-content,
    #deleteConfirmModal .modal-content {
        background: #0d1626 !important;
        border: 1px solid var(--c-border2) !important;
        border-radius: 16px !important;
        color: #fff;
    }

    #createPostModal .modal-header,
    #createPostModal .modal-footer {
        border-color: var(--c-border2) !important;
    }

    #deleteConfirmModal .modal-content {
        border-color: var(--c-red) !important;
    }

    #createPostModal .form-label {
        font-size: 10px !important;
        font-weight: 700 !important;
        color: var(--c-cyan) !important;
        letter-spacing: .07em;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    #createPostModal .form-control,
    #createPostModal .form-select {
        background: rgba(5,12,26,0.9) !important;
        border: 1px solid var(--c-border2) !important;
        color: #fff !important;
        border-radius: 8px !important;
        font-size: 13px !important;
    }

        #createPostModal .form-control:focus,
        #createPostModal .form-select:focus {
            border-color: rgba(0,200,255,0.4) !important;
            box-shadow: 0 0 0 3px rgba(0,200,255,0.07) !important;
        }

        #createPostModal .form-control::placeholder {
            color: var(--c-hint) !important;
        }

    .dark-dropdown option {
        background: #0d1626 !important;
        color: #fff !important;
    }

    #createPostModal .btn-outline-light {
        border-color: var(--c-border2) !important;
        color: var(--c-muted) !important;
        border-radius: 50px !important;
    }

        #createPostModal .btn-outline-light:hover {
            background: rgba(255,255,255,0.05) !important;
            color: #fff !important;
        }

    #createPostModal .btn-info {
        background: var(--c-cyan) !important;
        border-color: var(--c-cyan) !important;
        color: #000 !important;
        font-weight: 700 !important;
        border-radius: 50px !important;
    }
</style>

<div class="container mb-5">
    <div class="glass-panel">

        <div class="inventory-header">
            <div>
                <h2 class="market-title-glow">
                    <i class="fas fa-box-open me-2 text-cyan"></i>Kho hàng của tôi
                </h2>
                <p class="d-none d-md-block">Quản lý và theo dõi các sản phẩm bạn đang rao bán</p>
            </div>
            <button class="btn-create-new" data-bs-toggle="modal" data-bs-target="#createPostModal">
                <i class="fas fa-plus-circle" style="font-size:13px;"></i> Thêm mới
            </button>
        </div>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Danh mục</th>
                        <th>Giá bán</th>
                        <th>Ngày đăng</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@(string.IsNullOrEmpty(item.MainImage) ? "/Content/Images/default-market.jpg" : item.MainImage)"
                                             class="post-img"
                                             onerror="this.onerror=null;this.src='/Content/Images/default-market.jpg'" />
                                        <span class="prod-name" title="@item.Title">@item.Title</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-dark border border-secondary text-info">
                                        @(item.MarketCategory?.CategoryName ?? "Không xác định")
                                    </span>
                                </td>
                                <td><span class="price-tag">@string.Format("{0:N0}đ", item.Price)</span></td>
                                <td class="cell-date">
                                    @(item.CreatedAt.HasValue ? item.CreatedAt.Value.ToString("dd/MM/yyyy") : "---")
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center">
                                        <a href="@Url.Action("Details", new { id = item.PostID })"
                                           class="btn btn-sm btn-outline-info btn-action" title="Xem">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="@Url.Action("Edit", new { id = item.PostID })"
                                           class="btn btn-sm btn-outline-warning btn-action" title="Sửa">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        @using (Html.BeginForm("Delete", "Market", new { id = item.PostID }, FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger btn-action" title="Xóa"
                                                    onclick="openDeleteModal('@item.PostID', '@item.Title')">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr class="empty-row">
                            <td colspan="5">
                                <span class="empty-icon">🛒</span>
                                Bạn chưa đăng sản phẩm nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination-container">
            @Html.PagedListPager(Model, page => Url.Action("MyMarketPosts", new { page }),
                new PagedListRenderOptions
                     {
                    DisplayLinkToFirstPage = PagedListDisplayMode.Always,
                    DisplayLinkToLastPage = PagedListDisplayMode.Always,
                    MaximumPageNumbersToDisplay = 5
                })
        </div>
    </div>
</div>

<script>
    function openDeleteModal(id, title) {
        document.getElementById('deleteTargetID').value = id;
        document.getElementById('deleteTargetName').innerText = title;
        new bootstrap.Modal(document.getElementById('deleteConfirmModal')).show();
    }
</script>

@section Modals {
    <div class="modal fade" id="createPostModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-pencil-square me-2 text-info"></i>Tạo bài đăng bán mới
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                @using (Html.BeginForm("Create", "Market", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label">Tiêu đề bài đăng <span class="text-danger">*</span></label>
                            <input type="text" name="Title" class="form-control"
                                   placeholder="Ví dụ: Bán sách giáo trình Tư tưởng Hồ Chí Minh..." required>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Danh mục <span class="text-danger">*</span></label>
                                @Html.DropDownList("CategoryID", (SelectList)ViewBag.CategoryID, "-- Chọn danh mục --",
                                    new { @class = "form-select dark-dropdown", required = "required" })
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                                <input type="number" name="Price" class="form-control"
                                       placeholder="VD: 50000" min="0" value="0" required>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Nơi giao dịch</label>
                            <input type="text" name="ExchangeLocation" class="form-control"
                                   placeholder="VD: Cổng 1, Thư viện TDMU...">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Mô tả chi tiết <span class="text-danger">*</span></label>
                            <textarea name="Description" class="form-control" rows="4"
                                      placeholder="Cung cấp tình trạng món đồ, lý do bán..." required></textarea>
                        </div>
                        <div class="mb-1">
                            <label class="form-label">Tải ảnh sản phẩm</label>
                            <input class="form-control" type="file" name="hinhAnh" accept="image/*">
                        </div>
                    </div>
                    <div class="modal-footer border-top">
                        <button type="button" class="btn btn-outline-light px-4" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-info px-4 text-dark fw-bold">Đăng bán ngay</button>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body text-center p-4">
                    <div class="text-danger mb-3" style="font-size:3rem;">
                        <i class="bi bi-exclamation-octagon"></i>
                    </div>
                    <h5 class="text-white fw-bold">Xác nhận xóa?</h5>
                    <p class="text-muted small">
                        Bạn muốn xóa bài:<br />
                        <strong id="deleteTargetName" class="text-info"></strong>
                    </p>
                    @using (Html.BeginForm("Delete", "Market", FormMethod.Post, new { id = "formDeleteReal" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" id="deleteTargetID" />
                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-danger fw-bold">Xóa</button>
                            <button type="button" class="btn btn-outline-secondary border-0" data-bs-dismiss="modal">Hủy</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />