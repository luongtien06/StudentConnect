@model PagedList.IPagedList<StudentConnect.Models.MarketPost>
@using PagedList.Mvc;

@{
    bool isLoggedIn = Session["UserID"] != null;
    int currentUserId = isLoggedIn ? (int)Session["UserID"] : 0;
}

@if (Model != null && Model.Any())
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            string hinhDaiDien = item.MarketImages != null && item.MarketImages.Count > 0
                ? item.MarketImages.First().ImageUrl
                : item.MainImage ?? "https://via.placeholder.com/300x200/0d1626/00c8ff?text=No+Image";

            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 product-card position-relative" style="border-radius:14px;">
                    @if (currentUserId == item.UserID)
                    {
                        <div class="position-absolute top-0 start-0 m-2 d-flex gap-2" style="z-index:20;">
                            <a href="@Url.Action("Edit","Market",new{id=item.PostID})"
                               class="btn btn-sm btn-warning rounded-circle d-flex align-items-center justify-content-center shadow"
                               style="width:32px;height:32px;" title="Sửa tin">
                                <i class="bi bi-pencil-fill"></i>
                            </a>
                            <button type="button"
                                    class="btn btn-sm btn-danger rounded-circle d-flex align-items-center justify-content-center shadow"
                                    style="width:32px;height:32px;" title="Xóa tin"
                                    onclick="event.preventDefault();event.stopPropagation();openDeleteModal('@item.PostID','@item.Title')">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                        </div>
                    }
                    <a href="@Url.Action("Details","Market",new{id=item.PostID})" class="text-decoration-none h-100 d-flex flex-column">
                        <div class="position-relative">
                            <img src="@hinhDaiDien" class="card-img-top" alt="@item.Title" loading="lazy">
                            <span class="badge bg-dark bg-opacity-75 position-absolute top-0 end-0 m-2 border border-secondary">
                                @(item.MarketCategory?.CategoryName ?? "Khác")
                            </span>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fs-6 fw-bold text-white mb-2 text-truncate" title="@item.Title">@item.Title</h5>
                            <h6 class="fw-bold mb-3" style="color:#00c8ff;">@((item.Price ?? 0).ToString("N0")) VNĐ</h6>
                            <p class="card-text text-muted small mb-3 flex-grow-1"
                               style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                                @item.Description
                            </p>
                            <div class="d-flex justify-content-between align-items-center mt-auto border-top border-secondary pt-3">
                                <div class="text-muted" style="font-size:11px;">
                                    <div class="mb-1"><i class="bi bi-person-circle me-1"></i>@(item.User?.Username ?? "Ẩn danh")</div>
                                    <div><i class="bi bi-clock me-1"></i>@(item.CreatedAt?.ToString("dd/MM/yyyy") ?? "")</div>
                                </div>
                                <span class="btn btn-sm btn-outline-info rounded-pill px-3">Chi tiết</span>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        }
    </div>

    <div class="d-flex justify-content-center mt-5 mb-5 pagination-dark">
        @Html.PagedListPager(Model, page => Url.Action("Index",
            new { page, searchString = ViewBag.CurrentFilter, categoryId = ViewBag.CurrentCategory }))
    </div>
}
else
{
    <div class="empty-market text-center py-5" style="background:var(--c-surface); border:1px dashed var(--c-border2); border-radius:var(--radius); margin: 20px 0;">
        <i class="bi bi-inbox text-muted" style="font-size: 3rem; display:block; margin-bottom:12px;"></i>
        <h5 class="text-white">Không tìm thấy sản phẩm nào</h5>
        <p class="text-muted small mb-3">Thử tìm kiếm với từ khóa khác hoặc chuyển sang danh mục khác xem sao.</p>
        <button type="button" class="btn btn-outline-info btn-sm rounded-pill px-3" onclick="resetMarketFilter()">
            <i class="bi bi-arrow-counterclockwise me-1"></i>Xem tất cả sản phẩm
        </button>
    </div>
}
