@{
    ViewBag.Title = "Xác thực Email Sinh viên - TDMUEcoSystem";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string targetEmail = ViewBag.TargetEmail as string ?? "";
    int remainingCooldown = ViewBag.RemainingCooldown != null ? (int)ViewBag.RemainingCooldown : 0;
}

<style>
    .otp-wrap {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2.5rem 1rem;
    }

    .otp-card {
        width: 100%;
        max-width: 440px;
        background: #111424;
        border: 1px solid #23273b;
        border-radius: 20px;
        padding: 2.5rem 2rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,0.4);
        color: #fff;
    }

    .otp-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, #0dcaf0, #0d6efd, transparent);
    }

    .otp-icon-wrap {
        width: 60px;
        height: 60px;
        border-radius: 18px;
        margin: 0 auto 1.25rem;
        background: rgba(13,202,240,0.1);
        border: 1px solid rgba(13,202,240,0.25);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        color: #0dcaf0;
    }

    .otp-title {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.45rem;
        font-weight: 700;
        color: #fff;
        text-align: center;
        margin-bottom: 8px;
    }

    .otp-sub {
        font-size: 13px;
        color: rgba(255,255,255,0.6);
        text-align: center;
        margin-bottom: 1.75rem;
        line-height: 1.6;
    }

    .otp-sub b {
        color: #0dcaf0;
        font-weight: 600;
        word-break: break-all;
    }

    /* 6 separate boxes */
    .otp-boxes {
        display: flex;
        gap: 8px;
        justify-content: center;
        margin-bottom: 1.5rem;
    }

    .otp-box {
        width: 48px;
        height: 58px;
        border-radius: 12px;
        text-align: center;
        font-family: 'JetBrains Mono', monospace;
        font-size: 24px;
        font-weight: 700;
        color: #fff;
        background: #080d17;
        border: 1px solid #23273b;
        transition: all 0.2s ease;
        outline: none;
        caret-color: #0dcaf0;
    }

    .otp-box:focus {
        border-color: #0dcaf0;
        background: #0d1626;
        box-shadow: 0 0 0 3px rgba(13,202,240,0.2);
    }

    .otp-box.filled {
        border-color: #0dcaf0;
        background: #081220;
        color: #0dcaf0;
    }

    .otp-hidden {
        display: none;
    }

    .otp-btn {
        width: 100%;
        padding: 12px;
        border-radius: 100px;
        border: none;
        background: linear-gradient(135deg, #0dcaf0 0%, #0d6efd 100%);
        color: #000;
        font-size: 14px;
        font-weight: 700;
        font-family: 'Space Grotesk', sans-serif;
        cursor: pointer;
        transition: all 0.2s;
        letter-spacing: 0.02em;
    }

    .otp-btn:hover {
        opacity: 0.92;
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(13,202,240,0.3);
    }

    .otp-btn:active {
        transform: scale(0.98);
    }

    .otp-btn:disabled {
        opacity: 0.4;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    .otp-alert-err {
        border-radius: 12px;
        padding: 12px 14px;
        font-size: 13px;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 10px;
        background: rgba(220,53,69,0.12);
        border: 1px solid rgba(220,53,69,0.3);
        color: #ea868f;
    }

    .otp-timer {
        text-align: center;
        margin-top: 1.25rem;
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        color: rgba(255,255,255,0.45);
    }

    .otp-timer span {
        color: #ffc107;
        font-weight: 600;
    }

    .otp-resend-wrap {
        text-align: center;
        margin-top: 1rem;
    }

    .btn-resend-otp {
        background: none;
        border: none;
        color: #0dcaf0;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: underline;
        transition: color 0.2s;
        padding: 4px 8px;
    }

    .btn-resend-otp:hover {
        color: #79dfed;
    }

    .btn-resend-otp:disabled {
        color: rgba(255,255,255,0.3);
        cursor: not-allowed;
        text-decoration: none;
    }

    .otp-back-link {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        margin-top: 1.5rem;
        font-size: 13px;
        color: rgba(255,255,255,0.45);
        text-decoration: none;
        transition: color 0.2s;
    }

    .otp-back-link:hover {
        color: #0dcaf0;
    }
</style>

<div class="otp-wrap">
    <div class="otp-card">

        <div class="otp-icon-wrap">
            <i class="fas fa-envelope-open-text"></i>
        </div>

        <h2 class="otp-title">Xác thực Email Sinh viên</h2>
        <p class="otp-sub">
            Mã OTP 6 chữ số đã được gửi đến email sinh viên TDMU:<br>
            <b>@targetEmail</b>
        </p>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="otp-alert-err">
                <i class="fas fa-exclamation-triangle"></i>
                <span>@ViewBag.ErrorMessage</span>
            </div>
        }

        <div id="ajaxAlertContainer" style="display:none;" class="otp-alert-err"></div>

        @using (Html.BeginForm("VerifyRegisterOTP", "User", FormMethod.Post, new { id = "otpForm" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="email" id="targetEmailInput" value="@targetEmail" />
            <input type="text" name="otp" id="otpHidden" class="otp-hidden" maxlength="6" required />

            <div class="otp-boxes">
                <input class="otp-box" type="text" inputmode="numeric" maxlength="1" autocomplete="one-time-code" autofocus />
                <input class="otp-box" type="text" inputmode="numeric" maxlength="1" />
                <input class="otp-box" type="text" inputmode="numeric" maxlength="1" />
                <input class="otp-box" type="text" inputmode="numeric" maxlength="1" />
                <input class="otp-box" type="text" inputmode="numeric" maxlength="1" />
                <input class="otp-box" type="text" inputmode="numeric" maxlength="1" />
            </div>

            <button type="submit" class="otp-btn" id="otpSubmit" disabled>
                <i class="fas fa-check-circle me-1"></i> Kích hoạt tài khoản ngay
            </button>
        }

        <div class="otp-timer">
            ⏱️ Mã hết hạn sau <span id="otpCountdown">05:00</span>
        </div>

        <div class="otp-resend-wrap">
            Chưa nhận được mã?
            <button type="button" class="btn-resend-otp" id="btnResendOtp" onclick="handleResendOtp()">
                Gửi lại mã OTP <span id="cooldownText"></span>
            </button>
        </div>

        <a href="@Url.Action("Register", "User")" class="otp-back-link">
            <i class="fas fa-arrow-left"></i> Đổi email hoặc đăng ký lại
        </a>
    </div>
</div>

@section scripts {
    <script>
        (function () {
            var boxes = document.querySelectorAll('.otp-box');
            var hidden = document.getElementById('otpHidden');
            var btn = document.getElementById('otpSubmit');

            boxes.forEach(function (box, i) {
                box.addEventListener('input', function () {
                    this.value = this.value.replace(/\D/g, '').slice(0, 1);
                    this.classList.toggle('filled', this.value !== '');
                    if (this.value && i < boxes.length - 1) {
                        boxes[i + 1].focus();
                    }
                    sync();
                });

                box.addEventListener('keydown', function (e) {
                    if (e.key === 'Backspace' && !this.value && i > 0) {
                        boxes[i - 1].value = '';
                        boxes[i - 1].classList.remove('filled');
                        boxes[i - 1].focus();
                        sync();
                    }
                });

                box.addEventListener('paste', function (e) {
                    var pasted = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '').slice(0, 6);
                    e.preventDefault();
                    if (!pasted) return;

                    pasted.split('').forEach(function (ch, j) {
                        if (boxes[j]) {
                            boxes[j].value = ch;
                            boxes[j].classList.add('filled');
                        }
                    });
                    var next = Math.min(pasted.length, boxes.length - 1);
                    boxes[next].focus();
                    sync();
                });
            });

            function sync() {
                var val = Array.from(boxes).map(function (b) { return b.value; }).join('');
                hidden.value = val;
                btn.disabled = val.length < 6;
            }

            // Countdown 5 minutes
            var totalSecs = 300;
            var countdownEl = document.getElementById('otpCountdown');
            var cdInterval = setInterval(function () {
                totalSecs--;
                if (totalSecs <= 0) {
                    clearInterval(cdInterval);
                    countdownEl.textContent = '00:00 (Đã hết hạn)';
                    countdownEl.style.color = '#dc3545';
                    btn.disabled = true;
                    return;
                }
                var m = String(Math.floor(totalSecs / 60)).padStart(2, '0');
                var s = String(totalSecs % 60).padStart(2, '0');
                countdownEl.textContent = m + ':' + s;
            }, 1000);

            // Cooldown logic for Resend
            var initialCooldown = @remainingCooldown;
            var resendBtn = document.getElementById('btnResendOtp');
            var cooldownSpan = document.getElementById('cooldownText');
            var resendTimer = null;

            function startCooldown(seconds) {
                if (seconds <= 0) {
                    resendBtn.disabled = false;
                    cooldownSpan.textContent = '';
                    return;
                }
                resendBtn.disabled = true;
                cooldownSpan.textContent = '(' + seconds + 's)';

                if (resendTimer) clearInterval(resendTimer);
                resendTimer = setInterval(function () {
                    seconds--;
                    if (seconds <= 0) {
                        clearInterval(resendTimer);
                        resendBtn.disabled = false;
                        cooldownSpan.textContent = '';
                    } else {
                        cooldownSpan.textContent = '(' + seconds + 's)';
                    }
                }, 1000);
            }

            if (initialCooldown > 0) {
                startCooldown(initialCooldown);
            }

            // Expose resend handler
            window.handleResendOtp = function () {
                var emailVal = document.getElementById('targetEmailInput').value;
                var token = $('input[name="__RequestVerificationToken"]').val();

                resendBtn.disabled = true;
                cooldownSpan.textContent = '(Đang gửi...)';

                $.ajax({
                    url: '@Url.Action("ResendRegisterOtp", "User")',
                    type: 'POST',
                    data: {
                        email: emailVal,
                        __RequestVerificationToken: token
                    },
                    success: function (res) {
                        if (res.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Đã gửi lại OTP',
                                text: res.message,
                                background: '#111424',
                                color: '#fff'
                            });
                            // Reset 5 minute countdown
                            totalSecs = 300;
                            countdownEl.style.color = '#ffc107';
                            // Start 60s cooldown
                            startCooldown(res.cooldown || 60);
                        } else {
                            Swal.fire({
                                icon: 'warning',
                                title: 'Thông báo',
                                text: res.message,
                                background: '#111424',
                                color: '#fff'
                            });
                            resendBtn.disabled = false;
                            cooldownSpan.textContent = '';
                        }
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi',
                            text: 'Không thể kết nối đến máy chủ. Vui lòng thử lại sau.',
                            background: '#111424',
                            color: '#fff'
                        });
                        resendBtn.disabled = false;
                        cooldownSpan.textContent = '';
                    }
                });
            };
        })();
    </script>
}
