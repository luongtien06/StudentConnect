@{
    ViewBag.Title = "Đặt lại mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .rp-wrap {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
    }

    .rp-card {
        width: 100%;
        max-width: 420px;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 20px;
        padding: 2.5rem;
        position: relative;
        overflow: hidden;
    }

        .rp-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255,160,0,0.55), rgba(255,80,80,0.35), transparent);
        }

    .rp-icon-wrap {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        margin: 0 auto 1.5rem;
        background: rgba(255,160,0,0.08);
        border: 1px solid rgba(255,160,0,0.22);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .rp-title {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.4rem;
        font-weight: 600;
        color: #fff;
        text-align: center;
        margin-bottom: 6px;
    }

    .rp-sub {
        font-size: 13px;
        color: rgba(255,255,255,0.3);
        text-align: center;
        margin-bottom: 2rem;
        font-weight: 300;
        line-height: 1.6;
    }

    .rp-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        letter-spacing: 0.1em;
        color: rgba(255,160,0,0.55);
        text-transform: uppercase;
        margin-bottom: 8px;
        display: block;
    }

    .rp-input {
        width: 100%;
        background: rgba(255,255,255,0.04) !important;
        border: 1px solid rgba(255,255,255,0.1) !important;
        border-radius: 10px !important;
        color: #fff !important;
        padding: 11px 44px 11px 14px;
        font-size: 13px;
        font-family: 'Space Grotesk', sans-serif;
        transition: all 0.2s;
        outline: none;
    }

        .rp-input:focus {
            border-color: rgba(255,160,0,0.4) !important;
            background: rgba(255,160,0,0.04) !important;
            box-shadow: 0 0 0 3px rgba(255,160,0,0.08) !important;
        }

        .rp-input::placeholder {
            color: rgba(255,255,255,0.2) !important;
        }

        .rp-input.is-invalid {
            border-color: rgba(255,60,60,0.45) !important;
            box-shadow: 0 0 0 3px rgba(255,60,60,0.07) !important;
        }

        .rp-input.is-valid {
            border-color: rgba(0,200,80,0.45) !important;
            box-shadow: 0 0 0 3px rgba(0,200,80,0.07) !important;
        }

    .rp-pass-wrap {
        position: relative;
    }

    .rp-eye {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: rgba(255,255,255,0.22);
        cursor: pointer;
        padding: 4px;
        transition: color 0.2s;
        font-size: 15px;
    }

        .rp-eye:hover {
            color: rgba(255,255,255,0.55);
        }

    /* strength bar */
    .pw-bar-track {
        height: 3px;
        border-radius: 10px;
        margin-top: 8px;
        background: rgba(255,255,255,0.07);
        overflow: hidden;
    }

    .pw-bar-fill {
        height: 100%;
        border-radius: 10px;
        width: 0%;
        transition: width 0.35s, background 0.35s;
    }

    .pw-hint {
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        color: rgba(255,255,255,0.22);
        margin-top: 5px;
        letter-spacing: 0.06em;
    }

    /* match */
    .pw-match {
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        margin-top: 6px;
        letter-spacing: 0.06em;
        min-height: 16px;
    }

        .pw-match.ok {
            color: rgba(0,200,80,0.75);
        }

        .pw-match.bad {
            color: rgba(255,80,80,0.75);
        }

    .rp-alert-err {
        border-radius: 10px;
        padding: 11px 14px;
        font-size: 13px;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 9px;
        background: rgba(255,60,60,0.08);
        border: 1px solid rgba(255,60,60,0.2);
        color: rgba(255,120,120,0.9);
    }

    .rp-btn {
        width: 100%;
        padding: 12px;
        border-radius: 100px;
        border: none;
        background: linear-gradient(135deg, rgba(255,160,0,0.85), rgba(255,80,80,0.75));
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        font-family: 'Space Grotesk', sans-serif;
        cursor: pointer;
        transition: opacity 0.2s, transform 0.15s;
        letter-spacing: 0.02em;
        margin-top: 1.5rem;
    }

        .rp-btn:hover {
            opacity: 0.88;
            transform: translateY(-1px);
        }

        .rp-btn:active {
            transform: scale(0.98);
        }

    .rp-back {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        margin-top: 1.5rem;
        font-size: 12px;
        color: rgba(255,255,255,0.25);
        text-decoration: none;
        transition: color 0.2s;
    }

        .rp-back:hover {
            color: rgba(255,160,0,0.6);
        }

    /* checklist */
    .rp-rules {
        margin-top: 10px;
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .rp-rule {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 11px;
        color: rgba(255,255,255,0.25);
        font-family: 'JetBrains Mono', monospace;
        letter-spacing: 0.04em;
        transition: color 0.2s;
    }

        .rp-rule .rr-dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: rgba(255,255,255,0.15);
            transition: background 0.2s;
            flex-shrink: 0;
        }

        .rp-rule.pass {
            color: rgba(0,200,80,0.7);
        }

            .rp-rule.pass .rr-dot {
                background: rgba(0,200,80,0.7);
            }
</style>

<div class="rp-wrap">
    <div class="rp-card">

        <div class="rp-icon-wrap">🔒</div>
        <h2 class="rp-title">Tạo mật khẩu mới</h2>
        <p class="rp-sub">Chọn mật khẩu mạnh để bảo vệ tài khoản của bạn.</p>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="rp-alert-err">
                <i class="bi bi-exclamation-circle"></i>
                <span>@ViewBag.ErrorMessage</span>
            </div>
        }

        @using (Html.BeginForm("ResetPassword", "User", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="rp-label">Mật khẩu mới</label>
                <div class="rp-pass-wrap">
                    <input type="password" name="newPassword" id="newPass"
                           class="rp-input" placeholder="Nhập mật khẩu mới" required />
                    <button type="button" class="rp-eye" data-target="newPass">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <div class="pw-bar-track"><div class="pw-bar-fill" id="rpBar"></div></div>
                <div class="pw-hint" id="rpHint">Nhập mật khẩu để kiểm tra độ mạnh</div>
                <div class="rp-rules">
                    <div class="rp-rule" id="r-len"><div class="rr-dot"></div>Ít nhất 8 ký tự</div>
                    <div class="rp-rule" id="r-num"><div class="rr-dot"></div>Có ít nhất 1 chữ số</div>
                    <div class="rp-rule" id="r-sym"><div class="rr-dot"></div>Có ít nhất 1 ký tự đặc biệt</div>
                    <div class="rp-rule" id="r-case"><div class="rr-dot"></div>Có cả chữ hoa và chữ thường</div>
                </div>
            </div>

            <div class="mb-1">
                <label class="rp-label">Xác nhận mật khẩu</label>
                <div class="rp-pass-wrap">
                    <input type="password" name="confirmPassword" id="confirmPass"
                           class="rp-input" placeholder="Nhập lại mật khẩu" required />
                    <button type="button" class="rp-eye" data-target="confirmPass">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <div class="pw-match" id="rpMatch"></div>
            </div>

            <button type="submit" class="rp-btn">
                <i class="bi bi-shield-lock me-2"></i>Đổi mật khẩu
            </button>
        }

        <a href="@Url.Action("Login", "User")" class="rp-back">
            <i class="bi bi-arrow-left"></i> Quay lại đăng nhập
        </a>

    </div>
</div>

@section scripts {
    <script>
        (function () {
            // toggle eye
            document.querySelectorAll('.rp-eye').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var inp = document.getElementById(this.getAttribute('data-target'));
                    var icon = this.querySelector('i');
                    var isPass = inp.type === 'password';
                    inp.type = isPass ? 'text' : 'password';
                    icon.classList.toggle('bi-eye', !isPass);
                    icon.classList.toggle('bi-eye-slash', isPass);
                });
            });

            var newPass = document.getElementById('newPass');
            var confPass = document.getElementById('confirmPass');
            var bar = document.getElementById('rpBar');
            var hint = document.getElementById('rpHint');
            var matchEl = document.getElementById('rpMatch');

            var rules = {
                len: { el: document.getElementById('r-len'), fn: function (v) { return v.length >= 8; } },
                num: { el: document.getElementById('r-num'), fn: function (v) { return /[0-9]/.test(v); } },
                sym: { el: document.getElementById('r-sym'), fn: function (v) { return /[^A-Za-z0-9]/.test(v); } },
                case: { el: document.getElementById('r-case'), fn: function (v) { return /[A-Z]/.test(v) && /[a-z]/.test(v); } }
            };

            var levels = [
                { w: '0%', bg: 'transparent', text: 'Nhập mật khẩu để kiểm tra độ mạnh' },
                { w: '25%', bg: 'rgba(255,60,60,0.75)', text: 'YẾU' },
                { w: '50%', bg: 'rgba(255,140,0,0.75)', text: 'TRUNG BÌNH' },
                { w: '75%', bg: 'rgba(0,200,255,0.75)', text: 'KHÁ MẠNH' },
                { w: '100%', bg: 'rgba(0,200,80,1)', text: 'RẤT MẠNH ✓' }
            ];

            newPass.addEventListener('input', function () {
                var v = this.value;
                var score = 0;
                Object.values(rules).forEach(function (r) {
                    var ok = r.fn(v);
                    r.el.classList.toggle('pass', ok);
                    if (ok) score++;
                });
                var lv = v ? Math.max(1, score) : 0;
                bar.style.width = levels[lv].w;
                bar.style.background = levels[lv].bg;
                hint.textContent = levels[lv].text;
                checkMatch();
            });

            confPass.addEventListener('input', checkMatch);

            function checkMatch() {
                if (!confPass.value) { matchEl.textContent = ''; matchEl.className = 'pw-match'; return; }
                var ok = newPass.value === confPass.value;
                matchEl.textContent = ok ? '✓ MẬT KHẨU KHỚP' : '✗ CHƯA KHỚP';
                matchEl.className = 'pw-match ' + (ok ? 'ok' : 'bad');
                confPass.classList.toggle('is-valid', ok);
                confPass.classList.toggle('is-invalid', !ok);
            }
        })();
    </script>
}