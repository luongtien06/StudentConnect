            gap: 6px;
        }
        .profile-actions-bar {
            width: 100%;
            flex-direction: column;
            gap: 6px;
        }
        .profile-actions-bar .btn-social {
            width: 100%;
            flex: 1 1 100%;
            padding: 8px 14px;
            font-size: 12.5px;
        }
        #friendshipActionWrap {
            width: 100%;
            flex: 1 1 100%;
        }
        #friendshipActionWrap .dropdown,
        #friendshipActionWrap .btn-social {
            width: 100%;
        }
        .profile-highlights-card {
            padding: 12px;
            border-radius: 12px;
