                            timer: 1500,
                            showConfirmButton: false,
                            background: '#111d30',
                            color: '#fff'
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire({ icon: 'error', title: 'Lỗi', text: res.message || 'Không thể tạo tin nổi bật!', background: '#111d30', color: '#fff' });
                    }
                },
                error: function() {
                    $btn.prop('disabled', false).html('<i class="fa-solid fa-check me-1"></i> Lưu tin nổi bật');
                    Swal.fire({ icon: 'error', title: 'Lỗi kết nối', text: 'Không thể kết nối đến máy chủ!', background: '#111d30', color: '#fff' });
