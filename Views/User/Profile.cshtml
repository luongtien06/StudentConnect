@model StudentConnect.Models.SocialProfileViewModel
@using StudentConnect.Models
@using StudentConnect.Helpers
@{
    ViewBag.Title = Model.Username + " | Trang cá nhân";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var currentUserId = Session["UserID"] as int? ?? 0;
    bool isOwner = Model.IsOwner;
    var joinDate = Model.CreatedAt.HasValue ? Model.CreatedAt.Value.ToString("dd/MM/yyyy") : "N/A";
    var avatarSrc = !string.IsNullOrEmpty(Model.Avatar) ? Model.Avatar : "/Content/Images/default-avatar.png";
    var coverSrc = !string.IsNullOrEmpty(Model.CoverPhoto) ? Model.CoverPhoto : "/Content/Images/default-cover.jpg";

    var myMarket = ViewBag.MarketPosts as List<MarketPost> ?? new List<MarketPost>();
    var myConnect = ViewBag.ConnectPosts as List<ConnectPost> ?? new List<ConnectPost>();
    bool hasActiveStories = Model.HasActiveStories;
    bool canViewContent = isOwner || !Model.IsPrivate || Model.RelationshipStatus == UserRelationshipStatus.Friends;
}

@Html.AntiForgeryToken()

<style>
    :root {
        --c-surface: #0d1626;
        --c-surface2: #111d30;
        --c-surface3: #16243d;
        --c-border: #1a2540;
        --c-border2: #232840;
        --c-cyan: #00c8ff;
        --c-cyan-hover: #33d4ff;
        --c-purple: #7b61ff;
        --c-green: #00c850;
        --c-red: #e24b4a;
        --c-amber: #ef9f27;
        --c-text: rgba(255,255,255,0.92);
        --c-muted: #8b94a5;
        --c-hint: #4a5568;
        --radius: 14px;
        --tr: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .social-profile-page {
        max-width: 1140px;
        margin: 0 auto;
        padding: 0 0 3rem;
    }

    /* ===================================================
       1. COVER & HEADER BANNER (Facebook style)
       =================================================== */
    .profile-header-card {
        background: var(--c-surface);
        border: 1px solid var(--c-border2);
        border-radius: var(--radius);
        overflow: hidden;
        margin-bottom: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }

    .cover-container {
        position: relative;
        width: 100%;
        height: 280px;
        background: #080d17;
        overflow: hidden;
    }

    .cover-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.4s ease;
    }

    .cover-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(8,13,23,0.1) 0%, rgba(13,22,38,0.85) 100%);
    }

    .btn-change-cover {
        position: absolute;
        bottom: 16px;
        right: 16px;
        background: rgba(13, 22, 38, 0.85);
        color: #fff;
        border: 1px solid var(--c-border2);
        backdrop-filter: blur(8px);
        padding: 7px 14px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        transition: var(--tr);
        z-index: 5;
    }
    .btn-change-cover:hover {
        background: var(--c-cyan);
        color: #000;
        border-color: var(--c-cyan);
    }

    /* Main Info Bar */
    .profile-info-bar {
        position: relative;
        padding: 0 24px 20px;
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
        margin-top: -65px;
    }

    .avatar-details-group {
        display: flex;
        align-items: flex-end;
        gap: 20px;
        z-index: 10;
    }

    .profile-avatar-wrap {
        position: relative;
        width: 132px;
        height: 132px;
        border-radius: 50%;
        flex-shrink: 0;
        background: var(--c-surface);
        padding: 4px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    }

    .profile-avatar-wrap.has-story-ring {
        background: linear-gradient(135deg, #00c8ff, #7b61ff, #f33e5b);
        cursor: pointer;
    }

    .profile-avatar-img {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid var(--c-surface);
        display: block;
    }

    .avatar-change-btn {
        position: absolute;
        bottom: 4px;
        right: 4px;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--c-cyan);
        color: #000;
        border: 2px solid var(--c-surface);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        cursor: pointer;
        transition: var(--tr);
        box-shadow: 0 2px 8px rgba(0,0,0,0.4);
    }
    .avatar-change-btn:hover {
        transform: scale(1.1);
        background: #fff;
    }

    .story-pill-badge {
        position: absolute;
        bottom: -6px;
        left: 50%;
        transform: translateX(-50%);
        background: linear-gradient(135deg, var(--c-cyan), var(--c-purple));
        color: #fff;
        font-size: 10px;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 20px;
        border: 2px solid var(--c-surface);
        white-space: nowrap;
        pointer-events: none;
    }

    .profile-names-wrap {
        padding-bottom: 6px;
    }

    .profile-name {
        font-size: 1.6rem;
        font-weight: 800;
        color: #fff;
        margin: 0 0 4px;
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .profile-badge-student {
        font-size: 11px;
        padding: 3px 9px;
        border-radius: 20px;
        background: rgba(0, 200, 255, 0.12);
        color: var(--c-cyan);
        border: 1px solid rgba(0, 200, 255, 0.3);
        font-weight: 600;
    }

    .profile-badge-private {
        font-size: 11px;
        padding: 3px 9px;
        border-radius: 20px;
        background: rgba(239, 159, 39, 0.12);
        color: var(--c-amber);
        border: 1px solid rgba(239, 159, 39, 0.3);
        font-weight: 600;
    }

    .profile-bio-quote {
        font-size: 13.5px;
        color: var(--c-muted);
        margin: 4px 0 8px;
        max-width: 520px;
        line-height: 1.4;
    }

    .profile-stats-row {
        display: flex;
        gap: 16px;
        font-size: 13px;
        color: var(--c-muted);
        flex-wrap: wrap;
    }
    .profile-stats-row b {
        color: #fff;
        font-weight: 700;
    }

    /* Action Buttons (Right) */
    .profile-actions-bar {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        padding-bottom: 6px;
        z-index: 10;
    }

    .btn-social {
        padding: 8px 16px;
        border-radius: 9px;
        font-size: 13.5px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border: 1px solid transparent;
        cursor: pointer;
        transition: var(--tr);
        text-decoration: none;
    }
    .btn-social-primary {
        background: var(--c-cyan);
        color: #000;
    }
    .btn-social-primary:hover {
        background: var(--c-cyan-hover);
        color: #000;
        transform: translateY(-1px);
    }
    .btn-social-secondary {
        background: var(--c-surface2);
        color: #fff;
        border-color: var(--c-border2);
    }
    .btn-social-secondary:hover {
        background: var(--c-surface3);
        color: #fff;
        border-color: var(--c-cyan);
    }
    .btn-social-danger {
        background: rgba(226, 75, 74, 0.15);
        color: var(--c-red);
        border-color: rgba(226, 75, 74, 0.3);
    }
    .btn-social-danger:hover {
        background: var(--c-red);
        color: #fff;
    }

    /* ===================================================
       2. DUAL COLUMN LAYOUT
       =================================================== */
    .profile-body-grid {
        display: grid;
        grid-template-columns: 360px 1fr;
        gap: 20px;
    }

    .sidebar-card, .timeline-card {
        background: var(--c-surface);
        border: 1px solid var(--c-border2);
        border-radius: var(--radius);
        overflow: hidden;
        margin-bottom: 20px;
    }

    .card-header-styled {
        padding: 14px 18px;
        border-bottom: 1px solid var(--c-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .card-title-styled {
        font-size: 15px;
        font-weight: 700;
        color: #fff;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .card-link-muted {
        font-size: 12px;
        color: var(--c-cyan);
        text-decoration: none;
    }
    .card-link-muted:hover {
        text-decoration: underline;
    }

    .sidebar-card-body {
        padding: 16px 18px;
    }

    /* Student Info List */
    .info-list-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        font-size: 13.5px;
        color: var(--c-text);
        margin-bottom: 13px;
        line-height: 1.4;
    }
    .info-list-item:last-child {
        margin-bottom: 0;
    }
    .info-icon {
        width: 20px;
        color: var(--c-cyan);
        font-size: 15px;
        flex-shrink: 0;
        text-align: center;
        margin-top: 2px;
    }
    .info-label {
        color: var(--c-muted);
        font-size: 12px;
        display: block;
    }

    /* Friends Grid Preview */
    .friends-preview-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
    }
    .friend-preview-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-decoration: none;
        padding: 8px;
        border-radius: 10px;
        background: var(--c-surface2);
        border: 1px solid var(--c-border);
        transition: var(--tr);
    }
    .friend-preview-card:hover {
        border-color: var(--c-cyan);
        transform: translateY(-2px);
    }
    .friend-preview-avatar {
        width: 68px;
        height: 68px;
        border-radius: 12px;
        object-fit: cover;
        margin-bottom: 6px;
    }
    .friend-preview-name {
        font-size: 11.5px;
        font-weight: 600;
        color: #fff;
        text-align: center;
        max-width: 80px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* Photos Grid Preview */
    .photos-preview-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 6px;
    }
    .photo-thumb-wrap {
        aspect-ratio: 1;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid var(--c-border);
    }
    .photo-thumb-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }
    .photo-thumb-wrap:hover .photo-thumb-img {
        transform: scale(1.08);
    }

    /* Active Stories Widget */
    .active-story-widget {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px;
        border-radius: 10px;
        background: linear-gradient(135deg, rgba(0,200,255,0.08), rgba(123,97,255,0.08));
        border: 1px solid rgba(0,200,255,0.25);
        cursor: pointer;
        transition: var(--tr);
    }
    .active-story-widget:hover {
        border-color: var(--c-cyan);
        transform: translateY(-2px);
    }
    .story-widget-thumb {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        border: 2px solid var(--c-cyan);
        object-fit: cover;
    }

    /* ===================================================
       3. RIGHT COLUMN: TIMELINE FEED & TABS
       =================================================== */
    .timeline-nav-tabs {
        display: flex;
        gap: 8px;
        border-bottom: 1px solid var(--c-border);
        padding: 0 16px;
        background: var(--c-surface);
        border-radius: var(--radius) var(--radius) 0 0;
    }
    .nav-tab-item {
        padding: 14px 16px;
        color: var(--c-muted);
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        border-bottom: 2px solid transparent;
        transition: var(--tr);
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .nav-tab-item:hover {
        color: #fff;
    }
    .nav-tab-item.active {
        color: var(--c-cyan);
        border-bottom-color: var(--c-cyan);
    }
    .tab-badge {
        font-size: 11px;
        padding: 1px 7px;
        border-radius: 12px;
        background: var(--c-surface2);
        color: var(--c-muted);
    }
    .nav-tab-item.active .tab-badge {
        background: rgba(0,200,255,0.15);
        color: var(--c-cyan);
    }

    /* Quick Create Post Box */
    .quick-create-card {
        background: var(--c-surface);
        border: 1px solid var(--c-border2);
        border-radius: var(--radius);
        padding: 16px;
        margin-bottom: 20px;
    }
    .create-input-row {
        display: flex;
        gap: 12px;
        align-items: center;
        margin-bottom: 12px;
    }
    .create-user-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
    }
    .create-fake-input {
        flex: 1;
        background: var(--c-surface2);
        border: 1px solid var(--c-border);
        border-radius: 24px;
        padding: 10px 18px;
        font-size: 13.5px;
        color: var(--c-muted);
        cursor: pointer;
        transition: var(--tr);
    }
    .create-fake-input:hover {
        background: var(--c-surface3);
        border-color: var(--c-cyan);
        color: var(--c-text);
    }
    .create-options-row {
        display: flex;
        justify-content: space-around;
        border-top: 1px solid var(--c-border);
        padding-top: 10px;
    }
    .btn-create-opt {
        background: none;
        border: none;
        color: var(--c-text);
        font-size: 13px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 6px 12px;
        border-radius: 8px;
        cursor: pointer;
        transition: var(--tr);
    }
    .btn-create-opt:hover {
        background: var(--c-surface2);
    }

    /* Single Post Item */
    .post-card {
        background: var(--c-surface);
        border: 1px solid var(--c-border2);
        border-radius: var(--radius);
        overflow: hidden;
        margin-bottom: 20px;
    }
    .post-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 18px;
    }
    .post-author-group {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .post-author-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        object-fit: cover;
    }
    .post-author-name {
        font-size: 14px;
        font-weight: 700;
        color: #fff;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .post-meta-line {
        font-size: 11.5px;
        color: var(--c-muted);
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 1px;
    }

    .post-body-content {
        padding: 0 18px 14px;
        font-size: 14px;
        line-height: 1.5;
        color: var(--c-text);
        white-space: pre-line;
    }
    .shared-post-preview {
        margin: 0 18px 14px;
        padding: 12px 14px;
        border: 1px solid rgba(255,255,255,0.14);
        border-left: 3px solid var(--c-cyan);
        border-radius: 6px;
        background: rgba(255,255,255,0.025);
    }
    .shared-post-author { color: #fff; font-size: 13px; font-weight: 700; text-decoration: none; }
    .shared-post-author:hover { color: var(--c-cyan); }
    .shared-post-content { margin-top: 8px; color: var(--c-text); white-space: pre-line; overflow-wrap: anywhere; }
    .shared-post-media { display: grid; grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); gap: 6px; margin-top: 8px; }
    .shared-post-media img, .shared-post-media video { width: 100%; max-height: 220px; object-fit: cover; border-radius: 4px; }

    /* Post Media Grid */
    .post-media-grid {
        display: grid;
        gap: 4px;
        background: #000;
        margin-bottom: 12px;
    }
    .post-media-grid.count-1 { grid-template-columns: 1fr; }
    .post-media-grid.count-2 { grid-template-columns: 1fr 1fr; }
    .post-media-grid.count-3 { grid-template-columns: 2fr 1fr; }
    .post-media-grid.count-4 { grid-template-columns: 1fr 1fr; }

    .post-media-item {
        position: relative;
        overflow: hidden;
        max-height: 520px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .post-media-item img, .post-media-item video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        cursor: pointer;
    }

    /* Post Stats Bar */
    .post-stats-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 18px;
        font-size: 12.5px;
        color: var(--c-muted);
        border-top: 1px solid var(--c-border);
    }
    .top-reactions-icons {
        display: flex;
        align-items: center;
        gap: 2px;
    }
    .reaction-emoji-badge {
        font-size: 15px;
    }

    /* Post Action Buttons */
    .post-actions-row {
        display: flex;
        justify-content: space-around;
        padding: 6px 14px;
        border-top: 1px solid var(--c-border);
        border-bottom: 1px solid var(--c-border);
        position: relative;
    }
    .btn-post-action {
        flex: 1;
        background: none;
        border: none;
        color: var(--c-muted);
        font-size: 13.5px;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 8px 0;
        border-radius: 8px;
        cursor: pointer;
        transition: var(--tr);
    }
    .btn-post-action:hover {
        background: var(--c-surface2);
        color: #fff;
    }
    .btn-post-action.reacted {
        color: var(--c-cyan);
    }

    /* Facebook-style Reaction Popup */
    .reaction-popup-container {
        position: relative;
        display: flex;
        flex: 1;
        align-items: stretch;
    }
    .reaction-popover {
        position: absolute;
        bottom: 100%;
        left: 50%;
        transform: translateX(-50%);
        background: var(--c-surface2);
        border: 1px solid var(--c-border2);
        box-shadow: 0 10px 25px rgba(0,0,0,0.5);
        border-radius: 30px;
        padding: 6px 10px;
        display: none;
        align-items: center;
        gap: 8px;
        z-index: 50;
    }
    .reaction-popup-container:hover .reaction-popover,
    .reaction-popup-container:focus-within .reaction-popover,
    .reaction-popup-container.is-open .reaction-popover {
        display: flex;
        animation: popUpAnim 0.15s ease-out;
    }
    @@keyframes popUpAnim {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    .reaction-picker-toggle {
        width: 28px;
        border: 0;
        border-radius: 0 8px 8px 0;
        color: var(--c-muted);
        background: transparent;
        cursor: pointer;
    }
    .reaction-btn-icon {
        background: none;
        border: none;
        font-size: 24px;
        cursor: pointer;
        transition: transform 0.15s ease;
        padding: 2px 4px;
    }
    .reaction-btn-icon:hover {
        transform: scale(1.35) translateY(-4px);
    }

    /* Comment Section */
    .post-comments-box {
        padding: 14px 18px;
        background: rgba(13, 22, 38, 0.4);
    }
    .comment-item {
        display: flex;
        gap: 10px;
        margin-bottom: 12px;
    }
    .comment-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
    }
    .comment-bubble {
        background: var(--c-surface2);
        border: 1px solid var(--c-border);
        border-radius: 14px;
        padding: 8px 14px;
        max-width: 85%;
    }
    .comment-author-name {
        font-size: 12.5px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 2px;
    }
    .comment-text {
        font-size: 13px;
        color: var(--c-text);
        word-break: break-word;
    }
    .comment-meta {
        font-size: 11px;
        color: var(--c-muted);
        margin-top: 4px;
        display: flex;
        gap: 12px;
    }
    .comment-action-link {
        color: var(--c-muted);
        text-decoration: none;
        cursor: pointer;
    }
    .comment-action-link:hover {
        color: var(--c-cyan);
    }

    .comment-input-row {
        display: flex;
        gap: 10px;
        align-items: center;
        margin-top: 10px;
    }
    .comment-input-field {
        flex: 1;
        background: var(--c-surface2);
        border: 1px solid var(--c-border);
        border-radius: 20px;
        padding: 7px 16px;
        font-size: 13px;
        color: #fff;
        outline: none;
        transition: var(--tr);
    }
    .comment-input-field:focus {
        border-color: var(--c-cyan);
    }
    .btn-send-comment {
        background: var(--c-cyan);
        color: #000;
        border: none;
        border-radius: 50%;
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        cursor: pointer;
        transition: var(--tr);
    }
    .btn-send-comment:hover {
        transform: scale(1.08);
    }

    /* Private Account Notice Card */
    .private-account-notice {
        text-align: center;
        padding: 48px 24px;
        background: var(--c-surface);
        border: 1px solid var(--c-border2);
        border-radius: var(--radius);
    }
    .private-lock-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: rgba(239, 159, 39, 0.1);
        color: var(--c-amber);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin: 0 auto 16px;
        border: 1px solid rgba(239, 159, 39, 0.3);
    }

    /* ===================================================
       STORY HIGHLIGHTS & ARCHIVE STYLES
       =================================================== */
    .profile-highlights-card {
        background: linear-gradient(145deg, rgba(13, 22, 38, 0.95), rgba(17, 29, 48, 0.95));
        border: 1px solid var(--c-border);
        border-radius: 18px;
        padding: 16px 20px;
        margin-bottom: 24px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(12px);
    }
    .highlights-scroll-wrap {
        display: flex;
        align-items: flex-start;
        gap: 20px;
        overflow-x: auto;
        padding-bottom: 4px;
        scrollbar-width: thin;
        scrollbar-color: rgba(0, 200, 255, 0.3) transparent;
    }
    .highlights-scroll-wrap::-webkit-scrollbar {
        height: 4px;
    }
    .highlights-scroll-wrap::-webkit-scrollbar-thumb {
        background: rgba(0, 200, 255, 0.3);
        border-radius: 4px;
    }
    .highlight-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        position: relative;
        min-width: 76px;
        max-width: 86px;
        text-align: center;
        user-select: none;
    }
    .highlight-circle {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        padding: 3px;
        background: linear-gradient(135deg, var(--c-cyan), var(--c-purple));
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .highlight-item:hover .highlight-circle {
        transform: scale(1.06);
        box-shadow: 0 0 18px rgba(0, 200, 255, 0.45);
    }
    .highlight-cover-img {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #0d1626;
        background: #0d1626;
    }
    .highlight-plus-icon, .highlight-archive-icon {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: #0d1626;
        border: 2px solid #0d1626;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        color: var(--c-cyan);
        transition: background 0.2s, color 0.2s;
    }
    .highlight-item.archive-highlight .highlight-circle {
        background: linear-gradient(135deg, #ef9f27, #f43f5e);
    }
    .highlight-item.archive-highlight .highlight-archive-icon {
        color: #ef9f27;
    }
    .highlight-title {
        font-size: 12px;
        font-weight: 600;
        color: #fff;
        width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        transition: color 0.2s;
    }
    .highlight-item:hover .highlight-title {
        color: var(--c-cyan);
    }
    .highlight-count-badge {
        position: absolute;
        bottom: 0;
        right: 0;
        background: rgba(0, 0, 0, 0.85);
        color: var(--c-cyan);
        font-size: 10px;
        font-weight: 700;
        padding: 1px 6px;
        border-radius: 10px;
        border: 1px solid rgba(0, 200, 255, 0.4);
    }
    .highlight-delete-btn {
        position: absolute;
        top: -4px;
        right: 4px;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: rgba(220, 53, 69, 0.95);
        border: 1px solid rgba(255, 255, 255, 0.4);
        color: #fff;
        font-size: 10px;
        display: none;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 5;
        transition: transform 0.15s;
    }
    .highlight-delete-btn:hover {
        transform: scale(1.2);
    }
    .highlight-item:hover .highlight-delete-btn {
        display: flex;
    }

    /* Archive Grid */
    .archive-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
        gap: 12px;
        max-height: 480px;
        overflow-y: auto;
        padding: 4px;
    }
    .archive-card {
        position: relative;
        aspect-ratio: 9/16;
        border-radius: 12px;
        overflow: hidden;
        border: 1.5px solid var(--c-border);
        background: #000;
        cursor: pointer;
        transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
    }
    .archive-card:hover {
        transform: translateY(-2px);
        border-color: var(--c-cyan);
        box-shadow: 0 4px 16px rgba(0, 200, 255, 0.25);
    }
    .archive-card.selected {
        border-color: var(--c-green);
        box-shadow: 0 0 16px rgba(0, 200, 80, 0.45);
    }
    .archive-card-media {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .archive-card-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(0,0,0,0.6) 0%, transparent 40%, rgba(0,0,0,0.85) 100%);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 8px;
    }
    .archive-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .archive-card-badge {
        font-size: 10px;
        padding: 2px 6px;
        border-radius: 6px;
        font-weight: 600;
    }
    .archive-card-checkbox {
        width: 18px;
        height: 18px;
        accent-color: var(--c-cyan);
        cursor: pointer;
    }
    .archive-card-footer {
        color: #fff;
    }
    .archive-card-date {
        font-size: 11px;
        font-weight: 600;
    }
    .archive-card-views {
        font-size: 10px;
        color: rgba(255, 255, 255, 0.7);
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* Highlight picker in modal */
    .highlight-picker-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
        gap: 10px;
        max-height: 360px;
        overflow-y: auto;
        padding: 4px;
    }
    .picker-card {
        position: relative;
        aspect-ratio: 9/16;
        border-radius: 10px;
        overflow: hidden;
        border: 2px solid transparent;
        cursor: pointer;
        transition: border-color 0.2s, transform 0.2s;
    }
    .picker-card:hover {
        transform: scale(1.02);
    }
    .picker-card.active {
        border-color: var(--c-cyan);
    }
    .picker-card-check {
        position: absolute;
        top: 6px;
        right: 6px;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.6);
        border: 1.5px solid #fff;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
    }
    .picker-card.active .picker-card-check {
        background: var(--c-cyan);
        border-color: var(--c-cyan);
        color: #000;
    }

    /* ===================================================
       MARKET & CONNECT STYLES IN PROFILE
       =================================================== */
    .market-profile-card {
        background: var(--c-surface);
        border: 1px solid var(--c-border2);
        border-radius: var(--radius);
        overflow: hidden;
        transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        display: flex;
        flex-direction: column;
        height: 100%;
        text-decoration: none;
    }
    .market-profile-card:hover {
        transform: translateY(-3px);
        border-color: var(--c-cyan);
        box-shadow: 0 8px 24px rgba(0, 200, 255, 0.12);
        color: inherit;
    }
    .market-card-img-wrap {
        position: relative;
        height: 175px;
        overflow: hidden;
        background: #000;
    }
    .market-card-img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }
    .market-profile-card:hover .market-card-img-wrap img {
        transform: scale(1.05);
    }
    .market-card-price-badge {
        position: absolute;
        bottom: 8px;
        left: 8px;
        background: rgba(0, 0, 0, 0.85);
        color: #ff5252;
        font-weight: 800;
        font-size: 13.5px;
        padding: 4px 10px;
        border-radius: 8px;
        backdrop-filter: blur(4px);
        border: 1px solid rgba(255, 82, 82, 0.3);
    }
    .market-card-cat-badge {
        position: absolute;
        top: 8px;
        left: 8px;
        background: rgba(0, 200, 255, 0.85);
        color: #000;
        font-weight: 700;
        font-size: 10.5px;
        padding: 2px 8px;
        border-radius: 6px;
    }

    .connect-profile-card {
        background: var(--c-surface);
        border: 1px solid var(--c-border2);
        border-radius: var(--radius);
        padding: 16px;
        transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        text-decoration: none;
        color: inherit;
        display: block;
    }
    .connect-profile-card:hover {
        transform: translateY(-2px);
        border-color: var(--c-cyan);
        box-shadow: 0 6px 20px rgba(0, 200, 255, 0.1);
        color: inherit;
    }
    .connect-card-img {
        width: 85px;
        height: 85px;
        border-radius: 10px;
        object-fit: cover;
        flex-shrink: 0;
        background: #000;
    }

    .sidebar-mini-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 10px;
        border-radius: 10px;
        text-decoration: none;
        color: inherit;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid transparent;
        transition: all 0.2s ease;
        margin-bottom: 8px;
    }
    .sidebar-mini-item:hover {
        background: var(--c-surface3);
        border-color: var(--c-border);
        color: #fff;
        transform: translateX(3px);
    }
    .sidebar-mini-thumb {
        width: 44px;
        height: 44px;
        border-radius: 8px;
        object-fit: cover;
        flex-shrink: 0;
        background: #000;
    }

    .tab-section-header {
        background: var(--c-surface);
        border: 1px solid var(--c-border2);
        border-radius: var(--radius);
        padding: 14px 18px;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
    }

    /* ===================================================
       4. RESPONSIVE DESIGN
       =================================================== */
    /* Màn hình máy tính bảng & laptop nhỏ (<= 992px) */
    @@media (max-width: 992px) {
        .profile-body-grid {
            grid-template-columns: 1fr;
            gap: 20px;
        }
        .cover-container {
            height: 220px;
        }
        .profile-info-bar {
            margin-top: -50px;
            padding: 0 20px 16px;
        }
        .profile-avatar-wrap {
            width: 110px;
            height: 110px;
        }
        .profile-name {
            font-size: 1.4rem;
        }
        .profile-actions-bar {
            width: 100%;
            justify-content: flex-start;
        }
    }

    /* Màn hình máy tính bảng đứng & điện thoại lớn (<= 768px) */
    @@media (max-width: 768px) {
        .social-profile-page {
            padding: 12px 10px;
        }
        .cover-container {
            height: 180px;
        }
        .btn-change-cover {
            padding: 6px 12px;
            font-size: 12px;
            bottom: 12px;
            right: 12px;
        }
        .profile-info-bar {
            margin-top: -45px;
            padding: 0 16px 16px;
            flex-direction: column;
            align-items: flex-start;
            gap: 14px;
        }
        .avatar-details-group {
            gap: 16px;
            width: 100%;
        }
        .profile-avatar-wrap {
            width: 98px;
            height: 98px;
        }
        .avatar-change-btn {
            width: 28px;
            height: 28px;
            font-size: 11px;
            bottom: 2px;
            right: 2px;
        }
        .profile-name {
            font-size: 1.3rem;
        }
        .profile-stats-row {
            font-size: 12px;
            gap: 10px;
        }
        .profile-actions-bar {
            width: 100%;
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }
        .profile-actions-bar .btn-social {
            flex: 1 1 calc(50% - 8px);
            min-width: 130px;
            justify-content: center;
