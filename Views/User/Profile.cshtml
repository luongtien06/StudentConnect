</style>

<div class="social-profile-page">

    <!-- ==========================================
         HEADER: ẢNH BÌA & THÔNG TIN CÁ NHÂN
         ========================================== -->
    <div class="profile-header-card">
        <!-- Cover Photo -->
        <div class="cover-container">
            <img src="@coverSrc" alt="Ảnh bìa" class="cover-img" id="profileCoverImg" onerror="this.src='/Content/Images/default-cover.jpg';" />
            <div class="cover-overlay"></div>

            @if (isOwner)
            {
                <button type="button" class="btn-change-cover" onclick="$('#coverFileInput').click();">
                    <i class="fa-solid fa-camera"></i>
                    <span>Chỉnh sửa ảnh bìa</span>
                </button>
                <input type="file" id="coverFileInput" accept="image/*" style="display:none;" />
            }
        </div>

        <!-- Info Bar (Overlapping avatar + stats + action buttons) -->
        <div class="profile-info-bar">
            <div class="avatar-details-group">
                <!-- Avatar with Story Ring -->
                <div class="profile-avatar-wrap @(hasActiveStories ? "has-story-ring" : "")" 
                     id="profileAvatarWrap"
                     onclick="@(hasActiveStories ? $"loadUserStories({Model.UserID}, 0)" : (isOwner ? "$('#avatarFileInput').click()" : ""))">
                    <img src="@avatarSrc" alt="@Model.Username" class="profile-avatar-img" id="profileAvatarImg" onerror="this.src='/Content/Images/default-avatar.png';" />
                    
                    @if (hasActiveStories)
                    {
                        <span class="story-pill-badge"><i class="fa-solid fa-circle-play me-1"></i>Xem Tin</span>
                    }

                    @if (isOwner)
                    {
                        <div class="avatar-change-btn" onclick="event.stopPropagation(); $('#avatarFileInput').click();" title="Đổi ảnh đại diện">
                            <i class="fa-solid fa-camera"></i>
                        </div>
                        <input type="file" id="avatarFileInput" accept="image/*" style="display:none;" />
                    }
                </div>

                <!-- Names & Badges -->
                <div class="profile-names-wrap">
                    <h1 class="profile-name">
                        @Model.Username
                        @if (Model.IsTDMUStudent)
                        {
                            <span class="profile-badge-student"><i class="fa-solid fa-graduation-cap me-1"></i>TDMU</span>
                        }
                        @if (Model.IsPrivate)
                        {
                            <span class="profile-badge-private" id="privateBadge"><i class="fa-solid fa-lock me-1"></i>Riêng tư</span>
                        }
                    </h1>

                    @if (!string.IsNullOrEmpty(Model.Bio))
                    {
                        <div class="profile-bio-quote" id="profileBioText">
                            <i class="fa-solid fa-quote-left text-muted me-1"></i>@Model.Bio
                        </div>
                    }

                    <div class="profile-stats-row">
                        <span><b>@Model.FriendCount</b> bạn bè</span>
                        <span>·</span>
                        <span><b>@Model.PostCount</b> bài viết</span>
                        <span>·</span>
                        <span><b id="followerCountDisplay">@Model.FollowerCount</b> người theo dõi</span>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="profile-actions-bar">
                @if (isOwner)
                {
                    <button type="button" class="btn-social btn-social-primary" data-bs-toggle="modal" data-bs-target="#createStoryModal">
                        <i class="fa-solid fa-circle-plus"></i>
                        <span>Thêm vào tin</span>
                    </button>
                    <button type="button" class="btn-social btn-social-secondary" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                        <i class="fa-solid fa-pen"></i>
                        <span>Chỉnh sửa hồ sơ</span>
                    </button>
                    <button type="button" class="btn-social btn-social-secondary" id="btnTogglePrivacy" onclick="togglePrivacyAjax();" title="Bật/Tắt chế độ riêng tư">
                        <i class="fa-solid @(Model.IsPrivate ? "fa-lock" : "fa-globe")"></i>
                        <span id="privacyBtnLabel">@(Model.IsPrivate ? "Riêng tư" : "Công khai")</span>
                    </button>
                }
                else
                {
                    <!-- Friend Button with dynamic status -->
                    <div id="friendshipActionWrap" class="d-inline-flex gap-2">
                        @if (Model.RelationshipStatus == UserRelationshipStatus.Friends)
                        {
                            <div class="dropdown">
                                <button class="btn-social btn-social-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    <i class="fa-solid fa-user-check text-success"></i> Bạn bè
                                </button>
                                <ul class="dropdown-menu dropdown-menu-dark">
                                    <li><a class="dropdown-item text-danger" href="javascript:void(0)" onclick="unfriendAjax(@Model.UserID)"><i class="fa-solid fa-user-xmark me-2"></i>Hủy kết bạn</a></li>
                                </ul>
                            </div>
                        }
                        else if (Model.RelationshipStatus == UserRelationshipStatus.PendingSent)
                        {
                            <div class="dropdown">
                                <button class="btn-social btn-social-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    <i class="fa-solid fa-clock text-warning"></i> Đã gửi lời mời
                                </button>
                                <ul class="dropdown-menu dropdown-menu-dark">
                                    <li><a class="dropdown-item text-danger" href="javascript:void(0)" onclick="declineFriendAjax(null, @Model.UserID)"><i class="fa-solid fa-xmark me-2"></i>Hủy lời mời</a></li>
                                </ul>
                            </div>
                        }
                        else if (Model.RelationshipStatus == UserRelationshipStatus.PendingReceived)
                        {
                            <button type="button" class="btn-social btn-social-primary" onclick="acceptFriendAjax(@(Model.FriendshipID ?? 0), @Model.UserID)">
                                <i class="fa-solid fa-check"></i> Chấp nhận
                            </button>
                            <button type="button" class="btn-social btn-social-secondary" onclick="declineFriendAjax(@(Model.FriendshipID ?? 0), @Model.UserID)">
                                <i class="fa-solid fa-xmark"></i> Xóa
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn-social btn-social-primary" onclick="sendFriendAjax(@Model.UserID)">
                                <i class="fa-solid fa-user-plus"></i> Thêm bạn bè
                            </button>
                        }
                    </div>

                    <!-- Direct Message Button -->
                    <button type="button" class="btn-social btn-social-secondary" onclick="startDirectMessage(@Model.UserID)">
                        <i class="fa-solid fa-comment-dots text-primary"></i>
                        <span>Nhắn tin</span>
                    </button>

                    <!-- Follow Button -->
                    <button type="button" class="btn-social btn-social-secondary" id="btnFollow" onclick="toggleFollowAjax(@Model.UserID)">
                        <i class="fa-solid @(Model.IsFollowing ? "fa-bell-slash text-warning" : "fa-bell text-info")"></i>
                        <span id="followBtnText">@(Model.IsFollowing ? "Đang theo dõi" : "Theo dõi")</span>
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- ==========================================
         STORY HIGHLIGHTS & ARCHIVE TRAY (TIN NỔI BẬT & KHO LƯU TRỮ)
         ========================================== -->
    @if (isOwner || (Model.Highlights != null && Model.Highlights.Any()))
    {
        <div class="profile-highlights-card">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-star text-warning"></i>
                    <span class="fw-bold text-white small">Tin nổi bật</span>
                </div>
                @if (isOwner)
                {
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-sm btn-outline-info rounded-pill py-1 px-3" onclick="openStoryArchiveModal()" style="font-size: 11px;">
                            <i class="fa-solid fa-box-archive me-1"></i> Kho lưu trữ tin
                        </button>
                    </div>
                }
            </div>

            <div class="highlights-scroll-wrap" id="highlightsScrollWrap">
                @if (isOwner)
                {
                    <!-- Nút Thêm tin nổi bật mới -->
                    <div class="highlight-item add-highlight" onclick="openCreateHighlightModal()" title="Thêm tin nổi bật">
                        <div class="highlight-circle">
                            <div class="highlight-plus-icon">
                                <i class="fa-solid fa-plus"></i>
                            </div>
                        </div>
                        <span class="highlight-title">Mới</span>
                    </div>

                    <!-- Nút Kho lưu trữ tin nhanh -->
                    <div class="highlight-item archive-highlight" onclick="openStoryArchiveModal()" title="Kho lưu trữ tất cả tin 24h">
                        <div class="highlight-circle">
                            <div class="highlight-archive-icon">
                                <i class="fa-solid fa-box-archive"></i>
                            </div>
                        </div>
                        <span class="highlight-title">Lưu trữ</span>
                    </div>
                }

                @if (Model.Highlights != null && Model.Highlights.Any())
                {
                    foreach (var hl in Model.Highlights)
                    {
                        <div class="highlight-item" id="hlItem_@hl.HighlightID">
                            <div class="highlight-circle" onclick="openHighlightViewer('@hl.HighlightID')">
                                <img src="@hl.CoverUrl" class="highlight-cover-img" alt="@hl.Title" onerror="this.src='/Content/Images/default-avatar.png';" />
                                <span class="highlight-count-badge">@hl.StoryCount</span>
                            </div>
                            <span class="highlight-title" onclick="openHighlightViewer('@hl.HighlightID')" title="@hl.Title">@hl.Title</span>
                            @if (isOwner)
                            {
                                <button type="button" class="highlight-delete-btn" onclick="event.stopPropagation(); deleteHighlightAjax('@hl.HighlightID', '@hl.Title')" title="Xóa tin nổi bật">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }


    <!-- ==========================================
         BODY: DUAL COLUMN (SIDEBAR + TIMELINE)
         ========================================== -->
    <div class="profile-body-grid">
        
        <!-- ==========================================
             LEFT COLUMN: GIỚI THIỆU, TIN 24H, BẠN BÈ, ẢNH
             ========================================== -->
        <div class="profile-sidebar-col">
            
            <!-- Giới thiệu Card -->
            <div class="sidebar-card">
                <div class="card-header-styled">
                    <h3 class="card-title-styled"><i class="fa-solid fa-circle-info text-info"></i> Giới thiệu</h3>
                    @if (isOwner)
                    {
                        <a href="javascript:void(0)" class="card-link-muted" data-bs-toggle="modal" data-bs-target="#editProfileModal">Chỉnh sửa</a>
                    }
                </div>
                <div class="sidebar-card-body">
                    @if (!string.IsNullOrEmpty(Model.Faculty))
                    {
                        <div class="info-list-item">
                            <i class="fa-solid fa-landmark info-icon"></i>
                            <div>
                                <span class="info-label">Khoa / Viện</span>
                                <span>@Model.Faculty</span>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Major))
                    {
                        <div class="info-list-item">
                            <i class="fa-solid fa-book-open-reader info-icon"></i>
                            <div>
                                <span class="info-label">Chuyên ngành</span>
                                <span>@Model.Major</span>
                            </div>
                        </div>
                    }

                    @if (Model.StudentYear.HasValue && Model.StudentYear.Value > 0)
                    {
                        <div class="info-list-item">
                            <i class="fa-solid fa-graduation-cap info-icon"></i>
                            <div>
                                <span class="info-label">Khóa sinh viên</span>
                                <span>Sinh viên năm @Model.StudentYear.Value</span>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Hometown))
                    {
                        <div class="info-list-item">
                            <i class="fa-solid fa-location-dot info-icon"></i>
                            <div>
                                <span class="info-label">Đến từ</span>
                                <span>@Model.Hometown</span>
                            </div>
                        </div>
                    }

                    <div class="info-list-item">
                        <i class="fa-solid fa-envelope info-icon"></i>
                        <div>
                            <span class="info-label">Email</span>
                            <span>@Model.Email</span>
                        </div>
                    </div>

                    <div class="info-list-item">
                        <i class="fa-solid fa-calendar-days info-icon"></i>
                        <div>
                            <span class="info-label">Tham gia từ</span>
                            <span>@joinDate</span>
                        </div>
                    </div>

                    @if (isOwner && string.IsNullOrEmpty(Model.Faculty) && string.IsNullOrEmpty(Model.Bio))
                    {
                        <button type="button" class="btn btn-sm btn-outline-info w-100 mt-2" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                            <i class="fa-solid fa-plus me-1"></i> Thêm thông tin sinh viên
                        </button>
                    }
                </div>
            </div>

            <!-- Active Story Widget (if any) -->
            @if (hasActiveStories)
            {
                <div class="sidebar-card">
                    <div class="card-header-styled">
                        <h3 class="card-title-styled"><i class="fa-solid fa-bolt text-warning"></i> Tin 24 Giờ</h3>
                        <span class="badge bg-primary">@Model.ActiveStories.Count tin</span>
                    </div>
                    <div class="sidebar-card-body">
                        <div class="active-story-widget" onclick="loadUserStories(@Model.UserID, 0)">
                            <img src="@Model.ActiveStories.First().MediaUrl" class="story-widget-thumb" alt="Tin 24h" />
                            <div class="flex-grow-1">
                                <div class="fw-bold text-white small">Tin mới nhất của @Model.Username</div>
                                <div class="text-muted" style="font-size: 11px;">@Model.ActiveStories.First().TimeAgo</div>
                            </div>
                            <i class="fa-solid fa-chevron-right text-muted"></i>
                        </div>
                    </div>
                </div>
            }

            <!-- Bạn bè Card -->
            <div class="sidebar-card">
                <div class="card-header-styled">
                    <div>
                        <h3 class="card-title-styled"><i class="fa-solid fa-user-group text-primary"></i> Bạn bè</h3>
                        <span class="text-muted" style="font-size: 12px;">@Model.FriendCount người bạn</span>
                    </div>
                </div>
                <div class="sidebar-card-body">
                    @if (Model.FriendsPreview != null && Model.FriendsPreview.Any())
                    {
                        <div class="friends-preview-grid">
                            @foreach (var friend in Model.FriendsPreview)
                            {
                                <a href="@Url.Action("Profile", "User", new { id = friend.UserID })" class="friend-preview-card" title="@friend.Username">
                                    <img src="@friend.Avatar" class="friend-preview-avatar" alt="@friend.Username" onerror="this.src='/Content/Images/default-avatar.png';" />
                                    <div class="friend-preview-name">@friend.Username</div>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-muted text-center py-3 small">
                            Chưa có bạn bè nào.
                        </div>
                    }
                </div>
            </div>

            <!-- Ảnh đã đăng Card -->
            @if (Model.RecentPhotos != null && Model.RecentPhotos.Any())
            {
                <div class="sidebar-card">
                    <div class="card-header-styled">
                        <h3 class="card-title-styled"><i class="fa-solid fa-images text-success"></i> Hình ảnh</h3>
                    </div>
                    <div class="sidebar-card-body">
                        <div class="photos-preview-grid">
                            @foreach (var photo in Model.RecentPhotos)
                            {
                                <div class="photo-thumb-wrap">
                                    <img src="@photo" class="photo-thumb-img" alt="Ảnh" />
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Gian hàng Chợ sinh viên Widget -->
            @if (myMarket.Any() || isOwner)
            {
                <div class="sidebar-card">
                    <div class="card-header-styled">
                        <div>
                            <h3 class="card-title-styled"><i class="fa-solid fa-store text-danger"></i> Chợ sinh viên</h3>
                            <span class="text-muted" style="font-size: 12px;">@myMarket.Count sản phẩm</span>
                        </div>
                        @if (isOwner)
                        {
                            <a href="@Url.Action("Create", "Market")" class="card-link-muted text-info" title="Đăng bán đồ mới">
                                <i class="fa-solid fa-plus me-1"></i>Đăng bán
                            </a>
                        }
                    </div>
                    <div class="sidebar-card-body">
                        @if (myMarket.Any())
                        {
                            <div class="sidebar-mini-list mb-2">
                                @foreach (var item in myMarket.Take(3))
                                {
                                    var img = item.MarketImages?.FirstOrDefault()?.ImageUrl ?? item.MainImage;
                                    <a href="@Url.Action("Details", "Market", new { id = item.PostID })" class="sidebar-mini-item" title="@item.Title">
                                        <img src="@(!string.IsNullOrEmpty(img) ? img : "/Content/Images/default-market.jpg")" class="sidebar-mini-thumb" alt="@item.Title" onerror="this.src='/Content/Images/default-market.jpg';" />
                                        <div class="flex-grow-1 overflow-hidden">
                                            <div class="text-truncate fw-bold text-white small">@item.Title</div>
                                            <div class="text-danger fw-bold" style="font-size: 11.5px;">@((item.Price ?? 0).ToString("N0"))đ</div>
                                        </div>
                                        <i class="fa-solid fa-angle-right text-muted" style="font-size: 11px;"></i>
                                    </a>
                                }
                            </div>
                            <div class="d-flex gap-2 mt-2">
                                <button type="button" class="btn btn-sm btn-outline-info w-100 rounded-pill py-1" onclick="switchTimelineTab('market', $('.nav-tab-item:contains(\'Chợ\')')[0]); $('html, body').animate({ scrollTop: $('.timeline-nav-tabs').offset().top - 80 }, 300);" style="font-size: 11.5px;">
                                    <i class="fa-solid fa-eye me-1"></i>Xem tất cả (@myMarket.Count)
                                </button>
                                <a href="@Url.Action("Index", "Market")" class="btn btn-sm btn-outline-secondary rounded-pill py-1 px-2" title="Đến Chợ sinh viên TDMU" style="font-size: 11.5px; white-space: nowrap;">
                                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-2 text-muted small">
                                <p class="mb-2">Bạn chưa đăng món đồ nào lên Chợ.</p>
                                <a href="@Url.Action("Create", "Market")" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1" style="font-size: 11.5px;">
                                    <i class="fa-solid fa-plus me-1"></i>Đăng bán đồ ngay
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Bài viết Kết nối Widget -->
            @if (myConnect.Any() || isOwner)
            {
                <div class="sidebar-card">
                    <div class="card-header-styled">
                        <div>
                            <h3 class="card-title-styled"><i class="fa-solid fa-handshake text-info"></i> Kết nối sinh viên</h3>
                            <span class="text-muted" style="font-size: 12px;">@myConnect.Count bài chia sẻ</span>
                        </div>
                        @if (isOwner)
                        {
                            <a href="@Url.Action("Create", "Connect")" class="card-link-muted text-info" title="Tạo bài kết nối">
                                <i class="fa-solid fa-plus me-1"></i>Tạo bài
                            </a>
                        }
                    </div>
                    <div class="sidebar-card-body">
                        @if (myConnect.Any())
                        {
                            <div class="sidebar-mini-list mb-2">
                                @foreach (var item in myConnect.Take(3))
                                {
                                    <a href="@Url.Action("Details", "Connect", new { id = item.PostID })" class="sidebar-mini-item" title="@item.Title">
                                        @if (!string.IsNullOrEmpty(item.MainImage))
                                        {
                                            <img src="@item.MainImage" class="sidebar-mini-thumb" alt="@item.Title" onerror="this.src='/Content/Images/default-avatar.png';" />
                                        }
                                        else
                                        {
                                            <div class="sidebar-mini-thumb d-flex align-items-center justify-content-center text-info" style="background: rgba(0,200,255,0.1);">
                                                <i class="fa-solid fa-handshake"></i>
                                            </div>
                                        }
                                        <div class="flex-grow-1 overflow-hidden">
                                            <div class="text-truncate fw-bold text-white small">@item.Title</div>
                                            <div class="text-muted" style="font-size: 11px;">@(item.ConnectCategory?.CategoryName ?? "Kết nối")</div>
                                        </div>
                                        <i class="fa-solid fa-angle-right text-muted" style="font-size: 11px;"></i>
                                    </a>
                                }
                            </div>
                            <div class="d-flex gap-2 mt-2">
                                <button type="button" class="btn btn-sm btn-outline-info w-100 rounded-pill py-1" onclick="switchTimelineTab('connect', $('.nav-tab-item:contains(\'Kết nối\')')[0]); $('html, body').animate({ scrollTop: $('.timeline-nav-tabs').offset().top - 80 }, 300);" style="font-size: 11.5px;">
                                    <i class="fa-solid fa-eye me-1"></i>Xem tất cả (@myConnect.Count)
                                </button>
                                <a href="@Url.Action("Index", "Connect")" class="btn btn-sm btn-outline-secondary rounded-pill py-1 px-2" title="Đến Diễn đàn Kết nối" style="font-size: 11.5px; white-space: nowrap;">
                                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-2 text-muted small">
                                <p class="mb-2">Chưa có bài viết kết nối nào.</p>
                                <a href="@Url.Action("Create", "Connect")" class="btn btn-sm btn-outline-info rounded-pill px-3 py-1" style="font-size: 11.5px;">
                                    <i class="fa-solid fa-plus me-1"></i>Tạo bài kết nối ngay
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>


        <!-- ==========================================
             RIGHT COLUMN: BẢNG TIN BÀI VIẾT
             ========================================== -->
        <div class="profile-timeline-col">
            
            <!-- Private Account Lock Banner (nếu tài khoản riêng tư và không phải bạn bè/chủ tài khoản) -->
            @if (!canViewContent)
            {
                <div class="private-account-notice">
                    <div class="private-lock-icon">
                        <i class="fa-solid fa-lock"></i>
                    </div>
                    <h3 class="text-white fw-bold h5">Đây là tài khoản riêng tư</h3>
                    <p class="text-muted small max-w-sm mx-auto mb-4">
                        Hãy kết bạn với <b>@Model.Username</b> để xem toàn bộ bài viết, hình ảnh và hoạt động của họ trên nền tảng.
                    </p>
                    <button type="button" class="btn-social btn-social-primary" onclick="sendFriendAjax(@Model.UserID)">
                        <i class="fa-solid fa-user-plus"></i> Gửi lời mời kết bạn
                    </button>
                </div>
            }
            else
            {
                <!-- Quick Create Post Box (nếu là chủ tài khoản) -->
                if (isOwner)
                {
                    <div class="quick-create-card">
                        <div class="create-input-row">
                            <img src="@avatarSrc" class="create-user-avatar" alt="@Model.Username" />
                            <div class="create-fake-input" data-bs-toggle="modal" data-bs-target="#createPostModal">
                                @Model.Username ơi, bạn đang nghĩ gì thế?
                            </div>
                        </div>
                        <div class="create-options-row">
                            <button type="button" class="btn-create-opt text-success" data-bs-toggle="modal" data-bs-target="#createPostModal">
                                <i class="fa-solid fa-images fa-lg"></i>
                                <span>Ảnh / Video</span>
                            </button>
                            <button type="button" class="btn-create-opt text-warning" data-bs-toggle="modal" data-bs-target="#createStoryModal">
                                <i class="fa-solid fa-circle-play fa-lg"></i>
                                <span>Tạo tin 24h</span>
                            </button>
                            <a href="@Url.Action("Create", "Market")" class="btn-create-opt text-danger text-decoration-none" title="Đăng bán đồ trên Chợ">
                                <i class="fa-solid fa-store fa-lg"></i>
                                <span>Bán đồ Chợ</span>
                            </a>
                            <a href="@Url.Action("Create", "Connect")" class="btn-create-opt text-info text-decoration-none" title="Tạo bài kết nối sinh viên">
                                <i class="fa-solid fa-handshake fa-lg"></i>
                                <span>Tạo kết nối</span>
                            </a>
                        </div>
                    </div>
                }

                <!-- Timeline Nav Tabs -->
                <div class="timeline-nav-tabs mb-3">
                    <div class="nav-tab-item active" onclick="switchTimelineTab('posts', this)">
                        <i class="fa-solid fa-newspaper"></i>
                        <span>Bài viết (@Model.Posts.Count)</span>
                    </div>
                    <div class="nav-tab-item" onclick="switchTimelineTab('market', this)">
                        <i class="fa-solid fa-store"></i>
                        <span>Chợ sinh viên</span>
                        <span class="tab-badge">@myMarket.Count</span>
                    </div>
                    <div class="nav-tab-item" onclick="switchTimelineTab('connect', this)">
                        <i class="fa-solid fa-handshake"></i>
                        <span>Kết nối</span>
                        <span class="tab-badge">@myConnect.Count</span>
                    </div>
                </div>

                <!-- TAB 1: SOCIAL POSTS FEED -->
                <div id="tabContentPosts">
                    @if (Model.Posts != null && Model.Posts.Any())
                    {
                        foreach (var post in Model.Posts)
                        {
                            <div class="post-card social-post-card" data-post-id="@post.PostID" id="@(post.SharedPost != null ? "share-" + post.SharedPost.ShareID : "post-" + post.PostID)">
                                <!-- Post Header -->
                                <div class="post-header">
                                    <div class="post-author-group">
                                        <a href="@Url.Action("Profile", "User", new { id = post.UserID })">
                                            <img src="@post.AuthorAvatar" class="post-author-avatar" alt="@post.AuthorUsername" onerror="this.src='/Content/Images/default-avatar.png';" />
                                        </a>
                                        <div>
                                            <h4 class="post-author-name">
                                                <a href="@Url.Action("Profile", "User", new { id = post.UserID })" class="text-white text-decoration-none">
                                                    @post.AuthorUsername
                                                </a>
                                                @if (post.IsTDMUStudent)
                                                {
                                                    <i class="fa-solid fa-circle-check text-info" style="font-size: 11px;" title="Sinh viên TDMU"></i>
                                                }
                                            </h4>
                                            <div class="post-meta-line">
                                                <span>@post.TimeAgo</span>
                                                <span>·</span>
                                                <i class="@post.PrivacyIcon" title="@post.PrivacyLabel"></i>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-link text-muted" type="button" data-bs-toggle="dropdown" aria-label="Tùy chọn bài viết">
                                            <i class="fa-solid fa-ellipsis"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                                            @if (post.CanEdit)
                                            {
                                                <li><a class="dropdown-item" href="javascript:void(0)" data-content="@post.Content" data-privacy="@post.Privacy" onclick="editPostAjax(@post.PostID, this)"><i class="fa-solid fa-pen-to-square me-2"></i>Sửa bài viết</a></li>
                                            }
                                            @if (post.CanDelete)
                                            {
                                                <li><a class="dropdown-item text-danger" href="javascript:void(0)" onclick="@(post.SharedPost != null ? "deleteShareAjax(" + post.SharedPost.ShareID + ")" : "deletePostAjax(" + post.PostID + ")")"><i class="fa-solid fa-trash-can me-2"></i>@(post.SharedPost != null ? "Xóa bài chia sẻ" : "Xóa bài viết")</a></li>
                                            }
                                            else
                                            {
                                                <li><a class="dropdown-item" href="javascript:void(0)" onclick="sharePostAjax(@post.PostID)"><i class="fa-solid fa-share-nodes me-2"></i>Chia sẻ bài viết</a></li>
                                                <li><a class="dropdown-item" href="javascript:void(0)" onclick="hidePostAjax(@post.PostID)"><i class="fa-solid fa-eye-slash me-2"></i>Ẩn bài viết</a></li>
                                            }
                                        </ul>
                                    </div>
                                </div>

                                <!-- Post Content -->
                                @if (!string.IsNullOrEmpty(post.Content))
                                {
                                    <div class="post-body-content">
                                        @post.Content
                                    </div>
                                }
                                @if (post.SharedPost != null)
                                {
                                    @Html.Partial("~/Views/Shared/_SharedPostPreview.cshtml", post.SharedPost)
                                }

                                <!-- Post Media (Images / Video) -->
                                @if (post.MediaList != null && post.MediaList.Any())
                                {
                                    int count = Math.Min(post.MediaList.Count, 4);
                                    <div class="post-media-grid count-@count">
                                        @foreach (var media in post.MediaList)
                                        {
                                            <div class="post-media-item">
                                                @if (media.MediaType == "video")
                                                {
                                                    <video src="@media.MediaUrl" controls></video>
                                                }
                                                else
                                                {
                                                    <img src="@media.MediaUrl" alt="Media" onclick="window.open('@media.MediaUrl', '_blank');" />
                                                }
                                            </div>
                                        }
                                    </div>
                                }

                                <!-- Interaction Stats Bar -->
                                <div class="post-stats-bar">
                                    <div class="top-reactions-icons" id="topReactionsWrap-@post.PostID">
                                        @if (post.TopReactions != null && post.TopReactions.Any())
                                        {
                                            foreach (var r in post.TopReactions)
                                            {
                                                <span class="reaction-emoji-badge">@r.Emoji</span>
                                            }
                                        }
                                        <span class="ms-1" id="likeCount-@post.PostID">@(post.LikeCount > 0 ? post.LikeCount.ToString() : "")</span>
                                    </div>
                                    <div>
                                        <span id="commentCount-@post.PostID">@post.CommentCount bình luận</span>
                                    </div>
                                </div>

                                <!-- Action Buttons with Facebook-style Reaction Popover -->
                                <div class="post-actions-row">
                                    <div class="reaction-popup-container">
                                        <div class="reaction-popover">
                                            <button type="button" class="reaction-btn-icon" onclick="toggleReactionAjax(@post.PostID, 'Like')" title="Thích">👍</button>
                                            <button type="button" class="reaction-btn-icon" onclick="toggleReactionAjax(@post.PostID, 'Love')" title="Yêu thích">❤️</button>
                                            <button type="button" class="reaction-btn-icon" onclick="toggleReactionAjax(@post.PostID, 'Haha')" title="Haha">😆</button>
                                            <button type="button" class="reaction-btn-icon" onclick="toggleReactionAjax(@post.PostID, 'Wow')" title="Wow">😮</button>
                                            <button type="button" class="reaction-btn-icon" onclick="toggleReactionAjax(@post.PostID, 'Sad')" title="Buồn">😢</button>
                                            <button type="button" class="reaction-btn-icon" onclick="toggleReactionAjax(@post.PostID, 'Angry')" title="Phẫn nộ">😡</button>
                                        </div>
                                        <button type="button" class="btn-post-action @(!string.IsNullOrEmpty(post.CurrentUserReaction) ? "reacted" : "")" id="btnReaction-@post.PostID" onclick="toggleReactionAjax(@post.PostID, 'Like')">
                                            <span id="reactionIcon-@post.PostID">
                                                @if (post.CurrentUserReactionMeta != null)
                                                {
                                                    <span>@post.CurrentUserReactionMeta.Emoji</span>
                                                }
                                                else
                                                {
                                                    <i class="fa-regular fa-thumbs-up"></i>
                                                }
                                            </span>
                                            <span id="reactionLabel-@post.PostID" style="color: @(post.CurrentUserReactionMeta?.Color ?? "inherit")">
                                                @(post.CurrentUserReactionMeta?.Label ?? "Thích")
                                            </span>
                                        </button>
                                        <button type="button" class="reaction-picker-toggle" onclick="toggleReactionPicker(event, this)" aria-label="Chọn cảm xúc" title="Chọn cảm xúc"><i class="fa-solid fa-chevron-up"></i></button>
                                    </div>

                                    <button type="button" class="btn-post-action" onclick="$('#commentInput-@post.PostID').focus();">
                                        <i class="fa-regular fa-message"></i>
                                        <span>Bình luận</span>
                                    </button>
                                    <button type="button" class="btn-post-action" onclick="sharePostAjax(@post.PostID)">
                                        <i class="fa-solid fa-share-nodes"></i>
                                        <span>Chia sẻ</span>
                                    </button>
                                </div>

                                <!-- Comment Section -->
                                <div class="post-comments-box">
                                    <div class="comments-list" id="commentsList-@post.PostID">
                                        @if (post.Comments != null)
                                        {
                                            foreach (var c in post.Comments)
                                            {
                                                <div class="comment-item" id="comment-@c.CommentID">
                                                    <img src="@c.AuthorAvatar" class="comment-avatar" alt="@c.AuthorUsername" onerror="this.src='/Content/Images/default-avatar.png';" />
                                                    <div class="comment-bubble">
                                                        <div class="comment-author-name">@c.AuthorUsername</div>
                                                        <div class="comment-text">@c.Content</div>
                                                        <div class="comment-meta">
                                                            <span>@c.TimeAgo</span>
                                                            @if (c.CanDelete)
                                                            {
                                                                <a href="javascript:void(0)" class="comment-action-link text-danger" onclick="deleteCommentAjax(@c.CommentID)"><i class="fa-solid fa-trash-can"></i></a>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>

                                    <!-- Comment input -->
                                    <div class="comment-input-row">
                                        <input type="text" class="comment-input-field" id="commentInput-@post.PostID" placeholder="Viết bình luận..." onkeypress="if(event.key === 'Enter') submitCommentAjax(@post.PostID);" />
                                        <button type="button" class="btn-send-comment" onclick="submitCommentAjax(@post.PostID)" title="Gửi bình luận">
                                            <i class="fa-solid fa-paper-plane"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state-box">
                            <i class="fa-regular fa-newspaper fa-3x mb-3 text-muted"></i>
                            <h4 class="text-white h6">Chưa có bài viết nào</h4>
                            <p class="small mb-0">@(isOwner ? "Hãy chia sẻ khoảnh khắc đầu tiên của bạn!" : "Người dùng này chưa đăng bài viết nào.")</p>
                        </div>
                    }
                </div>

                <!-- TAB 2: CHỢ SINH VIÊN -->
                <div id="tabContentMarket" style="display:none;">
                    <div class="tab-section-header">
                        <div class="d-flex align-items-center gap-2">
                            <div class="p-2 rounded-circle" style="background: rgba(226, 75, 74, 0.15); color: var(--c-red);">
                                <i class="fa-solid fa-store fa-lg"></i>
                            </div>
                            <div>
                                <h5 class="text-white mb-0 fw-bold" style="font-size: 15px;">
                                    Gian hàng Chợ @(isOwner ? "của bạn" : $"của {Model.Username}")
                                </h5>
                                <span class="text-muted" style="font-size: 12px;">Đang có @myMarket.Count món đồ được đăng bán</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            @if (isOwner)
                            {
                                <a href="@Url.Action("Create", "Market")" class="btn btn-sm btn-danger fw-bold rounded-pill px-3">
                                    <i class="fa-solid fa-plus me-1"></i> Đăng bán đồ mới
                                </a>
                            }
                            <a href="@Url.Action("Index", "Market")" class="btn btn-sm btn-outline-info rounded-pill px-3">
                                <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Khám phá Chợ sinh viên
                            </a>
                        </div>
                    </div>

                    @if (myMarket.Any())
                    {
                        <div class="row row-cols-1 row-cols-md-2 g-3">
                            @foreach (var item in myMarket)
                            {
                                var img = item.MarketImages?.FirstOrDefault()?.ImageUrl ?? item.MainImage;
                                <div class="col">
                                    <div class="market-profile-card">
                                        <a href="@Url.Action("Details", "Market", new { id = item.PostID })" class="market-card-img-wrap d-block text-decoration-none" title="Xem chi tiết: @item.Title">
                                            <img src="@(!string.IsNullOrEmpty(img) ? img : "/Content/Images/default-market.jpg")" alt="@item.Title" onerror="this.src='/Content/Images/default-market.jpg';" />
                                            <span class="market-card-price-badge">@((item.Price ?? 0).ToString("N0"))đ</span>
                                            <span class="market-card-cat-badge">@(item.MarketCategory?.CategoryName ?? "Chợ")</span>
                                        </a>
                                        <div class="p-3 d-flex flex-column flex-grow-1 justify-content-between">
                                            <div>
                                                <h6 class="card-title fw-bold mb-1 text-truncate" title="@item.Title">
                                                    <a href="@Url.Action("Details", "Market", new { id = item.PostID })" class="text-white text-decoration-none">@item.Title</a>
                                                </h6>
                                                @if (!string.IsNullOrEmpty(item.ExchangeLocation))
                                                {
                                                    <div class="text-muted small text-truncate mb-1" style="font-size: 11.5px;">
                                                        <i class="fa-solid fa-location-dot text-danger me-1"></i>@item.ExchangeLocation
                                                    </div>
                                                }
                                                <div class="text-muted" style="font-size: 11px;">
                                                    <i class="fa-regular fa-clock me-1"></i>@(item.CreatedAt?.ToString("dd/MM/yyyy HH:mm"))
                                                    @if (!string.IsNullOrEmpty(item.Condition))
                                                    {
                                                        <span class="mx-1">·</span>
                                                        <span>@item.Condition</span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="pt-2 mt-2 border-top border-secondary d-flex gap-2">
                                                <a href="@Url.Action("Details", "Market", new { id = item.PostID })" class="btn btn-sm btn-info text-dark fw-bold flex-grow-1 rounded-pill">
                                                    <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Xem bài đăng
                                                </a>
                                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2" onclick="navigator.clipboard.writeText(window.location.origin + '@Url.Action("Details", "Market", new { id = item.PostID })'); Swal.fire({ toast: true, position: 'top', icon: 'success', title: 'Đã sao chép link bài đăng!', showConfirmButton: false, timer: 1500, background: '#111d30', color: '#fff' });" title="Sao chép liên kết">
                                                    <i class="fa-solid fa-share-nodes"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-state-box">
                            <i class="fa-solid fa-bag-shopping fa-3x mb-3 text-muted"></i>
                            <h4 class="text-white h6">Chưa có sản phẩm nào</h4>
                            <p class="small mb-3">@(isOwner ? "Bạn chưa đăng bán món đồ nào trên Chợ sinh viên TDMU." : $"{Model.Username} chưa đăng bán món đồ nào trên Chợ sinh viên.")</p>
                            @if (isOwner)
                            {
                                <a href="@Url.Action("Create", "Market")" class="btn btn-sm btn-danger fw-bold rounded-pill px-4">
                                    <i class="fa-solid fa-plus me-1"></i> Đăng món đồ đầu tiên
                                </a>
                            }
                        </div>
                    }
                </div>

                <!-- TAB 3: BÀI KẾT NỐI -->
                <div id="tabContentConnect" style="display:none;">
                    <div class="tab-section-header">
                        <div class="d-flex align-items-center gap-2">
                            <div class="p-2 rounded-circle" style="background: rgba(0, 200, 255, 0.15); color: var(--c-cyan);">
                                <i class="fa-solid fa-handshake fa-lg"></i>
                            </div>
                            <div>
                                <h5 class="text-white mb-0 fw-bold" style="font-size: 15px;">
                                    Các bài chia sẻ & Kết nối @(isOwner ? "của bạn" : $"của {Model.Username}")
                                </h5>
                                <span class="text-muted" style="font-size: 12px;">Đang có @myConnect.Count bài kết nối</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            @if (isOwner)
                            {
                                <a href="@Url.Action("Create", "Connect")" class="btn btn-sm btn-info text-dark fw-bold rounded-pill px-3">
                                    <i class="fa-solid fa-plus me-1"></i> Tạo bài kết nối mới
                                </a>
                            }
                            <a href="@Url.Action("Index", "Connect")" class="btn btn-sm btn-outline-light rounded-pill px-3">
                                <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Đến Diễn đàn Kết nối
                            </a>
                        </div>
                    </div>

                    @if (myConnect.Any())
                    {
                        <div class="row row-cols-1 g-3">
                            @foreach (var item in myConnect)
                            {
                                <div class="col">
                                    <div class="connect-profile-card">
                                        <div class="d-flex gap-3 align-items-start">
                                            <a href="@Url.Action("Details", "Connect", new { id = item.PostID })" class="d-block flex-shrink-0" title="Xem chi tiết: @item.Title">
                                                @if (!string.IsNullOrEmpty(item.MainImage))
                                                {
                                                    <img src="@item.MainImage" class="connect-card-img" alt="@item.Title" onerror="this.src='/Content/Images/default-avatar.png';" />
                                                }
                                                else
                                                {
                                                    <div class="connect-card-img d-flex align-items-center justify-content-center text-info fs-3" style="background: rgba(0,200,255,0.1);">
                                                        <i class="fa-solid fa-handshake"></i>
                                                    </div>
                                                }
                                            </a>
                                            <div class="flex-grow-1 overflow-hidden">
                                                <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
                                                    <span class="badge" style="background: rgba(0,200,255,0.15); color: var(--c-cyan); font-size: 11px;">
                                                        <i class="fa-solid fa-tag me-1"></i>@(item.ConnectCategory?.CategoryName ?? "Kết nối")
                                                    </span>
                                                    <span class="text-muted" style="font-size: 11px;">
                                                        <i class="fa-regular fa-clock me-1"></i>@(item.CreatedAt?.ToString("dd/MM/yyyy HH:mm"))
                                                    </span>
                                                </div>
                                                <h6 class="mb-1 fw-bold">
                                                    <a href="@Url.Action("Details", "Connect", new { id = item.PostID })" class="text-white text-decoration-none">@item.Title</a>
                                                </h6>
                                                @if (!string.IsNullOrEmpty(item.Description))
                                                {
                                                    var desc = item.Description.Length > 150 ? item.Description.Substring(0, 150) + "..." : item.Description;
                                                    <p class="text-muted small mb-2 text-truncate-2" style="font-size: 12.5px; line-height: 1.4;">
                                                        @desc
                                                    </p>
                                                }
                                                <div class="d-flex align-items-center gap-2 mt-2">
                                                    <a href="@Url.Action("Details", "Connect", new { id = item.PostID })" class="btn btn-sm btn-outline-info rounded-pill px-3 py-1 fw-bold" style="font-size: 12px;">
                                                        <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Xem chi tiết bài viết
                                                    </a>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1" onclick="navigator.clipboard.writeText(window.location.origin + '@Url.Action("Details", "Connect", new { id = item.PostID })'); Swal.fire({ toast: true, position: 'top', icon: 'success', title: 'Đã sao chép link bài viết!', showConfirmButton: false, timer: 1500, background: '#111d30', color: '#fff' });" title="Sao chép liên kết">
                                                        <i class="fa-solid fa-share-nodes"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-state-box">
                            <i class="fa-solid fa-handshake fa-3x mb-3 text-muted"></i>
                            <h4 class="text-white h6">Chưa có bài chia sẻ nào</h4>
                            <p class="small mb-3">@(isOwner ? "Bạn chưa đăng bài kết nối học tập hay cộng đồng nào." : $"{Model.Username} chưa đăng bài kết nối nào.")</p>
                            @if (isOwner)
                            {
                                <a href="@Url.Action("Create", "Connect")" class="btn btn-sm btn-info text-dark fw-bold rounded-pill px-4">
                                    <i class="fa-solid fa-plus me-1"></i> Đăng bài kết nối đầu tiên
                                </a>
                            }
                        </div>
                    }
                </div>
            }

        </div>
    </div>
</div>




@section scripts {
    <script>
        // Switch between Timeline Tabs
        function switchTimelineTab(tabName, element) {
            $('.nav-tab-item').removeClass('active');
            if (element) {
                $(element).addClass('active');
            } else {
                if (tabName === 'posts') $('.nav-tab-item:eq(0)').addClass('active');
                if (tabName === 'market') $('.nav-tab-item:eq(1)').addClass('active');
                if (tabName === 'connect') $('.nav-tab-item:eq(2)').addClass('active');
            }

            $('#tabContentPosts').hide();
            $('#tabContentMarket').hide();
            $('#tabContentConnect').hide();

            if (tabName === 'posts') $('#tabContentPosts').show();
            if (tabName === 'market') $('#tabContentMarket').show();
            if (tabName === 'connect') $('#tabContentConnect').show();

            if (history.replaceState) {
                history.replaceState(null, null, '#' + tabName);
            }
        }

        // Auto activate tab from URL hash on load
        $(document).ready(function() {
            var h = window.location.hash;
            if (h === '#market') {
                switchTimelineTab('market');
            } else if (h === '#connect') {
                switchTimelineTab('connect');
            }
        });

        // ==========================================
        // DIRECT MESSAGE
        // ==========================================
        function startDirectMessage(targetId) {
            $.post('/Chat/CreatePrivateRoom', { targetId: targetId }, function(res) {
                if (res.success && res.roomId) {
                    window.location.href = '/Chat/Private/' + res.roomId;
                } else {
                    Swal.fire({ icon: 'error', title: 'Lỗi', text: res.message || 'Không thể tạo cuộc trò chuyện.' });
                }
            }).fail(function() {
                Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Lỗi kết nối, vui lòng thử lại.' });
            });
        }

        // ==========================================
        // FRIENDSHIP AJAX
        // ==========================================
        var _pendingFriendTargetId = @(isOwner ? 0 : Model.UserID);

        function sendFriendAjax(targetId) {
            if (targetId) {
                _pendingFriendTargetId = targetId;
            }
            var modalEl = document.getElementById('friendRequestModal');
            if (modalEl) {
                var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                $('#friendRequestMessage').val('');
                $('#friendMsgCount').text('0');
                modal.show();
            }
        }

        function submitFriendRequest() {
            var targetId = _pendingFriendTargetId || @(isOwner ? 0 : Model.UserID);
            var message = $('#friendRequestMessage').val().trim();
            var $btn = $('#btnSubmitFriendRequest');
            $btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Đang gửi...');

            $.post('/User/SendFriendRequest', { targetId: targetId, message: message }, function(res) {
                if (res.success) {
                    var modalEl = document.getElementById('friendRequestModal');
                    if (modalEl) {
                        var modal = bootstrap.Modal.getInstance(modalEl);
                        if (modal) modal.hide();
                    }
                    $('#friendRequestMessage').val('');
                    $('#friendMsgCount').text('0');
                    $('#friendshipActionWrap').html(`
                        <div class="dropdown">
                            <button class="btn-social btn-social-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                <i class="fa-solid fa-clock text-warning"></i> Đã gửi lời mời
                            </button>
                            <ul class="dropdown-menu dropdown-menu-dark">
                                <li><a class="dropdown-item text-danger" href="javascript:void(0)" onclick="declineFriendAjax(null, ${targetId})"><i class="fa-solid fa-xmark me-2"></i>Hủy lời mời</a></li>
                            </ul>
                        </div>
                    `);
                    Swal.fire({
                        icon: 'success',
                        title: 'Đã gửi!',
                        text: 'Lời mời kết bạn đã được gửi thành công.',
                        timer: 2000,
                        showConfirmButton: false,
                        background: '#111d30',
                        color: '#fff'
                    });
                } else {
                    Swal.fire({ icon: 'warning', title: 'Thông báo', text: res.message, background: '#111d30', color: '#fff' });
                }
            }).fail(function() {
                Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Lỗi kết nối, vui lòng thử lại.', background: '#111d30', color: '#fff' });
            }).always(function() {
                $btn.prop('disabled', false).html('<i class="fa-solid fa-paper-plane me-1"></i> Gửi lời mời');
            });
        }

        // Character counter for friend request message
        $('#friendRequestMessage').on('input', function() {
            $('#friendMsgCount').text(this.value.length);
        });
        function acceptFriendAjax(friendshipId, targetId) {
            $.post('/User/AcceptFriendRequest', { friendshipId: friendshipId, targetId: targetId }, function(res) {
                if (res.success) {
                    location.reload();
                } else {
                    Swal.fire({ icon: 'warning', title: 'Thông báo', text: res.message, background: '#111d30', color: '#fff' });
                }
            });
        }

        function declineFriendAjax(friendshipId, targetId) {
            $.post('/User/DeclineFriendRequest', { friendshipId: friendshipId, targetId: targetId }, function(res) {
                if (res.success) {
                    $('#friendshipActionWrap').html(`
                        <button type="button" class="btn-social btn-social-primary" onclick="sendFriendAjax(${targetId})">
                            <i class="fa-solid fa-user-plus"></i> Thêm bạn bè
                        </button>
                    `);
                } else {
                    Swal.fire({ icon: 'warning', title: 'Thông báo', text: res.message, background: '#111d30', color: '#fff' });
                }
            });
        }

        function unfriendAjax(targetId) {
            Swal.fire({
                title: 'Hủy kết bạn?',
                text: 'Bạn có chắc chắn muốn hủy kết bạn với @(Model.Username)?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e74c3c',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="fa-solid fa-user-xmark me-1"></i> Hủy kết bạn',
                cancelButtonText: 'Không',
                background: '#111d30',
                color: '#fff'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/User/Unfriend', { targetId: targetId }, function(res) {
                        if (res.success) {
                            location.reload();
                        } else {
                            Swal.fire({ icon: 'error', title: 'Lỗi', text: res.message, background: '#111d30', color: '#fff' });
                        }
                    });
                }
            });
        }

        // ==========================================
        // FOLLOW AJAX
        // ==========================================
        function toggleFollowAjax(targetId) {
            $.post('/User/ToggleFollow', { targetId: targetId }, function(res) {
                if (res.success) {
                    $('#followerCountDisplay').text(res.followerCount);
                    if (res.isFollowing) {
                        $('#btnFollow').html('<i class="fa-solid fa-bell-slash text-warning"></i> <span id="followBtnText">Đang theo dõi</span>');
                    } else {
