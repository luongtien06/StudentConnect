        function loadArchiveStories() {
            var $grid = $('#archiveStoriesGrid');
            $grid.html('<div class="text-center text-muted py-5 w-100 col-12"><span class="spinner-border spinner-border-sm me-2"></span> Đang tải kho lưu trữ...</div>');
            _archiveSelectedForHl = [];
            $('#archiveSelectedBadge').text('0');

            fetch('/Story/GetArchive')
                .then(res => res.json())
                .then(data => {
                    if (!data.success || !data.stories || data.stories.length === 0) {
                        $grid.html('<div class="text-center text-white-50 py-5 small w-100 col-12"><i class="fa-solid fa-box-open d-block mb-3 fs-3 text-secondary"></i>Bạn chưa có tin nào trong kho lưu trữ.</div>');
                        $('#archiveAllCount').text('0');
                        return;
                    }

                    _archiveStoriesCache = data.stories;
                    $('#archiveAllCount').text(data.stories.length);
                    renderArchiveGrid(data.stories);
                })
                .catch(() => {
                    $grid.html('<div class="text-center text-danger py-4 small w-100 col-12">Không thể tải kho lưu trữ. Vui lòng thử lại sau!</div>');
                });
        }

        function renderArchiveGrid(stories) {
            var $grid = $('#archiveStoriesGrid');
            var html = '';

            stories.forEach(s => {
                var statusBadge = s.isExpired
                    ? '<span class="archive-card-badge bg-secondary text-white">Đã lưu trữ</span>'
                    : '<span class="archive-card-badge bg-success text-white">Còn hạn</span>';

                var isSelected = _archiveSelectedForHl.includes(s.storyId);
                var selCls = isSelected ? 'selected' : '';

                var mediaHtml = s.mediaType === 'video'
                    ? `<video src="${s.mediaUrl}" class="archive-card-media" muted></video>`
                    : `<img src="${s.mediaUrl}" class="archive-card-media" alt="Story" />`;

                html += `
                    <div class="archive-card ${selCls}" id="archCard_${s.storyId}" data-expired="${s.isExpired}" onclick="watchArchiveStory(${s.storyId})">
                        ${mediaHtml}
                        <div class="archive-card-overlay">
                            <div class="archive-card-header">
                                ${statusBadge}
                                <input type="checkbox" class="archive-card-checkbox" title="Chọn đưa vào tin nổi bật" 
                                       onclick="event.stopPropagation(); toggleArchiveSelect(${s.storyId}, this);" ${isSelected ? 'checked' : ''} />
                            </div>
                            <div class="archive-card-footer">
                                <div class="archive-card-date">${s.createdAt}</div>
                                <div class="archive-card-views">
                                    <i class="fa-solid fa-eye"></i> ${s.viewCount} người xem
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });

            $grid.html(html);
        }

        function filterArchive(type) {
            $('#btnFilterAllStories, #btnFilterActiveStories, #btnFilterExpiredStories').removeClass('active');
            if (type === 'all') $('#btnFilterAllStories').addClass('active');
            if (type === 'active') $('#btnFilterActiveStories').addClass('active');
            if (type === 'expired') $('#btnFilterExpiredStories').addClass('active');

            if (!_archiveStoriesCache) return;

            var filtered = _archiveStoriesCache.filter(s => {
                if (type === 'active') return !s.isExpired;
                if (type === 'expired') return s.isExpired;
                return true;
            });

            renderArchiveGrid(filtered);
        }

        function toggleArchiveSelect(storyId, cbEl) {
            var idx = _archiveSelectedForHl.indexOf(storyId);
            if (cbEl.checked) {
                if (idx === -1) _archiveSelectedForHl.push(storyId);
                $('#archCard_' + storyId).addClass('selected');
            } else {
                if (idx > -1) _archiveSelectedForHl.splice(idx, 1);
                $('#archCard_' + storyId).removeClass('selected');
            }
            $('#archiveSelectedBadge').text(_archiveSelectedForHl.length);
        }

        function createHighlightFromArchive() {
            if (!_archiveSelectedForHl || _archiveSelectedForHl.length === 0) {
                Swal.fire({ icon: 'info', title: 'Chọn tin', text: 'Vui lòng tích chọn ít nhất 1 tin bằng ô vuông góc trên mỗi tin!', background: '#111d30', color: '#fff' });
                return;
            }

            var archiveModal = bootstrap.Modal.getInstance(document.getElementById('storyArchiveModal'));
            if (archiveModal) archiveModal.hide();

            setTimeout(() => {
                openCreateHighlightModal(_archiveSelectedForHl);
            }, 300);
        }

        function watchArchiveStory(storyId) {
            var archiveModal = bootstrap.Modal.getInstance(document.getElementById('storyArchiveModal'));
            if (archiveModal) archiveModal.hide();

            loadUserStories(@Model.UserID, 0);
        }
    </script>
}

@section Modals {
    @Html.Partial("~/Views/Story/_StoryModalsPartial.cshtml")

    @if (isOwner)
    {
        <!-- MODAL 1: CHỈNH SỬA TRANG CÁ NHÂN -->
        <div class="modal fade" id="editProfileModal" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content bg-dark text-white border-secondary">
                    <div class="modal-header border-secondary">
                        <h5 class="modal-title"><i class="fa-solid fa-user-pen text-info me-2"></i>Chỉnh sửa trang cá nhân</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="editProfileForm" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="isProfileFormSubmit" value="true" />
                            
                            <!-- Bio -->
                            <div class="mb-3">
                                <label class="form-label fw-bold small text-info">Tiểu sử</label>
                                <textarea class="form-control bg-black text-white border-secondary" name="Bio" id="inputBio" rows="3" placeholder="Mô tả ngắn gọn về bạn...">@Model.Bio</textarea>
                            </div>

                            <div class="row g-3 mb-3">
                                <!-- Khoa -->
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-info">Khoa / Viện</label>
                                    <input type="text" class="form-control bg-black text-white border-secondary" name="Faculty" id="inputFaculty" value="@Model.Faculty" placeholder="VD: Khoa Công nghệ Thông tin" />
                                </div>
                                <!-- Ngành -->
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-info">Chuyên ngành</label>
                                    <input type="text" class="form-control bg-black text-white border-secondary" name="Major" id="inputMajor" value="@Model.Major" placeholder="VD: Kỹ thuật Phần mềm" />
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <!-- Năm học -->
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-info">Năm học</label>
                                    <select class="form-select bg-black text-white border-secondary" name="StudentYear" id="inputStudentYear">
                                        <option value="">-- Chọn năm học --</option>
                                        <option value="1" @(Model.StudentYear == 1 ? "selected" : "")>Năm 1 (Tân sinh viên)</option>
                                        <option value="2" @(Model.StudentYear == 2 ? "selected" : "")>Năm 2</option>
                                        <option value="3" @(Model.StudentYear == 3 ? "selected" : "")>Năm 3</option>
                                        <option value="4" @(Model.StudentYear == 4 ? "selected" : "")>Năm 4 (Tốt nghiệp)</option>
                                    </select>
                                </div>
                                <!-- Quê quán -->
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-info">Quê quán</label>
                                    <input type="text" class="form-control bg-black text-white border-secondary" name="Hometown" id="inputHometown" value="@Model.Hometown" placeholder="VD: Bình Dương" />
                                </div>
                            </div>

                            <!-- Quyền riêng tư Toggle -->
                            <div class="form-check form-switch p-3 rounded bg-black border border-secondary mb-3">
                                <input class="form-check-input ms-0 me-3" type="checkbox" role="switch" id="inputIsPrivate" name="IsPrivate" value="true" @(Model.IsPrivate ? "checked" : "")>
                                <label class="form-check-label fw-bold" for="inputIsPrivate">
                                    <span>Tài khoản riêng tư</span>
                                    <span class="d-block text-muted small fw-normal">Khi bật, chỉ những người đã là bạn bè mới có thể xem các bài viết trên dòng thời gian của bạn.</span>
                                </label>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer border-secondary">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="button" class="btn btn-info text-dark fw-bold px-4" onclick="saveProfileChanges();">
                            <i class="fa-solid fa-floppy-disk me-1"></i> Lưu thay đổi
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- MODAL 2: TẠO BÀI VIẾT MỚI -->
        <div class="modal fade" id="createPostModal" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content bg-dark text-white border-secondary">
                    <div class="modal-header border-secondary">
                        <h5 class="modal-title"><i class="fa-solid fa-pen-to-square text-info me-2"></i>Tạo bài viết</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <img src="@avatarSrc" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" alt="@Model.Username" />
                            <div>
                                <div class="fw-bold small">@Model.Username</div>
                                <select class="form-select form-select-sm bg-black text-white border-secondary py-0 px-2" id="createPostPrivacy" style="width: auto; font-size: 11px;">
                                    <option value="Public">🌐 Công khai</option>
                                    <option value="Friends">👥 Bạn bè</option>
                                    <option value="OnlyMe">🔒 Chỉ mình tôi</option>
                                </select>
                            </div>
                        </div>

                        <textarea class="form-control bg-black text-white border-secondary mb-3" id="createPostContent" rows="4" placeholder="@Model.Username ơi, bạn đang nghĩ gì thế?"></textarea>

                        <div class="p-3 border border-secondary rounded mb-2 d-flex align-items-center justify-content-between">
                            <span class="small text-muted">Thêm vào bài viết:</span>
                            <button type="button" class="btn btn-sm btn-outline-success" onclick="$('#postFileInput').click();">
                                <i class="fa-solid fa-image me-1"></i> Ảnh / Video
                            </button>
                            <input type="file" id="postFileInput" multiple accept="image/*,video/*" style="display:none;" />
                        </div>

                        <div id="postFilePreviewWrap" class="d-flex gap-2 flex-wrap mb-2"></div>
                    </div>
                    <div class="modal-footer border-secondary">
                        <button type="button" class="btn btn-info text-dark fw-bold w-100" id="btnSubmitPost" onclick="submitNewPost();">
                            Đăng bài
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- MODAL 4: TẠO TIN NỔI BẬT (CREATE HIGHLIGHT) -->
        <div class="modal fade" id="createHighlightModal" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0" style="background: linear-gradient(145deg, #0d1626, #111d30); border-radius: 18px;">
                    <div class="modal-header border-secondary">
                        <h5 class="modal-title text-white fs-6">
                            <i class="fa-solid fa-star text-warning me-2"></i>Tạo tin nổi bật mới
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label text-white-50 small fw-bold">Tiêu đề tin nổi bật</label>
                            <input type="text" id="hlTitleInput" class="form-control bg-black text-white border-secondary" placeholder="VD: Kỷ niệm, Du lịch, TDMU..." maxlength="40" />
                        </div>

                        <div class="mb-3">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <label class="form-label text-white-50 small fw-bold m-0">Chọn các tin đưa vào mục nổi bật (<span id="hlSelectedCount">0</span> đã chọn)</label>
                                <span class="text-muted" style="font-size: 11px;">Nhấn vào để chọn/bỏ chọn</span>
                            </div>
                            <div class="highlight-picker-grid" id="hlPickerGrid">
                                <div class="text-center text-muted py-4 w-100 col-12">
                                    <span class="spinner-border spinner-border-sm me-2"></span> Đang tải kho tin của bạn...
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-secondary">
                        <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                        <button type="button" class="btn btn-info text-dark fw-bold rounded-pill px-4" id="btnSaveHighlight" onclick="submitCreateHighlight()">
                            <i class="fa-solid fa-check me-1"></i> Lưu tin nổi bật
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- MODAL 5: KHO LƯU TRỮ TIN (STORY ARCHIVE) -->
        <div class="modal fade" id="storyArchiveModal" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content border-0" style="background: linear-gradient(145deg, #0d1626, #111d30); border-radius: 20px;">
                    <div class="modal-header border-secondary">
                        <div>
                            <h5 class="modal-title text-white fs-6 mb-1">
                                <i class="fa-solid fa-box-archive text-warning me-2"></i>Kho lưu trữ tin 24h
                            </h5>
                            <span class="text-muted" style="font-size: 11.5px;">Chỉ bạn mới có thể xem các tin trong kho lưu trữ của mình.</span>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-outline-info active" id="btnFilterAllStories" onclick="filterArchive('all')">Tất cả (<span id="archiveAllCount">0</span>)</button>
                                <button type="button" class="btn btn-outline-info" id="btnFilterActiveStories" onclick="filterArchive('active')">Còn hạn</button>
                                <button type="button" class="btn btn-outline-info" id="btnFilterExpiredStories" onclick="filterArchive('expired')">Đã hết hạn</button>
                            </div>

                            <button type="button" class="btn btn-sm btn-info text-dark fw-bold rounded-pill px-3" onclick="createHighlightFromArchive()">
                                <i class="fa-solid fa-star me-1"></i> Tạo tin nổi bật từ tin đã chọn (<span id="archiveSelectedBadge">0</span>)
                            </button>
                        </div>

                        <div class="archive-grid" id="archiveStoriesGrid">
                            <div class="text-center text-muted py-5 w-100 col-12">
                                <span class="spinner-border spinner-border-sm me-2"></span> Đang tải kho lưu trữ...
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-secondary">
                        <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (!isOwner)
    {
        <!-- MODAL 3: GỬI LỜI MỜI KẾT BẠN -->
        <div class="modal fade" id="friendRequestModal" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content border-0" style="background: linear-gradient(145deg, #0d1626 0%, #111d30 50%, #16243d 100%); border-radius: 20px; overflow: hidden;">
                    <!-- Header Decorative -->
                    <div style="position: relative; height: 80px; background: linear-gradient(135deg, var(--c-cyan) 0%, var(--c-purple) 100%); overflow: hidden;">
                        <div style="position: absolute; inset: 0; background: url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22%3E%3Ccircle cx=%2220%22 cy=%2250%22 r=%2230%22 fill=%22rgba(255,255,255,0.08)%22/%3E%3Ccircle cx=%2280%22 cy=%2230%22 r=%2240%22 fill=%22rgba(255,255,255,0.05)%22/%3E%3C/svg%3E');"></div>
                        <button type="button" class="btn-close btn-close-white position-absolute" style="top: 12px; right: 12px; opacity: 0.8;" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body text-center px-4 pb-4" style="margin-top: -45px;">
                        <!-- Avatar -->
                        <div style="width: 90px; height: 90px; margin: 0 auto 12px; border-radius: 50%; border: 4px solid #111d30; overflow: hidden; box-shadow: 0 4px 20px rgba(0,200,255,0.2);">
                            <img src="@avatarSrc" alt="@Model.Username" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/Content/Images/default-avatar.png';" />
                        </div>

                        <!-- Name & Info -->
                        <h5 class="text-white fw-bold mb-1" style="font-size: 17px;">@Model.DisplayName</h5>
                        <p class="text-muted mb-3" style="font-size: 12px;">
                            <i class="fa-solid fa-at me-1"></i>@Model.Username
                            @if (!string.IsNullOrEmpty(Model.Faculty))
                            {
                                <span class="mx-1">·</span>
                                <i class="fa-solid fa-graduation-cap me-1"></i>@Model.Faculty
                            }
                        </p>

                        <!-- Mutual Friends hint -->
                        @if (Model.MutualFriendCount > 0)
                        {
                            <div class="d-flex align-items-center justify-content-center gap-2 mb-3 py-2 px-3 rounded-pill mx-auto" style="background: rgba(0,200,255,0.08); border: 1px solid rgba(0,200,255,0.15); width: fit-content;">
                                <i class="fa-solid fa-user-group text-info" style="font-size: 11px;"></i>
                                <span class="text-info" style="font-size: 12px;">@Model.MutualFriendCount bạn chung</span>
                            </div>
                        }

                        <!-- Divider -->
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <hr class="flex-grow-1 border-secondary m-0" />
                            <span class="text-muted" style="font-size: 11px; white-space: nowrap;">Viết lời nhắn (tùy chọn)</span>
                            <hr class="flex-grow-1 border-secondary m-0" />
                        </div>

                        <!-- Message Input -->
                        <div class="position-relative mb-3">
                            <textarea id="friendRequestMessage" class="form-control border-secondary text-white" maxlength="200" rows="3"
                                      placeholder="Xin chào, mình là sinh viên TDMU. Kết bạn nhé! 👋"
                                      style="background: rgba(255,255,255,0.04); border-radius: 14px; resize: none; font-size: 13px; padding: 12px 14px;"></textarea>
                            <small class="position-absolute text-muted" style="bottom: 8px; right: 12px; font-size: 10px;">
                                <span id="friendMsgCount">0</span>/200
                            </small>
                        </div>

                        <!-- Submit Button -->
                        <button type="button" class="btn w-100 fw-bold py-2" id="btnSubmitFriendRequest" onclick="submitFriendRequest();"
                                style="background: linear-gradient(135deg, var(--c-cyan), var(--c-purple)); color: #fff; border: none; border-radius: 12px; font-size: 14px; letter-spacing: 0.3px; transition: all 0.3s ease;">
                            <i class="fa-solid fa-paper-plane me-1"></i> Gửi lời mời
                        </button>
                        <p class="text-muted mt-2 mb-0" style="font-size: 10px;">
                            <i class="fa-solid fa-shield-halved me-1"></i>Lời mời sẽ được gửi kèm thông báo đến @Model.Username
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
}
