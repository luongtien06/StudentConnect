@model StudentConnect.Models.User
@using System.Linq
@{
    ViewBag.Title = "Hồ sơ cá nhân";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var joinDate = Model.CreatedAt.HasValue ? Model.CreatedAt.Value.ToString("dd/MM/yyyy") : "N/A";
    var avatarSrc = string.IsNullOrEmpty(Model.Avatar)
        ? "https://ui-avatars.com/api/?name=" + Uri.EscapeDataString(Model.Username ?? "U") + "&background=0d1626&color=00c8ff&size=200"
        : Model.Avatar;
    var myMarket = (Model.MarketPosts ?? Enumerable.Empty<StudentConnect.Models.MarketPost>())
        .OrderByDescending(p => p.CreatedAt).ToList();
    var myConnect = (Model.ConnectPosts ?? Enumerable.Empty<StudentConnect.Models.ConnectPost>())
        .OrderByDescending(p => p.CreatedAt).ToList();
    var emailPattern = ".+@student\\.tdmu\\.edu\\.vn";
    var emailHint = "@student.tdmu.edu.vn";
}

<style>
    :root {
        --c-surface: #0d1626; --c-surface2: #111d30;
        --c-border: #1a2540; --c-border2: #232840;
        --c-cyan: #00c8ff; --c-purple: #7b61ff;
        --c-green: #00c850; --c-red: #e24b4a;
        --c-amber: #ef9f27; --c-text: rgba(255,255,255,0.9);
        --c-muted: #8b94a5; --c-hint: #4a5568;
        --radius: 14px; --tr: 0.2s ease;
    }

    .profile-page { max-width: 1080px; margin: 0 auto; padding: 0 0 2.5rem; }

    .dk-toast { display: flex; align-items: center; border-radius: 10px; padding: 10px 14px; gap: 9px; font-size: 13px; }
    .dk-toast-success { background: rgba(0,200,80,0.1); border: 1px solid rgba(0,200,80,0.25); color: var(--c-green); }
    .dk-toast-error { background: rgba(226,75,74,0.1); border: 1px solid rgba(226,75,74,0.25); color: var(--c-red); }
    .dk-toast .btn-close { filter: invert(1) brightness(.7); }

    .profile-top {
        display: grid;
        grid-template-columns: minmax(260px, 320px) 1fr;
        gap: 14px;
        margin-bottom: 14px;
    }

    .identity-card, .form-card, .list-card {
        background: var(--c-surface);
        border: 1px solid var(--c-border2);
        border-radius: var(--radius);
        overflow: hidden;
    }

    .identity-card { padding: 16px; }
    .identity-row { display: flex; gap: 12px; align-items: center; }
    .avatar-wrap { position: relative; flex-shrink: 0; }
    .avatar-img {
        width: 68px; height: 68px; border-radius: 16px; object-fit: cover;
        border: 2px solid var(--c-border2); display: block;
    }
    .avatar-cam {
        position: absolute; bottom: -4px; right: -4px;
        width: 22px; height: 22px; border-radius: 7px;
        background: var(--c-cyan); border: 2px solid var(--c-surface);
        display: flex; align-items: center; justify-content: center;
        color: #000; font-size: 10px; cursor: pointer;
    }
    .avatar-name { font-size: 1rem; font-weight: 700; color: var(--c-text); margin: 0 0 2px; }
    .avatar-email { font-size: 12px; color: var(--c-hint); margin-bottom: 8px; word-break: break-all; }
    .avatar-badges { display: flex; gap: 6px; flex-wrap: wrap; }
    .dk-badge {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 2px 8px; border-radius: 20px; font-size: 10px; font-weight: 500;
    }
    .badge-tdmu { background: rgba(0,200,255,0.1); color: var(--c-cyan); border: 1px solid rgba(0,200,255,0.25); }
    .badge-guest { background: var(--c-surface2); color: var(--c-muted); border: 1px solid var(--c-border2); }
    .badge-admin { background: rgba(226,75,74,0.1); color: var(--c-red); border: 1px solid rgba(226,75,74,0.2); }
    .badge-user { background: rgba(123,97,255,0.1); color: var(--c-purple); border: 1px solid rgba(123,97,255,0.2); }

    .meta-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
    .meta-chip {
        font-size: 11px; color: var(--c-muted);
        background: var(--c-surface2); border: 1px solid var(--c-border);
        border-radius: 8px; padding: 5px 8px;
    }
    .meta-chip b { color: var(--c-text); font-weight: 600; }

    #avatarPreviewBanner {
        display: none; margin-top: 8px; background: rgba(0,200,255,0.07);
        border: 1px solid rgba(0,200,255,0.2); border-radius: 8px; padding: 6px 10px;
        font-size: 11px; color: var(--c-cyan); align-items: center; gap: 8px;
    }
    #avatarPreviewBanner.show { display: flex; }
    .banner-dismiss { background: none; border: none; color: inherit; cursor: pointer; margin-left: auto; }

    .section-head {
        background: var(--c-surface2); border-bottom: 1px solid var(--c-border);
        padding: 9px 14px; display: flex; align-items: center; justify-content: space-between; gap: 8px;
    }
    .section-head span { font-size: 12px; font-weight: 600; color: var(--c-text); }
    .section-head i { color: var(--c-cyan); }
    .section-count { font-size: 10px; color: var(--c-hint); font-family: 'JetBrains Mono', monospace; }
    .section-body { padding: 14px; }

    .form-row { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; }
    .form-group { display: flex; flex-direction: column; gap: 4px; }
    .form-label { font-size: 10px; color: var(--c-hint); font-weight: 600; text-transform: uppercase; letter-spacing: .06em; }
    .form-label .req { color: var(--c-red); }
    .form-control {
        background: var(--c-surface2) !important; border: 1px solid var(--c-border) !important;
        border-radius: 9px !important; color: var(--c-text) !important;
        font-size: 13px !important; padding: 8px 11px !important;
    }
    .form-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 12px; }
    .btn-save {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 8px 16px; border-radius: 50px; background: var(--c-cyan); border: none;
        color: #000; font-size: 13px; font-weight: 700; cursor: pointer;
    }
    .btn-cancel {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 8px 14px; border-radius: 50px; background: none;
        border: 1px solid var(--c-border2); color: var(--c-muted); font-size: 13px; text-decoration: none;
    }
    .error-feedback {
        color: #ff4d4d; font-size: 11px; margin-top: 6px; padding: 6px 10px;
        background: rgba(255, 77, 77, 0.1); border-radius: 8px; border-left: 3px solid #ff4d4d;
    }

    .content-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .mini-list { display: flex; flex-direction: column; gap: 8px; }
    .mini-item {
        display: grid; grid-template-columns: 56px 1fr auto; gap: 10px; align-items: center;
        padding: 8px; border-radius: 10px; text-decoration: none !important;
        background: var(--c-surface2); border: 1px solid var(--c-border);
        transition: border-color var(--tr);
    }
    .mini-item:hover { border-color: rgba(0,200,255,0.3); }
    .mini-thumb {
        width: 56px; height: 56px; border-radius: 8px; overflow: hidden;
        background: rgba(255,255,255,0.04);
        display: flex; align-items: center; justify-content: center; font-size: 20px;
    }
    .mini-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .mini-title { font-size: 13px; font-weight: 600; color: #fff; line-height: 1.3;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .mini-sub { font-size: 11px; color: var(--c-hint); margin-top: 2px; }
    .mini-price { font-size: 12px; font-weight: 700; color: var(--c-amber); white-space: nowrap; }
    .empty-mini { font-size: 12px; color: var(--c-hint); text-align: center; padding: 18px 8px; }
    .list-link { font-size: 11px; color: var(--c-cyan); text-decoration: none; }

    @@media (max-width: 900px) {
        .profile-top, .content-grid, .form-row { grid-template-columns: 1fr; }
        .mini-item { grid-template-columns: 48px 1fr; }
        .mini-price { grid-column: 2; }
    }
</style>

@if (TempData["Success"] != null)
{
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:9999">
        <div class="toast show border-0 dk-toast dk-toast-success" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <div class="flex-grow-1">@TempData["Success"]</div>
            <button type="button" class="btn-close ms-2" data-bs-dismiss="toast"></button>
        </div>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:9999">
        <div class="toast show border-0 dk-toast dk-toast-error" role="alert">
            <i class="bi bi-x-circle-fill"></i>
            <div class="flex-grow-1">@TempData["Error"]</div>
            <button type="button" class="btn-close ms-2" data-bs-dismiss="toast"></button>
        </div>
    </div>
}

<div class="profile-page">
    <form action="@Url.Action("UpdateProfile","User")" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" name="UserID" value="@Model.UserID" />
        <input type="file" id="avatarFileInput" name="avatarFile" accept="image/*" style="display:none" />

        <div class="profile-top">
            <div class="identity-card">
                <div class="identity-row">
                    <div class="avatar-wrap">
                        <img id="avatarImg" src="@avatarSrc" alt="Avatar" class="avatar-img"
                             onerror="this.src='https://ui-avatars.com/api/?name=@Uri.EscapeDataString(Model.Username ?? "U")&background=0d1626&color=00c8ff&size=200'" />
                        <div class="avatar-cam" onclick="document.getElementById('avatarFileInput').click()" title="Đổi ảnh đại diện">
                            <i class="bi bi-camera-fill"></i>
                        </div>
                    </div>
                    <div>
                        <div class="avatar-name">@Model.Username</div>
                        <div class="avatar-email">@Model.Email</div>
                        <div class="avatar-badges">
                            @if (Model.IsTDMUStudent)
                            {<span class="dk-badge badge-tdmu"><i class="bi bi-mortarboard-fill"></i> SV TDMU</span>}
                            else
                            {<span class="dk-badge badge-guest"><i class="bi bi-person"></i> Khách</span>}
                            @if (Model.IsAdmin)
                            {<span class="dk-badge badge-admin"><i class="bi bi-shield-fill"></i> Admin</span>}
                            else
                            {<span class="dk-badge badge-user"><i class="bi bi-person-check"></i> User</span>}
                        </div>
                    </div>
                </div>
                <div class="meta-chips">
                    <span class="meta-chip">ID <b>#@Model.UserID</b></span>
                    <span class="meta-chip">Tham gia <b>@joinDate</b></span>
                    <span class="meta-chip">Sản phẩm <b>@myMarket.Count</b></span>
                    <span class="meta-chip">Bài viết <b>@myConnect.Count</b></span>
                </div>
                <div id="avatarPreviewBanner">
                    <i class="bi bi-image"></i>
                    <span id="avatarFileName"></span>
                    <button type="button" class="banner-dismiss" onclick="clearAvatar()">×</button>
                </div>
            </div>

            <div class="form-card">
                <div class="section-head">
                    <span><i class="bi bi-pencil-square me-1"></i> Chỉnh sửa thông tin</span>
                </div>
                <div class="section-body">
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Tên tài khoản <span class="req">*</span></label>
                            <input type="text" class="form-control" name="Username" value="@Model.Username" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Email <span class="req">*</span></label>
                            <input type="email" class="form-control" name="Email" id="emailInput"
                                   value="@Model.Email" required pattern="@emailPattern" />
                            <div id="emailError" class="error-feedback" style="display:none;">
                                Chỉ chấp nhận email @emailHint
                            </div>
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger d-block", style = "font-size:11px;" })
                        </div>
                        <div class="form-group">
                            <label class="form-label">Số điện thoại</label>
                            <input type="text" class="form-control" name="PhoneNumber" value="@Model.PhoneNumber" placeholder="0901234567" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <a href="@Url.Action("Index","Home")" class="btn-cancel">Hủy</a>
                        <button type="submit" class="btn-save"><i class="bi bi-floppy-fill"></i> Lưu</button>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <div class="content-grid">
        <div class="list-card">
            <div class="section-head">
                <span><i class="bi bi-bag me-1"></i> Sản phẩm đã đăng</span>
                <span>
                    <span class="section-count">@myMarket.Count</span>
                    <a class="list-link ms-2" href="@Url.Action("MyMarketPosts", "Market")">Xem tất cả</a>
                </span>
            </div>
            <div class="section-body">
                @if (myMarket.Any())
                {
                    <div class="mini-list">
                        @foreach (var item in myMarket.Take(5))
                        {
                            string img = item.MarketImages != null && item.MarketImages.Any()
                                ? item.MarketImages.First().ImageUrl
                                : (item.MainImage ?? "");
                            <a class="mini-item" href="@Url.Action("Details", "Market", new { id = item.PostID })">
                                <div class="mini-thumb">
                                    @if (!string.IsNullOrEmpty(img))
                                    {<img src="@img" alt="@item.Title" />}
                                    else
                                    {<span>🛒</span>}
                                </div>
                                <div>
                                    <div class="mini-title">@item.Title</div>
                                    <div class="mini-sub">@(item.MarketCategory?.CategoryName ?? "Chợ") · @(item.CreatedAt?.ToString("dd/MM/yyyy") ?? "")</div>
                                </div>
                                <div class="mini-price">@((item.Price ?? 0).ToString("N0"))đ</div>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-mini">Chưa đăng sản phẩm nào. <a class="list-link" href="@Url.Action("Create", "Market")">Đăng tin</a></div>
                }
            </div>
        </div>

        <div class="list-card">
            <div class="section-head">
                <span><i class="bi bi-chat-square-text me-1"></i> Bài chia sẻ đã đăng</span>
                <span>
                    <span class="section-count">@myConnect.Count</span>
                    <a class="list-link ms-2" href="@Url.Action("MyPosts", "Connect")">Xem tất cả</a>
                </span>
            </div>
            <div class="section-body">
                @if (myConnect.Any())
                {
                    <div class="mini-list">
                        @foreach (var item in myConnect.Take(5))
                        {
                            <a class="mini-item" href="@Url.Action("Details", "Connect", new { id = item.PostID })">
                                <div class="mini-thumb">
                                    @if (!string.IsNullOrEmpty(item.MainImage))
                                    {<img src="@item.MainImage" alt="@item.Title" />}
                                    else
                                    {<span>🤝</span>}
                                </div>
                                <div>
                                    <div class="mini-title">@item.Title</div>
                                    <div class="mini-sub">@(item.ConnectCategory?.CategoryName ?? "Kết nối") · @(item.CreatedAt?.ToString("dd/MM/yyyy") ?? "")</div>
                                </div>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-mini">Chưa có bài chia sẻ. <a class="list-link" href="@Url.Action("Create", "Connect")">Viết bài</a></div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(function () {
            var originalSrc = $('#avatarImg').attr('src');
            $('#avatarFileInput').on('change', function () {
                var file = this.files[0];
                if (!file) return;
                var reader = new FileReader();
                reader.onload = function (e) { $('#avatarImg').attr('src', e.target.result); };
                reader.readAsDataURL(file);
                $('#avatarFileName').text(file.name);
                $('#avatarPreviewBanner').addClass('show');
            });
            window.clearAvatar = function () {
                $('#avatarFileInput').val('');
                $('#avatarImg').attr('src', originalSrc);
                $('#avatarPreviewBanner').removeClass('show');
            };
            document.querySelectorAll('.toast.show').forEach(function (el) {
                setTimeout(function () { new bootstrap.Toast(el, { delay: 400 }).hide(); }, 4000);
            });
            const emailInput = document.getElementById('emailInput');
            const errorDiv = document.getElementById('emailError');
            emailInput.addEventListener('invalid', function (e) {
                e.preventDefault();
                $(this).addClass('is-invalid');
                $(errorDiv).fadeIn(200);
            });
            $(emailInput).on('input', function () {
                if (this.validity.valid) {
                    $(this).removeClass('is-invalid');
                    $(errorDiv).fadeOut(200);
                }
            });
        });
    </script>
}
