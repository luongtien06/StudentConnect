        var _archiveStoriesCache = [];
        var _selectedHlStories = [];
        var _archiveSelectedForHl = [];

        function openCreateHighlightModal(preselectedIds) {
            _selectedHlStories = preselectedIds || [];
            $('#hlTitleInput').val('');
            $('#hlSelectedCount').text(_selectedHlStories.length);

            var modalEl = document.getElementById('createHighlightModal');
            if (modalEl) {
                var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
                loadStoriesForHighlightPicker();
            }
        }

        function loadStoriesForHighlightPicker() {
            var $grid = $('#hlPickerGrid');
            $grid.html('<div class="text-center text-muted py-4 w-100 col-12"><span class="spinner-border spinner-border-sm me-2"></span> Đang tải tin của bạn...</div>');

            fetch('/Story/GetArchive')
                .then(res => res.json())
                .then(data => {
                    if (!data.success || !data.stories || data.stories.length === 0) {
                        $grid.html('<div class="text-center text-white-50 py-4 small w-100 col-12">Bạn chưa đăng tin 24h nào để thêm vào mục nổi bật. Hãy đăng tin trước nhé!</div>');
                        return;
                    }

                    _archiveStoriesCache = data.stories;
                    var html = '';
                    data.stories.forEach(s => {
                        var isSel = _selectedHlStories.includes(s.storyId);
                        var activeCls = isSel ? 'active' : '';
                        var checkIcon = isSel ? '<i class="fa-solid fa-check"></i>' : '';

                        var mediaHtml = s.mediaType === 'video'
                            ? `<video src="${s.mediaUrl}" class="w-100 h-100" style="object-fit:cover;" muted></video>`
                            : `<img src="${s.mediaUrl}" class="w-100 h-100" style="object-fit:cover;" alt="Story" />`;

                        html += `
                            <div class="picker-card ${activeCls}" id="pickerCard_${s.storyId}" onclick="togglePickerStory(${s.storyId})">
                                ${mediaHtml}
                                <div class="picker-card-check" id="pickerCheck_${s.storyId}">${checkIcon}</div>
                            </div>
                        `;
                    });
                    $grid.html(html);
                })
                .catch(() => {
                    $grid.html('<div class="text-center text-danger py-4 small w-100 col-12">Không thể tải kho tin. Vui lòng thử lại!</div>');
                });
        }

        function togglePickerStory(storyId) {
            var idx = _selectedHlStories.indexOf(storyId);
            var card = $('#pickerCard_' + storyId);
            var check = $('#pickerCheck_' + storyId);

            if (idx > -1) {
                _selectedHlStories.splice(idx, 1);
                card.removeClass('active');
                check.html('');
            } else {
                _selectedHlStories.push(storyId);
                card.addClass('active');
                check.html('<i class="fa-solid fa-check"></i>');
            }
            $('#hlSelectedCount').text(_selectedHlStories.length);
        }

        function submitCreateHighlight() {
            var title = $('#hlTitleInput').val().trim();
            if (!title) {
                Swal.fire({ icon: 'warning', title: 'Thiếu thông tin', text: 'Vui lòng đặt tên cho mục tin nổi bật!', background: '#111d30', color: '#fff' });
                return;
            }

            if (!_selectedHlStories || _selectedHlStories.length === 0) {
                Swal.fire({ icon: 'warning', title: 'Chưa chọn tin', text: 'Vui lòng chọn ít nhất 1 tin để đưa vào mục nổi bật!', background: '#111d30', color: '#fff' });
                return;
            }

            var $btn = $('#btnSaveHighlight');
            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span> Đang lưu...');

            $.ajax({
                url: '/Story/CreateHighlight',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    Title: title,
                    StoryIDs: _selectedHlStories
                }),
