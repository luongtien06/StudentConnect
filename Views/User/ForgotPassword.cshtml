@{
    ViewBag.Title = "Quên mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .fp-wrap {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
    }

    .fp-card {
        width: 100%;
        max-width: 440px;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 20px;
        padding: 2.5rem;
        position: relative;
        overflow: hidden;
    }

        .fp-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(0,200,255,0.5), rgba(123,97,255,0.4), transparent);
        }

    .fp-icon-wrap {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        margin: 0 auto 1.5rem;
        background: rgba(0,200,255,0.08);
        border: 1px solid rgba(0,200,255,0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .fp-title {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.4rem;
        font-weight: 600;
        color: #fff;
        text-align: center;
        margin-bottom: 6px;
    }

    .fp-sub {
        font-size: 13px;
        color: rgba(255,255,255,0.35);
        text-align: center;
        margin-bottom: 2rem;
        line-height: 1.6;
        font-weight: 300;
    }

    .fp-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        letter-spacing: 0.1em;
        color: rgba(0,200,255,0.55);
        text-transform: uppercase;
        margin-bottom: 8px;
        display: block;
    }

    .fp-input {
        width: 100%;
        background: rgba(255,255,255,0.04) !important;
        border: 1px solid rgba(255,255,255,0.1) !important;
        border-radius: 10px !important;
        color: #fff !important;
        padding: 11px 14px;
        font-size: 13px;
        font-family: 'Space Grotesk', sans-serif;
        transition: all 0.2s;
        outline: none;
    }

        .fp-input:focus {
            border-color: rgba(0,200,255,0.4) !important;
            background: rgba(0,200,255,0.04) !important;
            box-shadow: 0 0 0 3px rgba(0,200,255,0.08) !important;
        }

        .fp-input::placeholder {
            color: rgba(255,255,255,0.2) !important;
        }

    .fp-btn {
        width: 100%;
        padding: 12px;
        border-radius: 100px;
        border: none;
        background: linear-gradient(135deg, rgba(0,200,255,0.8), rgba(123,97,255,0.8));
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        font-family: 'Space Grotesk', sans-serif;
        cursor: pointer;
        transition: opacity 0.2s, transform 0.15s;
        margin-top: 1.5rem;
        letter-spacing: 0.02em;
    }

        .fp-btn:hover {
            opacity: 0.88;
            transform: translateY(-1px);
        }

        .fp-btn:active {
            transform: scale(0.98);
        }

    .fp-alert {
        border-radius: 10px;
        padding: 12px 14px;
        font-size: 13px;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: flex-start;
        gap: 10px;
    }

    .fp-alert-err {
        background: rgba(255,60,60,0.08);
        border: 1px solid rgba(255,60,60,0.2);
        color: rgba(255,120,120,0.9);
    }

    .fp-alert-ok {
        background: rgba(0,200,80,0.08);
        border: 1px solid rgba(0,200,80,0.2);
        color: rgba(0,220,100,0.9);
    }

    .fp-alert i {
        font-size: 15px;
        margin-top: 1px;
        flex-shrink: 0;
    }

    .fp-back {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        margin-top: 1.5rem;
        font-size: 12px;
        color: rgba(255,255,255,0.3);
        text-decoration: none;
        transition: color 0.2s;
    }

        .fp-back:hover {
            color: rgba(0,200,255,0.7);
        }

    .fp-login-link {
        color: #00c8ff;
        font-weight: 500;
        text-decoration: none;
    }

        .fp-login-link:hover {
            text-decoration: underline;
            color: #00c8ff;
        }
</style>

<div class="fp-wrap">
    <div class="fp-card">

        <div class="fp-icon-wrap">🔑</div>
        <h2 class="fp-title">Quên mật khẩu?</h2>
        <p class="fp-sub">Nhập email đã đăng ký, chúng tôi sẽ gửi mật khẩu mới ngay cho bạn.</p>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="fp-alert fp-alert-err">
                <i class="bi bi-exclamation-circle"></i>
                <span>@ViewBag.ErrorMessage</span>
            </div>
        }

        @if (ViewBag.SuccessMessage != null)
        {
            <div class="fp-alert fp-alert-ok">
                <i class="bi bi-check-circle"></i>
                <div>
                    @ViewBag.SuccessMessage<br />
                    <a href="@Url.Action("Login", "User")" class="fp-login-link mt-1 d-inline-block">
                        Đăng nhập ngay →
                    </a>
                </div>
            </div>
        }
        else
        {
            using (Html.BeginForm("ForgotPassword", "User", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="mb-1">
                    <label class="fp-label">Email đã đăng ký</label>
                    <input type="email" name="email"
                           class="fp-input"
                           placeholder="namthan@student.tdmu.edu.vn"
                           required />
                </div>
                <button type="submit" class="fp-btn">
                    <i class="bi bi-send me-2"></i>Gửi mật khẩu mới
                </button>
            }
        }

        <a href="@Url.Action("Login", "User")" class="fp-back">
            <i class="bi bi-arrow-left"></i> Quay lại đăng nhập
        </a>
    </div>
</div>