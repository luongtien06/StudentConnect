            <div class="modal-footer d-flex justify-content-between">
                <span class="text-white-50 small">💡 <strong>Mẹo:</strong> Bấm nút <strong>"Mở lại & Tiếp tục"</strong> để nạp toàn bộ lịch sử trao đổi và tiếp tục trò chuyện giữ nguyên ngữ cảnh.</span>
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL 13: XEM CHI TIẾT PHIÊN & TÁC VỤ LIÊN KẾT (SESSION DETAILS) -->
<div class="modal fade modal-dark" id="modalConversationDetail" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title font-weight-bold">
                    <i class="bi bi-info-circle text-info mr-2"></i> Chi tiết Phiên hội thoại #<span id="detailConvId"></span>
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" style="max-height: 540px; overflow-y: auto;">
                <div class="mb-3">
                    <h5 class="text-white font-weight-bold mb-1" id="detailConvTitle">...</h5>
                    <div class="text-white-50 small" id="detailConvMeta">...</div>
                </div>

                <!-- Khối tác vụ lịch liên kết nếu có -->
                <div id="groupLinkedTask" class="p-3 rounded mb-3" style="display: none; background: rgba(0, 200, 255, 0.08); border: 1px solid rgba(0, 200, 255, 0.3);">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <strong class="text-info"><i class="bi bi-calendar2-check mr-1"></i> Tác vụ lịch liên kết</strong>
                        <span class="badge badge-info" id="detailLinkedTaskStatus">Active</span>
                    </div>
                    <div class="text-white small mb-1" id="detailLinkedTaskName">...</div>
                    <div class="text-white-50 small mb-1" id="detailLinkedTaskPrompt">...</div>
                    <div class="d-flex justify-content-between align-items-center small text-white-50 mt-2">
                        <span>Chu kỳ: <strong class="text-white" id="detailLinkedTaskSchedule">...</strong></span>
                        <span>Chạy tiếp theo: <strong class="text-info" id="detailLinkedTaskNextRun">...</strong></span>
                    </div>
                </div>

                <!-- Khối các hành động Agent đã thực thi trong phiên -->
                <div id="groupLinkedLogs" class="mb-3" style="display: none;">
                    <label class="text-white-50 small font-weight-bold mb-1">Các hành động Agent đã gọi trong phiên này:</label>
                    <div class="table-responsive">
                        <table class="table table-dark table-sm mb-0" style="font-size: 12px; background: rgba(255,255,255,0.03);">
                            <thead>
                                <tr style="color: #00c8ff;">
                                    <th>Thời gian</th>
                                    <th>Hành động</th>
                                    <th>Trạng thái</th>
                                    <th>Kết quả</th>
                                </tr>
                            </thead>
                            <tbody id="tblLinkedLogsBody"></tbody>
                        </table>
                    </div>
                </div>

                <!-- Khối xem trước tin nhắn trong phiên -->
                <div>
                    <label class="text-white-50 small font-weight-bold mb-1">Các tin nhắn trong phiên (<span id="detailConvMsgCount">0</span> tin):</label>
                    <div id="detailConvMessagesPreview" class="p-2 rounded bg-dark border border-secondary" style="max-height: 220px; overflow-y: auto;">
                        <div class="text-center text-white-50 py-2 small">Đang nạp tin nhắn...</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-info font-weight-bold" id="btnResumeFromDetail">
                    <i class="bi bi-box-arrow-in-right"></i> Mở lại & Tiếp tục trò chuyện
                </button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL 14: SỬA PHIÊN HỘI THOẠI (RENAME / EDIT) -->
<div class="modal fade modal-dark" id="modalRenameConversation" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title font-weight-bold">
                    <i class="bi bi-pencil-square text-info mr-2"></i> Sửa phiên hội thoại #<span id="lblRenameConvId"></span>
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="renameConvId" />
                <div class="form-group mb-2">
                    <label class="text-white-50 small mb-1 font-weight-bold">Tiêu đề phiên hội thoại:</label>
                    <input type="text" class="form-control bg-dark text-white border-secondary" id="txtRenameConvTitle" placeholder="Nhập tiêu đề gợi nhớ cho phiên..." maxlength="150" />
                    <div id="errRenameConvTitle" class="text-danger small mt-1" style="display: none;"></div>
                    <small class="text-white-50 mt-1 d-block">💡 Đặt tiêu đề rõ ràng để bạn dễ dàng tìm kiếm và mở lại phiên làm việc sau này.</small>
