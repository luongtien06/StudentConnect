            <div class="modal-footer d-flex justify-content-between">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-info font-weight-bold" id="btnConfirmRenameConv">
                    <i class="bi bi-check-lg"></i> Lưu thay đổi
                </button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL 15: HỘP THOẠI XÁC NHẬN XÓA PHIÊN HỘI THOẠI -->
<div class="modal fade modal-dark" id="modalConfirmDeleteConversation" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-danger">
            <div class="modal-header border-danger">
                <h5 class="modal-title font-weight-bold text-danger">
                    <i class="bi bi-exclamation-triangle-fill mr-2"></i> Xác nhận xóa phiên hội thoại
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="deleteConvId" />
                <p class="mb-2">Bạn có chắc chắn muốn xóa phiên hội thoại này không?</p>
                <div class="p-3 rounded mb-3" style="background: rgba(255, 60, 60, 0.1); border: 1px solid rgba(255, 80, 80, 0.3);">
                    <div><strong>Mã phiên:</strong> #<span id="lblDeleteConvId"></span></div>
                    <div><strong>Tiêu đề:</strong> <span class="text-white font-weight-bold" id="lblDeleteConvTitle"></span></div>
                    <div><strong>Số tin nhắn:</strong> <span id="lblDeleteConvMsgCount" class="text-info font-weight-bold"></span></div>
                </div>
                <div class="alert alert-danger py-2 px-3 small mb-0" style="background: rgba(255, 60, 60, 0.15); border-color: rgba(255, 80, 80, 0.4); color: #ff8585;">
                    <i class="bi bi-shield-exclamation mr-1"></i> <strong>Lưu ý:</strong> Toàn bộ lịch sử tin nhắn trong phiên này sẽ bị xóa khỏi hệ thống. Nếu có tác vụ lịch độc lập được tạo trước đó, tác vụ vẫn tiếp tục hoạt động an toàn.
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-between">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger font-weight-bold" id="btnConfirmDeleteConv">
                    <i class="bi bi-trash-fill"></i> Xác nhận xóa
                </button>
            </div>
        </div>
    </div>
</div>
}

@section scripts {
    <script>
        $(function () {
            var $container = $('#aiMessagesContainer');
            var $input = $('#aiInputMessage');
            var $btnSend = $('#btnAiSend');
            var $typing = $('#typingIndicator');
            var agentName = '@agentName';

            function scrollToBottom() {
                $container.stop().animate({ scrollTop: $container.prop("scrollHeight") }, 250);
            }

            function showAgentToast(type, message) {
                var $box = $('#agentToastContainer');
                if ($box.length === 0) {
                    $box = $('<div id="agentToastContainer"></div>').appendTo('body');
                }
                var icon = type === 'success' ? 'bi-check-circle-fill' : (type === 'error' ? 'bi-exclamation-triangle-fill' : 'bi-info-circle-fill');
                var $toast = $('<div class="agent-toast agent-toast-' + type + '">' +
                    '<i class="bi ' + icon + '"></i>' +
                    '<span>' + $('<div>').text(message).html() + '</span>' +
                    '</div>').appendTo($box);

                setTimeout(function () {
                    $toast.css('opacity', 0).css('transform', 'translateY(12px)');
                    setTimeout(function () { $toast.remove(); }, 350);
                }, 3500);
            }

            function formatAiText(text) {
                if (!text) return '';
                var formatted = $('<div>').text(text).html();
                formatted = formatted.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
                formatted = formatted.replace(/\*(.*?)\*/g, '<em>$1</em>');
                var lines = formatted.split('\n');
                var inList = false;
                var resLines = [];

                for (var i = 0; i < lines.length; i++) {
                    var line = lines[i].trim();
                    if (line.indexOf('* ') === 0 || line.indexOf('- ') === 0) {
                        if (!inList) {
                            resLines.push('<ul>');
                            inList = true;
                        }
                        resLines.push('<li>' + line.substring(2) + '</li>');
                    } else {
                        if (inList) {
                            resLines.push('</ul>');
                            inList = false;
                        }
                        if (line.length > 0) {
                            resLines.push('<p>' + line + '</p>');
                        }
                    }
                }
                if (inList) resLines.push('</ul>');
                return resLines.join('');
            }

            function appendUserMessage(text) {
                var safeText = $('<div>').text(text).html();
                var html = '<div class="msg-row user">' +
                    '<div class="msg-avatar"><i class="bi bi-person-fill"></i></div>' +
                    '<div class="msg-bubble"><p>' + safeText + '</p></div>' +
                    '</div>';
                $typing.before(html);
                scrollToBottom();
            }

            function appendAiMessage(text, confirmationData) {
                var formatted = formatAiText(text);
                var confirmHtml = '';

                if (confirmationData && confirmationData.requires) {
                    confirmHtml =
                        '<div class="ai-confirm-box" id="confirm-box-' + confirmationData.id + '">' +
                            '<div class="ai-confirm-title"><i class="bi bi-exclamation-triangle-fill"></i> Xác nhận hành động nhạy cảm</div>' +
                            '<div class="ai-confirm-desc">' + (confirmationData.actionName || 'Thao tác') + ': ' + (confirmationData.actionDetails || 'Cần bạn bấm xác nhận để Agent tiến hành thực thi.') + '</div>' +
                            '<div class="ai-confirm-actions">' +
                                '<button type="button" class="btn-confirm-yes btn-handle-confirm" data-id="' + confirmationData.id + '" data-approve="true"><i class="bi bi-check-lg"></i> Xác nhận thực hiện</button>' +
                                '<button type="button" class="btn-confirm-no btn-handle-confirm" data-id="' + confirmationData.id + '" data-approve="false"><i class="bi bi-x-lg"></i> Hủy bỏ</button>' +
                            '</div>' +
                        '</div>';
                }

                var html = '<div class="msg-row ai">' +
                    '<div class="msg-avatar"><i class="bi bi-robot"></i></div>' +
                    '<div class="msg-bubble">' + formatted + confirmHtml + '</div>' +
                    '</div>';
                $typing.before(html);
                scrollToBottom();
            }

            var currentConversationId = @(ViewBag.InitialConversationId != null ? (long)ViewBag.InitialConversationId : 0);

            function updateSessionBanner(conv) {
                if (conv && conv.ConversationID) {
                    currentConversationId = conv.ConversationID;
                    $('#lblSessionBadge').html('<i class="bi bi-chat-dots-fill mr-1"></i> Phiên #' + conv.ConversationID);
                    $('#lblSessionTitle').text(conv.Title || ('Phiên #' + conv.ConversationID));
                    $('#lblSessionMeta').text('(' + (conv.MessageCount || 0) + ' tin nhắn · ' + (conv.LastMessageAt || '') + ')');
                    $('#btnRenameSession').show();
                    $('#btnViewSessionDetails').show();
                } else {
                    currentConversationId = 0;
                    $('#lblSessionBadge').html('<i class="bi bi-plus-circle mr-1"></i> Phiên mới');
                    $('#lblSessionTitle').text('Chưa chọn phiên (Tin nhắn đầu tiên sẽ tự tạo phiên)');
                    $('#lblSessionMeta').text('');
                    $('#btnRenameSession').hide();
                    $('#btnViewSessionDetails').hide();
                }
            }

            function sendMessage() {
                var msg = $input.val().trim();
                if (!msg) return;

                $input.val('');
                appendUserMessage(msg);

                $typing.css('display', 'flex');
                scrollToBottom();
                $btnSend.prop('disabled', true);
                $input.prop('disabled', true);

                var payload = {
                    message: msg,
                    conversationId: currentConversationId > 0 ? currentConversationId : null
                };

                $.ajax({
                    url: '@Url.Action("Ask", "Assistant")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function (res) {
                        $typing.hide();
                        $btnSend.prop('disabled', false);
                        $input.prop('disabled', false).focus();

                        if (res && res.Success) {
                            if (res.ConversationId && currentConversationId !== res.ConversationId) {
                                currentConversationId = res.ConversationId;
                                $('#lblSessionBadge').html('<i class="bi bi-chat-dots-fill mr-1"></i> Phiên #' + res.ConversationId);
                                $('#lblSessionTitle').text(msg.length > 60 ? msg.substring(0, 60) + '...' : msg);
                                $('#btnRenameSession').show();
                                $('#btnViewSessionDetails').show();
                            }

                            var confData = null;
                            if (res.RequiresConfirmation && res.ConfirmationId) {
                                confData = {
                                    requires: true,
                                    id: res.ConfirmationId,
                                    actionName: res.ActionName,
                                    actionDetails: res.ActionDetails
                                };
                            }
                            appendAiMessage(res.Reply || 'Đã nhận yêu cầu.', confData);
                        } else {
                            var errMsg = (res && res.Error) ? res.Error : 'Có lỗi xảy ra khi trò chuyện với trợ lý.';
                            appendAiMessage('⚠️ ' + errMsg);
                        }
                    },
                    error: function (xhr) {
                        $typing.hide();
                        $btnSend.prop('disabled', false);
                        $input.prop('disabled', false).focus();

                        var errMsg = 'Không thể kết nối đến máy chủ trợ lý AI.';
                        try {
                            var j = JSON.parse(xhr.responseText);
                            if (j && j.Error) errMsg = j.Error;
                        } catch (e) { }
                        appendAiMessage('⚠️ ' + errMsg);
                    }
                });
            }

            // Xử lý nút Duyệt / Hủy xác nhận trong tin nhắn chat
            $(document).on('click', '.btn-handle-confirm', function () {
                var $btn = $(this);
                var confId = $btn.data('id');
                var isApprove = $btn.data('approve') === true || $btn.data('approve') === 'true';
                var $box = $('#confirm-box-' + confId);

                $box.find('button').prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("ConfirmAction", "Assistant")',
                    type: 'POST',
                    data: { confirmationId: confId, approve: isApprove },
                    success: function (res) {
                        if (res && res.success) {
                            var badgeClass = isApprove ? 'text-success' : 'text-danger';
                            var icon = isApprove ? 'bi-check-circle-fill' : 'bi-x-circle-fill';
                            $box.html('<div class="' + badgeClass + ' font-weight-bold"><i class="bi ' + icon + '"></i> ' + (res.message || (isApprove ? 'Đã duyệt thực hiện.' : 'Đã hủy bỏ.')) + '</div>');
                        } else {
                            if (window.AppDialog) AppDialog.warning(res ? res.message : 'Lỗi khi xử lý xác nhận.', 'Xác nhận');
                            else alert(res ? res.message : 'Lỗi khi xử lý xác nhận.');
                            $box.find('button').prop('disabled', false);
                        }
                    },
                    error: function (xhr) {
                        if (window.AppDialog) AppDialog.handleAjaxError(xhr, 'Không thể kết nối tới máy chủ.');
                        else alert('Không thể kết nối tới máy chủ.');
                        $box.find('button').prop('disabled', false);
                    }
                });
            });

            $btnSend.on('click', sendMessage);

            $input.on('keypress', function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    sendMessage();
                }
            });

            $('.ai-chip').on('click', function () {
                var q = $(this).data('query');
                if (q) {
                    $input.val(q);
                    sendMessage();
                }
            });

            $('#btnClearChat').on('click', function () {
                $container.find('.msg-row:not(:first)').remove();
                $input.val('').focus();
            });

            $('#btnNewConversation').on('click', function () {
                updateSessionBanner(null);
                $container.find('.msg-row:not(:first)').remove();
                $input.val('').focus();
                appendAiMessage('✨ Đã bắt đầu phiên hội thoại mới. Mời bạn nhập yêu cầu hoặc câu hỏi cho Mr. T nhé!');
            });

            // ==========================================
            // MODAL 1: PERMISSIONS MANAGEMENT
            // ==========================================
            $('#btnOpenPermissions').on('click', function () {
                $.get('@Url.Action("GetPermissions", "Assistant")', function (res) {
                    if (res && res.success && res.data) {
                        var d = res.data;
                        $('#permIsEnabled').prop('checked', d.IsEnabled);
                        $('#permCanReadData').prop('checked', d.CanReadData);
                        $('#permCanManageContent').prop('checked', d.CanManageContent);
                        $('#permCanInteract').prop('checked', d.CanInteract);
                        $('#permCanAutomation').prop('checked', d.CanAutomation);
                        $('#modalPermissions').modal('show');
                    } else {
                        if (window.AppDialog) {
                            if (res && res.requireLogin) AppDialog.requireLogin({ message: res.message || 'Vui lòng đăng nhập để thiết lập quyền Agent.' });
                            else AppDialog.warning(res ? res.message : 'Vui lòng đăng nhập để thiết lập quyền Agent.', 'Thông báo');
                        } else alert(res ? res.message : 'Vui lòng đăng nhập để thiết lập quyền Agent.');
                    }
                });
            });

            $('#btnSavePermissions').on('click', function () {
                var payload = {
                    isEnabled: $('#permIsEnabled').is(':checked'),
                    canRead: $('#permCanReadData').is(':checked'),
                    canManage: $('#permCanManageContent').is(':checked'),
                    canInteract: $('#permCanInteract').is(':checked'),
                    canAutomation: $('#permCanAutomation').is(':checked')
                };

                $.post('@Url.Action("SavePermissions", "Assistant")', payload, function (res) {
                    if (res && res.success) {
                        $('#modalPermissions').modal('hide');
                        appendAiMessage('🛡️ ' + res.message);
                    } else {
                        if (window.AppDialog) AppDialog.error(res ? res.message : 'Lỗi khi lưu quyền.', 'Lỗi');
                        else alert(res ? res.message : 'Lỗi khi lưu quyền.');
                    }
                });
            });

            // ==========================================
            // MODAL 2: SCHEDULED TASKS MANAGEMENT (5 NHÓM THAO TÁC CHUẨN)
            // ==========================================
            var currentTasksCache = [];

            $('#btnOpenTasks').on('click', function () {
                $('#modalTasks').modal('show');
                checkWorkerStatus();
                loadTasks();
            });

            $('#btnRefreshWorkerStatus').on('click', function () {
                checkWorkerStatus();
            });

            function checkWorkerStatus() {
                var $text = $('#workerStatusText');
                var $ind = $('#workerStatusIndicator');
                $text.text('Đang kiểm tra nhịp tim Worker nền...');
                $ind.removeClass('bg-success bg-danger bg-warning').addClass('spinner-grow text-info');

                $.get('@Url.Action("GetWorkerStatus", "Assistant")', function (res) {
                    $ind.removeClass('spinner-grow text-info');
                    if (res && res.isOnline) {
                        $ind.addClass('d-inline-block rounded-circle bg-success').css({ width: '10px', height: '10px' });
                        $text.html('🟢 <strong>' + res.workerType + '</strong>: Đang chạy nền (' + res.machineName + ' lúc ' + res.lastHeartbeat + ') — <em>' + res.message + '</em>');
                    } else {
                        $ind.addClass('d-inline-block rounded-circle bg-warning').css({ width: '10px', height: '10px' });
                        $text.html('🟡 <strong>Worker chưa bật hoặc đang ngủ</strong>: ' + (res ? res.message : 'Chưa có thông tin'));
                    }
                }).fail(function () {
                    $ind.removeClass('spinner-grow text-info').addClass('d-inline-block rounded-circle bg-danger').css({ width: '10px', height: '10px' });
                    $text.html('🔴 Không thể kết nối kiểm tra Worker.');
                });
            }

            function loadTasks() {
                var $tbody = $('#tblTasksBody');
                $tbody.html('<tr><td colspan="6" class="text-center text-white-50 py-3"><div class="spinner-border spinner-border-sm text-info mr-2"></div> Đang tải danh sách tác vụ...</td></tr>');

                $.get('@Url.Action("GetTasks", "Assistant")', function (res) {
                    if (res && res.success && res.data) {
                        currentTasksCache = res.data;
                        if (res.data.length === 0) {
                            $tbody.html('<tr><td colspan="6" class="text-center text-white-50 py-3">Bạn chưa có tác vụ tự động nào. Hãy thử yêu cầu Mr. T trong khung chat ví dụ: <i>"Lập lịch mỗi ngày đăng một bài chia sẻ mẹo học tập"</i>.</td></tr>');
                            return;
                        }

                        var rows = '';
                        res.data.forEach(function (t) {
                            var statusBadge;
                            if (t.Status === 'Active') {
                                statusBadge = '<span class="badge badge-success"><i class="bi bi-play-fill"></i> Đang chạy</span>';
                            } else if (t.Status === 'Paused') {
                                statusBadge = '<span class="badge badge-warning"><i class="bi bi-pause-fill"></i> Tạm dừng</span>';
                            } else if (t.Status === 'Completed') {
                                statusBadge = '<span class="badge badge-info"><i class="bi bi-check-all"></i> Hoàn thành</span>';
                            } else {
                                statusBadge = '<span class="badge badge-secondary">' + t.Status + '</span>';
                            }

                            // Nút Chạy/Dừng tác vụ (Thao tác 2)
                            var toggleBtn = t.Status === 'Active'
                                ? '<button class="btn btn-xs btn-outline-warning btn-task-toggle-state" data-id="' + t.TaskID + '" data-status="Active" data-name="' + $('<div>').text(t.TaskName).html() + '" title="2. Tạm dừng tác vụ"><i class="bi bi-pause-fill"></i></button>'
                                : '<button class="btn btn-xs btn-outline-success btn-task-toggle-state" data-id="' + t.TaskID + '" data-status="Paused" data-name="' + $('<div>').text(t.TaskName).html() + '" title="2. Kích hoạt lại tác vụ"><i class="bi bi-play-fill"></i></button>';

                            rows += '<tr>' +
                                '<td>' +
                                    '<div class="font-weight-bold text-white">' + $('<div>').text(t.TaskName).html() + '</div>' +
                                    '<div class="small text-white-50 text-truncate" style="max-width: 280px;" title="' + $('<div>').text(t.UserPrompt).html() + '">' + $('<div>').text(t.UserPrompt).html() + '</div>' +
                                '</td>' +
                                '<td><span class="badge badge-info">' + t.ScheduleType + '</span></td>' +
                                '<td>' + statusBadge + '</td>' +
                                '<td class="small text-white-50">' + (t.LastRunAt || 'Chưa chạy') + '</td>' +
                                '<td class="small text-info font-weight-bold">' + (t.NextRunAt || '—') + '</td>' +
                                '<td class="text-right" style="white-space: nowrap;">' +
                                    '<div class="btn-group btn-group-sm" role="group">' +
                                        '<!-- 1. Chạy ngay -->' +
                                        '<button class="btn btn-xs btn-outline-primary btn-task-run-now" data-id="' + t.TaskID + '" data-name="' + $('<div>').text(t.TaskName).html() + '" title="1. Chạy ngay lập tức"><i class="bi bi-lightning-charge-fill"></i></button>' +
                                        '<!-- 2. Chạy / Dừng -->' +
                                        toggleBtn +
                                        '<!-- 3. Sửa tác vụ -->' +
                                        '<button class="btn btn-xs btn-outline-info btn-task-edit" data-id="' + t.TaskID + '" title="3. Sửa nội dung & lịch"><i class="bi bi-pencil"></i></button>' +
                                        '<!-- 4. Xem lịch chạy -->' +
                                        '<button class="btn btn-xs btn-outline-secondary btn-task-runs" data-id="' + t.TaskID + '" data-name="' + $('<div>').text(t.TaskName).html() + '" title="4. Xem lịch sử chạy"><i class="bi bi-clock-history"></i></button>' +
                                        '<!-- 5. Xóa tác vụ -->' +
                                        '<button class="btn btn-xs btn-outline-danger btn-task-delete" data-id="' + t.TaskID + '" data-name="' + $('<div>').text(t.TaskName).html() + '" title="5. Xóa tác vụ"><i class="bi bi-trash"></i></button>' +
                                    '</div>' +
                                '</td>' +
                            '</tr>';
                        });
                        $tbody.html(rows);
                    } else {
                        $tbody.html('<tr><td colspan="6" class="text-center text-danger py-3">' + (res.message || 'Lỗi khi tải danh sách tác vụ.') + '</td></tr>');
                    }
                });
            }

            // ==========================================
            // THAO TÁC 1: CHẠY NGAY LẬP TỨC (RUN NOW CÓ XÁC NHẬN)
            // ==========================================
            $(document).on('click', '.btn-task-run-now', function () {
                var taskId = $(this).data('id');
                var taskName = $(this).data('name') || ('#' + taskId);

                $('#runNowTaskId').val(taskId);
                $('#lblRunNowTaskId').text(taskId);
                $('#lblRunNowTaskName').text(taskName);

                var $btnConfirm = $('#btnConfirmRunNow');
                $btnConfirm.prop('disabled', false).html('<i class="bi bi-lightning-charge-fill"></i> Chạy ngay');
                $('#modalConfirmRunNow').modal('show');
            });

            $('#btnConfirmRunNow').on('click', function () {
                var taskId = $('#runNowTaskId').val();
                var $btn = $(this);
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm mr-1"></span> Đang thực thi...');

                $.post('@Url.Action("RunNow", "Assistant")', { taskId: taskId, isDryRun: false }, function (res) {
                    $btn.prop('disabled', false).html('<i class="bi bi-lightning-charge-fill"></i> Chạy ngay');
                    $('#modalConfirmRunNow').modal('hide');

                    if (res && res.success) {
                        if (window.AppDialog) AppDialog.success((res.message || 'Đã thực thi thành công!') + (res.summary ? '<br><small>' + res.summary + '</small>' : ''), 'Thành công');
                        else alert('✅ ' + (res.message || 'Đã thực thi thành công!') + '\n\nKết quả: ' + (res.summary || '—'));
                        loadTasks();
                    } else {
                        if (window.AppDialog) AppDialog.error(res ? res.message : 'Lỗi khi thực thi tác vụ.', 'Lỗi thực thi');
                        else alert('❌ ' + (res.message || 'Lỗi khi thực thi tác vụ.'));
                    }
                }).fail(function (xhr) {
                    $btn.prop('disabled', false).html('<i class="bi bi-lightning-charge-fill"></i> Chạy ngay');
                    if (window.AppDialog) AppDialog.handleAjaxError(xhr, 'Lỗi kết nối máy chủ khi chạy tác vụ.');
                    else alert('Lỗi kết nối máy chủ khi chạy tác vụ.');
                });
            });

            // ==========================================
            // THAO TÁC 2: CHẠY / DỪNG TÁC VỤ (CÓ HỘP THOẠI XÁC NHẬN DỪNG)
            // ==========================================
            $(document).on('click', '.btn-task-toggle-state', function () {
                var $btn = $(this);
                var taskId = $btn.data('id');
                var taskName = $btn.data('name') || ('#' + taskId);
                var currentStatus = $btn.data('status');

                if (currentStatus === 'Active') {
                    // Dừng tác vụ -> hiển thị modalConfirmStopTask
                    $('#stopTaskId').val(taskId);
                    $('#lblStopTaskId').text(taskId);
                    $('#lblStopTaskName').text(taskName);

                    var $btnConfirm = $('#btnConfirmStopTask');
                    $btnConfirm.prop('disabled', false).html('<i class="bi bi-pause-fill"></i> Dừng tác vụ');
                    $('#modalConfirmStopTask').modal('show');
                } else {
                    // Kích hoạt lại -> gọi trực tiếp ResumeTask
                    $btn.prop('disabled', true);
                    $.post('@Url.Action("ResumeTask", "Assistant")', { taskId: taskId }, function (res) {
                        if (res && res.success) {
                            if (window.AppDialog) AppDialog.toastSuccess('Đã kích hoạt lại tác vụ.');
                            loadTasks();
                        } else {
                            if (window.AppDialog) AppDialog.error(res ? res.message : 'Không thể kích hoạt lại tác vụ.', 'Lỗi');
                            else alert(res ? res.message : 'Không thể kích hoạt lại tác vụ.');
                            $btn.prop('disabled', false);
                        }
                    }).fail(function (xhr) {
                        if (window.AppDialog) AppDialog.handleAjaxError(xhr, 'Lỗi kết nối máy chủ.');
                        else alert('Lỗi kết nối máy chủ.');
                        $btn.prop('disabled', false);
                    });
                }
            });

            $('#btnConfirmStopTask').on('click', function () {
                var taskId = $('#stopTaskId').val();
                var $btn = $(this);
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm mr-1"></span> Đang dừng...');

                $.post('@Url.Action("PauseTask", "Assistant")', { taskId: taskId }, function (res) {
                    $btn.prop('disabled', false).html('<i class="bi bi-pause-fill"></i> Dừng tác vụ');
                    $('#modalConfirmStopTask').modal('hide');

                    if (res && res.success) {
                        if (window.AppDialog) AppDialog.toastSuccess('Đã tạm dừng tác vụ.');
                        loadTasks();
                    } else {
                        if (window.AppDialog) AppDialog.error(res ? res.message : 'Không thể tạm dừng tác vụ.', 'Lỗi');
                        else alert(res ? res.message : 'Không thể tạm dừng tác vụ.');
                    }
                }).fail(function (xhr) {
                    $btn.prop('disabled', false).html('<i class="bi bi-pause-fill"></i> Dừng tác vụ');
                    if (window.AppDialog) AppDialog.handleAjaxError(xhr, 'Lỗi kết nối máy chủ.');
                    else alert('Lỗi kết nối máy chủ.');
                });
            });

            // ==========================================
            // THAO TÁC 3: SỬA TÁC VỤ (MODAL EDIT TASK)
            // ==========================================
            $(document).on('click', '.btn-task-edit', function () {
                var taskId = $(this).data('id');
                var task = currentTasksCache.find(function (t) { return t.TaskID === taskId; });
                if (!task) return;

                $('#editTaskId').val(task.TaskID);
                $('#editTaskName').val(task.TaskName);
                $('#editUserPrompt').val(task.UserPrompt);
                $('#editScheduleType').val(task.ScheduleType);
                $('#editSpecificRunTime').val('');

                if (task.ScheduleType === 'interval') {
                    $('#groupEditScheduleConfig').show();
                    $('#editScheduleConfig').val(task.ScheduleConfig || '30');
                } else {
                    $('#groupEditScheduleConfig').hide();
                }

                var $btnSave = $('#btnSaveTaskChanges');
                $btnSave.prop('disabled', false).html('<i class="bi bi-save"></i> Lưu thay đổi');
                $('#modalEditTask').modal('show');
            });

            $('#editScheduleType').on('change', function () {
                if ($(this).val() === 'interval') {
                    $('#groupEditScheduleConfig').show();
                } else {
                    $('#groupEditScheduleConfig').hide();
                }
            });

            $('#btnSaveTaskChanges').on('click', function () {
                var taskName = $('#editTaskName').val().trim();
                var userPrompt = $('#editUserPrompt').val().trim();

                if (!taskName) {
                    if (window.AppDialog) AppDialog.warning('Vui lòng nhập tên tác vụ.', 'Thông tin bắt buộc');
                    else alert('Vui lòng nhập tên tác vụ.');
                    $('#editTaskName').focus();
                    return;
                }
                if (!userPrompt) {
                    if (window.AppDialog) AppDialog.warning('Vui lòng nhập yêu cầu / prompt cho Agent.', 'Thông tin bắt buộc');
                    else alert('Vui lòng nhập yêu cầu / prompt cho Agent.');
                    $('#editUserPrompt').focus();
                    return;
                }

                var payload = {
                    taskId: $('#editTaskId').val(),
                    taskName: taskName,
                    userPrompt: userPrompt,
                    scheduleType: $('#editScheduleType').val(),
                    scheduleConfig: $('#editScheduleConfig').val(),
                    specificRunTime: $('#editSpecificRunTime').val()
                };

                var $btn = $(this);
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm mr-1"></span> Đang lưu...');

                $.post('@Url.Action("UpdateTask", "Assistant")', payload, function (res) {
                    $btn.prop('disabled', false).html('<i class="bi bi-save"></i> Lưu thay đổi');
                    if (res && res.success) {
                        if (window.AppDialog) AppDialog.toastSuccess('Đã lưu thay đổi tác vụ.');
                        $('#modalEditTask').modal('hide');
                        loadTasks();
                    } else {
                        if (window.AppDialog) AppDialog.error(res ? res.message : 'Lỗi khi lưu thay đổi tác vụ.', 'Lỗi');
                        else alert(res ? res.message : 'Lỗi khi lưu thay đổi tác vụ.');
                    }
                }).fail(function (xhr) {
                    $btn.prop('disabled', false).html('<i class="bi bi-save"></i> Lưu thay đổi');
                    if (window.AppDialog) AppDialog.handleAjaxError(xhr, 'Lỗi kết nối máy chủ.');
                    else alert('Lỗi kết nối máy chủ.');
                });
            });

            // ==========================================
            // THAO TÁC 4: XEM LỊCH CHẠY (RUN HISTORY & DETAILS)
            // ==========================================
            $(document).on('click', '.btn-task-runs', function () {
                var taskId = $(this).data('id');
                var taskName = $(this).data('name') || ('#' + taskId);

                $('#lblTaskRunTitle').text(taskName);
                $('#taskRunDetailsContainer').hide();
                $('#tblTaskRunsBody').html('<tr><td colspan="6" class="text-center text-white-50 py-3"><div class="spinner-border spinner-border-sm text-info mr-2"></div> Đang tải lịch sử...</td></tr>');
                $('#modalTaskRuns').modal('show');

                $.get('@Url.Action("GetTaskRuns", "Assistant")', { taskId: taskId }, function (res) {
                    if (res && res.success && res.data) {
                        if (res.data.length === 0) {
                            $('#tblTaskRunsBody').html('<tr><td colspan="6" class="text-center text-white-50 py-3">Tác vụ này chưa có lượt chạy nào.</td></tr>');
                            return;
                        }

                        var rows = '';
                        res.data.forEach(function (r) {
                            var statusColor = r.Status === 'Succeeded' ? 'text-success' : (r.Status === 'Running' ? 'text-info' : 'text-danger');
                            rows += '<tr>' +
                                '<td><code>#' + r.RunID + '</code></td>' +
                                '<td class="small text-white-50">' + (r.StartedAt || '—') + '</td>' +
                                '<td class="small text-white-50">' + (r.FinishedAt || '—') + '</td>' +
                                '<td><span class="' + statusColor + ' font-weight-bold">' + r.Status + '</span></td>' +
                                '<td class="small text-white-50 text-truncate" style="max-width: 220px;" title="' + $('<div>').text(r.ResultSummary || r.ErrorMessage || '').html() + '">' + $('<div>').text(r.ResultSummary || r.ErrorMessage || '—').html() + '</td>' +
                                '<td class="text-right"><button class="btn btn-xs btn-outline-info btn-run-detail" data-id="' + r.RunID + '">Chi tiết</button></td>' +
                            '</tr>';
                        });
                        $('#tblTaskRunsBody').html(rows);
                    } else {
                        $('#tblTaskRunsBody').html('<tr><td colspan="6" class="text-center text-danger py-3">' + (res.message || 'Lỗi khi tải lịch sử.') + '</td></tr>');
                    }
                });
            });

            // Xem chi tiết 1 lượt chạy cụ thể (kèm Action Logs)
            $(document).on('click', '.btn-run-detail', function () {
                var runId = $(this).data('id');
                var $c = $('#taskRunDetailsContainer');
                $c.show().html('<div class="text-center text-white-50 py-2"><div class="spinner-border spinner-border-sm text-info mr-2"></div> Đang tải chi tiết lượt chạy #' + runId + '...</div>');

                $.get('@Url.Action("GetRunDetails", "Assistant")', { runId: runId }, function (res) {
                    if (res && res.success && res.data) {
                        var d = res.data;
                        var logHtml = '';
                        if (d.Logs && d.Logs.length > 0) {
                            logHtml += '<div class="mt-2"><strong class="small text-info">Nhật ký hành động đã gọi:</strong><ul class="mb-0 pl-3 small text-white-50">';
                            d.Logs.forEach(function (l) {
                                logHtml += '<li><code>' + l.ActionName + '</code> - Mục tiêu: ' + l.TargetType + (l.TargetID ? ' #' + l.TargetID : '') + ' - <span class="' + (l.Status === 'Succeeded' ? 'text-success' : 'text-danger') + '">' + l.Status + '</span> (' + (l.ResultSummary || l.ErrorMessage || '') + ')</li>';
                            });
                            logHtml += '</ul></div>';
                        }

                        $c.html(
                            '<div class="d-flex justify-content-between align-items-center mb-2">' +
                                '<strong class="text-info">Chi tiết lượt chạy #' + d.RunID + '</strong>' +
                                '<button type="button" class="close text-white" onclick="$(\'#taskRunDetailsContainer\').hide();"><span>&times;</span></button>' +
                            '</div>' +
                            '<div class="small text-white-50 mb-1">Thời gian: ' + d.StartedAt + ' &rarr; ' + (d.FinishedAt || 'Đang chạy') + '</div>' +
                            '<div class="small mb-1">Trạng thái: <span class="font-weight-bold ' + (d.Status === 'Succeeded' ? 'text-success' : 'text-danger') + '">' + d.Status + '</span></div>' +
                            '<div class="small text-white-50 mb-1">Tóm tắt kết quả: <span class="text-white">' + $('<div>').text(d.ResultSummary || '—').html() + '</span></div>' +
                            (d.ErrorMessage ? '<div class="small text-danger mb-1">Lỗi: ' + $('<div>').text(d.ErrorMessage).html() + '</div>' : '') +
                            logHtml
                        );
                    } else {
                        $c.html('<div class="text-danger small">' + (res.message || 'Không thể tải chi tiết.') + '</div>');
                    }
                });
            });

            // ==========================================
            // THAO TÁC 5: XÓA TÁC VỤ (CÓ HỘP THOẠI XÁC NHẬN)
            // ==========================================
            $(document).on('click', '.btn-task-delete', function () {
                var taskId = $(this).data('id');
                var taskName = $(this).data('name') || ('#' + taskId);

                $('#deleteTaskId').val(taskId);
                $('#lblDeleteTaskId').text(taskId);
                $('#lblDeleteTaskName').text(taskName);

                var $btnConfirm = $('#btnConfirmDeleteTask');
                $btnConfirm.prop('disabled', false).html('<i class="bi bi-trash-fill"></i> Xóa tác vụ');
                $('#modalConfirmDeleteTask').modal('show');
            });

            $('#btnConfirmDeleteTask').on('click', function () {
                var taskId = $('#deleteTaskId').val();
                var $btn = $(this);
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm mr-1"></span> Đang xóa...');

                $.post('@Url.Action("DeleteTask", "Assistant")', { taskId: taskId }, function (res) {
                    $btn.prop('disabled', false).html('<i class="bi bi-trash-fill"></i> Xóa tác vụ');
                    $('#modalConfirmDeleteTask').modal('hide');

                    if (res && res.success) {
                        if (window.AppDialog) AppDialog.toastSuccess('Đã xóa tác vụ thành công.');
                        loadTasks();
                    } else {
                        if (window.AppDialog) AppDialog.error(res ? res.message : 'Không thể xóa tác vụ.', 'Lỗi');
                        else alert(res ? res.message : 'Không thể xóa tác vụ.');
                    }
                }).fail(function (xhr) {
                    $btn.prop('disabled', false).html('<i class="bi bi-trash-fill"></i> Xóa tác vụ');
                    if (window.AppDialog) AppDialog.handleAjaxError(xhr, 'Lỗi kết nối máy chủ.');
                    else alert('Lỗi kết nối máy chủ.');
                });
            });

            // ==========================================
            // AGENT CONVERSATIONS MANAGEMENT (QUẢN LÝ PHIÊN HỘI THOẠI)
            // ==========================================
            var convCurrentPage = 1;
            var convTotalPages = 1;

            $('#btnOpenConversations').on('click', function () {
                $('#modalConversations').modal('show');
                convCurrentPage = 1;
                loadConversations();
            });

            $('#btnModalNewConv').on('click', function () {
                $('#modalConversations').modal('hide');
                updateSessionBanner(null);
                window.history.replaceState(null, null, window.location.pathname);
                $container.find('.msg-row:not(:first)').remove();
                $input.val('').prop('disabled', false).focus();
                $btnSend.prop('disabled', false);
                appendAiMessage('✨ Đã bắt đầu phiên hội thoại mới. Mời bạn nhập yêu cầu cho Mr. T nhé!');
                showAgentToast('info', 'Đã chuyển sang phiên hội thoại mới.');
            });

            function loadConversations() {
                var keyword = ($('#filterConvKeyword').val() || '').trim();
                var status = $('#filterConvStatus').val();
                var $tbody = $('#tblConversationsBody');
                $tbody.html('<tr><td colspan="6" class="text-center text-white-50 py-3"><div class="spinner-border spinner-border-sm text-info mr-2"></div> Đang tải danh sách phiên...</td></tr>');

                $.get('@Url.Action("GetConversations", "Assistant")', { page: convCurrentPage, pageSize: 10, keyword: keyword, status: status }, function (res) {
                    if (res && res.success && res.data) {
                        convTotalPages = res.totalPages || 1;
                        $('#lblConvPaginationInfo').text('Hiển thị ' + res.data.length + ' / tổng số ' + res.total + ' phiên');
                        $('#lblConvCurrentPage').text('Trang ' + res.page + ' / ' + (res.totalPages || 1));
                        $('#btnConvPrevPage').prop('disabled', res.page <= 1);
                        $('#btnConvNextPage').prop('disabled', res.page >= res.totalPages);

                        if (res.data.length === 0) {
                            $tbody.html('<tr><td colspan="6" class="text-center text-white-50 py-3">Chưa có phiên hội thoại nào phù hợp với điều kiện tìm kiếm.</td></tr>');
                            return;
                        }

                        var rows = '';
                        res.data.forEach(function (c) {
                            var statusBadge;
                            if (c.Status === 'Active') {
                                statusBadge = '<span class="badge badge-success">Active</span>';
                            } else if (c.Status === 'Completed') {
                                statusBadge = '<span class="badge badge-info">Completed</span>';
                            } else if (c.Status === 'Paused') {
                                statusBadge = '<span class="badge badge-warning">Paused</span>';
                            } else {
                                statusBadge = '<span class="badge badge-danger">' + c.Status + '</span>';
                            }

                            var taskBadge = c.TaskID ? ' <span class="badge badge-secondary ml-1" title="Liên kết tác vụ #' + c.TaskID + '"><i class="bi bi-calendar2-check"></i> Task #' + c.TaskID + '</span>' : '';

                            rows += '<tr>' +
                                '<td>' +
                                    '<div class="font-weight-bold text-white text-truncate" style="max-width: 320px;" title="' + $('<div>').text(c.Title).html() + '">' +
                                        $('<div>').text(c.Title).html() + taskBadge +
                                    '</div>' +
                                    '<div class="small text-white-50">Mã phiên: <code>#' + c.ConversationID + '</code></div>' +
                                '</td>' +
                                '<td class="small text-white-50">' + c.CreatedAt + '</td>' +
                                '<td class="small text-info font-weight-bold">' + c.LastMessageAt + '</td>' +
                                '<td><span class="badge badge-dark text-white border border-secondary">' + c.MessageCount + ' tin</span></td>' +
                                '<td>' + statusBadge + '</td>' +
                                '<td class="text-right" style="white-space: nowrap;">' +
                                    '<div class="btn-group btn-group-sm" role="group">' +
                                        '<button class="btn btn-xs btn-outline-primary btn-resume-conv" data-id="' + c.ConversationID + '" title="Mở lại và tiếp tục trò chuyện"><i class="bi bi-box-arrow-in-right"></i> Tiếp tục</button>' +
                                        '<button class="btn btn-xs btn-outline-info btn-detail-conv" data-id="' + c.ConversationID + '" title="Xem chi tiết phiên & hành động Agent"><i class="bi bi-eye"></i></button>' +
                                        '<button class="btn btn-xs btn-outline-secondary btn-rename-conv-modal" data-id="' + c.ConversationID + '" data-title="' + $('<div>').text(c.Title).html() + '" title="Sửa tiêu đề phiên"><i class="bi bi-pencil"></i></button>' +
                                        '<button class="btn btn-xs btn-outline-danger btn-delete-conv-modal" data-id="' + c.ConversationID + '" data-title="' + $('<div>').text(c.Title).html() + '" data-count="' + c.MessageCount + '" title="Xóa phiên"><i class="bi bi-trash"></i></button>' +
                                    '</div>' +
                                '</td>' +
                            '</tr>';
                        });
                        $tbody.html(rows);
                    } else {
                        $tbody.html('<tr><td colspan="6" class="text-center text-danger py-3">' + (res.message || 'Lỗi khi tải danh sách phiên.') + '</td></tr>');
                        showAgentToast('error', res.message || 'Lỗi khi tải danh sách phiên.');
                    }
                }).fail(function () {
                    $tbody.html('<tr><td colspan="6" class="text-center text-danger py-3">Lỗi kết nối máy chủ.</td></tr>');
                    showAgentToast('error', 'Lỗi kết nối máy chủ khi nạp danh sách phiên.');
                });
            }

            $('#btnFilterConvs').on('click', function () {
                convCurrentPage = 1;
                loadConversations();
            });

            $('#filterConvKeyword').on('keypress', function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    convCurrentPage = 1;
                    loadConversations();
                }
            });

            $('#filterConvStatus').on('change', function () {
                convCurrentPage = 1;
                loadConversations();
            });

            $('#btnResetFilterConvs').on('click', function () {
                $('#filterConvKeyword').val('');
                $('#filterConvStatus').val('All');
                convCurrentPage = 1;
                loadConversations();
            });

            $('#btnConvPrevPage').on('click', function () {
                if (convCurrentPage > 1) {
                    convCurrentPage--;
                    loadConversations();
                }
            });

            $('#btnConvNextPage').on('click', function () {
                if (convCurrentPage < convTotalPages) {
                    convCurrentPage++;
                    loadConversations();
                }
            });

            // Mở lại phiên hội thoại (Resume Conversation) và nạp toàn bộ tin nhắn vào giao diện
            function resumeConversation(convId) {
                $container.find('.msg-row:not(:first)').remove();
                appendAiMessage('⏳ Đang nạp lịch sử phiên hội thoại #' + convId + '...');

                $.get('@Url.Action("GetConversationDetail", "Assistant")', { conversationId: convId }, function (res) {
                    if (res && res.success && res.data) {
                        var d = res.data;
                        updateSessionBanner(d);
                        window.history.replaceState(null, null, '?conversationId=' + d.ConversationID);

                        // Xóa tin nhắn tạm
                        $container.find('.msg-row:not(:first)').remove();

                        // Nạp lại từng tin nhắn theo đúng thứ tự
                        if (d.Messages && d.Messages.length > 0) {
                            d.Messages.forEach(function (m) {
                                var sender = (m.SenderType || '').toLowerCase();
                                if (sender === 'user') {
                                    appendUserMessage(m.Content);
                                } else {
                                    var extraInfo = '';
                                    if (m.ToolCallDetails) {
                                        extraInfo += '<div class="mt-2 p-2 rounded" style="background: rgba(0,200,255,0.06); border: 1px solid rgba(0,200,255,0.2); font-size: 11px;">' +
                                            '<strong class="text-info"><i class="bi bi-gear-fill"></i> Công cụ đã dùng:</strong> ' + $('<div>').text(m.ToolCallDetails).html() +
                                            '</div>';
                                    }
                                    if (m.ErrorMessage) {
                                        extraInfo += '<div class="mt-1 text-danger small font-italic"><i class="bi bi-exclamation-triangle"></i> ' + $('<div>').text(m.ErrorMessage).html() + '</div>';
                                    }

                                    var formatted = formatAiText(m.Content) + extraInfo;
                                    var html = '<div class="msg-row ai">' +
                                        '<div class="msg-avatar"><i class="bi bi-robot"></i></div>' +
                                        '<div class="msg-bubble">' + formatted + '</div>' +
                                        '</div>';
                                    $typing.before(html);
                                }
                            });
                        } else {
                            appendAiMessage('Phiên hội thoại này chưa có tin nhắn nào.');
                        }

                        // Nếu có tác vụ lịch liên kết, hiển thị thông báo trạng thái
                        if (d.LinkedTask) {
                            var lt = d.LinkedTask;
                            appendAiMessage('📌 <strong>Tác vụ lịch liên kết với phiên này:</strong> ' + $('<div>').text(lt.TaskName).html() +
                                ' (ID #' + lt.TaskID + ') — Trạng thái: <strong>' + lt.Status + '</strong>' +
                                (lt.NextRunAt ? ' · Lần chạy tiếp: ' + lt.NextRunAt : '') +
                                '. Bạn có thể trò chuyện với mình để kiểm tra hoặc cập nhật tác vụ này!');
                        }

                        scrollToBottom();
                        $input.prop('disabled', false).focus();
                        $btnSend.prop('disabled', false);
                        showAgentToast('info', 'Đã mở lại phiên #' + d.ConversationID + ' thành công.');
                    } else {
                        showAgentToast('error', res.message || 'Không thể tải phiên hội thoại.');
                    }
                }).fail(function () {
                    showAgentToast('error', 'Lỗi kết nối máy chủ khi nạp phiên hội thoại.');
                });
            }

            $(document).on('click', '.btn-resume-conv', function () {
                var convId = $(this).data('id');
                $('#modalConversations').modal('hide');
                resumeConversation(convId);
            });

            // Xem chi tiết phiên & các hành động Agent trong phiên
            $(document).on('click', '.btn-detail-conv', function () {
                var convId = $(this).data('id');
                openConversationDetail(convId);
            });

            $('#btnViewSessionDetails').on('click', function () {
                if (currentConversationId > 0) {
                    openConversationDetail(currentConversationId);
                }
            });

            function openConversationDetail(convId) {
                $('#detailConvId').text(convId);
                $('#detailConvTitle').text('Đang tải...');
                $('#detailConvMeta').text('...');
                $('#groupLinkedTask').hide();
                $('#groupLinkedLogs').hide();
                $('#detailConvMessagesPreview').html('<div class="text-center text-white-50 py-2 small">Đang nạp dữ liệu...</div>');
                $('#btnResumeFromDetail').data('id', convId);

                $('#modalConversationDetail').modal('show');

                $.get('@Url.Action("GetConversationDetail", "Assistant")', { conversationId: convId }, function (res) {
                    if (res && res.success && res.data) {
                        var d = res.data;
                        $('#detailConvTitle').text(d.Title);
                        $('#detailConvMeta').html('Tạo lúc: ' + d.CreatedAt + ' · Tương tác cuối: ' + d.LastMessageAt + ' · Trạng thái: <strong class="text-info">' + d.Status + '</strong>');
                        $('#detailConvMsgCount').text(d.MessageCount);

                        // Tác vụ lịch liên kết
                        if (d.LinkedTask) {
                            var t = d.LinkedTask;
                            $('#groupLinkedTask').show();
                            $('#detailLinkedTaskName').text(t.TaskName + ' (ID #' + t.TaskID + ')');
                            $('#detailLinkedTaskPrompt').text('Yêu cầu: ' + t.UserPrompt);
                            $('#detailLinkedTaskStatus').text(t.Status);
                            $('#detailLinkedTaskSchedule').text(t.ScheduleType + (t.ScheduleConfig ? ' (' + t.ScheduleConfig + ')' : ''));
                            $('#detailLinkedTaskNextRun').text(t.NextRunAt || '—');
                        } else {
                            $('#groupLinkedTask').hide();
                        }

                        // Nhật ký hành động Agent đã gọi trong phiên
                        if (d.LinkedLogs && d.LinkedLogs.length > 0) {
                            var logRows = '';
                            d.LinkedLogs.forEach(function (l) {
                                var sColor = l.Status === 'Succeeded' ? 'text-success' : 'text-danger';
                                logRows += '<tr>' +
                                    '<td class="text-white-50">' + l.CreatedAt + '</td>' +
                                    '<td><code>' + l.ActionName + '</code></td>' +
                                    '<td><span class="' + sColor + '">' + l.Status + '</span></td>' +
                                    '<td class="text-truncate text-white-50" style="max-width: 250px;">' + $('<div>').text(l.ResultSummary || l.ErrorMessage || '—').html() + '</td>' +
                                '</tr>';
                            });
                            $('#tblLinkedLogsBody').html(logRows);
                            $('#groupLinkedLogs').show();
                        } else {
                            $('#groupLinkedLogs').hide();
                        }

                        // Preview tin nhắn
                        if (d.Messages && d.Messages.length > 0) {
                            var msgHtml = '';
                            d.Messages.forEach(function (m) {
                                var isUser = (m.SenderType || '').toLowerCase() === 'user';
                                var badge = isUser ? '<span class="badge badge-primary mr-1">Bạn</span>' : '<span class="badge badge-info mr-1">Mr. T</span>';
                                msgHtml += '<div class="mb-2 pb-2" style="border-bottom: 1px solid rgba(255,255,255,0.05);">' +
                                    '<div class="d-flex justify-content-between align-items-center mb-1">' +
                                        '<div>' + badge + ' <span class="small text-white-50">' + m.CreatedAt + '</span></div>' +
                                    '</div>' +
                                    '<div class="small text-white">' + $('<div>').text(m.Content).html() + '</div>' +
                                    '</div>';
                            });
                            $('#detailConvMessagesPreview').html(msgHtml);
                        } else {
                            $('#detailConvMessagesPreview').html('<div class="text-white-50 small p-2">Chưa có tin nhắn trong phiên này.</div>');
                        }
                    } else {
                        showAgentToast('error', res.message || 'Không thể tải chi tiết phiên.');
                    }
                }).fail(function () {
                    showAgentToast('error', 'Lỗi kết nối máy chủ khi nạp chi tiết phiên.');
                });
            }

            $('#btnResumeFromDetail').on('click', function () {
                var convId = $(this).data('id');
                $('#modalConversationDetail').modal('hide');
                $('#modalConversations').modal('hide');
                resumeConversation(convId);
            });

            // Sửa tiêu đề phiên hội thoại
            $(document).on('click', '.btn-rename-conv-modal', function () {
                var convId = $(this).data('id');
                var currentTitle = $(this).data('title');
                openRenameModal(convId, currentTitle);
            });

            $('#btnRenameSession').on('click', function () {
                if (currentConversationId > 0) {
                    var currentTitle = $('#lblSessionTitle').text();
                    openRenameModal(currentConversationId, currentTitle);
                }
            });

            function openRenameModal(convId, title) {
                $('#lblRenameConvId').text(convId);
                $('#renameConvId').val(convId);
                $('#txtRenameConvTitle').val(title);
                $('#errRenameConvTitle').hide().text('');
                $('#btnConfirmRenameConv').prop('disabled', false).html('<i class="bi bi-check-lg"></i> Lưu thay đổi');
                $('#modalRenameConversation').modal('show');
                setTimeout(function () {
                    $('#txtRenameConvTitle').focus().select();
                }, 400);
            }

            $('#txtRenameConvTitle').on('input', function () {
                $('#errRenameConvTitle').hide().text('');
            });

            $('#txtRenameConvTitle').on('keypress', function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    $('#btnConfirmRenameConv').click();
                }
            });

            $('#btnConfirmRenameConv').on('click', function () {
                var convId = $('#renameConvId').val();
                var newTitle = ($('#txtRenameConvTitle').val() || '').trim();
                var $err = $('#errRenameConvTitle');

                if (!newTitle) {
                    $err.text('Vui lòng nhập tiêu đề cho phiên hội thoại.').show();
                    $('#txtRenameConvTitle').focus();
                    return;
                }
                if (newTitle.length > 200) {
                    $err.text('Tiêu đề phiên không được vượt quá 200 ký tự.').show();
                    $('#txtRenameConvTitle').focus();
                    return;
                }

                var $btn = $(this);
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm mr-1"></span> Đang lưu...');

                $.post('@Url.Action("UpdateConversationTitle", "Assistant")', { conversationId: convId, title: newTitle }, function (res) {
                    $btn.prop('disabled', false).html('<i class="bi bi-check-lg"></i> Lưu thay đổi');
                    if (res && res.success) {
                        $('#modalRenameConversation').modal('hide');
                        if (currentConversationId == convId) {
                            $('#lblSessionTitle').text(newTitle);
                        }
                        showAgentToast('success', 'Đã cập nhật tiêu đề phiên #' + convId + ' thành công.');
                        loadConversations();
                    } else {
                        $err.text(res.message || 'Lỗi khi cập nhật tiêu đề.').show();
                    }
                }).fail(function () {
                    $btn.prop('disabled', false).html('<i class="bi bi-check-lg"></i> Lưu thay đổi');
                    $err.text('Lỗi kết nối máy chủ. Vui lòng thử lại sau.').show();
                });
            });

            // Xóa phiên hội thoại (Có hộp thoại xác nhận)
            $(document).on('click', '.btn-delete-conv-modal', function () {
                var convId = $(this).data('id');
                var title = $(this).data('title');
                var count = $(this).data('count');

                $('#deleteConvId').val(convId);
                $('#lblDeleteConvId').text(convId);
                $('#lblDeleteConvTitle').text(title);
                $('#lblDeleteConvMsgCount').text(count + ' tin nhắn');

                var $btnConfirm = $('#btnConfirmDeleteConv');
                $btnConfirm.prop('disabled', false).html('<i class="bi bi-trash-fill"></i> Xác nhận xóa');
                $('#modalConfirmDeleteConversation').modal('show');
            });

            $('#btnConfirmDeleteConv').on('click', function () {
                var convId = $('#deleteConvId').val();
                var $btn = $(this);
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm mr-1"></span> Đang xóa...');

                $.post('@Url.Action("DeleteConversation", "Assistant")', { conversationId: convId }, function (res) {
                    $btn.prop('disabled', false).html('<i class="bi bi-trash-fill"></i> Xác nhận xóa');
                    $('#modalConfirmDeleteConversation').modal('hide');

                    if (res && res.success) {
                        showAgentToast('success', 'Đã xóa phiên hội thoại #' + convId + ' thành công.');
                        if (currentConversationId == convId) {
                            updateSessionBanner(null);
                            window.history.replaceState(null, null, window.location.pathname);
                            $container.find('.msg-row:not(:first)').remove();
                            appendAiMessage('✨ Phiên hội thoại đã được xóa thành công. Bạn đang ở phiên hội thoại mới.');
                        }
                        loadConversations();
                    } else {
                        showAgentToast('error', res.message || 'Lỗi khi xóa phiên hội thoại.');
                    }
                }).fail(function () {
                    $btn.prop('disabled', false).html('<i class="bi bi-trash-fill"></i> Xác nhận xóa');
                    showAgentToast('error', 'Lỗi kết nối máy chủ khi xóa phiên.');
                });
            });

            // Tự động mở lại phiên nếu có InitialConversationId trên URL (?conversationId=...)
            if (currentConversationId > 0) {
                resumeConversation(currentConversationId);
            }
        });
    </script>
}
