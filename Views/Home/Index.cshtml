                                            <li><a class="dropdown-item" href="javascript:void(0)" onclick="copyShareLink('@Url.Action("Details", "Connect", new { id = c.PostID })')"><i class="fa-solid fa-link me-2"></i>Sao chép liên kết</a></li>
                                            @if (currentUser != null && c.UserID != currentUser.UserID) { <li><a class="dropdown-item text-danger" href="javascript:void(0)" onclick="reportPost('connect', @c.PostID)"><i class="fa-solid fa-flag me-2"></i>Tố cáo bài đăng</a></li> }
