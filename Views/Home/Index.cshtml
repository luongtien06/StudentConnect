                            <div class="banner-market-grid">
                                <div class="item-card"><div class="item-thumb">📚</div><div class="item-body"><div class="item-name">Giáo trình CSDL</div><div class="item-price">45.000đ</div></div></div>
                                <div class="item-card"><div class="item-thumb">🎧</div><div class="item-body"><div class="item-name">Tai nghe cũ</div><div class="item-price">120.000đ</div></div></div>
                                <div class="item-card"><div class="item-thumb">🚲</div><div class="item-body"><div class="item-name">Xe đạp campus</div><div class="item-price">1.2tr</div></div></div>
                                <div class="item-card"><div class="item-thumb">💻</div><div class="item-body"><div class="item-name">Laptop học tập</div><div class="item-price">4.5tr</div></div></div>
                            </div>
                        </div>
                    </div>
                </article>
                <article class="hero-slide slide-connect" data-accent="#a87fff" aria-hidden="true">
                    <div class="slide-copy">
                        <span class="mod-tag tag-connect">KẾT NỐI</span>
                        <p class="slide-kicker">Quán ăn, cafe, việc làm được review bởi chính sinh viên.</p>
                        <h2 class="slide-title">Kết nối, <em>khám phá</em> đời sống quanh trường</h2>
                        <p class="slide-desc">Đánh giá địa điểm, chia sẻ tin part-time và tìm cộng đồng cùng sở thích. Mọi gợi ý đều đến từ người đang học tại đây.</p>
                        <ul class="slide-points">
                            <li>Review địa điểm</li>
                            <li>Chia sẻ kinh nghiệm</li>
                            <li>Cộng đồng TDMU</li>
                        </ul>
                        <a href="@Url.Action("Index", "Connect")" class="slide-cta">Khám phá<span class="cta-arrow">→</span></a>
                    </div>
                    <div class="slide-visual" aria-hidden="true">
                        <div class="visual-frame">
                            <div class="visual-top"><span class="dot r"></span><span class="dot y"></span><span class="dot g"></span> connect · nearby</div>
                            <div class="connect-list">
                                <div class="place-row"><div class="place-ico">☕</div><div><div class="place-name">Cafe cuối tuần</div><div class="place-sub">Cách cổng A · 4 phút</div></div><div class="place-stars">★★★★★</div></div>
                                <div class="place-row"><div class="place-ico">🍜</div><div><div class="place-name">Cơm tấm sinh viên</div><div class="place-sub">Giá từ 25k</div></div><div class="place-stars">★★★★☆</div></div>
                                <div class="place-row"><div class="place-ico">💼</div><div><div class="place-name">Part-time barista</div><div class="place-sub">Tuyển gấp · ca tối</div></div><div class="place-stars">HOT</div></div>
                            </div>
                        </div>
                    </div>
                </article>
            </div>
            <div class="banner-footer">
                <button type="button" class="banner-btn" id="bannerPrev" aria-label="Banner trước">‹</button>
                <div class="hero-dots" role="tablist" aria-label="Chọn banner">
                    <button type="button" class="hero-dot is-active" data-index="0" aria-label="Chat ẩn danh"></button>
                    <button type="button" class="hero-dot" data-index="1" aria-label="Chợ sinh viên"></button>
                    <button type="button" class="hero-dot" data-index="2" aria-label="Kết nối TDMU"></button>
                </div>
                <button type="button" class="banner-btn" id="bannerNext" aria-label="Banner sau">›</button>
                <div class="progress-track" aria-hidden="true"><div class="progress-bar" id="bannerProgress"></div></div>
            </div>
        </div>
        <!-- ====== 2. KHAY TIN 24H (TDMU STORIES TRAY)======== -->
        <div class="mt-4">
            @Html.Action("StoryTrayPartial", "Story")
        </div>
        <!-- ======= 3. KHU VỰC TÌM KIẾM & GỢI Ý BẠN BÈ (FACEBOOK-STYLE HORIZONTAL HUB)=========== -->
        <section class="home-friends-hub" id="homeFriendsHub">
            <!-- PHẦN 1: THANH TÌM KIẾM BẠN BÈ TRỰC TIẾP -->
            <div class="home-friend-search-wrap">
                <div class="friend-search-input-box">
                    <i class="fa-solid fa-magnifying-glass search-icon"></i>
                    <input type="text" id="homeFriendSearchInput" class="friend-search-input" 
                           placeholder="Tìm bạn bè theo họ tên, tên tài khoản, khoa, ngành..." autocomplete="off" />
                    <button type="button" id="btnClearFriendSearch" class="btn-clear-search d-none" onclick="clearFriendSearch()" title="Xóa tìm kiếm">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                    <span id="friendSearchSpinner" class="search-spinner d-none">
                        <i class="fa-solid fa-circle-notch fa-spin"></i>
                    </span>
                </div>
                <!-- Live Search Results Dropdown -->
                <div id="friendSearchResults" class="friend-search-results-dropdown d-none">
                    <div class="d-flex align-items-center justify-content-between pb-2 mb-2 border-bottom border-secondary border-opacity-25 px-1">
                        <span class="small text-white-50"><i class="fa-solid fa-users me-1 text-cyan"></i>Kết quả tìm kiếm</span>
                        <button type="button" class="btn-close-results" onclick="$('#friendSearchResults').addClass('d-none');" title="Đóng">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                    <div id="friendSearchResultsList" class="search-results-list"></div>
                    <div id="friendSearchPagination" class="text-center pt-2 d-none">
                        <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-3" onclick="loadMoreFriendSearch()">
                            <i class="fa-solid fa-chevron-down me-1"></i>Xem thêm kết quả
                        </button>
                    </div>
                </div>
            </div>
            <!-- PHẦN 2: GỢI Ý BẠN BÈ NẰM NGANG KIỂU FACEBOOK (CAROUSEL) -->
            <div class="home-suggestions-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="suggestions-badge-icon">
                        <i class="fa-solid fa-user-group text-cyan"></i>
                    </div>
                    <div>
                        <h3 class="suggestions-title">Những người bạn có thể biết</h3>
                        <p class="suggestions-subtitle">Gợi ý dựa trên bạn chung và khoa viện</p>
                    </div>
                </div>
                <div class="suggestions-controls">
                    <button type="button" class="btn-scroll-arrow" id="btnScrollSugLeft" onclick="scrollSuggestions('left')" title="Cuộn sang trái">
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>
                    <button type="button" class="btn-scroll-arrow" id="btnScrollSugRight" onclick="scrollSuggestions('right')" title="Cuộn sang phải">
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                    <button type="button" class="btn-refresh-suggestions" id="btnRefreshSuggestions" onclick="refreshFriendSuggestions()" title="Làm mới danh sách gợi ý">
                        <i class="fa-solid fa-arrows-rotate"></i>
                        <span>Làm mới</span>
                    </button>
                </div>
            </div>
            <!-- Viewport & Horizontal Track -->
            <div class="suggestions-horizontal-viewport" id="suggestionsViewport">
                <div class="suggestions-horizontal-track" id="suggestedFriendsTrack">
                    @if (initialSuggestions != null && initialSuggestions.Any())
                    {
                        foreach (var s in initialSuggestions)
                        {
                            <div class="sug-card" id="suggestion-user-@s.UserID" data-user-id="@s.UserID">
                                <button type="button" class="sug-card-dismiss" onclick="dismissSuggestion(@s.UserID)" title="Gỡ gợi ý">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                                <a href="@Url.Action("Profile", "User", new { id = s.UserID })" class="sug-avatar-link">
                                    <img src="@s.Avatar" class="sug-avatar" alt="@s.DisplayName" onerror="this.onerror=null;this.src=window.DEFAULT_AVATAR_SVG||'/Content/Images/default-avatar.png';" />
                                </a>
                                <a href="@Url.Action("Profile", "User", new { id = s.UserID })" class="sug-name" title="@s.DisplayName">
                                    @s.DisplayName
                                </a>
                                <div class="sug-reason" title="@(!string.IsNullOrEmpty(s.Faculty) ? s.Faculty : s.Reason)">
                                    @if (s.MutualFriendsCount > 0)
                                    {
                                        <span class="text-cyan"><i class="fa-solid fa-user-group me-1"></i>@s.MutualFriendsCount bạn chung</span>
                                    }
                                    else if (!string.IsNullOrEmpty(s.Faculty))
                                    {
                                        <span><i class="fa-solid fa-graduation-cap me-1"></i>@s.Faculty</span>
                                    }
                                    else
                                    {
                                        <span><i class="fa-solid fa-sparkles me-1"></i>@s.Reason</span>
                                    }
                                </div>
                                <div class="sug-actions">
                                    @if (s.RelationshipStatus == "PendingSent")
                                    {
                                        <button type="button" class="btn-sug-action btn-pending" data-friend-btn="@s.UserID" onclick="handleFriendAction(@s.UserID, 'cancel', this)" title="Đã gửi lời mời (Bấm để hủy)">
                                            <i class="fa-solid fa-clock me-1"></i>Đã gửi
                                        </button>
                                    }
                                    else if (s.RelationshipStatus == "PendingReceived")
                                    {
                                        <button type="button" class="btn-sug-action btn-accept" data-friend-btn="@s.UserID" onclick="handleFriendAction(@s.UserID, 'accept', this)" title="Chấp nhận lời mời">
                                            <i class="fa-solid fa-check me-1"></i>Chấp nhận
                                        </button>
                                    }
                                    else if (s.RelationshipStatus == "Friends")
                                    {
                                        <button type="button" class="btn-sug-action btn-friends" data-friend-btn="@s.UserID" onclick="handleFriendAction(@s.UserID, 'remove', this)" title="Bạn bè (Bấm để hủy kết bạn)">
                                            <i class="fa-solid fa-user-check me-1"></i>Bạn bè
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn-sug-action btn-add" data-friend-btn="@s.UserID" onclick="handleFriendAction(@s.UserID, 'add', this)" title="Thêm bạn bè">
                                            <i class="fa-solid fa-user-plus me-1"></i>Kết bạn
                                        </button>
                                    }
                                    <button type="button" class="btn-sug-follow @(s.IsFollowing ? "following" : "")" data-follow-btn="@s.UserID" onclick="handleFollowAction(@s.UserID, this)" title="@(s.IsFollowing ? "Bỏ theo dõi" : "Theo dõi")">
                                        <i class="fa-solid @(s.IsFollowing ? "fa-bell-slash text-warning" : "fa-bell")"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-suggestions-state text-center py-4 text-white-50 w-100">
                            <i class="fa-solid fa-user-check fa-2x mb-2 text-cyan opacity-50"></i>
                            <div>Hiện chưa có gợi ý mới. Hãy thử làm mới lại sau nhé!</div>
                        </div>
                    }
                </div>
            </div>
        </section>
        <!-- ==========4. BẢNG TIN TỔNG HỢP (FACEBOOK-STYLE MIXED FEED)========= -->
        <div class="home-feed-wrap">
            <!-- Filter Pills Bar -->
            <div class="feed-filter-bar">
                <button type="button" class="feed-filter-pill active" onclick="filterFeed('all', this)">
                    <i class="fa-solid fa-layer-group"></i> Tất cả
                </button>
                <button type="button" class="feed-filter-pill" onclick="filterFeed('social', this)">
                    <i class="fa-solid fa-newspaper"></i> Bài viết
                </button>
                <button type="button" class="feed-filter-pill" onclick="filterFeed('market', this)">
                    <i class="fa-solid fa-store"></i> Chợ sinh viên
                </button>
                <button type="button" class="feed-filter-pill" onclick="filterFeed('connect', this)">
                    <i class="fa-solid fa-handshake"></i> Kết nối
                </button>
            </div>
            <!-- Quick Create Post Box (if logged in) -->
            @if (currentUser != null) {
                <div class="feed-create-card">
                    <div class="create-input-row">
                        <a href="@Url.Action("Profile", "User", new { id = currentUser.UserID })">
                            <img src="@currentAvatar" class="create-user-avatar" alt="@currentUsername" onerror="this.onerror=null;this.src=window.DEFAULT_AVATAR_SVG||'/Content/Images/default-avatar.png';" />
                        </a>
                        <div class="create-fake-input" data-bs-toggle="modal" data-bs-target="#createPostModal">
                            @currentUsername ơi, bạn đang nghĩ gì thế?
                        </div>
                    </div>
                    <div class="create-options-row">
                        <button type="button" class="btn-create-opt text-success" data-bs-toggle="modal" data-bs-target="#createPostModal">
                            <i class="fa-solid fa-images fa-lg"></i>
                            <span>Ảnh / Video</span>
                        </button>
                        <button type="button" class="btn-create-opt text-warning" data-bs-toggle="modal" data-bs-target="#createStoryModal">
                            <i class="fa-solid fa-circle-play fa-lg"></i>
                            <span>Tạo tin 24h</span>
                        </button>
                        <a href="@Url.Action("Create", "Market")" class="btn-create-opt text-danger text-decoration-none" title="Đăng bán đồ trên Chợ">
                            <i class="fa-solid fa-store fa-lg"></i>
                            <span>Bán đồ Chợ</span>
                        </a>
                        <a href="@Url.Action("Create", "Connect")" class="btn-create-opt text-info text-decoration-none" title="Tạo bài kết nối sinh viên">
                            <i class="fa-solid fa-handshake fa-lg"></i>
                            <span>Tạo kết nối</span>
                        </a>
                    </div>
                </div>
            }
            <!-- Unified Mixed Stream -->
            <div id="homeFeedList">
                @if (feedItems.Any()) {
                    foreach (var item in feedItems) {
                        if (item.ItemType == HomeFeedItemType.SocialPost && item.SocialPost != null) {
                            var post = item.SocialPost;
                            <article class="feed-post-card feed-item-card social-post-card" data-type="social" data-post-id="@post.PostID" id="@(post.SharedPost != null ? "share-" + post.SharedPost.ShareID : "post-" + post.PostID)">
                                <!-- Header -->
                                <div class="post-header">
                                    <div class="post-author-group">
                                        <a href="@Url.Action("Profile", "User", new { id = post.UserID })">
                                            <img src="@post.AuthorAvatar" class="post-author-avatar" alt="@post.AuthorUsername" onerror="this.onerror=null;this.src=window.DEFAULT_AVATAR_SVG||'/Content/Images/default-avatar.png';" />
                                        </a>
                                        <div>
                                            <h4 class="post-author-name">
                                                <a href="@Url.Action("Profile", "User", new { id = post.UserID })" class="text-white text-decoration-none">
                                                    @post.AuthorUsername
                                                </a>
                                                @if (post.IsTDMUStudent) {
                                                    <i class="fa-solid fa-circle-check text-info" style="font-size: 11px;" title="Sinh viên TDMU"></i>
                                                }
                                            </h4>
                                            <div class="post-meta-line">
                                                <span class="feed-type-badge badge-social me-1">Bài viết</span>
                                                <span>·</span>
                                                <span>@post.TimeAgo</span>
                                                <span>·</span>
                                                <i class="@post.PrivacyIcon" title="@post.PrivacyLabel"></i>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-link text-muted p-1" type="button" data-bs-toggle="dropdown">
                                            <i class="fa-solid fa-ellipsis"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                                            <li><a class="dropdown-item" href="@Url.Action("Profile", "User", new { id = post.UserID })#post-@post.PostID"><i class="fa-solid fa-arrow-up-right-from-square me-2"></i>Xem chi tiết</a></li>
                                            <li><a class="dropdown-item" href="javascript:void(0)" onclick="copyShareLink('@Url.Action("Profile", "User", new { id = post.UserID })#post-@post.PostID')"><i class="fa-solid fa-link me-2"></i>Sao chép liên kết</a></li>
                                            @if (currentUser != null && post.UserID != currentUser.UserID) { <li><a class="dropdown-item text-danger" href="javascript:void(0)" onclick="reportPost('feed', @post.PostID)"><i class="fa-solid fa-flag me-2"></i>Tố cáo bài viết</a></li> }
                                            @if (post.CanDelete) {
                                                <li><hr class="dropdown-divider"></li>
                                                if (post.CanEdit) {
                                                    <li><a class="dropdown-item" href="javascript:void(0)" data-content="@post.Content" data-privacy="@post.Privacy" onclick="editPostAjax(@post.PostID, this)"><i class="fa-solid fa-pen-to-square me-2"></i>Sửa bài viết</a></li>
                                                }
                                                <li><a class="dropdown-item text-danger" href="javascript:void(0)" onclick="@(post.SharedPost != null ? "deleteShareAjax(" + post.SharedPost.ShareID + ")" : "deletePostAjax(" + post.PostID + ")")"><i class="fa-solid fa-trash-can me-2"></i>@(post.SharedPost != null ? "Xóa bài chia sẻ" : "Xóa bài viết")</a></li>
                                            }
                                            else {
                                                <li><hr class="dropdown-divider"></li>
                                                <li><a class="dropdown-item" href="javascript:void(0)" onclick="sharePostAjax(@post.PostID)"><i class="fa-solid fa-share-nodes me-2"></i>Chia sẻ bài viết</a></li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                                <!-- Post Content -->
                                @if (!string.IsNullOrEmpty(post.Content)) {
                                    <div class="post-body-content">@post.Content.Trim()</div>
                                }
                                @if (post.SharedPost != null) {
                                    @Html.Partial("~/Views/Shared/_SharedPostPreview.cshtml", post.SharedPost)
                                }
                                <!-- Post Media -->
                                @if (post.MediaList != null && post.MediaList.Any()) {
                                    int count = Math.Min(post.MediaList.Count, 4);
                                    <div class="post-media-grid count-@count">
                                        @foreach (var media in post.MediaList){
                                            <div class="post-media-item">
                                                @if (media.MediaType == "video") {
                                                    <video src="@media.MediaUrl" controls></video>
                                                }
                                                else {
                                                    <img src="@media.MediaUrl" alt="Media" onclick="window.open('@media.MediaUrl', '_blank');" />
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                <!-- Post Stats Bar -->
                                <div class="post-stats-bar">
                                    <div class="top-reactions-icons" id="topReactionsWrap-@post.PostID">
                                        @if (post.TopReactions != null && post.TopReactions.Any()) {
                                            foreach (var r in post.TopReactions){
                                                <span class="reaction-emoji-badge">@r.Emoji</span>
                                            }
                                        }
                                        <span class="ms-1" id="likeCount-@post.PostID">@(post.LikeCount > 0 ? post.LikeCount.ToString() : "")</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span id="commentCount-@post.PostID">@post.CommentCount bình luận</span>
                                        <span>·</span>
                                        <span id="shareCount-@post.PostID"><span class="share-count-Post-@post.PostID">@post.ShareCount</span> lượt chia sẻ</span>
                                    </div>
                                </div>
                                <!-- Action Buttons with Facebook-style Reaction Popover -->
                                <div class="post-actions-row">
                                    <div class="reaction-popup-container">
                                        <div class="reaction-popover">
                                            <button type="button" class="reaction-btn-icon" onclick="toggleReactionAjax(@post.PostID, 'Like')" title="Thích">👍</button>
                                            <button type="button" class="reaction-btn-icon" onclick="toggleReactionAjax(@post.PostID, 'Love')" title="Yêu thích">❤️</button>
                                            <button type="button" class="reaction-btn-icon" onclick="toggleReactionAjax(@post.PostID, 'Haha')" title="Haha">😆</button>
                                            <button type="button" class="reaction-btn-icon" onclick="toggleReactionAjax(@post.PostID, 'Wow')" title="Wow">😮</button>
                                            <button type="button" class="reaction-btn-icon" onclick="toggleReactionAjax(@post.PostID, 'Sad')" title="Buồn">😢</button>
                                            <button type="button" class="reaction-btn-icon" onclick="toggleReactionAjax(@post.PostID, 'Angry')" title="Phẫn nộ">😡</button>
                                        </div>
                                        <button type="button" class="btn-post-action @(!string.IsNullOrEmpty(post.CurrentUserReaction) ? "reacted" : "")" id="btnReaction-@post.PostID" onclick="toggleReactionAjax(@post.PostID, 'Like')">
                                            <span id="reactionIcon-@post.PostID">
                                                @if (post.CurrentUserReactionMeta != null) {
                                                    <span>@post.CurrentUserReactionMeta.Emoji</span>
                                                }
                                                else {
                                                    <i class="fa-regular fa-thumbs-up"></i>
                                                }
                                            </span>
                                            <span id="reactionLabel-@post.PostID" style="color: @(post.CurrentUserReactionMeta?.Color ?? "inherit")">
                                                @(post.CurrentUserReactionMeta?.Label ?? "Thích")
                                            </span>
                                        </button>
                                        <button type="button" class="reaction-picker-toggle" onclick="toggleReactionPicker(event, this)" aria-label="Chọn cảm xúc" title="Chọn cảm xúc"><i class="fa-solid fa-chevron-up"></i></button>
                                    </div>
                                    <button type="button" class="btn-post-action" onclick="$('#commentInput-@post.PostID').focus();">
                                        <i class="fa-regular fa-message"></i>
                                        <span>Bình luận</span>
                                    </button>
                                    <button type="button" class="btn-post-action" onclick="sharePostAjax(@post.PostID)" title="Chia sẻ bài viết">
                                        <i class="fa-solid fa-share-nodes"></i>
                                        <span>Chia sẻ</span>
                                        <span class="share-count-Post-@post.PostID" style="@(post.ShareCount > 0 ? "" : "display:none;") font-size:11px; font-weight:600; color:#00c8ff; margin-left:3px;">@(post.ShareCount > 0 ? "(" + post.ShareCount + ")" : "")</span>
                                    </button>
                                </div>
                                <!-- Comments Section -->
                                <div class="post-comments-box">
                                    <div class="comments-list" id="commentsList-@post.PostID">
                                        @if (post.Comments != null && post.Comments.Any())  {
                                            foreach (var c in post.Comments) {
                                                <div class="comment-item" id="comment-@c.CommentID">
                                                    <img src="@c.AuthorAvatar" class="comment-avatar" alt="@c.AuthorUsername" onerror="this.onerror=null;this.src=window.DEFAULT_AVATAR_SVG||'/Content/Images/default-avatar.png';" />
                                                    <div class="comment-thread">
                                                        <div class="comment-bubble">
                                                            <div class="comment-author-name">@c.AuthorUsername</div>
                                                            <div class="comment-text">@c.Content</div>
                                                            <div class="comment-meta">
                                                                <span>@c.TimeAgo</span>
                                                                @if (currentUser != null) {
                                                                    <a href="javascript:void(0)" class="comment-reply-link" onclick="toggleCommentReplyForm(@c.CommentID, @post.PostID)">Phản hồi</a>
                                                                }
                                                                @if (c.CanDelete) {
                                                                    <a href="javascript:void(0)" class="comment-action-link text-danger" onclick="deleteCommentAjax(@c.CommentID, @post.PostID)">Xóa</a>
                                                                }
                                                            </div>
                                                        </div>
