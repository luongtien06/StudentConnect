    function appendRealtimePostComment(postId, comment, totalComments) {
        var cards = $('.social-post-card[data-post-id="' + postId + '"]');
        cards.each(function() {
            var card = $(this);
            var existing = card.find('[id="comment-' + comment.commentId + '"]');
            if (existing.length) existing.replaceWith(renderPostComment(comment, postId));
            else if (comment.parentId) card.find('[id="commentReplies-' + comment.parentId + '"]').append(renderPostComment(comment, postId));
            else {
                card.find('[id="commentsList-' + postId + '"]').append(renderPostComment(comment, postId));
                var rootComments = card.find('[id="commentsList-' + postId + '"]').children('.comment-item');
                while (rootComments.length > 3) {
                    rootComments.first().remove();
                    rootComments = card.find('[id="commentsList-' + postId + '"]').children('.comment-item');
                }
            }
            if (totalComments !== undefined) card.find('[id="commentCount-' + postId + '"]').text(totalComments + ' bình luận');
        });
    }
    function refreshRealtimePostComment(postId, commentId) {
        if (!$('.social-post-card[data-post-id="' + postId + '"]').length) return;
        $.get('/Post/GetComment', { postId: postId, commentId: commentId }, function(res) {
            if (!res.success) {
                $('.social-post-card[data-post-id="' + postId + '"]').each(function() {
                    $(this).find('[id="comment-' + commentId + '"]').remove();
                    if (res.totalComments !== undefined) $(this).find('[id="commentCount-' + postId + '"]').text(res.totalComments + ' bình luận');
                });
                return;
            }
            appendRealtimePostComment(postId, res.comment, res.totalComments);
        });
    }
