                                            <img src="@authorAvatar" class="post-author-avatar" alt="@authorName" onerror="this.onerror=null;this.src=window.DEFAULT_AVATAR_SVG||'/Content/Images/default-avatar.png';" />
                                        </a>
                                        <div>
                                            <h4 class="post-author-name">
                                                <a href="@Url.Action("Profile", "User", new { id = c.UserID })" class="text-white text-decoration-none">
                                                    @authorName
