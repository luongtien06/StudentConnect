    function escapePostComment(value) {
        return $('<div>').text(value || '').html();
    }
    function renderPostComment(comment, postId) {
        var safeName = escapePostComment(comment.username || comment.authorUsername);
        var safeAvatar = escapePostComment(comment.avatar || comment.authorAvatar || window.DEFAULT_AVATAR_SVG || '/Content/Images/default-avatar.png');
        var safeContent = escapePostComment(comment.content);
        var actions = '';
        if (!comment.parentId && comment.canReply) actions += `<a href="javascript:void(0)" class="comment-reply-link" onclick="toggleCommentReplyForm(${comment.commentId})">Phản hồi</a>`;
        if (comment.canDelete) actions += `<a href="javascript:void(0)" class="comment-action-link text-danger" onclick="deleteCommentAjax(${comment.commentId}, ${postId})">Xóa</a>`;
        var image = comment.imageUrl ? `<img class="comment-image" src="${escapePostComment(comment.imageUrl)}" alt="Ảnh bình luận" />` : '';
        var threadContent = '';
        if (!comment.parentId) {
            var replyInput = comment.canReply
                ? `<div class="comment-reply-form" id="replyForm-${comment.commentId}" style="display:none;"><input type="text" class="comment-input-field" id="replyInput-${comment.commentId}" placeholder="Viết phản hồi..." onkeydown="if(event.key==='Enter'){event.preventDefault();addCommentAjax(${postId},${comment.commentId});}" /><button type="button" class="btn-send-comment" onclick="addCommentAjax(${postId},${comment.commentId})" title="Gửi phản hồi"><i class="fa-solid fa-paper-plane fa-sm"></i></button></div>`
                : '';
            threadContent = `<div class="comment-replies-list" id="commentReplies-${comment.commentId}"></div>${replyInput}`;
        }
        return `<div class="comment-item" id="comment-${comment.commentId}">
            <img src="${safeAvatar}" class="comment-avatar" alt="${safeName}" onerror="this.onerror=null;this.src=window.DEFAULT_AVATAR_SVG||'/Content/Images/default-avatar.png';" />
            <div class="comment-thread"><div class="comment-bubble"><div class="comment-author-name">${safeName}</div><div class="comment-text">${safeContent}</div>${image}<div class="comment-meta"><span>${escapePostComment(comment.timeAgo || 'Vừa xong')}</span>${actions}</div></div>${threadContent}</div>
        </div>`;
    }
    function toggleCommentReplyForm(commentId) {
