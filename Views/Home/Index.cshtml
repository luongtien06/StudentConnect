    // ── 6. CREATE POST WITH FILES PREVIEW & UPLOAD ──
    var selectedPostFiles = [];
    function triggerPostMediaSelect() {
        var modalEl = document.getElementById('createPostModal');
        if (modalEl) {
            var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }
    }
    $(document).on('change', '#postFileInput', function () {
        var files = Array.from(this.files || []);
        if (!files.length) return;
        files.forEach(function (f) {
            // Kiểm tra trùng lặp
            var isDuplicate = selectedPostFiles.some(function (existing) {
                return existing.name === f.name && existing.size === f.size && existing.lastModified === f.lastModified;
            });
            if (!isDuplicate) {
                selectedPostFiles.push(f);
            }
        });
        // Reset giá trị input để có thể chọn lại file cùng tên lần sau
        this.value = '';
        renderPostFilesPreview();
    });
    function renderPostFilesPreview() {
        var wrap = $('#postFilePreviewWrap');
        wrap.empty();
        if (!selectedPostFiles.length) return;
        selectedPostFiles.forEach(function (f, idx) {
            var url = URL.createObjectURL(f);
            var isVideo = f.type && f.type.startsWith('video');
            var itemHtml = `
                <div class="position-relative" style="width: 75px; height: 75px; border-radius: 8px; overflow: hidden; border: 1px solid rgba(255,255,255,0.2); background: #000;">
                    ${isVideo ? '<video src="' + url + '" style="width:100%;height:100%;object-fit:cover;"></video>' : '<img src="' + url + '" style="width:100%;height:100%;object-fit:cover;" />'}
                    <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 p-0 d-flex align-items-center justify-content-center" style="width: 20px; height: 20px; font-size: 11px; border-radius: 50%; margin: 2px;" onclick="removePostFile(${idx})" title="Xóa file">✕</button>
                </div>
            `;
            wrap.append(itemHtml);
        });
    }
    function removePostFile(idx) {
        selectedPostFiles.splice(idx, 1);
        renderPostFilesPreview();
    }
    function submitNewPost() {
        var content = ($('#createPostContent').val() || '').trim();
        var privacy = $('#createPostPrivacy').val() || 'Public';
        if (!content && selectedPostFiles.length === 0) {
            Swal.fire({ icon: 'warning', title: 'Nội dung trống', text: 'Vui lòng nhập nội dung bài viết hoặc đính kèm ảnh/video!' });
            return;
        }
        var formData = new FormData();
        formData.append('content', content);
        formData.append('privacy', privacy);
        var token = $('input[name="__RequestVerificationToken"]').first().val();
        if (token) {
            formData.append('__RequestVerificationToken', token);
        }
        selectedPostFiles.forEach(function (f) {
            formData.append('mediaFiles', f);
        });
        $('#btnSubmitPost').prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Đang đăng bài...');
        $.ajax({
            url: '/Post/Create',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            headers: token ? { '__RequestVerificationToken': token } : {},
            success: function (res) {
                if (res.success) {
                    $('#createPostContent').val('');
                    selectedPostFiles = [];
                    $('#postFilePreviewWrap').empty();
                    var modalEl = document.getElementById('createPostModal');
                    if (modalEl) {
                        var modal = bootstrap.Modal.getInstance(modalEl);
                        if (modal) modal.hide();
                    }
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công!',
                        text: 'Bài viết của bạn đã được đăng lên Bảng tin!',
                        timer: 1500,
                        showConfirmButton: false
                    }).then(function () {
                        location.reload();
                    });
                } else {
                    Swal.fire({ icon: 'error', title: 'Lỗi', text: res.message || 'Không thể đăng bài viết' });
                    $('#btnSubmitPost').prop('disabled', false).text('Đăng bài');
                }
            },
            error: function (xhr) {
                var msg = 'Lỗi kết nối khi đăng bài!';
                try { var j = JSON.parse(xhr.responseText); if (j && j.message) msg = j.message; } catch (e) {}
                Swal.fire({ icon: 'error', title: 'Lỗi', text: msg });
                $('#btnSubmitPost').prop('disabled', false).text('Đăng bài');
            }
        });
    }
