@model List<StudentConnect.Models.HomeFeedItemViewModel>
@using StudentConnect.Models
@using System.Collections.Generic
@using System.Linq
@{
    ViewBag.Title = "Trang chủ - TDMU";
    var currentUser = ViewBag.CurrentUser as User;
    var feedItems = Model ?? new List<HomeFeedItemViewModel>();
    string currentAvatar = currentUser?.SafeAvatar ?? StudentConnect.Helpers.DefaultImagePlaceholders.Avatar;
    string currentUsername = currentUser?.DisplayName ?? "Bạn";
    var initialSuggestions = ViewBag.FriendSuggestions as List<StudentConnect.Models.FriendSuggestionItemViewModel> ?? new List<StudentConnect.Models.FriendSuggestionItemViewModel>();
}
@Html.AntiForgeryToken()
<style>
    /* ── BASE & HERO BANNER ── */
    .home-page {
        font-family: 'Space Grotesk', sans-serif;
        background: transparent;
        padding: 0 0 3rem;
        position: relative;
        overflow: visible;
    }
    .home-content {
        position: relative;
        z-index: 2;
        max-width: 1140px;
        margin: 0 auto;
    }
    .hero-banner {
        position: relative;
        text-align: left;
        border-radius: 20px;
        overflow: hidden;
        min-height: 280px;
        border: 1px solid rgba(255,255,255,0.1);
        background: rgba(4, 10, 24, 0.45);
        box-shadow: 0 14px 40px rgba(0,0,0,0.22), inset 0 1px 0 rgba(255,255,255,0.06);
    }
    .hero-slides { position: relative; min-height: 280px; }
    .hero-slide {
        position: absolute;
        inset: 0;
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        gap: 1.2rem;
        padding: 1.4rem 1.8rem 2.8rem;
        opacity: 0;
        visibility: hidden;
        transform: translateX(24px);
        transition: opacity 0.28s ease, transform 0.28s ease, visibility 0.28s;
        pointer-events: none;
    }
    .hero-slide.is-active {
        opacity: 1;
        visibility: visible;
        transform: translateX(0);
        pointer-events: auto;
        position: relative;
    }
    .hero-slide::before {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
            radial-gradient(900px 280px at 18% 10%, var(--accent-soft), transparent 60%),
            radial-gradient(520px 240px at 92% 80%, var(--accent-soft-2), transparent 70%);
        z-index: 0;
    }
    .slide-chat { --accent: #00e070; --accent-2: #00c8ff; --accent-soft: rgba(0,224,112,0.18); --accent-soft-2: rgba(0,200,255,0.10); }
    .slide-market { --accent: #ffb830; --accent-2: #ff6b3d; --accent-soft: rgba(255,184,48,0.18); --accent-soft-2: rgba(255,107,61,0.10); }
    .slide-connect { --accent: #a87fff; --accent-2: #00c8ff; --accent-soft: rgba(168,127,255,0.20); --accent-soft-2: rgba(0,200,255,0.10); }
    .slide-copy, .slide-visual { position: relative; z-index: 1; }
    .slide-copy {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        max-width: 520px;
    }
    .mod-tag {
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        padding: 4px 11px;
        border-radius: 100px;
        display: inline-block;
        margin-bottom: 0.75rem;
        border: 1px solid;
    }
    .tag-chat { background: rgba(0,200,80,0.10); color: #00e070; border-color: rgba(0,200,80,0.28); }
    .tag-market { background: rgba(255,160,0,0.10); color: #ffb830; border-color: rgba(255,160,0,0.28); }
    .tag-connect { background: rgba(120,80,255,0.12); color: #a87fff; border-color: rgba(120,80,255,0.28); }
    .slide-kicker { font-size: 0.82rem; color: rgba(255,255,255,0.45); margin-bottom: 0.4rem; }
    .slide-title {
        font-size: clamp(1.25rem, 2.4vw, 1.8rem);
        font-weight: 700; color: #fff; line-height: 1.18;
        margin-bottom: 0.5rem; letter-spacing: -0.02em;
    }
    .slide-title em { font-style: normal; color: var(--accent); }
    .slide-desc {
        font-size: 0.86rem; color: rgba(255,255,255,0.55);
        line-height: 1.5; margin-bottom: 0.9rem; font-weight: 300; max-width: 440px;
    }
    .slide-points { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 1rem; list-style: none; padding: 0; }
    .slide-points li {
        font-size: 11px; color: rgba(255,255,255,0.72);
        background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08);
        border-radius: 100px; padding: 4px 10px;
    }
    .slide-cta {
        display: inline-flex; align-items: center; gap: 8px;
        font-size: 0.82rem; font-weight: 600; padding: 8px 16px;
        border-radius: 100px; text-decoration: none; color: #04140c;
        background: linear-gradient(135deg, var(--accent), var(--accent-2));
        box-shadow: 0 8px 20px rgba(0, 200, 255, 0.2);
        transition: transform 0.2s ease, filter 0.2s ease;
    }
    .slide-cta:hover { color: #04140c; transform: translateY(-2px); filter: brightness(1.08); }
    .slide-cta:hover .cta-arrow { transform: translateX(3px); }
    .cta-arrow { display: inline-block; transition: transform 0.2s ease; }
    .slide-visual { display: flex; align-items: center; justify-content: center; }
    .visual-frame {
        width: min(100%, 350px); border-radius: 16px;
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(8, 14, 28, 0.72);
        backdrop-filter: blur(16px); padding: 12px;
    }
    .visual-top {
        display: flex; align-items: center; gap: 8px;
        margin-bottom: 10px; padding-bottom: 8px;
        border-bottom: 1px solid rgba(255,255,255,0.07);
        font-family: 'JetBrains Mono', monospace; font-size: 10px; color: rgba(255,255,255,0.4);
    }
    .dot { width: 7px; height: 7px; border-radius: 50%; }
    .dot.r { background: #ff5f57; } .dot.y { background: #febc2e; } .dot.g { background: #28c840; }
    .chat-row { display: flex; margin-bottom: 8px; }
    .chat-row.me { justify-content: flex-end; }
    .bubble { max-width: 80%; padding: 8px 11px; border-radius: 12px; font-size: 12px; line-height: 1.4; color: rgba(255,255,255,0.85); }
    .bubble.them { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08); border-bottom-left-radius: 4px; }
    .bubble.me { background: linear-gradient(135deg, rgba(0,224,112,0.28), rgba(0,200,255,0.18)); border: 1px solid rgba(0,224,112,0.28); border-bottom-right-radius: 4px; }
    .chat-meta { font-size: 9.5px; color: rgba(255,255,255,0.28); margin-top: 3px; font-family: 'JetBrains Mono', monospace; }
    .banner-market-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .item-card { border-radius: 12px; overflow: hidden; border: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.03); }
    .item-thumb { height: 54px; display: flex; align-items: center; justify-content: center; font-size: 22px; background: linear-gradient(160deg, rgba(255,184,48,0.18), rgba(255,107,61,0.08)); }
    .item-body { padding: 6px 8px 8px; }
    .item-name { font-size: 11px; color: #fff; font-weight: 600; margin-bottom: 2px; }
    .item-price { font-size: 11px; color: #ffb830; font-family: 'JetBrains Mono', monospace; }
    .connect-list { display: flex; flex-direction: column; gap: 7px; }
    .place-row { display: flex; gap: 8px; align-items: center; padding: 7px 9px; border-radius: 10px; background: rgba(255,255,255,0.035); border: 1px solid rgba(255,255,255,0.07); }
    .place-ico { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; background: rgba(168,127,255,0.16); border: 1px solid rgba(168,127,255,0.25); font-size: 15px; flex-shrink: 0; }
    .place-name { font-size: 12px; color: #fff; font-weight: 600; }
    .place-sub { font-size: 10px; color: rgba(255,255,255,0.4); }
    .place-stars { color: #ffb830; font-size: 10px; margin-left: auto; white-space: nowrap; }
    .banner-footer {
        position: absolute; left: 2.2rem; right: 2.2rem; bottom: 14px;
        z-index: 4; display: flex; align-items: center; gap: 12px;
    }
    .banner-btn {
        width: 34px; height: 34px; border-radius: 50%;
        border: 1px solid rgba(255,255,255,0.14);
        background: rgba(8,14,28,0.7); color: #fff;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; flex-shrink: 0; font-size: 18px; line-height: 1;
    }
    .banner-btn:hover { background: rgba(0,200,255,0.18); border-color: rgba(0,200,255,0.4); }
    .hero-dots { display: flex; gap: 8px; align-items: center; }
    .hero-dot {
        width: 8px; height: 8px; border-radius: 100px; border: 0; padding: 0;
        background: rgba(255,255,255,0.22); cursor: pointer;
        transition: width 0.25s, background 0.25s;
    }
    .hero-dot.is-active { width: 26px; background: var(--dot-accent, #00c8ff); }
    .progress-track { flex: 1; height: 3px; max-width: 180px; background: rgba(255,255,255,0.08); border-radius: 10px; overflow: hidden; }
    .progress-bar { height: 100%; width: 0; background: linear-gradient(90deg, #00c8ff, #7b61ff); }
    .hero-banner.is-playing .progress-bar { animation: bannerProgress 3.2s linear; }
    @@keyframes bannerProgress { from { width: 0; } to { width: 100%; } }
    .hero-banner.is-paused .progress-bar { animation-play-state: paused; }
    /* =========================================================================
       UNIFIED FACEBOOK-STYLE NEWSFEED STYLES
       ========================================================================= */
    .home-feed-wrap {
        max-width: 680px;
        margin: 2rem auto 0;
        text-align: left;
    }
    /* Filter Pills Bar */
    .feed-filter-bar {
        display: flex;
        gap: 8px;
        margin-bottom: 1.25rem;
        overflow-x: auto;
        padding-bottom: 4px;
        scrollbar-width: none;
    }
    .feed-filter-bar::-webkit-scrollbar { display: none; }
    .feed-filter-pill {
        background: rgba(13, 22, 38, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: rgba(255, 255, 255, 0.7);
        padding: 7px 16px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .feed-filter-pill:hover {
        background: rgba(0, 200, 255, 0.15);
        color: #fff;
        border-color: rgba(0, 200, 255, 0.3);
    }
    .feed-filter-pill.active {
        background: linear-gradient(135deg, #00c8ff, #7b61ff);
        color: #000;
        border-color: transparent;
        font-weight: 700;
        box-shadow: 0 4px 15px rgba(0, 200, 255, 0.25);
    }
    /* Quick Create Card */
    .feed-create-card {
        background: rgba(13, 22, 38, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 16px;
        margin-bottom: 20px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    }
    .create-input-row {
        display: flex;
        gap: 12px;
        align-items: center;
        margin-bottom: 12px;
    }
    .create-user-avatar {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
        border: 2px solid rgba(0, 200, 255, 0.4);
    }
    .create-fake-input {
        flex: 1;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 24px;
        padding: 10px 18px;
        font-size: 13.5px;
        color: rgba(255, 255, 255, 0.6);
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .create-fake-input:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: #00c8ff;
        color: #fff;
    }
    .create-options-row {
        display: flex;
        justify-content: space-between;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding-top: 10px;
    }
    .btn-create-opt {
        background: none;
        border: none;
        color: rgba(255, 255, 255, 0.8);
        font-size: 13px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 6px 12px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .btn-create-opt:hover {
        background: rgba(255, 255, 255, 0.07);
        color: #fff;
    }
    /* Feed Post Cards */
    /* Feed Post Cards */
    .feed-post-card {
        background: rgba(13, 22, 38, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        overflow: visible;
        margin-bottom: 16px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .feed-post-card:focus-within { z-index: 60; }
    .feed-post-card:hover {
        border-color: rgba(0, 200, 255, 0.25);
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.35);
    }
    /* Card Header */
    .post-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px 8px;
    }
    .post-author-group {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .post-author-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid rgba(255, 255, 255, 0.1);
        flex-shrink: 0;
    }
    .post-author-name {
        font-size: 14.5px;
        font-weight: 700;
        color: #fff;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
        line-height: 1.25;
    }
    .post-meta-line {
        font-size: 11.5px;
        color: rgba(255, 255, 255, 0.5);
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 2px;
        line-height: 1.2;
    }
    .feed-type-badge {
        font-size: 11px;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 100px;
        display: inline-flex;
        align-items: center;
    }
    .badge-market {
        background: rgba(255, 82, 82, 0.18);
        color: #ff5252;
        border: 1px solid rgba(255, 82, 82, 0.35);
    }
    .badge-connect {
        background: rgba(0, 200, 255, 0.18);
        color: #00e0ff;
        border: 1px solid rgba(0, 200, 255, 0.35);
    }
    .badge-social {
        background: rgba(123, 97, 255, 0.18);
        color: #b39eff;
        border: 1px solid rgba(123, 97, 255, 0.35);
    }
    /* Post Content Text */
    .post-body-content {
        padding: 0 16px 10px;
        font-size: 14.5px;
        line-height: 1.5;
        color: rgba(255, 255, 255, 0.9);
        white-space: pre-line;
        word-break: break-word;
        margin: 0;
    }
    .post-body-content:empty {
        display: none !important;
        padding: 0 !important;
        margin: 0 !important;
    }
    /* Shared Post Preview Box */
    .shared-post-preview {
        margin: 4px 16px 12px;
        padding: 12px 14px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-left: 3px solid #00c8ff;
        border-radius: 10px;
        background: rgba(0, 0, 0, 0.25);
        transition: border-color 0.2s ease;
    }
    .shared-post-preview:hover {
        border-color: rgba(0, 200, 255, 0.35);
    }
    .shared-post-author { color: #fff; font-size: 13px; font-weight: 700; text-decoration: none; }
    .shared-post-author:hover { color: #00c8ff; }
    .shared-post-content {
        margin-top: 6px;
        color: rgba(255, 255, 255, 0.85);
        font-size: 13.5px;
        line-height: 1.45;
        white-space: pre-line;
        overflow-wrap: anywhere;
    }
    .shared-post-content:empty {
        display: none !important;
        margin: 0 !important;
    }
    .shared-post-media {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
        gap: 6px;
        margin-top: 8px;
    }
    .shared-post-media img, .shared-post-media video {
        width: 100%;
        max-height: 220px;
        object-fit: cover;
        border-radius: 4px;
    }
    /* Market Product Info Box */
    .market-product-body {
        padding: 0 16px 10px;
    }
    .market-product-title {
        font-size: 16px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 6px;
        line-height: 1.3;
    }
    .market-tags-row {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
        margin-bottom: 8px;
    }
    .market-price-tag {
        background: linear-gradient(135deg, rgba(255, 82, 82, 0.25), rgba(255, 184, 48, 0.2));
        border: 1px solid rgba(255, 82, 82, 0.45);
        color: #ff5252;
        font-weight: 800;
        font-size: 14px;
        padding: 3px 10px;
        border-radius: 6px;
    }
    .market-cat-tag {
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: #00c8ff;
        font-size: 11.5px;
        padding: 3px 8px;
        border-radius: 6px;
    }
    .market-condition-tag {
        background: rgba(0, 224, 112, 0.1);
        border: 1px solid rgba(0, 224, 112, 0.25);
        color: #00e070;
        font-size: 11.5px;
        padding: 3px 8px;
        border-radius: 6px;
    }
    .market-location-text {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.55);
        margin-bottom: 6px;
    }
    /* Connect Topic Box */
    .connect-topic-body {
        padding: 0 16px 10px;
    }
    .connect-topic-title {
        font-size: 16px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 6px;
        line-height: 1.3;
    }
    .connect-cat-tag {
        background: rgba(0, 200, 255, 0.12);
        border: 1px solid rgba(0, 200, 255, 0.3);
        color: #00c8ff;
        font-size: 11.5px;
        padding: 3px 8px;
        border-radius: 6px;
        margin-bottom: 6px;
        display: inline-block;
    }
    /* Post Media Grid */
    .post-media-grid {
        display: grid;
        gap: 4px;
        background: #000;
        margin-bottom: 8px;
        border-radius: 4px;
        overflow: hidden;
    }
    .post-media-grid.count-1 { grid-template-columns: 1fr; }
    .post-media-grid.count-2 { grid-template-columns: 1fr 1fr; height: 260px; }
    .post-media-grid.count-3 { grid-template-columns: 2fr 1fr; height: 300px; }
    .post-media-grid.count-4 { grid-template-columns: 1fr 1fr; height: 300px; }
    .post-media-item {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #050a14;
    }
    .post-media-grid.count-1 .post-media-item {
        max-height: 520px;
    }
    .post-media-grid.count-1 .post-media-item img {
        width: 100%;
        height: auto;
        max-height: 520px;
        object-fit: contain;
    }
    .post-media-grid.count-1 .post-media-item video {
        width: 100%;
        height: auto;
        max-height: 520px;
    }
    .post-media-grid:not(.count-1) .post-media-item img,
    .post-media-grid:not(.count-1) .post-media-item video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        cursor: pointer;
        transition: transform 0.3s ease;
    }
    .post-media-item:hover img {
        transform: scale(1.02);
    }
    /* Single Large Featured Image (Market / Connect) */
    .feed-featured-img-wrap {
        width: 100%;
        max-height: 400px;
        overflow: hidden;
        background: #000;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 8px;
    }
    .feed-featured-img {
        width: 100%;
        height: auto;
        max-height: 400px;
        object-fit: cover;
        cursor: pointer;
        transition: transform 0.3s ease;
    }
    .feed-featured-img:hover {
        transform: scale(1.02);
    }
    /* Shared Post Inner Box */
    .shared-original-post-box {
        background: rgba(0, 0, 0, 0.25);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 10px;
        padding: 12px;
        margin: 4px 16px 12px;
        transition: border-color 0.2s ease;
    }
    .shared-original-post-box:hover {
        border-color: rgba(0, 200, 255, 0.35);
    }
    /* Stats Bar */
    .post-stats-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 18px;
        font-size: 12.5px;
        color: rgba(255, 255, 255, 0.55);
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }
    .top-reactions-icons {
        display: flex;
        align-items: center;
        gap: 2px;
    }
    .reaction-emoji-badge { font-size: 15px; }
    /* Action Buttons Row */
    .post-actions-row {
        display: flex;
        justify-content: space-around;
        padding: 6px 14px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        position: relative;
        background: rgba(255, 255, 255, 0.015);
    }
    .btn-post-action {
        flex: 1;
        background: none;
        border: none;
        color: rgba(255, 255, 255, 0.65);
        font-size: 13.5px;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 8px 0;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
    }
    .btn-post-action:hover {
        background: rgba(255, 255, 255, 0.07);
        color: #fff;
    }
    .btn-post-action.reacted { color: #00c8ff; }
    /* Facebook-style Reaction Popover */
    .reaction-popup-container {
