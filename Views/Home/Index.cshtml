                        <p class="small mb-3">Hãy là người đầu tiên chia sẻ cảm nghĩ, bán món đồ hoặc tạo bài kết nối!</p>
                        @if (currentUser != null)
                        {
                            <button type="button" class="btn btn-sm btn-info text-dark fw-bold rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#createPostModal">
                                <i class="fa-solid fa-plus me-1"></i> Tạo bài viết ngay
                            </button>
                        }
                    </div>
                }
            </div>
                </div>
    </div>
</div>
@section scripts {
<script>
    // ── 1. BANNER CAROUSEL ──
    (function () {
        var root = document.getElementById('homeBanner');
        if (!root) return;
        var slides = Array.prototype.slice.call(root.querySelectorAll('.hero-slide'));
        var dots = Array.prototype.slice.call(root.querySelectorAll('.hero-dot'));
        var progress = document.getElementById('bannerProgress');
        var idx = 0, timer = null, INTERVAL = 3200;
        var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        function setAccent(i) {
            var accent = slides[i].getAttribute('data-accent') || '#00c8ff';
            dots.forEach(function (d) { d.style.setProperty('--dot-accent', accent); });
        }
        function restartProgress() {
            if (!progress) return;
            root.classList.remove('is-playing');
            void progress.offsetWidth;
            if (!reduceMotion) root.classList.add('is-playing');
        }
        function go(n) {
            slides[idx].classList.remove('is-active');
            slides[idx].setAttribute('aria-hidden', 'true');
            dots[idx].classList.remove('is-active');
            idx = (n + slides.length) % slides.length;
            slides[idx].classList.add('is-active');
            slides[idx].setAttribute('aria-hidden', 'false');
            dots[idx].classList.add('is-active');
            setAccent(idx);
            restartProgress();
        }
        function next() { go(idx + 1); }
        function prev() { go(idx - 1); }
        function start() {
            stop();
            if (reduceMotion) return;
            timer = setInterval(next, INTERVAL);
            restartProgress();
        }
        function stop() { if (timer) { clearInterval(timer); timer = null; } }
        document.getElementById('bannerNext').addEventListener('click', function () { next(); start(); });
        document.getElementById('bannerPrev').addEventListener('click', function () { prev(); start(); });
        dots.forEach(function (dot) {
            dot.addEventListener('click', function () {
                go(parseInt(this.getAttribute('data-index'), 10));
                start();
            });
        });
        root.addEventListener('mouseenter', function () { stop(); root.classList.add('is-paused'); });
        root.addEventListener('mouseleave', function () { root.classList.remove('is-paused'); start(); });
        setAccent(0);
        start();
    })();
    // ── 2. FILTER PILLS CLIENT-SIDE ──
    function filterFeed(type, btn) {
        $('.feed-filter-pill').removeClass('active');
        $(btn).addClass('active');
        if (type === 'all') {
            $('.feed-item-card').fadeIn(200);
        } else {
            $('.feed-item-card').each(function () {
                var cardType = $(this).attr('data-type');
                if (cardType === type) {
                    $(this).fadeIn(200);
                } else {
                    $(this).hide();
                }
            });
        }
    }
    // ── 3. DIRECT MESSAGE ──
    function startDirectMessage(targetId) {
        if (window.AppDialog && !AppDialog.ensureLoggedIn('Vui lòng đăng nhập để gửi tin nhắn.')) {
            return;
        }
        $.post('/Chat/CreatePrivateRoom', { targetId: targetId }, function (res) {
            if (res.success && res.roomId) {
                window.location.href = '/Chat/Private/' + res.roomId;
            } else if (res && res.requireLogin) {
                if (window.AppDialog) {
                    AppDialog.requireLogin({ message: res.message || 'Vui lòng đăng nhập để gửi tin nhắn.' });
                }
            } else {
                if (window.AppDialog) {
                    AppDialog.info(res.message || 'Không thể tạo phòng chat với người này!', 'Nhắn tin');
                } else {
                    Swal.fire({ icon: 'info', title: 'Nhắn tin', text: res.message || 'Không thể tạo phòng chat với người này!' });
                }
            }
        }).fail(function (xhr) {
            if (window.AppDialog) {
                AppDialog.handleAjaxError(xhr, 'Vui lòng đăng nhập để gửi tin nhắn!');
            } else {
                Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Vui lòng đăng nhập để gửi tin nhắn!' });
            }
        });
    }
    // ── 4. SHARE LINK HELPER ──
    function reportPost(postType, postId) {
        if (window.AppDialog && !AppDialog.ensureLoggedIn('Vui lòng đăng nhập để gửi báo cáo vi phạm.')) {
            return;
        }
        Swal.fire({ title: 'Báo cáo bài đăng', input: 'select', inputOptions: { spam: 'Spam hoặc quảng cáo', scam: 'Lừa đảo', offensive: 'Nội dung xúc phạm/không phù hợp', other: 'Lý do khác' }, inputPlaceholder: 'Chọn lý do', showCancelButton: true, confirmButtonText: 'Tiếp tục', cancelButtonText: 'Hủy' }).then(function (first) {
            if (!first.isConfirmed) return;
            Swal.fire({ title: 'Mô tả thêm', input: 'textarea', inputPlaceholder: 'Nêu chi tiết (không bắt buộc)', showCancelButton: true, confirmButtonText: 'Gửi báo cáo', cancelButtonText: 'Hủy' }).then(function (second) {
                if (!second.isConfirmed) return;
                $.post('/Notification/ReportPost', { postType: postType, postId: postId, reason: first.value, details: second.value || '', __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val() }, function (res) {
                    if (res && res.requireLogin) {
                        if (window.AppDialog) AppDialog.requireLogin({ message: res.message || 'Vui lòng đăng nhập để gửi báo cáo vi phạm.' });
                    } else if (res && res.success) {
                        if (window.AppDialog) AppDialog.toastSuccess(res.message || 'Đã gửi báo cáo thành công.');
                        else Swal.fire({ icon: 'success', title: 'Đã gửi', text: res.message });
                    } else {
                        if (window.AppDialog) AppDialog.warning(res ? res.message : 'Không thể gửi báo cáo', 'Thông báo');
                        else Swal.fire({ icon: 'error', title: 'Không thể gửi', text: res ? res.message : '' });
                    }
                }).fail(function (xhr) {
                    if (window.AppDialog) AppDialog.handleAjaxError(xhr, 'Lỗi khi gửi báo cáo vi phạm.');
                });
            });
        });
    }
    function copyShareLink(url) {
        var fullUrl = window.location.origin + url;
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(fullUrl).then(function () {
                if (window.AppDialog) {
                    AppDialog.toastSuccess('Đã sao chép liên kết vào bộ nhớ tạm!');
                } else {
                    Swal.fire({
                        toast: true,
                        position: 'top',
                        icon: 'success',
                        title: 'Đã sao chép liên kết vào bộ nhớ tạm!',
                        showConfirmButton: false,
                        timer: 1600
                    });
                }
            }).catch(function () {
                if (window.AppDialog) AppDialog.info(fullUrl, 'Liên kết');
                else prompt('Sao chép liên kết:', fullUrl);
            });
        } else {
            if (window.AppDialog) AppDialog.info(fullUrl, 'Liên kết');
            else prompt('Sao chép liên kết:', fullUrl);
        }
    }
    // ── 5. SOCIAL POST INTERACTIONS (REACTION / COMMENT / DELETE) ──
    function toggleReactionAjax(postId, likeType) {
        if (window.AppDialog && !AppDialog.ensureLoggedIn('Vui lòng đăng nhập để bày tỏ cảm xúc!')) {
            return;
        }
        var activeControl = document.activeElement;
        if (activeControl && $(activeControl).closest('.reaction-popup-container').length) {
            $(activeControl).closest('.reaction-popup-container').removeClass('is-open');
            activeControl.blur();
        }
        $.post('/Post/ToggleReaction', { postId: postId, likeType: likeType }, function (res) {
            if (res && res.success) {
                $('.social-post-card[data-post-id="' + postId + '"]').each(function () {
                    var card = $(this);
                    var btn = card.find('[id="btnReaction-' + postId + '"]');
                    if (res.currentReaction) {
                        btn.addClass('reacted');
                        card.find('[id="reactionIcon-' + postId + '"]').html('<span>' + res.reactionEmoji + '</span>');
                        card.find('[id="reactionLabel-' + postId + '"]').text(res.reactionLabel).css('color', res.reactionColor || '#00c8ff');
                    } else {
                        btn.removeClass('reacted');
                        card.find('[id="reactionIcon-' + postId + '"]').html('<i class="fa-regular fa-thumbs-up"></i>');
                        card.find('[id="reactionLabel-' + postId + '"]').text('Thích').css('color', 'inherit');
                    }
                    var html = '';
                    (res.topReactions || []).forEach(function (reaction) {
                        html += '<span class="reaction-emoji-badge">' + reaction.Emoji + '</span>';
                    });
                    html += '<span class="ms-1" id="likeCount-' + postId + '">' + (res.totalLikes > 0 ? res.totalLikes : '') + '</span>';
                    card.find('[id="topReactionsWrap-' + postId + '"]').html(html);
                });
            } else if (res && res.requireLogin) {
                if (window.AppDialog) AppDialog.requireLogin({ message: res.message || 'Vui lòng đăng nhập để bày tỏ cảm xúc!' });
            } else {
                if (window.AppDialog) AppDialog.warning(res ? res.message : 'Vui lòng đăng nhập để bày tỏ cảm xúc!', 'Thông báo');
                else Swal.fire({ icon: 'warning', title: 'Thông báo', text: res.message || 'Vui lòng đăng nhập để bày tỏ cảm xúc!' });
            }
        }).fail(function (xhr) {
            if (window.AppDialog) AppDialog.handleAjaxError(xhr, 'Vui lòng đăng nhập để tương tác!');
            else Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Vui lòng đăng nhập để tương tác!' });
        });
    }
    function addCommentAjax(postId, parentId) {
        if (window.AppDialog && !AppDialog.ensureLoggedIn('Vui lòng đăng nhập để bình luận!')) {
            return;
        }
        var input = parentId ? $('#replyInput-' + parentId) : $('#commentInput-' + postId);
        var content = input.val().trim();
        if (!content) return;
        var formData = new FormData();
        formData.append('postId', postId);
        formData.append('content', content);
        formData.append('parentId', parentId || '');
        formData.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').val());
        input.val('');
        $.ajax({
            url: '/Post/AddComment',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (res) {
                if (res && res.success) {
                    input.val('');
                    appendRealtimePostComment(postId, res, res.totalComments);
                } else if (res && res.requireLogin) {
                    if (window.AppDialog) AppDialog.requireLogin({ message: res.message || 'Vui lòng đăng nhập để bình luận!' });
                } else {
                    if (window.AppDialog) AppDialog.warning(res ? res.message : 'Không thể gửi bình luận!', 'Thông báo');
                    else Swal.fire({ icon: 'warning', title: 'Thông báo', text: res.message || 'Không thể gửi bình luận!' });
                }
            },
            error: function (xhr) {
                if (window.AppDialog) AppDialog.handleAjaxError(xhr, 'Vui lòng đăng nhập để bình luận!');
                else Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Vui lòng đăng nhập để bình luận!' });
            }
        });
    }
