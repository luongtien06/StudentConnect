    var friendSearchPage = 1;
    var friendSearchPageSize = 8;
    var friendSearchDebounceTimer = null;
    var friendSearchLastQuery = '';
    var friendSearchHasMore = false;
    // 1. Thực thi tìm kiếm bạn bè
    function executeFriendSearch(isLoadMore) {
        var query = ($('#homeFriendSearchInput').val() || '').trim();
        if (!query) {
            clearFriendSearch();
            return;
        }
        if (!isLoadMore) {
            friendSearchPage = 1;
            friendSearchLastQuery = query;
            $('#friendSearchResultsList').empty();
            $('#friendSearchPagination').addClass('d-none');
        } else {
            friendSearchPage++;
        }
        $('#friendSearchSpinner').removeClass('d-none');
        $('#btnClearFriendSearch').removeClass('d-none');
        $('#friendSearchResults').removeClass('d-none');
        $.ajax({
            url: '/Home/SearchFriends',
            type: 'GET',
            data: { q: query, page: friendSearchPage, pageSize: friendSearchPageSize },
            success: function (res) {
                $('#friendSearchSpinner').addClass('d-none');
                if (!res || !res.success) {
                    if (!isLoadMore) {
                        $('#friendSearchResultsList').html('<div class="text-center py-3 text-white-50"><i class="fa-solid fa-triangle-exclamation text-warning me-1"></i> Không thể tải kết quả. Vui lòng thử lại!</div>');
                    }
                    return;
                }
                friendSearchHasMore = res.hasMore;
                if (!isLoadMore && (!res.users || res.users.length === 0)) {
                    $('#friendSearchResultsList').html('<div class="text-center py-3 text-white-50"><i class="fa-solid fa-user-xmark me-1 text-cyan"></i> Không tìm thấy người dùng phù hợp với từ khóa "<strong>' + $('<div>').text(query).html() + '</strong>"</div>');
                    $('#friendSearchPagination').addClass('d-none');
                    return;
                }
                var html = '';
                $.each(res.users, function (i, u) {
                    html += renderSearchUserItemHtml(u);
                });
                if (isLoadMore) {
                    $('#friendSearchResultsList').append(html);
                } else {
                    $('#friendSearchResultsList').html(html);
                }
                if (res.hasMore) {
                    $('#friendSearchPagination').removeClass('d-none');
                } else {
                    $('#friendSearchPagination').addClass('d-none');
                }
            },
            error: function () {
                $('#friendSearchSpinner').addClass('d-none');
                if (!isLoadMore) {
                    $('#friendSearchResultsList').html('<div class="text-center py-3 text-danger"><i class="fa-solid fa-triangle-exclamation me-1"></i> Lỗi kết nối máy chủ. Vui lòng thử lại!</div>');
                }
            }
        });
    }
    function renderSearchUserItemHtml(u) {
        var avatar = u.Avatar || window.DEFAULT_AVATAR_SVG || '/Content/Images/default-avatar.png';
        var name = u.DisplayName || u.Username || 'Người dùng';
        var faculty = u.Faculty || '';
        var major = u.Major || '';
        var metaText = faculty ? faculty : (major ? major : (u.Bio || 'Thành viên TDMU'));
        var mutualText = u.MutualFriendsCount > 0 ? ('<span class="meta-tag mutual"><i class="fa-solid fa-user-group me-1"></i>' + u.MutualFriendsCount + ' bạn chung</span>') : '';
        var friendBtnHtml = '';
        if (u.RelationshipStatus === 'Self') {
            friendBtnHtml = '<span class="badge bg-secondary opacity-75">Bạn</span>';
        } else if (u.RelationshipStatus === 'PendingSent') {
            friendBtnHtml = '<button type="button" class="btn-sug-action btn-pending" data-friend-btn="' + u.UserID + '" onclick="handleFriendAction(' + u.UserID + ', \'cancel\', this)" title="Đã gửi lời mời (Bấm để hủy)"><i class="fa-solid fa-clock me-1"></i>Đã gửi</button>';
        } else if (u.RelationshipStatus === 'PendingReceived') {
            friendBtnHtml = '<button type="button" class="btn-sug-action btn-accept" data-friend-btn="' + u.UserID + '" onclick="handleFriendAction(' + u.UserID + ', \'accept\', this)" title="Chấp nhận lời mời"><i class="fa-solid fa-check me-1"></i>Chấp nhận</button>';
        } else if (u.RelationshipStatus === 'Friends') {
            friendBtnHtml = '<button type="button" class="btn-sug-action btn-friends" data-friend-btn="' + u.UserID + '" onclick="handleFriendAction(' + u.UserID + ', \'remove\', this)" title="Bạn bè (Bấm để hủy kết bạn)"><i class="fa-solid fa-user-check me-1"></i>Bạn bè</button>';
        } else {
            friendBtnHtml = '<button type="button" class="btn-sug-action btn-add" data-friend-btn="' + u.UserID + '" onclick="handleFriendAction(' + u.UserID + ', \'add\', this)" title="Thêm bạn bè"><i class="fa-solid fa-user-plus me-1"></i>Kết bạn</button>';
        }
        var followBtnHtml = '';
        if (u.RelationshipStatus !== 'Self') {
            var isFollowing = u.IsFollowing || false;
            followBtnHtml = '<button type="button" class="btn-sug-follow ' + (isFollowing ? 'following' : '') + '" data-follow-btn="' + u.UserID + '" onclick="handleFollowAction(' + u.UserID + ', this)" title="' + (isFollowing ? 'Bỏ theo dõi' : 'Theo dõi') + '">' +
                '<i class="fa-solid ' + (isFollowing ? 'fa-bell-slash text-warning' : 'fa-bell') + '"></i>' +
                '</button>';
        }
        return '<div class="search-user-item" data-search-user="' + u.UserID + '">' +
            '<a href="/User/Profile/' + u.UserID + '" class="search-avatar-wrap">' +
                '<img src="' + avatar + '" class="search-avatar" alt="' + $('<div>').text(name).html() + '" onerror="this.onerror=null;this.src=\'/Content/Images/default-avatar.png\';" />' +
            '</a>' +
            '<div class="search-user-info">' +
                '<a href="/User/Profile/' + u.UserID + '" class="search-user-name text-truncate d-block" title="' + $('<div>').text(name).html() + '">' + $('<div>').text(name).html() + '</a>' +
                '<div class="search-user-meta">' +
                    (metaText ? ('<span class="meta-tag">' + $('<div>').text(metaText).html() + '</span>') : '') +
                    mutualText +
                '</div>' +
            '</div>' +
            '<div class="search-actions">' +
                friendBtnHtml +
                followBtnHtml +
            '</div>' +
        '</div>';
    }
    function clearFriendSearch() {
        $('#homeFriendSearchInput').val('');
        $('#btnClearFriendSearch').addClass('d-none');
        $('#friendSearchSpinner').addClass('d-none');
        $('#friendSearchResults').addClass('d-none');
        $('#friendSearchResultsList').empty();
        $('#friendSearchPagination').addClass('d-none');
        friendSearchPage = 1;
        friendSearchLastQuery = '';
    }
    function loadMoreFriendSearch() {
        if (friendSearchHasMore) {
            executeFriendSearch(true);
        }
    }
    // 2. Cuộn thanh gợi ý bạn bè nằm ngang
    function scrollSuggestions(direction) {
        var track = document.getElementById('suggestedFriendsTrack');
        if (!track) return;
        var scrollStep = 380;
        if (direction === 'left') {
            track.scrollBy({ left: -scrollStep, behavior: 'smooth' });
        } else {
            track.scrollBy({ left: scrollStep, behavior: 'smooth' });
        }
    }
    function updateSuggestionScrollButtons() {
        var track = document.getElementById('suggestedFriendsTrack');
        if (!track) return;
        var btnLeft = document.getElementById('btnScrollSugLeft');
        var btnRight = document.getElementById('btnScrollSugRight');
        if (!btnLeft || !btnRight) return;
        var scrollLeft = track.scrollLeft;
        var maxScroll = track.scrollWidth - track.clientWidth;
        if (scrollLeft <= 5) {
            btnLeft.disabled = true;
            btnLeft.style.opacity = '0.3';
        } else {
            btnLeft.disabled = false;
            btnLeft.style.opacity = '1';
        }
        if (scrollLeft >= maxScroll - 5) {
            btnRight.disabled = true;
            btnRight.style.opacity = '0.3';
        } else {
            btnRight.disabled = false;
            btnRight.style.opacity = '1';
        }
    }
    // 3. Làm mới danh sách gợi ý bạn bè (có xoay vòng phân trang mượt mà)
    var friendSuggestionSkip = 0;
    function refreshFriendSuggestions() {
        var btn = $('#btnRefreshSuggestions');
        var icon = btn.find('i');
        icon.addClass('fa-spin');
        btn.prop('disabled', true);
        friendSuggestionSkip += 10;
        $.ajax({
            url: '/Home/GetFriendSuggestions',
            type: 'GET',
            data: { take: 10, skip: friendSuggestionSkip },
            success: function (res) {
                icon.removeClass('fa-spin');
                btn.prop('disabled', false);
                if (!res || !res.success) {
                    if (window.AppDialog) AppDialog.error('Không thể tải danh sách gợi ý. Vui lòng thử lại!', 'Thông báo');
                    else Swal.fire({ icon: 'error', title: 'Thông báo', text: 'Không thể tải danh sách gợi ý. Vui lòng thử lại!' });
                    return;
                }
                var track = $('#suggestedFriendsTrack');
                if (!res.users || res.users.length === 0) {
                    if (friendSuggestionSkip > 0) {
                        // Đã xem hết danh sách, quay vòng về trang đầu
                        friendSuggestionSkip = 0;
                        $.ajax({
                            url: '/Home/GetFriendSuggestions',
                            type: 'GET',
                            data: { take: 10, skip: 0 },
                            success: function (wrapRes) {
                                if (wrapRes && wrapRes.success && wrapRes.users && wrapRes.users.length > 0) {
                                    track.empty();
                                    var cardsHtml = '';
                                    $.each(wrapRes.users, function (i, u) {
                                        cardsHtml += renderSuggestionCardHtml(u);
                                    });
                                    track.html(cardsHtml);
                                    track.scrollLeft(0);
                                    updateSuggestionScrollButtons();
                                }
                            }
                        });
                        return;
                    }
                    track.html('<div class="empty-suggestions-state text-center py-4 text-white-50 w-100">' +
                        '<i class="fa-solid fa-user-check fa-2x mb-2 text-cyan opacity-50"></i>' +
                        '<div>Hiện chưa có gợi ý mới. Hãy thử làm mới lại sau nhé!</div>' +
                        '</div>');
                    return;
                }
                track.empty();
                var cardsHtml = '';
                $.each(res.users, function (i, u) {
                    cardsHtml += renderSuggestionCardHtml(u);
                });
                track.html(cardsHtml);
                track.scrollLeft(0);
                updateSuggestionScrollButtons();
            },
            error: function (xhr) {
                icon.removeClass('fa-spin');
                btn.prop('disabled', false);
                if (window.AppDialog) AppDialog.handleAjaxError(xhr, 'Lỗi kết nối khi làm mới gợi ý bạn bè!');
                else Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Lỗi kết nối khi làm mới gợi ý bạn bè!' });
            }
        });
    }
    function renderSuggestionCardHtml(s) {
        var avatar = s.Avatar || window.DEFAULT_AVATAR_SVG || '/Content/Images/default-avatar.png';
        var name = s.DisplayName || s.Username || 'Người dùng';
        var reasonHtml = '';
        if (s.MutualFriendsCount > 0) {
            reasonHtml = '<span class="text-cyan"><i class="fa-solid fa-user-group me-1"></i>' + s.MutualFriendsCount + ' bạn chung</span>';
        } else if (s.Faculty) {
            reasonHtml = '<span><i class="fa-solid fa-graduation-cap me-1"></i>' + $('<div>').text(s.Faculty).html() + '</span>';
        } else {
            reasonHtml = '<span><i class="fa-solid fa-sparkles me-1"></i>' + $('<div>').text(s.Reason || 'Gợi ý kết nối').html() + '</span>';
        }
        var friendBtnHtml = '';
        if (s.RelationshipStatus === 'PendingSent') {
            friendBtnHtml = '<button type="button" class="btn-sug-action btn-pending" data-friend-btn="' + s.UserID + '" onclick="handleFriendAction(' + s.UserID + ', \'cancel\', this)" title="Đã gửi lời mời (Bấm để hủy)"><i class="fa-solid fa-clock me-1"></i>Đã gửi</button>';
        } else if (s.RelationshipStatus === 'PendingReceived') {
            friendBtnHtml = '<button type="button" class="btn-sug-action btn-accept" data-friend-btn="' + s.UserID + '" onclick="handleFriendAction(' + s.UserID + ', \'accept\', this)" title="Chấp nhận lời mời"><i class="fa-solid fa-check me-1"></i>Chấp nhận</button>';
        } else if (s.RelationshipStatus === 'Friends') {
            friendBtnHtml = '<button type="button" class="btn-sug-action btn-friends" data-friend-btn="' + s.UserID + '" onclick="handleFriendAction(' + s.UserID + ', \'remove\', this)" title="Bạn bè (Bấm để hủy kết bạn)"><i class="fa-solid fa-user-check me-1"></i>Bạn bè</button>';
        } else {
            friendBtnHtml = '<button type="button" class="btn-sug-action btn-add" data-friend-btn="' + s.UserID + '" onclick="handleFriendAction(' + s.UserID + ', \'add\', this)" title="Thêm bạn bè"><i class="fa-solid fa-user-plus me-1"></i>Kết bạn</button>';
        }
        var isFollowing = s.IsFollowing || false;
        var followBtnHtml = '<button type="button" class="btn-sug-follow ' + (isFollowing ? 'following' : '') + '" data-follow-btn="' + s.UserID + '" onclick="handleFollowAction(' + s.UserID + ', this)" title="' + (isFollowing ? 'Bỏ theo dõi' : 'Theo dõi') + '">' +
            '<i class="fa-solid ' + (isFollowing ? 'fa-bell-slash text-warning' : 'fa-bell') + '"></i>' +
            '</button>';
        return '<div class="sug-card" id="suggestion-user-' + s.UserID + '" data-user-id="' + s.UserID + '">' +
            '<button type="button" class="sug-card-dismiss" onclick="dismissSuggestion(' + s.UserID + ')" title="Gỡ gợi ý">' +
                '<i class="fa-solid fa-xmark"></i>' +
            '</button>' +
            '<a href="/User/Profile/' + s.UserID + '" class="sug-avatar-link">' +
                '<img src="' + avatar + '" class="sug-avatar" alt="' + $('<div>').text(name).html() + '" onerror="this.onerror=null;this.src=\'/Content/Images/default-avatar.png\';" />' +
            '</a>' +
            '<a href="/User/Profile/' + s.UserID + '" class="sug-name" title="' + $('<div>').text(name).html() + '">' +
                $('<div>').text(name).html() +
            '</a>' +
            '<div class="sug-reason">' +
                reasonHtml +
            '</div>' +
            '<div class="sug-actions">' +
                friendBtnHtml +
                followBtnHtml +
            '</div>' +
        '</div>';
    }
    // 4. Gỡ gợi ý bạn bè
    function dismissSuggestion(userId) {
        var card = $('#suggestion-user-' + userId);
        if (card.length) {
            card.fadeOut(250, function () {
                card.remove();
                var track = $('#suggestedFriendsTrack');
                if (track.children('.sug-card').length === 0) {
                    track.html('<div class="empty-suggestions-state text-center py-4 text-white-50 w-100">' +
                        '<i class="fa-solid fa-user-check fa-2x mb-2 text-cyan opacity-50"></i>' +
                        '<div>Hiện chưa có gợi ý mới. Hãy thử làm mới lại sau nhé!</div>' +
                        '</div>');
                }
                updateSuggestionScrollButtons();
            });
        }
    }
    // 5. Xử lý Kết bạn / Hủy lời mời / Chấp nhận / Hủy kết bạn
    function handleFriendAction(targetUserId, action, btnElement) {
        if (window.AppDialog && !AppDialog.ensureLoggedIn('Vui lòng đăng nhập để thực hiện thao tác này.')) {
            return;
        }
        var token = $('input[name="__RequestVerificationToken"]').first().val();
        if (action === 'remove') {
            if (window.AppDialog) {
                AppDialog.confirm({
                    title: 'Hủy kết bạn?',
                    message: 'Bạn có chắc chắn muốn hủy kết bạn với người dùng này?',
                    confirmText: 'Đồng ý hủy',
                    cancelText: 'Không',
                    confirmColor: '#ef4444'
                }).then(function (result) {
                    if (result && result.isConfirmed) {
                        executeFriendRequestCall('/User/Unfriend', { targetId: targetUserId, __RequestVerificationToken: token }, targetUserId, 'None', btnElement);
                    }
                });
            } else {
                Swal.fire({
                    title: 'Hủy kết bạn?',
                    text: 'Bạn có chắc chắn muốn hủy kết bạn với người dùng này?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#ef4444',
                    cancelButtonColor: '#6b7280',
                    confirmButtonText: 'Đồng ý hủy',
                    cancelButtonText: 'Không'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        executeFriendRequestCall('/User/Unfriend', { targetId: targetUserId, __RequestVerificationToken: token }, targetUserId, 'None', btnElement);
                    }
                });
            }
            return;
        }
        if (action === 'add') {
            executeFriendRequestCall('/User/SendFriendRequest', { targetId: targetUserId, __RequestVerificationToken: token }, targetUserId, 'PendingSent', btnElement);
        } else if (action === 'cancel') {
            executeFriendRequestCall('/User/CancelFriendRequest', { targetId: targetUserId, __RequestVerificationToken: token }, targetUserId, 'None', btnElement);
        } else if (action === 'accept') {
            executeFriendRequestCall('/User/AcceptFriendRequest', { targetId: targetUserId, __RequestVerificationToken: token }, targetUserId, 'Friends', btnElement);
        }
    }
    function executeFriendRequestCall(url, postData, targetUserId, newStatus, btnElement) {
        var $btn = btnElement ? $(btnElement) : null;
        if ($btn && $btn.prop('disabled')) return;
        if ($btn) $btn.prop('disabled', true);

        $.ajax({
            url: url,
            type: 'POST',
            data: postData,
            success: function (res) {
                if (res && res.success) {
                    syncFriendButtonState(targetUserId, newStatus);
                    var msg = res.message || 'Thao tác thành công!';
                    if (window.AppDialog) AppDialog.toastSuccess(msg);
                    else {
                        const Toast = Swal.mixin({ toast: true, position: 'top-end', showConfirmButton: false, timer: 2000 });
                        Toast.fire({ icon: 'success', title: msg });
                    }
                } else if (res && res.requireLogin) {
                    if (window.AppDialog) AppDialog.requireLogin({ message: res.message || 'Vui lòng đăng nhập để thực hiện thao tác này.' });
                } else {
                    var errMsg = (res && res.message) ? res.message : 'Thao tác không thành công!';
                    if (window.AppDialog) AppDialog.warning(errMsg, 'Thông báo');
                    else Swal.fire({ icon: 'warning', title: 'Thông báo', text: errMsg });
                }
            },
            error: function (xhr) {
                if (window.AppDialog) AppDialog.handleAjaxError(xhr, 'Lỗi kết nối khi gửi yêu cầu.');
                else Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Lỗi kết nối khi gửi yêu cầu. Vui lòng kiểm tra đăng nhập!' });
            },
            complete: function () {
                if ($btn) $btn.prop('disabled', false);
            }
        });
    }
    function syncFriendButtonState(targetUserId, status) {
        var btns = $('[data-friend-btn="' + targetUserId + '"]');
        btns.each(function () {
            var b = $(this);
            b.removeClass('btn-add btn-pending btn-accept btn-friends');
            if (status === 'PendingSent') {
                b.addClass('btn-pending');
                b.html('<i class="fa-solid fa-clock me-1"></i>Đã gửi');
                b.attr('title', 'Đã gửi lời mời (Bấm để hủy)');
                b.attr('onclick', 'handleFriendAction(' + targetUserId + ', \'cancel\', this)');
            } else if (status === 'PendingReceived') {
                b.addClass('btn-accept');
                b.html('<i class="fa-solid fa-check me-1"></i>Chấp nhận');
                b.attr('title', 'Chấp nhận lời mời');
                b.attr('onclick', 'handleFriendAction(' + targetUserId + ', \'accept\', this)');
            } else if (status === 'Friends') {
                b.addClass('btn-friends');
                b.html('<i class="fa-solid fa-user-check me-1"></i>Bạn bè');
                b.attr('title', 'Bạn bè (Bấm để hủy kết bạn)');
                b.attr('onclick', 'handleFriendAction(' + targetUserId + ', \'remove\', this)');
            } else {
                b.addClass('btn-add');
                b.html('<i class="fa-solid fa-user-plus me-1"></i>Kết bạn');
                b.attr('title', 'Thêm bạn bè');
                b.attr('onclick', 'handleFriendAction(' + targetUserId + ', \'add\', this)');
            }
        });
    }
    // 6. Xử lý Theo dõi / Bỏ theo dõi
    function handleFollowAction(targetUserId, btnElement) {
        if (window.AppDialog && !AppDialog.ensureLoggedIn('Vui lòng đăng nhập để theo dõi người dùng này.')) {
            return;
        }
        var $btn = btnElement ? $(btnElement) : $('[data-follow-btn="' + targetUserId + '"]');
        if ($btn && $btn.prop('disabled')) return;
        if ($btn) $btn.prop('disabled', true);

        var token = $('input[name="__RequestVerificationToken"]').first().val();
        $.ajax({
            url: '/User/ToggleFollow',
            type: 'POST',
            data: { targetId: targetUserId, __RequestVerificationToken: token },
            success: function (res) {
                if (res && res.success) {
                    var isFollowing = res.isFollowing;
                    syncFollowButtonState(targetUserId, isFollowing);
                    var msg = isFollowing ? 'Đã theo dõi người dùng' : 'Đã bỏ theo dõi người dùng';
                    if (window.AppDialog) AppDialog.toastSuccess(msg);
                    else {
                        const Toast = Swal.mixin({ toast: true, position: 'top-end', showConfirmButton: false, timer: 1800 });
                        Toast.fire({ icon: 'success', title: msg });
                    }
                } else if (res && res.requireLogin) {
                    if (window.AppDialog) AppDialog.requireLogin({ message: res.message || 'Vui lòng đăng nhập để theo dõi người dùng này.' });
                } else {
                    var errMsg = (res && res.message) ? res.message : 'Không thể thực hiện thao tác!';
                    if (window.AppDialog) AppDialog.warning(errMsg, 'Thông báo');
                    else Swal.fire({ icon: 'warning', title: 'Thông báo', text: errMsg });
                }
            },
            error: function (xhr) {
                if (window.AppDialog) AppDialog.handleAjaxError(xhr, 'Lỗi kết nối khi cập nhật theo dõi!');
                else Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Lỗi kết nối khi cập nhật theo dõi!' });
            },
            complete: function () {
                if ($btn) $btn.prop('disabled', false);
            }
        });
    }
    function syncFollowButtonState(targetUserId, isFollowing) {
        var btns = $('[data-follow-btn="' + targetUserId + '"]');
        btns.each(function () {
            var b = $(this);
            if (isFollowing) {
                b.addClass('following');
                b.attr('title', 'Bỏ theo dõi');
                b.html('<i class="fa-solid fa-bell-slash text-warning"></i>');
            } else {
                b.removeClass('following');
                b.attr('title', 'Theo dõi');
                b.html('<i class="fa-solid fa-bell"></i>');
            }
        });
    }
    // Gắn sự kiện khi DOM sẵn sàng
    $(document).ready(function () {
        // Friend search debounce
        $('#homeFriendSearchInput').on('input', function () {
            var val = $(this).val();
            if (val.length > 0) {
                $('#btnClearFriendSearch').removeClass('d-none');
            } else {
                $('#btnClearFriendSearch').addClass('d-none');
            }
            clearTimeout(friendSearchDebounceTimer);
            friendSearchDebounceTimer = setTimeout(function () {
                executeFriendSearch(false);
            }, 300);
        });
        // Friend search Enter key
        $('#homeFriendSearchInput').on('keydown', function (e) {
            if (e.key === 'Enter' || e.keyCode === 13) {
                e.preventDefault();
                clearTimeout(friendSearchDebounceTimer);
                executeFriendSearch(false);
            }
        });
        // Close search dropdown when clicking outside
        $(document).on('click', function (e) {
            if (!$(e.target).closest('.home-friend-search-wrap').length) {
                $('#friendSearchResults').addClass('d-none');
            }
        });
        // Track scroll listener to update left/right navigation buttons
        var sugTrack = document.getElementById('suggestedFriendsTrack');
        if (sugTrack) {
            sugTrack.addEventListener('scroll', updateSuggestionScrollButtons, { passive: true });
            updateSuggestionScrollButtons();
        }
    });
</script>
}
