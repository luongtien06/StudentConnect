@model IEnumerable<StudentConnect.Models.ConnectPost>
@{
    ViewBag.Title = "Bài viết của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .my-posts-wrap {
        padding: 2.5rem 0 4rem;
    }

    /* ── HEADER ── */
    .mp-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        gap: 12px;
    }

    .mp-title-block {
    }

    .mp-eyebrow {
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        letter-spacing: 0.14em;
        color: rgba(123,97,255,0.7);
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .mp-title {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.6rem;
        font-weight: 700;
        color: #fff;
        margin: 0;
        letter-spacing: -0.02em;
        line-height: 1.1;
    }

        .mp-title span {
            background: linear-gradient(135deg, #7b61ff, #00c8ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

    .mp-count {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        color: rgba(255,255,255,0.25);
        margin-top: 6px;
        letter-spacing: 0.06em;
    }

    .btn-create {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 22px;
        border-radius: 100px;
        font-size: 13px;
        font-weight: 600;
        font-family: 'Space Grotesk', sans-serif;
        background: linear-gradient(135deg, rgba(123,97,255,0.85), rgba(0,200,255,0.75));
        color: #fff;
        border: none;
        text-decoration: none;
        transition: opacity 0.2s, transform 0.15s;
        box-shadow: 0 4px 20px rgba(123,97,255,0.25);
    }

        .btn-create:hover {
            opacity: 0.88;
            transform: translateY(-1px);
            color: #fff;
        }

    /* ── STATS ROW ── */
    .mp-stats {
        display: flex;
        gap: 10px;
        margin-bottom: 2rem;
        flex-wrap: wrap;
    }

    .mp-stat {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 12px;
        padding: 10px 18px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .mp-stat-icon {
        font-size: 16px;
    }

    .mp-stat-val {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.1rem;
        font-weight: 700;
        color: #fff;
    }

    .mp-stat-lbl {
        font-family: 'JetBrains Mono', monospace;
        font-size: 9px;
        letter-spacing: 0.1em;
        color: rgba(255,255,255,0.25);
        margin-top: 1px;
    }

    /* ── GRID ── */
    .mp-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.25rem;
    }

    /* ── CARD ── */
    .mp-card {
        background: rgba(255,255,255,0.025);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 18px;
        overflow: hidden;
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
        display: flex;
        flex-direction: column;
        animation: cardIn 0.4s ease both;
    }

        .mp-card:hover {
            transform: translateY(-5px);
            border-color: rgba(123,97,255,0.35);
            box-shadow: 0 12px 40px rgba(123,97,255,0.12);
        }

    @@keyframes cardIn {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    /* stagger */
    .mp-card:nth-child(1) {
        animation-delay: 0.04s;
    }

    .mp-card:nth-child(2) {
        animation-delay: 0.08s;
    }

    .mp-card:nth-child(3) {
        animation-delay: 0.12s;
    }

    .mp-card:nth-child(4) {
        animation-delay: 0.16s;
    }

    .mp-card:nth-child(5) {
        animation-delay: 0.20s;
    }

    .mp-card:nth-child(6) {
        animation-delay: 0.24s;
    }

    .mp-card-img {
        position: relative;
        height: 180px;
        overflow: hidden;
        flex-shrink: 0;
    }

        .mp-card-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

    .mp-card:hover .mp-card-img img {
        transform: scale(1.04);
    }

    .mp-card-img-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, transparent 40%, rgba(5,10,20,0.7) 100%);
    }

    .mp-cat-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        background: rgba(123,97,255,0.85);
        color: #fff;
        font-family: 'JetBrains Mono', monospace;
        font-size: 9px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 100px;
        backdrop-filter: blur(8px);
    }

    .mp-card-body {
        padding: 1.1rem 1.25rem;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .mp-card-title {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 14px;
        font-weight: 600;
        color: rgba(255,255,255,0.9);
        margin-bottom: 6px;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .mp-card-date {
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        color: rgba(255,255,255,0.25);
        letter-spacing: 0.05em;
        margin-bottom: auto;
    }

    /* actions */
    .mp-card-actions {
        display: flex;
        gap: 6px;
        margin-top: 14px;
        padding-top: 12px;
        border-top: 1px solid rgba(255,255,255,0.06);
    }

    .mp-btn {
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        padding: 7px 0;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 500;
        font-family: 'Space Grotesk', sans-serif;
        border: 1px solid;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
        background: none;
        white-space: nowrap;
    }

        .mp-btn.view {
            color: rgba(0,200,255,0.8);
            border-color: rgba(0,200,255,0.2);
        }

            .mp-btn.view:hover {
                background: rgba(0,200,255,0.1);
                border-color: rgba(0,200,255,0.45);
                color: #00c8ff;
            }

        .mp-btn.edit {
            color: rgba(255,160,0,0.8);
            border-color: rgba(255,160,0,0.2);
        }

            .mp-btn.edit:hover {
                background: rgba(255,160,0,0.1);
                border-color: rgba(255,160,0,0.45);
                color: #ffa000;
            }

        .mp-btn.del {
            color: rgba(255,100,100,0.75);
            border-color: rgba(255,60,60,0.2);
        }

            .mp-btn.del:hover {
                background: rgba(255,60,60,0.1);
                border-color: rgba(255,60,60,0.45);
                color: rgba(255,100,100,1);
            }

    /* deleting state */
    .mp-card.is-deleting {
        opacity: 0.35;
        pointer-events: none;
        transform: scale(0.97);
        transition: all 0.3s;
    }

    /* ── EMPTY STATE ── */
    .mp-empty {
        grid-column: 1 / -1;
        text-align: center;
        padding: 4rem 1rem;
    }

    .mp-empty-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
        opacity: 0.25;
        display: block;
    }

    .mp-empty-title {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.1rem;
        font-weight: 600;
        color: rgba(255,255,255,0.35);
        margin-bottom: 8px;
    }

    .mp-empty-sub {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        color: rgba(255,255,255,0.15);
        letter-spacing: 0.08em;
    }
</style>

<div class="container my-posts-wrap">

    <!-- HEADER -->
    <div class="mp-header">
        <div class="mp-title-block">
            <div class="mp-eyebrow">CONNECT · TDMU</div>
            <h1 class="mp-title">Bài viết <span>của tôi</span></h1>
            <div class="mp-count">@Model.Count() bài đăng trong hệ thống</div>
        </div>
        <a href="@Url.Action("Create")" class="btn-create">
            <i class="bi bi-plus-lg"></i> Tạo bài mới
        </a>
    </div>

    <!-- STATS -->
    @if (Model.Any())
    {
        <div class="mp-stats">
            <div class="mp-stat">
                <span class="mp-stat-icon">📝</span>
                <div>
                    <div class="mp-stat-val">@Model.Count()</div>
                    <div class="mp-stat-lbl">TỔNG BÀI</div>
                </div>
            </div>
            <div class="mp-stat">
                <span class="mp-stat-icon">📅</span>
                <div>
                    <div class="mp-stat-val">@Model.Count(p => p.CreatedAt.HasValue && p.CreatedAt.Value.Month == DateTime.Now.Month)</div>
                    <div class="mp-stat-lbl">THÁNG NÀY</div>
                </div>
            </div>
            <div class="mp-stat">
                <span class="mp-stat-icon">🗂️</span>
                <div>
                    <div class="mp-stat-val">@Model.Select(p => p.CategoryID).Distinct().Count()</div>
                    <div class="mp-stat-lbl">DANH MỤC</div>
                </div>
            </div>
        </div>
    }

    <!-- GRID -->
    <div class="mp-grid" id="postGrid">
        @if (!Model.Any())
        {
            <div class="mp-empty">
                <span class="mp-empty-icon">📭</span>
                <div class="mp-empty-title">Chưa có bài viết nào</div>
                <div class="mp-empty-sub">BẮT ĐẦU BẰNG CÁCH TẠO BÀI ĐĂNG ĐẦU TIÊN</div>
            </div>
        }
        else
        {
            foreach (var item in Model)
            {
                <div class="mp-card" id="card-@item.PostID">
                    <div class="mp-card-img">
                        <img src="@item.MainImage" alt="@item.Title"
                             onerror="this.src='/Content/Images/default-connect.jpg'" />
                        <div class="mp-card-img-overlay"></div>
                        <span class="mp-cat-badge">
                            @(item.ConnectCategory != null ? item.ConnectCategory.CategoryName : "Khác")
                        </span>
                    </div>
                    <div class="mp-card-body">
                        <div class="mp-card-title">@item.Title</div>
                        <div class="mp-card-date">
                            <i class="bi bi-calendar3" style="font-size:9px;"></i>
                            @(item.CreatedAt.HasValue ? item.CreatedAt.Value.ToString("dd/MM/yyyy") : "---")
                        </div>
                        <div class="mp-card-actions">
                            <a href="@Url.Action("Details", new { id = item.PostID })" class="mp-btn view">
                                <i class="bi bi-eye" style="font-size:11px;"></i> Xem
                            </a>
                            <a href="@Url.Action("Edit", new { id = item.PostID })" class="mp-btn edit">
                                <i class="bi bi-pencil" style="font-size:11px;"></i> Sửa
                            </a>
                            <button type="button" class="mp-btn del btn-delete"
                                    data-id="@item.PostID" data-title="@item.Title">
                                <i class="bi bi-trash3" style="font-size:11px;"></i> Xóa
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<form id="deleteForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteId" />
</form>

@section scripts {
    <script>
$(function () {
    $(document).on('click', '.btn-delete', function () {
        var id    = $(this).data('id');
        var title = $(this).data('title');
        var card  = $('#card-' + id);

        Swal.fire({
            title: 'Xóa bài viết?',
            html: '<span style="font-size:13px;color:rgba(255,255,255,0.55);">Bài viết <strong style="color:#fff;">"' + title + '"</strong> sẽ bị xóa vĩnh viễn và không thể khôi phục.</span>',
            icon: 'warning',
            showCancelButton:  true,
            confirmButtonText: '<i class="bi bi-trash3 me-1"></i> Xóa',
            cancelButtonText:  'Hủy'
        }).then(function (result) {
            if (!result.isConfirmed) return;

            card.addClass('is-deleting');

            $('#deleteForm').attr('action', '@Url.Action("Delete", "Connect")');
            $('#deleteId').val(id);
            $('#deleteForm').submit();
        });
    });
});
    </script>
}