@model StudentConnect.Models.ConnectPost

@{
    ViewBag.Title = "Chỉnh sửa bài viết";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .dark-dropdown {
        background-color: #0d1626 !important; 
        color: #ffffff !important;
        border: 1px solid #232840 !important; 
    }

        .dark-dropdown option {
            background-color: #0d1626 !important;
            color: #ffffff !important;
            padding: 10px;
        }

        .dark-dropdown:focus {
            border-color: #00c8ff !important;
            box-shadow: 0 0 0 3px rgba(0, 200, 255, 0.2) !important;
        }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <h2 class="fw-bold mb-4 text-center text-primary">Chỉnh sửa bài viết ✍️</h2>

                    @using (Html.BeginForm("Edit", "Connect", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()

                        @Html.HiddenFor(model => model.PostID)
                        @Html.HiddenFor(model => model.MainImage)
                        @Html.HiddenFor(model => model.UserID)
                        @Html.HiddenFor(model => model.CreatedAt)

                        <div class="mb-3">
                            <label class="form-label fw-bold">Tiêu đề (Tên quán/Địa điểm)</label>
                            @Html.TextBoxFor(model => model.Title, new { @class = "form-control", @required = "required", placeholder = "VD: Highlands Coffee TDMU..." })
                            @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Danh mục</label>
                            @Html.DropDownList("CategoryID", null, "--- Chọn danh mục ---",
                                htmlAttributes: new { @class = "form-select dark-dropdown", @required = "required" })
                            @Html.ValidationMessageFor(model => model.CategoryID, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Ảnh đại diện hiện tại</label>
                            <div class="mb-2 bg-light p-2 rounded-3 text-center border">
                                @{
                                    string imagePath = Model.MainImage;
                                    if (!string.IsNullOrEmpty(imagePath) && !imagePath.StartsWith("/") && !imagePath.StartsWith("~"))
                                    {
                                        imagePath = "~/Content/Uploads/" + imagePath;
                                    }
                                }
                                <img src="@Url.Content(imagePath)" alt="Current Image" class="img-fluid rounded" style="max-height: 200px; object-fit: contain;" onerror="this.src='/Content/Images/default-image.jpg';" />
                            </div>
                            <label class="form-label small text-primary mt-2"><i class="fas fa-upload"></i> Chọn ảnh mới (Chỉ up nếu muốn thay đổi ảnh cũ):</label>
                            <input type="file" name="uploadImage" class="form-control" accept="image/*" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Mô tả / Đánh giá chi tiết</label>
                            @Html.TextAreaFor(model => model.Description, new { @class = "form-control", rows = "6", @required = "required", placeholder = "Chia sẻ cảm nhận của bạn..." })
                            @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger small" })
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-center mt-4 pt-3 border-top">
                            <a href="@Url.Action("Details", "Connect", new { id = Model.PostID })" class="btn btn-light rounded-pill px-4 me-md-2 border">
                                Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">
                                Lưu thay đổi
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>