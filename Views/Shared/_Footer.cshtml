@if (ViewBag.HideFooter == null || !(bool)ViewBag.HideFooter)
{
    <style>
        .tdmu-footer {
            background: rgba(5,10,20,0.98);
            border-top: 1px solid rgba(255,255,255,0.06);
            padding: 1.2rem 0;
            font-family: 'Space Grotesk', sans-serif;
            text-align:center;
        }

        .fb-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-bottom: 6px;
        }

        .fb-icon {
            width: 28px;
            height: 28px;
            border-radius: 7px;
            background: rgba(0,200,255,0.1);
            border: 1px solid rgba(0,200,255,0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 600;
            color: #00c8ff;
        }

        .fb-name {
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            color: #fff;
            letter-spacing: .06em;
        }

        .footer-copy {
            font-size: 11px;
            color: rgba(255,255,255,0.25);
        }
    </style>

    <footer class="tdmu-footer">
        <div class="container">
            <div class="fb-row">
                <div class="fb-icon">TDMU</div>
                <span class="fb-name" >TDMU</span>
            </div>
            <div class="footer-copy">
                © @DateTime.Now.Year TDMU
            </div>
        </div>
    </footer>
}