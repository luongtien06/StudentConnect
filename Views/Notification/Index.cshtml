@model IEnumerable<StudentConnect.Models.Notification>
@{
    ViewBag.Title = "Thông báo của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .notif-page-wrap {
        max-width: 680px;
        margin: 2rem auto;
        padding: 0 1rem;
    }

    .notif-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 10px;
    }

    .notif-page-title {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.3rem;
        font-weight: 600;
        color: #fff;
        margin: 0;
    }

    .notif-page-sub {
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        color: rgba(0,200,255,0.5);
        letter-spacing: 0.1em;
        margin-top: 3px;
    }

    .notif-card {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 16px;
        overflow: hidden;
    }

        .notif-card::before {
            content: '';
            display: block;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(0,200,255,0.4), rgba(123,97,255,0.3), transparent);
        }

    .notif-filter-bar {
        display: flex;
        gap: 4px;
        padding: 12px 16px;
        border-bottom: 1px solid rgba(255,255,255,0.06);
        flex-wrap: wrap;
    }

    .filter-btn {
        padding: 5px 14px;
        border-radius: 100px;
        font-size: 11px;
        font-family: 'JetBrains Mono', monospace;
        letter-spacing: 0.06em;
        cursor: pointer;
        border: 1px solid rgba(255,255,255,0.1);
        background: none;
        color: rgba(255,255,255,0.35);
        transition: all 0.2s;
    }

        .filter-btn:hover {
            color: rgba(255,255,255,0.7);
            border-color: rgba(255,255,255,0.2);
        }

        .filter-btn.active {
            color: #00c8ff;
            border-color: rgba(0,200,255,0.35);
            background: rgba(0,200,255,0.08);
        }

    .notif-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 14px 18px;
        border-bottom: 1px solid rgba(255,255,255,0.04);
        text-decoration: none;
        transition: background 0.15s;
        position: relative;
    }

        .notif-item:last-child {
            border-bottom: none;
        }

        .notif-item:hover {
            background: rgba(255,255,255,0.03);
        }

        .notif-item.unread {
            background: rgba(0,200,255,0.025);
        }

            .notif-item.unread::before {
                content: '';
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                width: 2px;
                background: rgba(0,200,255,0.5);
            }

    .notif-icon {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
    }

        .notif-icon.market {
            background: rgba(0,200,80,0.1);
            border: 1px solid rgba(0,200,80,0.2);
        }

        .notif-icon.connect {
            background: rgba(123,97,255,0.1);
            border: 1px solid rgba(123,97,255,0.2);
        }

        .notif-icon.system {
            background: rgba(0,200,255,0.1);
            border: 1px solid rgba(0,200,255,0.2);
        }

        .notif-icon.chat {
            background: rgba(0,200,255,0.1);
            border: 1px solid rgba(0,200,255,0.25);
        }

    .notif-body {
        flex: 1;
        min-width: 0;
    }

    .notif-msg {
        font-size: 13px;
        color: rgba(255,255,255,0.75);
        line-height: 1.55;
        font-family: 'Space Grotesk', sans-serif;
    }

    .notif-item.unread .notif-msg {
        color: rgba(255,255,255,0.9);
    }

    .notif-time {
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        color: rgba(255,255,255,0.2);
        margin-top: 5px;
        letter-spacing: 0.04em;
    }

    .unread-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #00c8ff;
        flex-shrink: 0;
        margin-top: 5px;
    }

    .notif-empty {
        padding: 3rem;
        text-align: center;
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        color: rgba(255,255,255,0.15);
        letter-spacing: 0.08em;
    }

    .notif-empty-icon {
        font-size: 2rem;
        display: block;
        margin-bottom: 12px;
        opacity: 0.3;
    }

    .mark-all-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 100px;
        font-size: 11px;
        font-family: 'JetBrains Mono', monospace;
        letter-spacing: 0.06em;
        color: rgba(0,200,255,0.7);
        border: 1px solid rgba(0,200,255,0.25);
        background: rgba(0,200,255,0.06);
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
    }

        .mark-all-btn:hover {
            background: rgba(0,200,255,0.12);
            color: #00c8ff;
        }
</style>

<div class="notif-page-wrap">
    @Html.AntiForgeryToken()
    <div class="notif-page-header">
        <div>
            <h1 class="notif-page-title">Thông báo</h1>
            <div class="notif-page-sub" id="unreadCount">
                @Model.Count(n => !n.IsRead) thông báo chưa đọc
            </div>
        </div>
        <div style="display:flex; gap:8px; flex-wrap:wrap;">
            @if (Model.Any(n => !n.IsRead))
            {
                <a href="#" class="mark-all-btn" id="markAllBtn">
                    <i class="bi bi-check2-all"></i> Đánh dấu tất cả đã đọc
                </a>
            }
            @if (Model.Any())
            {
                <a href="#" class="mark-all-btn" id="deleteAllPageBtn" style="color:#ff4d4d; border-color:rgba(255,77,77,0.3); background:rgba(255,77,77,0.06);">
                    <i class="bi bi-trash"></i> Xóa tất cả
                </a>
            }
        </div>
    </div>

    <div class="notif-card">
        <div class="notif-filter-bar">
            <button class="filter-btn active" data-filter="all">TẤT CẢ (@Model.Count())</button>
            <button class="filter-btn" data-filter="market">🛒 CHỢ (@Model.Count(n => (n.Type ?? "").ToLower() == "market"))</button>
            <button class="filter-btn" data-filter="connect">🤝 KẾT NỐI (@Model.Count(n => (n.Type ?? "").ToLower() == "connect"))</button>
        </div>

        <div id="notifListFull">
            @if (!Model.Any())
            {
                <div class="notif-empty">
                    <span class="notif-empty-icon">🔔</span>
                    CHƯA CÓ THÔNG BÁO NÀO
                </div>
            }
            else
            {
                foreach (var item in Model)
                {
                    string safeType = (item.Type ?? "").ToLower();
                    string iconClass = safeType == "market" ? "market" : safeType == "connect" ? "connect" : safeType == "chat" ? "chat" : "system";
                    string iconEmoji = safeType == "market" ? "🛒" : safeType == "connect" ? "🤝" : safeType == "chat" ? "💬" : "🔔";
                    string href = string.IsNullOrEmpty(item.Url) ? "#" : item.Url;

                    <div class="notif-row-wrap" data-type="@safeType" data-id="@item.NotificationID" style="display:flex; align-items:center; border-bottom:1px solid rgba(255,255,255,0.04);">
                        <a class="notif-item @(!item.IsRead ? "unread" : "")"
                           href="@href"
                           data-type="@safeType"
                           data-id="@item.NotificationID"
                           style="flex:1; border-bottom:none;">
                            <div class="notif-icon @iconClass">@iconEmoji</div>
                            <div class="notif-body">
                                <div class="notif-msg">@item.Message</div>
                                <div class="notif-time">
                                    @item.CreatedAt.ToString("HH:mm · dd/MM/yyyy")
                                </div>
                            </div>
                            @if (!item.IsRead)
                            {
                                <div class="unread-dot"></div>
                            }
                        </a>
                        <button type="button" class="delete-single-btn" data-id="@item.NotificationID"
                                title="Xóa thông báo"
                                style="background:none; border:none; color:rgba(255,255,255,0.3); padding:12px 16px; cursor:pointer; font-size:14px; flex-shrink:0; transition:color 0.2s;"
                                onmouseover="this.style.color='#ff4d4d'"
                                onmouseout="this.style.color='rgba(255,255,255,0.3)'">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
$(function () {
    // filter tabs
    $('.filter-btn').on('click', function () {
        $('.filter-btn').removeClass('active');
        $(this).addClass('active');
        var f = $(this).data('filter').toLowerCase();

        $('.notif-row-wrap').each(function () {
            var itemType = ($(this).find('.notif-item').data('type') || "").toString().toLowerCase();
            if (f === 'all' || itemType === f) $(this).show();
            else $(this).hide();
        });
    });

    // mark single on click
    $(document).on('click', '.notif-item', function () {
        var id   = $(this).data('id');
        var self = $(this);
        if (self.hasClass('unread')) {
            self.removeClass('unread').find('.unread-dot').remove();
            $.post('@Url.Action("MarkRead", "Notification")', {
                id: id,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            });
        }
    });

    // delete single
    $(document).on('click', '.delete-single-btn', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var id = $(this).data('id');
        var row = $(this).closest('.notif-row-wrap');
        row.fadeOut(200, function () { row.remove(); });
        $.post('@Url.Action("Delete", "Notification")', {
            id: id,
            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
        });
    });

    // mark all
    $('#markAllBtn').on('click', function (e) {
        e.preventDefault();
        $('.notif-item.unread').removeClass('unread').find('.unread-dot').remove();
        $(this).fadeOut(200);
        $('.notif-page-sub').text('0 thông báo chưa đọc');
        $.post('@Url.Action("MarkAllRead", "Notification")', {
            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
        });
    });

    // delete all page
    $('#deleteAllPageBtn').on('click', function (e) {
        e.preventDefault();
        $('#notifListFull').html('<div class="notif-empty"><span class="notif-empty-icon">🔔</span>CHƯA CÓ THÔNG BÁO NÀO</div>');
        $(this).fadeOut(200);
        $('#markAllBtn').fadeOut(200);
        $('.notif-page-sub').text('0 thông báo chưa đọc');
        $.post('@Url.Action("DeleteAll", "Notification")', {
            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
        });
    });
});
    </script>
}